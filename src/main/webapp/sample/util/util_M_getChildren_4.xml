// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getChildren]&lt;br/&gt;GridView(inputType=select, viewType=icon) 포함 시 options.excludeInnerComp, options.excludeContainerComp 파라미터를 검증합니다.&quot;,
    &quot;validation&quot; : [
        &quot;options.excludeInnerComp 가 true 이면 GridView 내부에 자동 생성된 SelectBox 등 내부 컴포넌트를 결과에서 제외해야 합니다.&quot;,
        &quot;options.excludeInnerComp 가 false 이면 GridView 내부 컴포넌트를 결과에 포함해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getChildren_onclick = function () {
    let excludeInnerCompVal = par_excludeInnerComp.getValue();

    let options = { recursive : true };
    if (excludeInnerCompVal !== '') {
        options.excludeInnerComp = (excludeInnerCompVal === 'true');
    }

    let ret = WebSquare.util.getChildren(grp_test, options);

    let result = [];
    result.push(&quot;자식 수: &quot; + ret.length);

    for (let i = 0; i &lt; ret.length; i++) {
        result.push(&quot;[&quot; + i + &quot;] id: &quot; + ret[i].getID());
    }

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(result.join(&quot;, &quot;));
}</script>
