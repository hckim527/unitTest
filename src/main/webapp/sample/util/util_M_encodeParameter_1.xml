    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_encodeParameter_onclick = function () {
    let uri = par_uri.getValue();
    let ret = WebSquare.util.encodeParameter(uri);

    let result = [];
    result.push(&quot;encodeParameter('&quot; + uri + &quot;') : &quot; + ret);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(result.join(&quot;, &quot;));
}</script>
