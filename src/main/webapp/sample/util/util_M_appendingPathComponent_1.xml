									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_endUrl" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[/inswave.xml (슬래시로 시작)]]></xf:label>
												<xf:value><![CDATA[/inswave.xml]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[inswave.xml (슬래시 없이 시작)]]></xf:label>
												<xf:value><![CDATA[inswave.xml]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[http://other.com/page (절대 경로)]]></xf:label>
												<xf:value><![CDATA[http://other.com/page]]></xf:value>
											</xf:item>
										</xf:choices>
