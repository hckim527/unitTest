		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; appendingPathComponent]&lt;br/&gt;두 URL 경로 조각을 슬래시(/) 중복 및 누락 없이 병합하여 하나의 경로 문자열로 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;startUrl(필수) 파라미터로 병합할 URL 의 앞부분 경로를 설정할 수 있어야 합니다.&quot;,
        &quot;endUrl(필수) 파라미터로 병합할 URL 의 뒷부분 경로를 설정할 수 있어야 합니다.&quot;,
        &quot;두 경로 조각이 슬래시 규칙에 맞게 병합된 URL 문자열을 반환해야 합니다.&quot;,
        &quot;startUrl 파라미터가 '/' 로 끝나고 endUrl 파라미터가 '/' 로 시작하면 중복 슬래시를 제거하여 병합해야 합니다.&quot;,
        &quot;startUrl 파라미터가 '/' 로 끝나지 않고 endUrl 파라미터도 '/' 로 시작하지 않으면 사이에 '/' 를 추가하여 병합해야 합니다.&quot;,
        &quot;endUrl 파라미터에 '://' 가 포함된 경우(프로토콜이 있는 절대 경로) endUrl 파라미터값만 반환해야 합니다.&quot;,
        &quot;startUrl 파라미터의 길이가 0 인 경우에도 endUrl 파라미터값만 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_appendingPathComponent_onclick = function () {
    let startUrl = par_startUrl.getValue();
    let endUrl = par_endUrl.getValue();
    let ret = WebSquare.util.appendingPathComponent(startUrl, endUrl);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;appendingPathComponent('&quot; + startUrl + &quot;', '&quot; + endUrl + &quot;') : &quot; + ret);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
