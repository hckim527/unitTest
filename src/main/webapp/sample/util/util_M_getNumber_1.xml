		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getNumber]&lt;br/&gt;콤마(,) 가 포함된 숫자 문자열에서 콤마를 제거하고 숫자로 변환하여 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;number(필수) 파라미터로 변환하려는 숫자 문자열을 설정할 수 있어야 합니다.&quot;,
        &quot;콤마가 포함된 숫자 문자열에서 콤마를 제거하고 숫자로 변환하여 반환해야 합니다.&quot;,
        &quot;소수점이 포함된 숫자 문자열을 정상적으로 변환해야 합니다.&quot;,
        &quot;마이너스 부호가 포함된 숫자 문자열을 정상적으로 변환해야 합니다.&quot;,
        &quot;숫자, 마이너스 부호, 소수점 이외의 문자가 포함된 경우 NaN 을 반환해야 합니다.&quot;,
        &quot;빈 문자열인 경우 0 을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getNumber_onclick = function () {
    let number = par_number.getValue();

    let result = WebSquare.util.getNumber(number);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getNumber('&quot; + number + &quot;') : &quot; + result + &quot; (typeof: &quot; + typeof result + &quot;)&quot;);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
