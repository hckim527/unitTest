		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getPopupParam]&lt;br/&gt;팝업이 생성될때 전달된 데이터(파라미터)를 팝업 내부에서 조회하여 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;팝업에 전달된 데이터 문자열을 반환해야 합니다.&quot;,
        &quot;XML 데이터인 경우 직렬화(serialize) 된 문자열을 반환해야 합니다.&quot;,
        &quot;XML 이 아닌 경우 JSON.stringify 로 변환된 문자열을 반환해야 합니다.&quot;,
        &quot;전달된 데이터가 없으면 null 을 반환해야 합니다.&quot;,
        &quot;팝업 내부에서만 호출하여야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_createPopup_onclick = function () {
    let dataType = par_dataType.getValue();
    let xmlData;

    if (dataType === 'xml') {
        xmlData = '&lt;data&gt;&lt;name&gt;테스트&lt;/name&gt;&lt;value&gt;100&lt;/value&gt;&lt;/data&gt;';
    } else if (dataType === 'json') {
        xmlData = JSON.stringify({name:&quot;테스트&quot;, value:100});
    } else if (dataType === 'string') {
        xmlData = &quot;문자열 파라미터&quot;;
    } else {
        xmlData = undefined;
    }

    WebSquare.util.createPopup(
        &quot;getPopupParam_1&quot;,
        &quot;window&quot;,
        &quot;테스트 팝업&quot;,
        &quot;width:600px;height:350px;top:100px;left:100px;&quot;,
        true,
        false,
        &quot;/sample/common_link/util_getPopupParam_1.xml&quot;,
        undefined,
        &quot;map&quot;,
        xmlData
    );

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;createPopup 실행 (dataType: &quot; + dataType + &quot;)&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 내부에서 getPopupParam 결과를 확인하세요.&quot;);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
