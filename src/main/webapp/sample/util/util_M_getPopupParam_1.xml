									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_dataType" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[XML 데이터]]></xf:label>
												<xf:value><![CDATA[xml]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[JSON 데이터]]></xf:label>
												<xf:value><![CDATA[json]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[String 데이터]]></xf:label>
												<xf:value><![CDATA[string]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[데이터 없음 (null)]]></xf:label>
												<xf:value><![CDATA[none]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
								</xf:group>
