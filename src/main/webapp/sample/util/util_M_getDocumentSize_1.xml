	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260320" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getDocumentSize]&lt;br/&gt;스크롤바 영역을 제외한 Document 의 가로(Width) 또는 세로(Height) 크기를 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;sizeName(필수) 파라미터로 조회하려는 크기 종류를 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;sizeName 을 'width' 로 설정 시 문서의 가로 크기를 반환해야 합니다.&quot;,
        &quot;sizeName 을 'height' 로 설정 시 문서의 세로 크기를 반환해야 합니다.&quot;,
        &quot;sizeName 파라미터는 대소문자를 구분하지 않아야 합니다.&quot;,
        &quot;sizeName 파라미터가 'width' 또는 'height' 가 아닌 경우 undefined 를 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getDocumentSize_onclick = function () {
    let sizeName = par_sizeName.getValue();

    let result = WebSquare.util.getDocumentSize(sizeName);

    if (result !== undefined) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDocumentSize('&quot; + sizeName + &quot;') : &quot; + result + &quot;px&quot;);
    } else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDocumentSize('&quot; + sizeName + &quot;') : undefined&quot;);
    }
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="sizeName" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_sizeName" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[width]]></xf:label>
												<xf:value><![CDATA[width]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[height]]></xf:label>
												<xf:value><![CDATA[height]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[Width (대소문자 혼합)]]></xf:label>
												<xf:value><![CDATA[Width]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[invalid (잘못된 값)]]></xf:label>
												<xf:value><![CDATA[invalid]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getDocumentSize_onclick" id="btn_getDocumentSize"
							label="getDocumentSize" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>