		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getStringByteSize]&lt;br/&gt;문자열의 바이트 크기를 설정된 인코딩 방식에 따라 계산하여 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;str(필수) 파라미터로 바이트 크기를 계산하려는 문자열을 설정할 수 있어야 합니다.&quot;,
        &quot;영문 문자열의 바이트 크기를 정상적으로 계산해야 합니다.&quot;,
        &quot;한글 문자열의 바이트 크기를 인코딩 방식에 따라 계산해야 합니다. (UTF-8: 3바이트, EUC-KR: 2바이트)&quot;,
        &quot;ignoreChar(선택) 파라미터로 바이트 크기 계산 시 무시할 문자를 설정할 수 있어야 합니다.&quot;,
        &quot;ignoreChar 파라미터 문자열 내 각 문자가 개별적으로 무시 대상이 되어야 합니다.&quot;,
        &quot;ignoreChar(선택) 생략 시 기본값 undefined 로 동작해야 합니다.&quot;,
        &quot;str 파라미터가 유효하지 않은 경우 0 을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getStringByteSize_onclick = function () {
    let str = par_str.getValue();
    let ignoreChar = par_ignoreChar.getValue();

    let result;
    if (ignoreChar === 'omit') {
        result = WebSquare.util.getStringByteSize(str);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getStringByteSize('&quot; + str + &quot;') : &quot; + result + &quot; bytes&quot;);
    } else {
        result = WebSquare.util.getStringByteSize(str, ignoreChar);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getStringByteSize('&quot; + str + &quot;', '&quot; + ignoreChar + &quot;') : &quot; + result + &quot; bytes&quot;);
    }
}</script>
	</head>
