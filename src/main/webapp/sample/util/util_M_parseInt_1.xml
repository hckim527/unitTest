		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[util > M > parseInt]<br/>문자열을 10진수 정수로 변환하여 반환합니다.",
    "validation" : [
        "number(필수) 파라미터로 정수로 변환할 문자열을 설정할 수 있어야 합니다.",
        "defaultValue(선택) 파라미터로 변환 결과가 NaN 일 때 반환할 기본값을 설정할 수 있어야 합니다.",
        "defaultValue(선택) 파라미터 생략 시 기본값 undefined 로 동작해야 합니다.",
        "변환된 정수를 반환해야 합니다.",
        "변환 결과가 NaN 이고 defaultValue 가 설정되어 있으면 defaultValue 값을 반환해야 합니다.",
        "defaultValue 가 undefined 이거나 NaN 이면 변환 결과 NaN 을 그대로 반환해야 합니다.",
        "\"0x10\" 같은 16진수 문자열은 NaN 을 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_parseInt_onclick = function () {
    let numberVal = par_number.getValue();
    let defaultVal = par_defaultValue.getValue();

    let ret;
    if (defaultVal === '') {
        ret = WebSquare.util.parseInt(numberVal);
    } else if (defaultVal === 'NaN') {
        ret = WebSquare.util.parseInt(numberVal, NaN);
    } else if (defaultVal === 'undefined') {
        ret = WebSquare.util.parseInt(numberVal, undefined);
    } else {
        ret = WebSquare.util.parseInt(numberVal, Number(defaultVal));
    }

    wf_body_bottom.getObj("scwin").setReturnValue("parseInt : " + ret);
}]]></script>
