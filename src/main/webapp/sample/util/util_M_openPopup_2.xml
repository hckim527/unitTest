		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[util > M > openPopup]<br/>지정한 옵션에 맞게 팝업을 생성하여 엽니다.",
    "validation" : [
        "options.resizable(선택) 파라미터를 true 로 설정하면 팝업의 크기를 조절할 수 있어야 합니다.",
        "options.resizable(선택) 파라미터 생략 시 기본값 false 로 동작해야 합니다.",
        "options.useControl(선택) 파라미터를 true 로 설정하면 타이틀바에 최소화, 최대화, 닫기 버튼이 표시되어야 합니다.",
        "options.useControl(선택) 파라미터 생략 시 기본값 false 로 동작해야 합니다.",
        "options.controls.minimize(선택) 파라미터를 false 로 설정하면 최소화 버튼이 숨겨져야 합니다.",
        "options.controls.maximize(선택) 파라미터를 false 로 설정하면 최대화 버튼이 숨겨져야 합니다.",
        "options.controls.close(선택) 파라미터를 false 로 설정하면 닫기 버튼이 숨겨져야 합니다.",
        "options.useMaximize(선택) 파라미터를 true 로 설정하면 타이틀바 더블클릭 시 팝업이 최대화되어야 합니다.",
        "options.closeAction(선택) 파라미터로 팝업 닫기 전 호출할 함수 이름을 설정할 수 있어야 합니다.",
        "options.closeAction(선택) 함수에서 true 를 반환하면 팝업이 닫혀야 합니다.",
        "options.disableCloseButton(선택) 파라미터를 true 로 설정하면 닫기 버튼이 비활성화되어야 합니다.",
        "options.fixPosition(선택) 파라미터를 true 로 설정하면 팝업 위치가 고정되어 드래그되지 않아야 합니다.",
        "options.fixPosition(선택) 파라미터 생략 시 기본값 false 로 동작해야 합니다.",
        "options.windowDragMove(선택) 파라미터를 true 로 설정하면 팝업 전체가 드래그를 따라 이동해야 합니다.",
        "options.windowDragMove(선택) 파라미터를 false 로 설정하면 테두리만 드래그를 따라 이동해야 합니다.",
        "options.alwaysOnTop(선택) 파라미터를 true 로 설정하면 클릭한 팝업이 상위에 표시되어야 합니다.",
        "options.className(선택) 파라미터로 팝업 최상위 div 의 class 속성을 설정할 수 있어야 합니다.",
        "options.style(선택) 파라미터로 팝업의 CSS 스타일을 직접 설정할 수 있어야 합니다.",
        "options.frameModal(선택) 파라미터로 팝업을 표시할 Frame 영역을 설정할 수 있어야 합니다.",
        "options.windowMoveType(선택) 파라미터를 'restrict' 로 설정하면 팝업이 영역 밖으로 나가지 않아야 합니다.",
        "options.windowMoveType(선택) 파라미터를 'overflow' 로 설정하면 마우스 포인터 영역 밖 시점에 고정되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.popup_closeAction = function (argRuntimeID, argJsnInfo) {
    wf_body_bottom.getObj("scwin").setReturnValue("closeAction 호출됨 (isCloseButtonClick: " + argJsnInfo.isCloseButtonClick + ")");
    return true;
};



scwin.btn_openPopup_onclick = function () {
    let resizable = par_resizable.getValue();
    let useControl = par_useControl.getValue();
    let fixPosition = par_fixPosition.getValue();
    let windowDragMove = par_windowDragMove.getValue();
    let closeAction = par_closeAction.getValue();
    let disableCloseButton = par_disableCloseButton.getValue();
    let windowMoveType = par_windowMoveType.getValue();

    let options = {
        id: "popup_test_2",
        type: "wframePopup",
        width: "500px",
        height: "350px",
        top: "150px",
        left: "200px",
        popupName: "openPopup 고급 옵션 테스트",
        modal: false,
        alwaysOnTop: true
    };

    if (resizable !== '') options.resizable = (resizable === 'true');
    if (useControl === 'true') {
        options.useControl = true;
        options.controls = {minimize: true, maximize: true, close: true};
        options.foldSize = {width: 500};
    }
    if (fixPosition !== '') options.fixPosition = (fixPosition === 'true');
    if (windowDragMove !== '') options.windowDragMove = (windowDragMove === 'true');
    if (closeAction === 'true') options.closeAction = "scwin.popup_closeAction";
    if (disableCloseButton !== '') options.disableCloseButton = (disableCloseButton === 'true');
    if (windowMoveType !== '') options.windowMoveType = windowMoveType;

    wf_body_bottom.getObj("scwin").setReturnValue("options : " + JSON.stringify(options, null, 2));

    WebSquare.util.openPopup("/sample/common_link/util_openPopup_1.xml", options);
}]]></script>
