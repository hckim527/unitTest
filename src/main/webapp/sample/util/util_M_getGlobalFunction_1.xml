		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getGlobalFunction]&lt;br/&gt;문자열로 지정된 함수를 window 영역 또는 스코프 체인에서 찾아 반환합니다.&lt;br/&gt;점(.) 으로 구분된 객체 내부의 함수도 탐색합니다.&quot;,
    &quot;validation&quot; : [
        &quot;func(필수) 파라미터로 찾으려는 함수를 나타내는 문자열 또는 함수 객체를 설정할 수 있어야 합니다.&quot;,
        &quot;문자열로 지정된 함수를 window 영역에서 찾아 반환해야 합니다.&quot;,
        &quot;점(.) 으로 구분된 객체 내부의 함수도 탐색해야 합니다.&quot;,
        &quot;func 파라미터가 이미 함수 타입이면 그대로 반환해야 합니다.&quot;,
        &quot;함수를 찾지 못한 경우 null 을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트용 글로벌 함수 및 객체 등록
    window.testFunc = function () { return &quot;testFunc 호출됨&quot;; };
    window.testObj = { formatter: function () { return &quot;testObj.formatter 호출됨&quot;; } };

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    $c.gcm.createLabel('label=&quot;등록: window.testFunc(Function), window.testObj.formatter(Function)&quot;', '', 'label1');
};



scwin.btn_getGlobalFunction_onclick = function () {
    let func = par_func.getValue();
    let result;

    if (func === 'functionType') {
        result = WebSquare.util.getGlobalFunction(window.testFunc);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getGlobalFunction(Function) : typeof = &quot; + typeof result);
    } else {
        result = WebSquare.util.getGlobalFunction(func);

        if (result !== null) {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getGlobalFunction('&quot; + func + &quot;') : typeof = &quot; + typeof result);
        } else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getGlobalFunction('&quot; + func + &quot;') : null (함수 없음)&quot;);
        }
    }
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
