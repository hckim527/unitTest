												<xf:value><![CDATA[functionType]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[notExistFunc (존재하지 않는 함수)]]></xf:label>
												<xf:value><![CDATA[notExistFunc]]></xf:value>
