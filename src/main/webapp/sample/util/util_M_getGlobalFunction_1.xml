												<xf:label><![CDATA[testFunc (문자열)]]></xf:label>
												<xf:value><![CDATA[testFunc]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[testObj.formatter (점 구분 객체 함수)]]></xf:label>
												<xf:value><![CDATA[testObj.formatter]]></xf:value>
											</xf:item>
