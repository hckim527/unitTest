		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[util > M > url]<br/>전체 URL 대신 w2xPath(XML 파일 경로) 만 지정하여 페이지를 이동합니다.",
    "validation" : [
        "options.forceReload(선택) 파라미터를 true 로 설정하면 페이지 이동과 동시에 브라우저가 갱신되어야 합니다.",
        "options.forceReload(선택) 파라미터를 false 로 설정하면 브라우저를 갱신하지 않고 SPA 방식으로 페이지를 이동해야 합니다.",
        "options.transition(선택) 파라미터로 빈 문자열을 설정하면 화면 효과를 적용하지 않아야 합니다.",
        "options.transition(선택) 파라미터로 \"fadeout\" 을 설정하면 fadeOut 효과를 적용한 후 페이지를 이동해야 합니다.",
        "options.transition(선택) 파라미터로 \"slideup\" 을 설정하면 slideUp 효과를 적용한 후 페이지를 이동해야 합니다.",
        "options.urlHashText(선택) 파라미터로 SPA 모드에서 주소창의 해시 부분을 사용자 지정 텍스트로 변경할 수 있어야 합니다.",
        "options.urlHashText(선택) 파라미터에 ?, &, # 문자는 포함할 수 없습니다.",
        "options.msaName(선택) 파라미터로 MSA 서버 이름을 설정할 수 있어야 합니다.",
        "options.spa 가 true 이면 서버 버전 변경 여부를 확인하고, 변경되었으면 options.forceReload 가 true 로 강제 설정되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_url_onclick = function () {
    let w2xPath = par_w2xPath.getValue();
    let forceReload = par_forceReload.getValue();
    let transition = par_transition.getValue();
    let urlHashText = par_urlHashText.getValue();
    let msaName = par_msaName.getValue();
    let options = {spa: true};

    if (forceReload !== '') {
        options.forceReload = (forceReload === 'true');
    }
    if (transition !== 'none') {
        options.transition = transition;
    }
    if (urlHashText !== '') {
        options.urlHashText = urlHashText;
    }
    if (msaName !== '') {
        options.msaName = msaName;
    }

    wf_body_bottom.getObj("scwin").setReturnValue("url 호출 : w2xPath=" + w2xPath);
    wf_body_bottom.getObj("scwin").setReturnValue("options : " + JSON.stringify(options));

    WebSquare.util.url(w2xPath, options);
}]]></script>
