scwin.btn_multipleExcelDownload_onclick = function () {
    let headerColor = par_headerColor.getValue();
    let bodyColor = par_bodyColor.getValue();
    let headerFontName = par_headerFontName.getValue();
    let bodyFontName = par_bodyFontName.getValue();
    let headerFontColor = par_headerFontColor.getValue();
    let bodyFontColor = par_bodyFontColor.getValue();
    let autoSizeColumn = par_autoSizeColumn.getValue();
    let bodyWordwrap = par_bodyWordwrap.getValue();
    let useStyle = par_useStyle.getValue();
    let useDataFormat = par_useDataFormat.getValue();
    let displayGridlines = par_displayGridlines.getValue();
    let useInfoArr = par_useInfoArr.getValue();
    let startRowIndex = par_startRowIndex.getValue();
    let msaName = par_msaName.getValue();

    let common = {
        fileName: "multipleExcel_styled.xlsx",
        multipleSheet: "true",
        showProcess: false
    };

    if (autoSizeColumn !== '') common.autoSizeColumn = autoSizeColumn;
    if (bodyWordwrap !== '') common.bodyWordwrap = (bodyWordwrap === 'true');
    if (useStyle !== '') common.useStyle = useStyle;
    if (useDataFormat !== '') common.useDataFormat = useDataFormat;
    if (displayGridlines !== '') common.displayGridlines = displayGridlines;
    if (msaName !== '') common.msaName = msaName;

    let excelInfo1 = {
        gridId: "gridView1",
        sheetName: "직원정보",
        type: "1"
    };
    if (headerColor !== '') excelInfo1.headerColor = headerColor;
    if (bodyColor !== '') excelInfo1.bodyColor = bodyColor;
    if (headerFontName !== '') excelInfo1.headerFontName = headerFontName;
    if (bodyFontName !== '') excelInfo1.bodyFontName = bodyFontName;
    if (headerFontColor !== '') excelInfo1.headerFontColor = headerFontColor;
    if (bodyFontColor !== '') excelInfo1.bodyFontColor = bodyFontColor;
    if (startRowIndex !== '') excelInfo1.startRowIndex = parseInt(startRowIndex);

    if (useInfoArr === 'true') {
        excelInfo1.startRowIndex = 3;
        excelInfo1.startColumnIndex = 1;
        excelInfo1.infoArr = [
            {rowIndex: 1, colIndex: 2, rowSpan: 1, colSpan: 3, text: "직원 정보 보고서", textAlign: "center", fontSize: "14", fontWeight: "bold"},
            {rowIndex: 2, colIndex: 2, rowSpan: 1, colSpan: 1, text: "작성일: 2026-04-15", textAlign: "left", fontSize: "10"}
        ];
    }

    let excelInfo2 = {
        gridId: "gridView2",
        sheetName: "상품정보",
        type: "1"
    };

    let options = {
        common: common,
        excelInfo: [excelInfo1, excelInfo2]
    };

    wf_body_bottom.getObj("scwin").setReturnValue("options : " + JSON.stringify(options, null, 2));
    WebSquare.util.multipleExcelDownload(options);
}]]></script>
