											</xf:item>
											<xf:item>
												<xf:label><![CDATA[1123 (길이 4, 그대로 반환)]]></xf:label>
												<xf:value><![CDATA[1123]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
