		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getTime]&lt;br/&gt;시간 문자열에서 구분 문자를 제거하여 숫자만으로 구성된 시간 문자열을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;time(필수) 파라미터로 구분 문자가 포함된 시간 문자열을 설정할 수 있어야 합니다.&quot;,
        &quot;길이가 5 인 경우 HH:mm 형식으로 인식하여 구분 문자를 제거해야 합니다.&quot;,
        &quot;길이가 8 인 경우 HH:mm:ss 형식으로 인식하여 구분 문자를 제거해야 합니다.&quot;,
        &quot;입력 문자열의 길이가 5 또는 8 이 아니면 입력값을 그대로 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getTime_onclick = function () {
    let time = par_time.getValue();

    let result = WebSquare.util.getTime(time);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getTime('&quot; + time + &quot;') : '&quot; + result + &quot;'&quot;);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
