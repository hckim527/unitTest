		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[util > M > multipleDataListDownload]<br/>여러 DataList 의 데이터를 멀티 시트 Excel 파일로 다운로드합니다.",
    "validation" : [
        "options.excelInfo[i].wframeId(선택) 파라미터로 DataList 가 포함된 wFrame 의 ID 를 설정할 수 있어야 합니다.",
        "options.excelInfo[i].wframeId(선택) 파라미터 설정 시 해당 wFrame 내부의 DataList 를 대상으로 다운로드해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_multipleDataListDownload_onclick = function () {
    let wframeId = par_wframeId.getValue();

    let common = {
        fileName: "wframe_dataList_download.xlsx",
        multipleSheet: "true",
        showProcess: false
    };

    let excelInfo = [
        {
            dataListId: "wf_dataList1",
            sheetName: "직원정보",
            wframeId: wframeId
        },
        {
            dataListId: "wf_dataList2",
            sheetName: "상품정보",
            wframeId: wframeId
        }
    ];

    let options = {
        common: common,
        excelInfo: excelInfo
    };

    wf_body_bottom.getObj("scwin").setReturnValue("options : " + JSON.stringify(options, null, 2));
    WebSquare.util.multipleDataListDownload(options);
}]]></script>
