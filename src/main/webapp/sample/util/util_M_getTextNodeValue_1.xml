<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260323" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getTextNodeValue]&lt;br/&gt;주어진 DOM 요소의 첫 번째 텍스트 노드의 값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;element(필수) 파라미터로 텍스트 노드를 검색할 DOM 요소를 설정할 수 있어야 합니다.&quot;,
        &quot;첫 번째 텍스트 노드의 값을 반환해야 합니다.&quot;,
        &quot;element 파라미터가 유효하지 않거나 텍스트 노드가 없으면 null 을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getTextNodeValue_onclick = function () {
    let elementType = par_element.getValue();
    let element;

    if (elementType === 'xmlNode') {
        let xmlStr = '&lt;root&gt;텍스트 노드 값&lt;/root&gt;';
        let parser = new DOMParser();
        let xmlDoc = parser.parseFromString(xmlStr, 'text/xml');
        element = xmlDoc.documentElement;
    } else if (elementType === 'domElement') {
        element = document.createElement('span');
        element.textContent = 'DOM 텍스트 값';
    } else if (elementType === 'emptyElement') {
        element = document.createElement('div');
    } else {
        element = null;
    }

    let result = WebSquare.util.getTextNodeValue(element);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getTextNodeValue(&quot; + elementType + &quot;) : &quot; + result);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="element" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_element" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[XML 노드 (<root>텍스트 노드 값</root>)]]></xf:label>
												<xf:value><![CDATA[xmlNode]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[DOM 요소 (span, 텍스트 있음)]]></xf:label>
												<xf:value><![CDATA[domElement]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[빈 DOM 요소 (div, 텍스트 없음)]]></xf:label>
												<xf:value><![CDATA[emptyElement]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[null (유효하지 않은 값)]]></xf:label>
												<xf:value><![CDATA[nullValue]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getTextNodeValue_onclick" id="btn_getTextNodeValue"
							label="getTextNodeValue" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>