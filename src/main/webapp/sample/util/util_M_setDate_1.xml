		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[util > M > setDate]<br/>8자리 날짜 문자열에 구분자를 삽입하여 포맷된 날짜 문자열을 반환합니다.",
    "validation" : [
        "date(필수) 파라미터로 8자리 날짜 문자열을 설정할 수 있어야 합니다.",
        "symbol(선택) 파라미터로 구분자로 사용할 길이 1 인 특수문자를 설정할 수 있어야 합니다.",
        "symbol(선택) 파라미터 생략 시 기본값 \"/\" 로 동작해야 합니다.",
        "구분자가 삽입된 날짜 문자열을 반환해야 합니다.",
        "date 파라미터의 길이가 8 이 아니면 undefined 를 반환해야 합니다.",
        "symbol 파라미터가 길이 1 인 특수문자가 아니면 undefined 를 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_setDate_onclick = function () {
    let date = par_date.getValue();
    let symbol = par_symbol.getValue();
    let result;

    if (symbol === '') {
        // symbol 파라미터 생략 (기본값 "/")
        result = WebSquare.util.setDate(date);
    } else {
        result = WebSquare.util.setDate(date, symbol);
    }

    wf_body_bottom.getObj("scwin").setReturnValue("setDate 결과 : " + result);
    wf_body_bottom.getObj("scwin").setReturnValue("typeof : " + typeof result);
}]]></script>
	</head>
