			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; getBoolean]&lt;br/&gt;입력값을 Boolean 타입으로 변환하여 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;boolean(필수) 파라미터로 Boolean 으로 변환할 값을 설정할 수 있어야 합니다.&quot;,
        &quot;boolean 파라미터가 Boolean 타입이면 그대로 반환해야 합니다.&quot;,
        &quot;boolean 파라미터가 String 타입이고 대소문자에 관계없이 'true' 이면 true 를 반환해야 합니다.&quot;,
        &quot;그 외 모든 경우에는 false 를 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getBoolean_onclick = function () {
    let booleanVal = par_boolean.getValue();

    let param;
    if (booleanVal === 'true_bool') {
        param = true;
    } else if (booleanVal === 'false_bool') {
        param = false;
    } else {
        param = booleanVal;
    }

    let ret = WebSquare.util.getBoolean(param);

    let result = [];
    result.push(&quot;입력값: &quot; + param + &quot; (타입: &quot; + typeof param + &quot;)&quot;);
    result.push(&quot;반환값: &quot; + ret + &quot; (타입: &quot; + typeof ret + &quot;)&quot;);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(result.join(&quot;, &quot;));
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="boolean" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_boolean" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[true (Boolean)]]></xf:label>
												<xf:value><![CDATA[true_bool]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[false (Boolean)]]></xf:label>
												<xf:value><![CDATA[false_bool]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[True (String 대소문자)]]></xf:label>
												<xf:value><![CDATA[True]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[false (String)]]></xf:label>
												<xf:value><![CDATA[false]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[abc (기타 문자열)]]></xf:label>
												<xf:value><![CDATA[abc]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getBoolean_onclick" id="btn_getBoolean"
							label="getBoolean" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>