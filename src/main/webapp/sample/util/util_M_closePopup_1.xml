		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[util &gt; M &gt; closePopup]&lt;br/&gt;지정한 ID 의 팝업을 닫습니다.&lt;br/&gt;id 파라미터를 생략하면 현재 팝업 자신을 닫습니다.&quot;,
    &quot;validation&quot; : [
        &quot;id(선택) 파라미터로 닫을 팝업의 ID 를 설정할 수 있어야 합니다.&quot;,
        &quot;id 파라미터를 생략하면 URL 파라미터의 popupID 값을 사용하여 현재 팝업을 닫아야 합니다.&quot;,
        &quot;id(선택) 생략 시 기본값 undefined 로 동작해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_createPopup_onclick = function () {
    WebSquare.util.createPopup(
        &quot;createPopup_1&quot;,
        &quot;window&quot;,
        &quot;테스트 팝업&quot;,
        &quot;width:600px;height:350px;top:100px;left:100px;&quot;,
        true,
        false,
        &quot;/sample/common_link/util_createPopup_1.xml&quot;,
        &quot;WebSquare1.xml&quot;,
        undefined,
        &quot;map&quot;,
        undefined
    );

    setTimeout(function () {
        let popupEl = document.querySelector(&quot;div[id='createPopup_1']&quot;);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 생성 : &quot; + (popupEl ? &quot;PASS&quot; : &quot;FAIL&quot;));
    }, 500);
}



scwin.btn_closePopup_onclick = function () {
    let id = par_id.getValue();

    if (id === 'omit') {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;id 생략은 팝업 내부에서만 테스트 가능합니다. 팝업 내 닫기 버튼을 사용하세요.&quot;);
        return;
    }

    WebSquare.util.closePopup(id);

    setTimeout(function () {
        let popupEl = document.querySelector(&quot;div[id='closePopup_1']&quot;);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;closePopup('&quot; + id + &quot;') 실행 완료, 팝업 존재 : &quot; + (popupEl ? &quot;YES&quot; : &quot;NO&quot;));
    }, 500);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
