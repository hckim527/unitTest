		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[wframe &gt; M &gt; msaLoad]&lt;br/&gt;컴포넌트의 src, msaName 속성을 설정하여 WebSquare XML 페이지를 연결하고 렌더링합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;setSrc() 메소드와 동일한 기능이며 msaName 속성을 추가로 설정할 수 있습니다.&quot;,
        &quot;msaLoad() 는 비동기 메소드이므로 async/await 또는 then/catch 로 처리해야 합니다.&quot;,
        &quot;src(필수) 파라미터로 WFrame 에 연결할 WebSquare XML 페이지를 URL 로 설정합니다.&quot;,
        &quot;src(필수) 파라미터로 상대경로, 절대경로, 프로토콜 포함 경로를 설정할 수 있습니다.&quot;,
        &quot;msaName(선택) 파라미터로 MSA Server 의 이름을 설정합니다.&quot;,
        &quot;msaName(선택) 파라미터값은 config.xml 의 msaServer 항목에 존재하는 값이어야 합니다.&quot;,
        &quot;options(선택) 파라미터로 연결하는 WebSquare XML 페이지에 전달할 부가정보를 객체로 설정합니다.&quot;,
        &quot;options.dataObject 파라미터로 연결하는 WebSquare XML 페이지에 전달할 데이터를 객체로 설정합니다.&quot;,
        &quot;options.dataObject 파라미터로 연결하는 WebSquare XML 페이지에선 $p.getParamter() 메소드를 사용하여 전달된 데이터에 접근할 수 있습니다.&quot;,
        &quot;options.dataObject.type 파라미터로 전달할 데이터의 유형을 'json', 'array', 'json', 'xml' 중 하나로 설정합니다.&quot;,
        &quot;options.dataObject.name 파라미터로 전달할 데이터 객체를 구분할 이름을 설정합니다.&quot;,
        &quot;options.dataObject.data 파라미터로 전달할 데이터를 type 파라미터의 데이터 유형에 맞게 설정합니다.&quot;,
        &quot;반환값으로 연결 성공 여부를 true/false 로 갖습니다.&quot;,
        &quot;동일한 WebSquare XML 페이지를 설정해도 다시 로딩됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getSrc_onclick = function () {
    let src = target1.getSrc();
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;src : &quot; + src);       
};



scwin.btn_msaLoad_onclick = async function (e) {
    let src = par_src.getText();
    let msaName = par_msaName.getText();
    let options = par_options.getText();
    let rtn = ''

    let rowJSON = {
        &quot;Personal Info&quot; : { &quot;Name&quot;: &quot;Lee&quot;, &quot;Age&quot;: 50, &quot;Married&quot; : false},   
        &quot;Region&quot;: &quot;Seoul&quot;,  
        &quot;Carrier&quot;: true,
    }; 

    let sendData = {
        &quot;type&quot;: &quot;json&quot;, 
        &quot;name&quot;: &quot;wframeData&quot;,
        &quot;data&quot; : rowJSON
    };    

    if (options == &quot;&quot;)
	    rtn = await target1.msaLoad(src, msaName, sendData);
    else
        rtn = await target1.msaLoad(src, msaName);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;return : &quot; + rtn);

    scwin.btn_getSrc_onclick();
};
</script>
