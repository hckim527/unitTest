		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[wframe &gt; M &gt; getSrc]&lt;br/&gt;컴포넌트의 src 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;WFrame 컴포넌트에 연결된 WebSquare XML 페이지의 URL 값을 반환합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        src: con_src.getText(),        
    };

    let cList = $c.gcm.createCList(properties);      
    let eList = '';
   
    let grp_comp = $c.gcm.getTestGroup();    
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
       
strTarget += '&lt;w2:wframe ' + strNameSpace + ' ' + cList + ' style=&quot;width:500px; height:300px; background-color:silver;&quot; id=&quot;&quot;&gt;&lt;/w2:wframe&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;wframe&quot;,
        strTarget,
        grp_comp
    );

    scwin.btn_getSrc_onclick();
}



scwin.btn_getSrc_onclick = function (e) {
    let src = target1.getSrc();

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getSrc : &quot; + src);   
};
</script>
