		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[wframe &gt; M &gt; setSrc]&lt;br/&gt;WFrame 컴포넌트의 src 속성을 설정하고, WebSquare XML 페이지를 렌더링합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;WebSquare XML 페이지가 연결되고 렌더링되는 과정에서 onbeforewfreamunload -&gt; onwframeunload -&gt; onwframeload 이벤트가 순서대로 발생합니다.&quot;,
        &quot;동일한 WebSquare XML 페이지를 설정해도 다시 로딩됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onbeforewframeunload&quot;, &quot;onwframeunload&quot;, &quot;onwframeload&quot;]);

    let grp_comp = $c.gcm.getTestGroup();    
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
       
    strTarget += '&lt;w2:wframe ' + strNameSpace + ' ' + eList + ' style=&quot;width:500px; height:300px; background-color:silver;&quot; id=&quot;&quot;&gt;&lt;/w2:wframe&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;wframe&quot;,
        strTarget,
        grp_comp
    );    
}



scwin.btn_setSrc_onclick = async function (e) {
    let src = par_src.getText();
    
    await target1.setSrc(src);    
}



scwin.target1_onbeforewframeunload = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onbeforewframeunload=====&quot;);
}



scwin.target1_onwframeunload = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onwframeunload=====&quot;);
}



scwin.target1_onwframeload = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onwframeload=====&quot;);
}</script>
