		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[button &gt; P &gt; nextTabID]&lt;br/&gt;Tab 키로 포커스 이동 시 포커스가 이동될 다음 컴포넌트의 ID 를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;Shift+Tab 키로 포커스를 이전으로 이동하면 현재 포커스된 컴포넌트를 nextTabID 속성에 설정한 컴포넌트로 포커스가 이동되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_setStartFocus_onclick = function (e) {
	startcomp.focus();
};



scwin.startcomp_onfocus = function (e) {
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====startcomp_onfocus=====&quot;);    
};



scwin.target_onfocus = function (e) {
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target_onfocus=====&quot;); 
};



