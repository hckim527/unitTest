		<script lazy="false" type="text/javascript"><![CDATA[


let cStyle = ""; // 조건 1
let cStyleParent = ""; // 조건 2

let pLeft = ""; // parameter1
let pTop = "";  // parameter2
let pMode = ""; // parameter3



scwin.gVar = {
    "cInitClass" : null,
    "cInitStyle" : ""
}



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[body > M > setPosition]<br/>컴포넌트의 left, top 속성값을 변경합니다.",
    "validation" : [
        "컴포넌트의 position 속성이 'relative' 인 경우 left, top 속성값을 변경할 수 있어야 합니다.",
        "컴포넌트의 position 속성이 'absolute' 인 경우 left, top 속성값을 변경할 수 있어야 합니다.",        
        "컴포넌트의 position 속성이 'fixed' 인 경우 left, top 속성값을 변경할 수 있어야 합니다.",
        "left 파라미터를 음수, 0, 양수로 설정하면 픽셀(px) 단위로 적용되어야 합니다.",
        "left 파라미터를 null 로 설정 시 left 속성값이 변경되지 않아야 합니다.",
        "top 파라미터를 음수, 0, 양수로 설정하면 픽셀(px) 단위로 적용되어야 합니다.",
        "top 파라미터를 null 로 설정 시 top 속성값이 변경되지 않아야 합니다.",
        "left, top 속성의 변경 방법을 'absolute' 또는 'delta' 로 설정할 수 있어야 합니다.",
        "mode 파라미터를 'absolute' 로 설정한 경우 left, top 속성값을 입력한 값으로 설정하여야 합니다.",
        "mode 파라미터를 'delta' 로 설정한 경우 left, top 속성값에 입력한 값을 더한 값으로 설정하여야 합니다.",
        "position 속성이 'static' 이 아닌 가장 가까운 상위 요소의 Contents Edge 를 기준으로 위치가 계산되어야 합니다.",
        "픽셀(px) 이외의 단위 (%, vw, vh em 등) 설정 시 픽셀(px) 단위로 적용되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 생성 (Target 재생성 버튼 클릭 시 재실행)
//  body 는 동적 생성/삭제가 불가하므로 최초 렌더된 body 컴포넌트를 그대로 대상으로 사용하고,
//  "Target 재생성" 은 최초 렌더 시점의 class / style 상태로 되돌리는 것으로 대응한다.
scwin.comp_init = function () {
    let objBody = scwin.getBody();

    if (scwin.gVar["cInitClass"] === null) {
        // 최초 1회 : 초기 class / style 보관
        scwin.gVar["cInitClass"] = objBody.render.className;
        scwin.gVar["cInitStyle"] = objBody.render.getAttribute("style") || "";
    } else {
        // 재생성 : 초기 상태로 복원
        objBody.render.className = scwin.gVar["cInitClass"];
        objBody.render.setAttribute("style", scwin.gVar["cInitStyle"]);
    }
}



// 테스트 수행
scwin.btn_setPosition_onclick = function (e) {    
    pLeft = par_left.getText();
    pTop = par_top.getText();
    pMode = par_mode.getText();

    if(pLeft == "null")
        pLeft = null;
    if(pTop == "null")
        pTop = null;


    if (pLeft != "") {
        if (pTop != "") {
            if (pMode != "") {
               scwin.getBody().setPosition(pLeft, pTop, pMode); 
            }
            else {
                scwin.getBody().setPosition(pLeft, pTop);
            }
        }
        else {
            scwin.getBody().setPosition(pLeft);
        }
    }
    else
        scwin.getBody().setPosition();    

    scwin.btn_getPosition_onclick();
};



scwin.btn_getPosition_onclick = function (e) {
    let rtn = '';

    rtn = scwin.getBody().getStyle("position");
    wf_body_bottom.getObj("scwin").setReturnValue("position : "+rtn);   

    rtn = scwin.getBody().getPosition("left");
    wf_body_bottom.getObj("scwin").setReturnValue("left : "+rtn);   

    rtn = scwin.getBody().getPosition("top");
    wf_body_bottom.getObj("scwin").setReturnValue("top : "+rtn);
}
// body 컴포넌트 조회
//  body 는 화면과 함께 렌더되는 컴포넌트로 $p.dynamicCreate / remove 대상이 아니고
//  공통 생성 함수($c.gcm.createBasicXxx)도 없어 공통 base(common_M) wrap 패턴을 쓸 수 없다.
//  <body id="target1"> 로 선언해도 body 는 root 요소라 scope 전역(target1)으로 등록되지 않으며
//  $p.getComponentById("target1") 도 scope 접두어가 적용되지 않아 undefined 를 반환하므로,
//  정적 선언된 자식(grp_main)의 parentControl 로 조회한다.
scwin.getBody = function () {
    return grp_main.parentControl;
}
]]></script>
