		<script lazy="false" type="text/javascript"><![CDATA[scwin.gVar = {
    "cInitClass" : null,
    "cInitStyle" : ""
}



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[body > M > setSize]<br/>컴포넌트의 width, height 속성값을 변경합니다.",
    "validation" : [
        "width(필수) 파라미터로 width 속성에 적용할 값을 픽셀(px) 단위의 0 이상 값으로 설정할 수 있어야 합니다.",
        "width(필수) 파라미터로 음수 또는 null 을 설정하면 width 값을 변경하지 않아야 합니다.",
        "height(필수) 파라미터로 height 속성에 적용할 값을 픽셀(px) 단위의 0 이상 값으로 설정할 수 있어야 합니다.",
        "height(필수) 파라미터로 음수 또는 null 을 설정하면 height 값을 변경하지 않아야 합니다.",
        "픽셀(px) 외의 단위는 지원하지 않습니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 생성 (Target 재생성 버튼 클릭 시 재실행)
//  body 는 동적 생성/삭제가 불가하므로 최초 렌더된 body 컴포넌트를 그대로 대상으로 사용하고,
//  "Target 재생성" 은 최초 렌더 시점의 class / style 상태로 되돌리는 것으로 대응한다.
scwin.comp_init = function () {
    let objBody = scwin.getBody();

    if (scwin.gVar["cInitClass"] === null) {
        // 최초 1회 : 초기 class / style 보관
        scwin.gVar["cInitClass"] = objBody.render.className;
        scwin.gVar["cInitStyle"] = objBody.render.getAttribute("style") || "";
    } else {
        // 재생성 : 초기 상태로 복원
        objBody.render.className = scwin.gVar["cInitClass"];
        objBody.render.setAttribute("style", scwin.gVar["cInitStyle"]);
    }
}



scwin.btn_setSize_onclick = function (e) {
    pWdith = par_width.getText();
    pHeight = par_height.getText();

    if(pWdith == "null")
        pWdith = null;
    if(pHeight == "null")
        pHeight = null;   

    if (pWdith != "") {
        if (pHeight != "") {
             scwin.getBody().setSize(pWdith, pHeight);
        }
        else {
            scwin.getBody().setSize(pWdith);
        }
    }
    else
        scwin.getBody().setSize();
};



scwin.btn_getSize_onclick = function (e) {
    let rtn = '';
    
    rtn = scwin.getBody().getSize(par_sizeName.getText());
    wf_body_bottom.getObj("scwin").setReturnValue("getSize : " + rtn);  
};

// body 컴포넌트 조회
//  body 는 화면과 함께 렌더되는 컴포넌트로 $p.dynamicCreate / remove 대상이 아니고
//  공통 생성 함수($c.gcm.createBasicXxx)도 없어 공통 base(common_M) wrap 패턴을 쓸 수 없다.
//  <body id="target1"> 로 선언해도 body 는 root 요소라 scope 전역(target1)으로 등록되지 않으며
//  $p.getComponentById("target1") 도 scope 접두어가 적용되지 않아 undefined 를 반환하므로,
//  정적 선언된 자식(grp_main)의 parentControl 로 조회한다.
scwin.getBody = function () {
    return grp_main.parentControl;
}
]]></script>
