		<script lazy="false" type="text/javascript"><![CDATA[let cEventList = [];

let pArrayJson = [{ardata:[1, 2, 3],nmdata:'이름'}];
let pArray = [['a','b','c']];



scwin.gVar = {
    "cInitClass" : null,
    "cInitStyle" : ""
}



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[body > M > trigger]<br/>컴포넌트에 정의된 특정 이벤트를 발생시킵니다.",
    "validation" : [
        "type(필수) 파라미터로 발생시킬 이벤트의 이름을 문자열로 설정할 수 있어야 합니다.",
        "type(필수) 파라미터로 컴포넌트에 정의되지 않은 이벤트의 이름 설정 시 이벤트가 발생하지 않아야 합니다.",
        "array(선택) 파라미터로 이벤트 핸들러에 전달할 데이터를 단일 원소 배열로 설정할 수 있어야 합니다.",
        "setEventPause() 메소드에 의해 중지된 이벤트는 발생하지 않아야 합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};




// comp 생성 (Target 재생성 버튼 클릭 시 재실행)
//  body 는 동적 생성/삭제가 불가하므로 최초 렌더된 body 컴포넌트를 그대로 대상으로 사용하고,
//  "Target 재생성" 은 최초 렌더 시점의 class / style 상태로 되돌리는 것으로 대응한다.
scwin.comp_init = function () {
    let objBody = scwin.getBody();

    if (scwin.gVar["cInitClass"] === null) {
        // 최초 1회 : 초기 class / style 보관
        scwin.gVar["cInitClass"] = objBody.render.className;
        scwin.gVar["cInitStyle"] = objBody.render.getAttribute("style") || "";
    } else {
        // 재생성 : 초기 상태로 복원
        objBody.render.className = scwin.gVar["cInitClass"];
        objBody.render.setAttribute("style", scwin.gVar["cInitStyle"]);
    }
}



scwin.setEvent = function () {
    cEventList.forEach(cEvent => {
        scwin[`target1_${cEvent}`] = function (e) {

            wf_body_bottom.getObj("scwin").setReturnValue(`=====target1_${cEvent} 이벤트 발생=====`);
            wf_body_bottom.getObj("scwin").setReturnValue("e:" + e);

            if (par_array.getText() == 'json') {
                wf_body_bottom.getObj("scwin").setReturnValue(e["ardata"] + e["nmdata"]);
            } else if (par_array.getText() == 'array') {
                wf_body_bottom.getObj("scwin").setReturnValue(e[0] + e[1] + e[2]);
            }
        };
    });
}



scwin.btn_trigger_onclick = function (e) {
    if (par_array.getText() == '생략')
        scwin.getBody().trigger(par_type.getValue());
    else if (par_array.getText() == 'json')
        scwin.getBody().trigger(par_type.getValue(), pArrayJson);
    else
        scwin.getBody().trigger(par_type.getValue(), pArray);
};



scwin.btn_setEventPause_onclick = function (e) {
    scwin.getBody().setEventPause(par_eventList, true);
};


// body 컴포넌트 조회
//  body 는 화면과 함께 렌더되는 컴포넌트로 $p.dynamicCreate / remove 대상이 아니고
//  공통 생성 함수($c.gcm.createBasicXxx)도 없어 공통 base(common_M) wrap 패턴을 쓸 수 없다.
//  <body id="target1"> 로 선언해도 body 는 root 요소라 scope 전역(target1)으로 등록되지 않으며
//  $p.getComponentById("target1") 도 scope 접두어가 적용되지 않아 undefined 를 반환하므로,
//  정적 선언된 자식(grp_main)의 parentControl 로 조회한다.
scwin.getBody = function () {
    return grp_main.parentControl;
}
]]></script>
	</head>
