		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[radio > M > deleteItem]<br/>컴포넌트에서 특정 아이템을 제거합니다.",
    "validation" : [            
        "useItemLocale 속성으로 아이템에 다국어가 적용된 경우 반환된 아이템 정보에서 label 속성은 다국어가 적용된 값을 갖습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        useLocale: con_useLocale.getText(),
        useItemLocale: con_useItemLocale.getText(),
    };
  
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onlabelclick", "onradioclick"]);     

    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    let grp_comp = $c.gcm.getTestGroup();
   
    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' ' + eList + ' selectedIndex="-1" appearance="full" style="width:150px;background-color:var(--ws-gray-300);">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_radioItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "radio",
        strTarget,
        grp_comp
    ); 

    // $c.gcm.createBasicRadio(cList, eList);
}



scwin.btn_deleteItem_onclick = function (e) {
    let rtn = '';
    let index = par_index.getValue();
	
    rtn = target1.deleteItem(index);

    wf_body_bottom.getObj("scwin").setReturnValue("obj : " + rtn);
    wf_body_bottom.getObj("scwin").setReturnValue("label : " + rtn.label);
    wf_body_bottom.getObj("scwin").setReturnValue("value : " + rtn.value);	
};
]]></script>
