		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[Radio &gt; P &gt; tagname]&lt;br/&gt;renderType=radiogroup 일때 컴포넌트가 렌더링되는 최상위 태그를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;renderType 속성값이 'radiogroup' 이 아니면 해당 속성은 무시됩니다.&quot;,
        &quot;Radio 컴포넌트의 아이템을 그룹핑하기 위한 최상위 태그 이름을 문자열로 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 div 태그가 설정됩니다.&quot;,
        &quot;웹접근성을 위해서는 renderType=radiogroup, tagname=ul, itemTagname=li 로 설정하는 것을 권장합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        tagname : con_tagname.getValue(),
        renderType : con_renderType.getText(),
        itemTagname : &quot;li&quot;
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicRadio(cList);    
}



scwin.btn_getTagName_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.tagName;

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;tagName : &quot; + rtn);

    // // class에 &quot;w2radio&quot;를 포함하는 input 태그 찾기
