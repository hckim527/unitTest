		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[Radio &gt; M &gt; click]&lt;br/&gt;컴포넌트의 특정 아이템을 선택하고, 클릭 관련 이벤트를 발생시킵니다.&quot;,
    &quot;validation&quot; : [        
        &quot;index(필수) 파라미터로 선택하려는 아이템의 인덱스를 숫자로 설정합니다.&quot;,        
        &quot;아이템의 인덱스는 0 부터 시작합니다.&quot;,
        &quot;visibleColumn 속성으로 숨겨진 아이템을 포함한 전체 아이템을 기준으로 인덱스를 설정합니다.&quot;,
        &quot;존재하지 않는 인덱스로 설정하면 아이템이 선택되지 않습니다.&quot;,
        &quot;click() 메소드가 정상적으로 실행되면 항상 onbeforeselect, onradioclick 이벤트가 발생합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onbeforeselect&quot;, &quot;onradioclick&quot;]);

    // comp 생성
    $c.gcm.createBasicRadio('', eList);
}



scwin.target1_onbeforeselect = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onbeforeselect=====&quot;);	
}



scwin.target1_onradioclick = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onradioclick=====&quot;);	
}



scwin.btn_click_onclick = function (e) {
	target1.click(par_index.getText());
};</script>
