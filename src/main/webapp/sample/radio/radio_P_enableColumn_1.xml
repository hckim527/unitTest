		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[Radio > P > enableColumn]<br/>컴포넌트에서 특정 아이템의 비활성화 정보를 갖는 컬럼명을 설정합니다.",
    "validation" : [                
        "아이템의 비활성화 정보가 있는 DataCollection 의 컬럼명을 문자열로 설정합니다.",
        "설정된 컬럼의 값이 enableColumnFalseValue 속성값에 있는 경우 해당 아이템은 비활성화 처리됩니다.",
        "DataCollection 바인딩으로 컴포넌트의 아이템이 정의된 경우에 동작합니다.",
        "비활성화 된 아이템은 사용자의 액션으로 선택할 수 없습니다.",
        "setSelectedIndex() 메소드를 사용하면 비활성화 된 아이템도 선택할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getSelectedIndex_onclick = function (e) {
    let rtn = '';

    rtn = target1.getSelectedIndex();

    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex : " + rtn);	
};



scwin.btn_setSelectedIndex_onclick = function (e) {
	target1.setSelectedIndex(par_index.getText());
};



scwin.btn_getDisabled_onclick = function (e) {
    let comp = "target1";
    let targetElements = document.querySelectorAll('[id*='+comp+']');
    let inputs = targetElements[0].querySelectorAll('input.w2radio_input');

    // 각 input 요소의 disabled 속성 존재 여부 확인
    inputs.forEach((input, index) => {
        if (input.hasAttribute('disabled')) {            
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 비활성화");	
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 활성화");	
        }
    });	
};
]]></script>
