		<script lazy="false" type="text/javascript">let bReturn = ''


// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[Radio &gt; E &gt; onbeforeselect]&lt;br/&gt;컴포넌트에서 사용자의 액션으로 아이템이 선택되면 발생합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;selectedIndex 파라미터로 기존에 선택되어 있던 아이템의 인덱스값을 갖습니다.&quot;,        
        &quot;기존에 선택된 아이템이 없는 경우 -1 값을 갖습니다.&quot;,
        &quot;index 파라미터로 사용자가 새로 선택한 아이템의 인덱스값을 갖습니다.&quot;,
        &quot;리턴값을 생략 시 사용자가 선택한 아이템으로 변경합니다.&quot;,
        &quot;리턴값을 true 로 설정 시 사용자가 선택한 아이템으로 변경합니다.&quot;,
        &quot;리턴값을 false 로 설정 시 선택 아이템이 변경되지 않고 기존 선택을 유지합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onbeforeselect&quot;]);

    // comp 생성
    $c.gcm.createBasicRadio('', eList);
}



scwin.btn_setSelectedIndex_onclick = function (e) {
	target1.setSelectedIndex(par_index.getText());
};



scwin.btn_setValue_onclick = function (e) {
    let value = par_value.getText();

    if (value == '')
	    target1.setValue();
    else
        target1.setValue(value);
};



scwin.target1_onbeforeselect = function (selectedIndex, index) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onbeforeselect=====&quot;);	
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;selectedIndex : &quot; + selectedIndex);	
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;index : &quot; + index);	
}</script>
