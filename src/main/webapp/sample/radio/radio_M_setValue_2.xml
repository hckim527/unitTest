		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[Radio > M > setValue]<br/>컴포넌트에서 선택하려는 아이템의 Value 값을 설정합니다.",
    "validation" : [        
        "동일한 Value 값을 가진 아이템이 있는 경우 마지막 아이템이 선택됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.target1_onchange = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");	
}



scwin.btn_setValue_onclick = function (e) {
    let rtn ='';
    let value = par_value.getText();

    if (value == '')
	    target1.setValue();
    else
        target1.setValue(value);

    rtn = target1.getText();    
    wf_body_bottom.getObj("scwin").setReturnValue("getText : " + rtn);	
};



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';

    rtn = target1.getValue();

    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + rtn);	
};]]></script>
		<style type="text/css"><![CDATA[/* renderType=table */
