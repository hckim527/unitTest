		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[Radio &gt; P &gt; name]&lt;br/&gt;컴포넌트를 동일 그룹으로 묶기 위한 이름을 name 속성에 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;그룹의 이름을 문자열로 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 Radio 컴포넌트 별로 고유값이 자동 설정됩니다.&quot;,
        &quot;renderType 속성값에 관계없이 아이템으로 렌더링된 각 input 태그에 name 속성으로 설정됩니다.&quot;,
        &quot;컴포넌트 렌더링 과정에서 name 속성에 scope variable 값과 Frame ID 값이 자동으로 추가됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    if (typeof target2 !== 'undefined') {
        target2.remove();
    }

    let properties = {
        name : con_name.getValue(),
        renderType : con_renderType.getText()
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;name 이 같으면 1개의 Radio 로 동작되어 1개의 아이템만 선택 가능&quot;', '', 'label1');
    $c.gcm.createBasicRadio(cList);
    $c.gcm.createBasicRadio(cList, '', 'target2');
}



scwin.btn_getName_onclick = function (e) {
    // class에 &quot;w2radio&quot;를 포함하는 input 태그 찾기
    let inputs = document.querySelectorAll('input[class*=&quot;w2radio&quot;]');
    
    inputs.forEach((input, index) =&gt; {        
        let name = input.name;           
        let isChecked = input.checked;          

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(`Input[${index}] name: ${name}`);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(`Input[${index}] checked: ${isChecked}`);
    });
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
