				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group tagname="tr" style="">
								<xf:group tagname="th" style="" class="w2tb_th">
									<w2:textbox ref="" style="" userData2="" id="" label="name" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" style="" class="w2tb_td">
									<xf:input style="" id="con_name" initValue=""></xf:input>
								</xf:group>
								<xf:group tagname="th" class="w2tb_th ">
									<w2:attributes></w2:attributes>
									<w2:textbox ref="" style="" userData2="" id="" label="" class=""></w2:textbox>
									<w2:textbox class="" id="" label="renderType" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" class="w2tb_td">
									<w2:attributes></w2:attributes>
									<xf:select1 id="con_renderType" chooseOption="" style="" submenuSize="auto" allOption=""
										disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[]]></xf:label>
												<xf:value><![CDATA[1]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[table]]></xf:label>
												<xf:value><![CDATA[2]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[native]]></xf:label>
												<xf:value><![CDATA[3]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[radiogroup]]></xf:label>
												<xf:value><![CDATA[4]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>

				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" id="btn_getName" label="name 확인" style="" ev:onclick="scwin.btn_getName_onclick"></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>