		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[Radio &gt; M &gt; getValue]&lt;br/&gt;컴포넌트에 선택된 아이템의 Value 값을 반환합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;선택된 아이템의 Value 값을 문자열로 반환합니다.&quot;,
        &quot;컴포넌트에 선택된 아이템이 없는 경우 ''(Empty String)을 반환합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onchange&quot;]);

    // comp 생성
    $c.gcm.createBasicRadio('', eList);
}



scwin.target1_onchange = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);	
}



scwin.btn_setValue_onclick = function (e) {
    let value = par_value.getText();

    if (value == '')
	    target1.setValue();
    else
        target1.setValue(value);
};



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';

    rtn = target1.getValue();

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn);	
};</script>
	</head>
