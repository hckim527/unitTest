        &quot;Radio 컴포넌트는 선택된 아이템의 Value 컬럼값이 Value 값으로 적용되며, getValue() 메소드로 조회할 수 있습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    if (typeof label1 !== 'undefined') {
        label1.remove();
    }   

    let properties = {        
        renderType : &quot;native&quot;,
        value : con_value.getText()
    }
   
    let cList = $c.gcm.createCList(properties);
   
    // comp 생성
    $c.gcm.createBasicRadio(cList);
    $c.gcm.createEmptyTextBox('label=&quot;radio_item1&quot; style=&quot;display:inline-block;&quot;', '', 'label1');
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = ''
    rtn = target1.getValue();

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn); 
};</script>
