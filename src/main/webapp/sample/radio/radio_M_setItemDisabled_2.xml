		<script lazy="false" type="text/javascript"><![CDATA[// 샘플에 직접 유효성 설정
scwin.tData = {
    "description" : "[radio > M > setItemDisabled]<br/>컴포넌트에서 특정 아이템을 비활성화 상태를 설정합니다.",
    "validation" : [        
        "DataCollection 바인딩으로 아이템이 정의된 경우 아이템은 비활성화 상태값이 DataCollection 에 반영되지 않습니다.",
        "enableColumn, enableColumnFalseValue 속성과 관계없이 아이템의 비활성화 상태값이 변경됩니다.",
        "해당 아이템의 비활성화 상태를 변경해도 아이템의 선택 상태는 유지됩니다.",
    ]
} 




scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getDisabled_onclick = function (e) {
    let comp = "target1";
    let targetElements = document.querySelectorAll('[id*='+comp+']');
    let inputs = targetElements[0].querySelectorAll('input.w2radio_input');

    // 각 input 요소의 disabled 속성 존재 여부 확인
    inputs.forEach((input, index) => {
        if (input.hasAttribute('disabled')) {            
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 비활성화");	
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 활성화");	
        }
    });	
};



scwin.btn_getDataList_onclick = function (e) {
	// let rsData  = dlt_ref.getAllJSON();
    let rsData = dlt_radioItem.getAllJSON();

    for(var i = 0; i < rsData.length; i++) {        
        wf_body_bottom.getObj("scwin").setReturnValue(i + " 의 상태값 : " + rsData[i].enable_col);
    }
};



scwin.btn_setItemDisabled_onclick = function (e) {
    let index = par_index.getValue();
    let disabled = par_disabled.getText();

	target1.setItemDisabled(index, disabled);

    scwin.btn_getDisabled_onclick();
};



scwin.btn_getSelectedIndex_onclick = function (e) {
    let rtn = '';

    rtn = target1.getSelectedIndex();

    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex : " + rtn);	
};]]></script>
