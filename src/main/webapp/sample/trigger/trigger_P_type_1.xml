		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[trigger &gt; P &gt; type]&lt;br/&gt;컴포넌트가 렌더링 되는 방식을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;미설정 시 'input' 태그로 렌더링 되며 속성에 type='button' 이 설정됩니다.&quot;,
        &quot;button 설정 시 'input' 태그로 렌더링 되며 속성에 type='button' 이 설정됩니다.&quot;,
        &quot;image 설정 시 'table' 태그로 렌더링 되며, 하위에 'tr' 태그와 왼쪽, 가운데, 오른쪽 세개의 'td' 태그가 설정되고 가운데 'td' 태그의 컨텐츠로 내부 텍스트가 설정됩니다.&quot;,
        &quot;anchor 설정 시 'a' 태그로 렌더링 되며, 하위에 'span' 태그가 설정되고 'span' 태그의 컨텐츠로 내부 텍스트가 설정됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성    
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        type: con_type.getText(),
        style: &quot;width:150px;height:50px;&quot;
    }

    let cList = $c.gcm.createCList(properties);

    // comp 생성 함수 호출   
    $c.gcm.createEmptyTrigger(cList);
}



scwin.btn_getType_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getType();  
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getType : &quot; + rtn);    

    rtn = target1.render.tagName;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;tagName : &quot; + rtn);    
};</script>
	</head>
