		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[trigger &gt; P &gt; ariaLabel]&lt;br/&gt;웹접근성 향상을 위해 Trigger 컴포넌트에 추가 정보를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;웹 접근성 추가 정보를 문자열로 설정할 수 있어야 합니다.&quot;,        
        &quot;화면 렌더링 시 type 속성값에 따라 각 'input', 'table', 'a' 태그에 aria-label 속성으로 적용됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        ariaLabel: con_ariaLabel.getValue(),
        type: con_type.getText(),
        style : &quot;width:150px;height:50px;&quot;
    };

    let cList = $c.gcm.createCList(properties);       
   
    $c.gcm.createEmptyTrigger(cList);
}



scwin.btn_getAriaLabel_onclick = function (e) {
    let rtn = '';
    let elem = document.getElementById(target1.getID());
    
    rtn = elem.getAttribute('aria-label');
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;aria-label : &quot; + rtn);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
