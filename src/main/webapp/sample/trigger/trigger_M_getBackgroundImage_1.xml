		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[trigger &gt; M &gt; getBackgroundImage]&lt;br/&gt;type=button 일때 Trigger 컴포넌트의 background-image 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트에 CSS 로 정의된 background-image 속성값을 URL 전체 경로로 문자열로 반환합니다.&quot;,
        &quot;배경 이미지와 관련된 background-repeat, background-size 등의 속성값을 조회하려면 getStyle() 메소드를 사용해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    $c.gcm.createBasicTrigger();    
}



scwin.btn_getStyle_onclick = function (e) {
    let rtn = '';

    
    rtn = target1.render.style.backgroundImage;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;backgroundImage : &quot; + rtn);
    
    // rtn = target1.getStyle(&quot;background-image&quot;);
    // wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;background-image : &quot; + rtn);

    rtn = target1.getStyle(&quot;background-repeat&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;background-repeat : &quot; + rtn);

    rtn = target1.getStyle(&quot;background-size&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;background-size : &quot; + rtn);
};



scwin.btn_setBackgroundImage_onclick = function (e) {
    target1.setBackgroundImage(par_imgUrl.getValue());
};



scwin.btn_getBackgroundImage_onclick = function (e) {
    let rtn = '';
    rtn = target1.getBackgroundImage();

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getBackgroundImage-size : &quot; + rtn);
};



scwin.par_imgUrl_sub_onchange = function (info) {
    par_imgUrl.setValue(par_imgUrl_sub.getText());
};</script>
