		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[trigger &gt; M &gt; setValue]&lt;br/&gt;컴포넌트에 표시되고 있는 내부 텍스트를 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;label(필수) 파라미터로 컴포넌트에 표시할 텍스트를 설정합니다.&quot;,
        &quot;localeRef, useLocale 속성으로 클라이언트 다국어가 적용된 경우에도 컴포넌트의 내부 텍스트가 변경됩니다.&quot;,
        &quot;type 속성값에 따라 각각 'input' 태그의 'value' 속성, 중앙 'td' 태그의 컨텐츠, 'span' 태그의 컨텐츠로 텍스트가 반영됩니다.&quot;,
        &quot;컴포넌트가 비활성화(disabled) 상태일땐 실행되지 않아야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    $c.gcm.createCommonDatalist();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        localeRef: con_localeRef.getValue(),
        useLocale: con_useLocale.getText(),
        type: con_type.getText(),
        style: &quot;width:150px;height:50px;&quot;
    };

    let cList = $c.gcm.createCList(properties);       

    $c.gcm.createEmptyTrigger(cList);
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getValue();  
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn);    
};



scwin.btn_setValue_onclick = function (e) {
    target1.setValue(par_label.getValue());
};



scwin.btn_setIDisabled_onclick = function (e) {
    target1.setDisabled(par_disabled.getText());
};
</script>
	</head>
