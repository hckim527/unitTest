		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[trigger > P > centerOnImageClass]<br/>컴포넌트 영역에 마우스 포인터가 들어올때 가운데 'td' 영역에 적용될 클래스 이름을 설정합니다.",
    "validation" : [
        "type=image 인 경우에 동작합니다.",
        "CSS 파일이나 style 블럭에 정의된 클래스 이름을 공백으로 구분하여 설정합니다.",
        "값을 설정하지 않으면 'w2trigger_center' 가 설정됩니다.",
    ]
} 



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        centerOnImageClass: con_centerOnImageClass.getText(),
        type: con_type.getText(),
        style: "display:inline-table;width:300px;height:50px;",
    }
    
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"])

    // comp 생성 함수 호출    
    $c.gcm.createLabel('label="trigger 를 클릭하여 class 값 확인"', '', 'label1');
    $c.gcm.createEmptyTrigger(cList, eList);    
}


scwin.btn_getClassName_onclick = function (e) {
    let rtn = '';    
    let elemTD = document.querySelectorAll('td[id*="target"]');

    let leftTD = elemTD[0];
    let centerTD = elemTD[1];
    let rightTD = elemTD[2];

    if (centerTD) {
        rtn = centerTD.className;
    } else {
        rtn = target1.render.className
    }   

    wf_body_bottom.getObj("scwin").setReturnValue("className : " + rtn);
};


scwin.target1_onclick = function (e) {
    scwin.btn_getClassName_onclick();
}
]]></script>
