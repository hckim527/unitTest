		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[trigger &gt; P &gt; anchorWithGroupClass]&lt;br/&gt;type=anchor 일때 'w2group' 클래스의 추가 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [                
        &quot;type 속성값이 'image', 'button' 이면 해당 속성은 false 로 동작합니다.&quot;,     
        &quot;type 속성값이 'anchor' 이면 anchorWithGroupClass 속성값에 따라 동작합니다.&quot;,     
        &quot;미설정 시 컴포넌트 렌더링 시 class 속성에 'w2group' 클래스를 추가합니다.&quot;,
        &quot;false 설정 시 컴포넌트 렌더링 시 class 속성에 'w2group' 클래스를 추가하지 않습니다. &quot;,
        &quot;true 설정 시 컴포넌트 렌더링 시 class 속성에 'w2group' 클래스를 추가합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        anchorWithGroupClass: con_anchorWithGroupClass.getText(),
        type: con_type.getText(),
        style: &quot;width:150px;height:50px;&quot;
    }

    let cList = $c.gcm.createCList(properties);

    // comp 생성 함수 호출   
    $c.gcm.createEmptyTrigger(cList);
}



scwin.btn_hasClass_onclick = function (e) {
    let rtn = '';
    rtn = target1.hasClass(&quot;w2group&quot;);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;hasClass : &quot; + rtn);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group meta_snippetCategory="05_입출력테이블" meta_snippetName="5_02 2단테이블" meta_snippetKeyComponent="true" style="" id=""
					class="tblbox">
					<xf:group adaptive="layout" adaptiveThreshold="600" tagname="table" style="" id="" class="w2tb tbl">
						<w2:attributes>
							<w2:summary></w2:summary>
						</w2:attributes>
						<xf:group tagname="colgroup">
							<xf:group tagname="col" style="width:150px;"></xf:group>
							<xf:group tagname="col" style=""></xf:group>
							<xf:group tagname="col" style="width:150px;"></xf:group>
							<xf:group tagname="col" style=""></xf:group>
						</xf:group>
						<xf:group tagname="tr" style="">
							<xf:group tagname="th" style="" class="w2tb_th">

								<w2:textbox class="" id="" label="anchorWithGroupClass" ref="" style="" userData2=""></w2:textbox>
							</xf:group>
							<xf:group tagname="td" style="" class="w2tb_td">

								<xf:select1 id="con_anchorWithGroupClass" chooseOption="" style="" submenuSize="auto" allOption=""
									appearance="minimal" ref="">
									<xf:choices>
										<xf:itemset nodeset="data:gdl_boolean">
											<xf:label ref="label"></xf:label>
											<xf:value ref="value"></xf:value>
										</xf:itemset>
									</xf:choices>
								</xf:select1>
							</xf:group>
							<xf:group tagname="th" class="w2tb_th ">
								<w2:attributes></w2:attributes>
								<w2:textbox ref="" style="" userData2="" id="" label="" class=""></w2:textbox>
								<w2:textbox ref="" style="" userData2="" id="" label="type" class=""></w2:textbox>
							</xf:group>
							<xf:group tagname="td" class="w2tb_td">
								<w2:attributes></w2:attributes>
								<xf:select1 allOption="" appearance="minimal" chooseOption="" id="con_type" ref="" style=""
									submenuSize="auto">
									<xf:choices>
										<xf:item>
											<xf:label><![CDATA[]]></xf:label>
											<xf:value><![CDATA[1]]></xf:value>
										</xf:item>
										<xf:item>
											<xf:label><![CDATA[image]]></xf:label>
											<xf:value><![CDATA[2]]></xf:value>
										</xf:item>
										<xf:item>
											<xf:label><![CDATA[button]]></xf:label>
											<xf:value><![CDATA[3]]></xf:value>
										</xf:item>
										<xf:item>
											<xf:label><![CDATA[anchor]]></xf:label>
											<xf:value><![CDATA[4]]></xf:value>
										</xf:item>
									</xf:choices>
								</xf:select1>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group id="grp_condition"></xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button style="" id="btn_hasClass" label='hasClass("w2group")' class="tc_btn_basic"
							ev:onclick="scwin.btn_hasClass_onclick">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>