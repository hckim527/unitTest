    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);    
};



// 사용자 정의 함수
scwin.fn_dpformat = function(val) {
    return "Dear " + val;
};



// 사용자 정의 함수
scwin.fn_escape = function(val) {
    const escapeTable = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&apos;'
    };

    // 문자열을 한 글자씩 순회하여 이스케이프 처리된 문자열을 생성
    let escapedString = '';
    for (let char of val) {
        escapedString += escapeTable[char] || char;  // 해당 문자가 escapeTable에 없으면 원래 문자 사용
    }

    return escapedString;  // 이스케이프된 문자열 반환
};



scwin.btn_getFormatValue_onclick = function (e) {
    for(var i =1; i < 13; i ++) {
        wf_body_bottom.getObj("scwin").setReturnValue(eval('target'+i+'.getFormatValue()'));      
    }    
};
]]></script>
