		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[textbox &gt; M &gt; getsetAttributeNode]&lt;br/&gt;렌더링된 컴포넌트의 HTML 속성(attribute)값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;attrName(필수) 파라미터로 조회하려는 HTML 속성(attribute)의 이름을 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;attrName(필수) 파라미터에 설정한 HTML 속성(attribute)의 값을 반환하여야 합니다.&quot;,
        &quot;HTML 속성(attribute)이 정의되어 있지 않으면 null 값을 반환하여야 합니다.&quot;,
        &quot;tagname, tooltip 과 같이 컴포넌트 속성(Property)으로 정의된 값은 조회할 수 없어야 합니다.&quot;
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    $c.gcm.createBasicTextBox('tagname=&quot;a&quot;');
}



scwin.btn_setAttributeNode_onclick = function (e) {
    target1.setAttributeNode(par_attrName_set.getText(), par_attrValue.getValue());
};



scwin.btn_getAttributeNode_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getAttributeNode(par_attrName_get.getText());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getAttributeNode : &quot; + rtn);    
};



scwin.par_attrName_set_onchange = function (info) {
    if (par_attrName_set.getText() == &quot;href&quot;)
        par_attrValue.setValue(&quot;https://www.inswave.com&quot;);
    else if (par_attrName_set.getText() == &quot;target&quot;)
        par_attrValue.setValue(&quot;_blank&quot;);
    else if (par_attrName_set.getText() == &quot;name&quot;)
        par_attrValue.setValue(&quot;link name&quot;);
    else
        par_attrValue.setValue(&quot;title&quot;);
};
</script>
