<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[cookie] getCookie" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260401" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[cookie > M > getCookie]<br/>지정한 이름의 Cookie 값을 조회하여 반환합니다.",
    "validation" : [
        "name(필수) 파라미터로 조회할 Cookie 의 이름을 설정할 수 있어야 합니다.",
        "Cookie 값을 unescape() 로 디코딩하여 반환해야 합니다.",
        "name 파라미터에 해당하는 Cookie 가 없는 경우 null 을 반환해야 합니다.",
        "name 파라미터에 해당하는 Cookie 가 존재하지만 값이 없는 경우 ''(Empty String)을 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_setCookie_onclick = function (e) {
    let name = par_name.getValue();
    let value = par_value.getValue();
    WebSquare.cookie.setCookie(name, value);
    wf_body_bottom.getObj("scwin").setReturnValue("setCookie(\"" + name + "\", \"" + value + "\") 완료");
};



scwin.btn_getCookie_onclick = function (e) {
    let name = par_name.getValue();
    let rtn = WebSquare.cookie.getCookie(name);
    wf_body_bottom.getObj("scwin").setReturnValue("getCookie(\"" + name + "\") : " + rtn);
};



scwin.btn_delCookie_onclick = function (e) {
    let name = par_name.getValue();
    WebSquare.cookie.delCookie(name);
    wf_body_bottom.getObj("scwin").setReturnValue("delCookie(\"" + name + "\") 완료");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group meta_snippetCategory="05_입출력테이블" meta_snippetName="5_02 2단테이블" meta_snippetKeyComponent="true" style="" id=""
						class="tblbox">
						<xf:group adaptive="layout" adaptiveThreshold="600" tagname="table" style="" id="" class="w2tb tbl">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
							</xf:group>
							<xf:group tagname="tr" style="">
								<xf:group tagname="th" style="" class="w2tb_th">
									<w2:textbox ref="" style="" userData2="" id="" label="name" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" style="" class="w2tb_td">
									<xf:input id="par_name" style="" initValue="testCookie"></xf:input>
								</xf:group>
								<xf:group tagname="th" class="w2tb_th">
									<w2:textbox ref="" style="" userData2="" id="" label="value" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" class="w2tb_td">
									<xf:input id="par_value" style="" initValue="testValue"></xf:input>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button ev:onclick="scwin.btn_setCookie_onclick" style="" id="btn_setCookie" label="setCookie"
							class="tc_btn_basic">
						</w2:button>
						<w2:button ev:onclick="scwin.btn_getCookie_onclick" style="" id="btn_getCookie" label="getCookie"
							class="tc_btn_basic">
						</w2:button>
						<w2:button ev:onclick="scwin.btn_delCookie_onclick" style="" id="btn_delCookie" label="delCookie"
							class="tc_btn_basic">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>