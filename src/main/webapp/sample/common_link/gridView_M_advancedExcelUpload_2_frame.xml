<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[gridView] advancedExcelUpload 테스트 샘플 Frame" meta_author="InswaveSystems" meta_type="서브">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(gridView_M_advancedExcelUpload_2 전용 테스트 샘플 Frame)" meta_date="20260825" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_bind" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name3"></w2:column>
						<w2:column dataType="text" id="col4" name="name4"></w2:column>
					</w2:columnInfo>
					<w2:data use="true"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// gridView_M_advancedExcelUpload_2 전용 테스트 샘플 Frame
//  ★ advancedExcelUpload 의 frameModal 옵션은 GridView 가 속한 Scope(scope_id) 의 Frame 을 비활성화한다.
//    GridView 가 최상위 페이지 Scope 에 있으면 비활성화할 Frame 이 없어 frameModal 의 true / 'frame' 을 검증할 수 없다.
//    그래서 GridView 를 이 WFrame(부모에서 부여한 id : wf_body_sample) 안에 정적으로 선언한다.
let objParent = $p.parent(); // 테스트 샘플 객체



scwin.onpageload = function () {
    scwin.setInitData();
};



// GridView 에 바인딩된 DataList 를 초기 데이터 4행(col1_1 ~ col4_4)으로 설정한다.
scwin.setInitData = function () {
    let jsonData = [];

    for (let i = 1; i <= 4; i++) {
        jsonData.push({
            "col1": "col1_" + i,
            "col2": "col2_" + i,
            "col3": "col3_" + i,
            "col4": "col4_" + i
        });
    }

    dlt_bind.setJSON(jsonData, false);
};



// Target 재생성 : 초기 데이터로 되돌리고 부모 화면의 안내 라벨을 갱신한다.
scwin.btn_createTarget_onclick = function (e) {
    scwin.setInitData();
    objParent.scwin.comp_init();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload" style="">
		<w2:button ev:onclick="scwin.btn_createTarget_onclick" style="" id="btn_createTarget" label="Target 재생성" class="tc_btn_basic"></w2:button>
		<xf:group style="" id="grp_sample">
			<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<xf:group style="" id="grp_comp" class="tc_group_basic">
				<xf:group style="" id="grp_label"></xf:group>
				<w2:gridView checkAllType="false" dataList="data:dlt_bind" id="target1" style="width:500px;height:300px;">
					<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
					<w2:header id="header1" style="">
						<w2:row id="row1" style="">
							<w2:column id="column1" inputType="text" style="" value="name1" width="70"></w2:column>
							<w2:column id="column2" inputType="text" style="" value="name2" width="70"></w2:column>
							<w2:column id="column3" inputType="text" style="" value="name3" width="70"></w2:column>
							<w2:column id="column4" inputType="text" style="" value="name4" width="70"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1" style="">
						<w2:row id="row2" style="">
							<w2:column id="col1" inputType="text" style="" value="" width="70"></w2:column>
							<w2:column id="col2" inputType="text" style="" value="" width="70"></w2:column>
							<w2:column id="col3" inputType="text" style="" value="" width="70"></w2:column>
							<w2:column id="col4" inputType="text" style="" value="" width="70"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
		</xf:group>
	</body>
</html>
