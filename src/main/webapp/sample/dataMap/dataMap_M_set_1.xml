		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataMap &gt; M &gt; set]&lt;br/&gt;Key 의 ID 를 사용하여 특정 Key 에 값(Value)을 할당합니다.&quot;,
    &quot;validation&quot; : [
        &quot;keyId(필수) 파라미터로 값(Value)을 할당하려는 Key 의 ID 를 설정합니다.&quot;,
        &quot;keyValue(필수) 파라미터로 Key 에 할당하려는 값(Value)을 설정합니다.&quot;,
        &quot;keyId 파라미터에 해당하는 Key 가 없는 경우 값(Value)이 할당되지 않습니다.&quot;,
        &quot;set() 메소드로 Key 의 값(Value)이 할당되면 onbeforemodelchange, onmodelchange, onkeyset 이벤트가 발생합니다.&quot;,
        &quot;할당하려는 값이 String, Number, Boolean 형일때 동일값(Value)은 재할당되지 않으며 onbeforemodelchange, onmodelchange 이벤트가 발생하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {      
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof input1 !== 'undefined') {
        input1.remove();
    }  

    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);  

    // target 생성
    $c.gcm.createBasicDataMap();

    // event 바인딩    
    target1.bind(&quot;onbeforemodelchange&quot;, function(info){wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onbeforemodelchange=====&quot;);});    
    target1.bind(&quot;onmodelchange&quot;, function(info){wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onmodelchange=====&quot;);});    
    target1.bind(&quot;onkeyset&quot;, function(info){wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onkeyset=====&quot;);});    
    
    // input 생성
    $c.gcm.createEmptyInput('ref=&quot;data:target1.key1&quot; style=&quot;width:200px;&quot;', '', 'input1');  

    scwin.btn_getJSON_onclick();    
}   



scwin.btn_getJSON_onclick = function (e) {
    let rtn = target1.getJSON();
    let jsonString = JSON.stringify(rtn);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getJSON : &quot; + jsonString);  
};



scwin.btn_set_onclick = function (e) {   
    let keyId = par_keyId.getText();
    let keyValue = par_keyValue.getText();

    if (keyValue == &quot;string&quot;)
        target1.set(keyId, &quot;stringValue&quot;);
    else if (keyValue == &quot;number&quot;)
        target1.set(keyId, 123345);
    else if (keyValue == &quot;boolean&quot;)
        target1.set(keyId, true);
    else
        target1.set(keyId, &quot;&quot;);

    scwin.btn_getJSON_onclick();
};</script>
