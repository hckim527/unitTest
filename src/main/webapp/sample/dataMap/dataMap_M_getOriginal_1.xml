		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataMap &gt; M &gt; getOriginal]&lt;br/&gt;Key 의 ID 를 사용하여 특정 Key 에 할당되었던 원본값(Origin Value)을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;메소드 또는 사용자의 조작에 의해 변경된 값(Value)이 아닌 최초에 할당된 원본값(Origin Value)을 반환합니다.&quot;,
        &quot;keyId(필수) 파라미터로 원본값(Origin Value)을 조회하려는 Key 의 ID 를 설정합니다.&quot;,
        &quot;반환값으로 파라미터의 Key 에 할당된 원본값(Origin Value)을 반환합니다.&quot;,
        &quot;파라미터의 Key 가 정의되지 않은 경우 undefined 를 반환합니다.&quot;,
        &quot;반환값은 일반적으로 String 형이며 Key 에 할당된 데이터 형식에 맞게 반환됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }    

    if (typeof input1 !== 'undefined') {
        input1.remove();
    }    
   
    // target 생성
    $c.gcm.createBasicDataMap();

    // input 생성
    $c.gcm.createEmptyInput('ref=&quot;data:target1.key1&quot; style=&quot;width:200px;&quot;', '', 'input1');

    scwin.btn_set_onclick();
    scwin.btn_getOriginal_onclick();
}



scwin.btn_set_onclick = function (e) {
    target1.set(&quot;key1&quot;, &quot;change1&quot;);
    target1.set(&quot;key2&quot;, &quot;change2&quot;);
    target1.set(&quot;key3&quot;, &quot;change3&quot;);
    target1.set(&quot;key4&quot;, &quot;change4&quot;);
}



scwin.btn_getOriginal_onclick = function (e) {
    let keyId = par_keyId.getText();
    let rtn = &quot;&quot;;

    if (keyId == &quot;&quot;)
        rtn = target1.getOriginal();
    else
        rtn = target1.getOriginal(keyId);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getOriginal : &quot; + rtn);  
};</script>
