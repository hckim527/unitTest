		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataMap &gt; M &gt; trigger]&lt;br/&gt;DataMap 모듈에 정의된 특정 이벤트를 발생시킵니다.&quot;,
    &quot;validation&quot; : [
        &quot;type(필수) 파라미터로 발생시킬 이벤트의 이름을 설정합니다.&quot;,
        &quot;array(선택) 파라미터로 이벤트 핸들러에 전달할 데이터를 1차원 배열로 설정합니다.&quot;,
        &quot;컴포넌트에 정의되지 않은 이벤트는 발생하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {      
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof input1 !== 'undefined') {
        input1.remove();
    }  

    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);  

    // target 생성
    $c.gcm.createBasicDataMap();

    // event 바인딩        
    target1.bind(&quot;onsetdata&quot;, function(info){
        let array = par_array.getText();

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onsetdata=====&quot;);

        if (array == &quot;JSON&quot;) {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info.id: &quot;+ info[&quot;id&quot;]);
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info.newValue: &quot;+ info[&quot;newValue&quot;]); 
        }
        else if (array == &quot;Array&quot;) {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info[0]:&quot;+ info[0]);
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info[1]:&quot;+ info[1]);
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info[2]:&quot;+ info[2]);
        }        
    });        
    
    // input 생성
    $c.gcm.createEmptyInput('ref=&quot;data:target1.key1&quot; style=&quot;width:200px;&quot;', '', 'input1');  
}   



scwin.btn_trigger_onclick = function (e) {
    let type = par_type.getText();
    let array = par_array.getText();

    if (type == &quot;onmodelchange&quot;)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;정의되지 않은 이벤트&quot;);

    if (array == &quot;JSON&quot;)    
        target1.trigger(type, [{&quot;index&quot;:0,&quot;id&quot;:&quot;key1&quot;,&quot;oldValue&quot;:10,&quot;newValue&quot;:20}]);
    else if (array == &quot;Array&quot;)
        target1.trigger(type, [['a','b','c']]);
    else
        target1.trigger(type);
};</script>
