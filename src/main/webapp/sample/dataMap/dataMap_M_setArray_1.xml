		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataMap &gt; M &gt; setArray]&lt;br/&gt;1차원 배열을 사용하여 전체 Key 의 값(Value)을 새로 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;arrData(필수) 파라미터로 새로 설정할 전체 Key 의 값(Value)을 1차원 배열로 설정합니다.&quot;,
        &quot;KeyInfo 영역에 정의된 Key 의 갯수와 순서에 맞게 1차원 배열이 설정되어야 합니다.&quot;,
        &quot;배열의 원소 갯수가 Key 의 갯수보다 작으면 순서대로 설정되고 뒤에 정의된 Key 는 값(Value)이 설정되지 않습니다.&quot;,
        &quot;값(Value)이 새로 설정된 Key 의 '변경여부' 상태값은 firstSet 속성과 원본값(Origin Value) 할당 여부에 따라 달라집니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof input1 !== 'undefined') {
        input1.remove();
    }  

    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);  

    // target 생성
    $c.gcm.createBasicDataMap();
    
    // input 생성
    $c.gcm.createEmptyInput('ref=&quot;data:target1.key1&quot; style=&quot;width:200px;&quot;', '', 'input1');  

    scwin.btn_getJSON_onclick();
    scwin.btn_getModifiedJSON_onclick();
}   



scwin.btn_getJSON_onclick = function (e) {
    let rtn = target1.getJSON();
    let jsonString = JSON.stringify(rtn);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getJSON : &quot; + jsonString);  
};



scwin.btn_getModifiedJSON_onclick = function (e) {
    let rtn = target1.getModifiedJSON();
    let jsonString = JSON.stringify(rtn);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getModifiedJSON : &quot; + jsonString);  
}



scwin.btn_setArray_onclick = function (e) {   
    let arrData = eval('{' + par_arrData.getText() + '}');  

    target1.setArray(arrData);

    scwin.btn_getJSON_onclick();
    scwin.btn_getModifiedJSON_onclick();
};</script>
