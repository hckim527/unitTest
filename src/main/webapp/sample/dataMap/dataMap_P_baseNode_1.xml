		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataMap &gt; P &gt; baseNode]&lt;br/&gt;DataMap 모듈에서 XML 형식으로 데이터를 전달하거나 받을때 XML 의 Root 노드 태그로 적용될 값을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;Root 노드의 태그명을 설정합니다.&quot;,
        &quot;속성값을 설정하지 않으면 'map' 으로 적용됩니다.&quot;,
        &quot;데이터 노드의 태그엔 Key 의 ID 값이 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof input1 !== 'undefined') {
        input1.remove();
    }  

    // 조건 설정       
    let properties = {
        baseNode : con_baseNode.getText(),
    };

    let cList = $c.gcm.createCList(properties);  

    // target 생성
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strInput = '';
    let strNameSpace = $c.gcm.getNameSpace();
    
    strTarget += '&lt;w2:dataMap ' + strNameSpace + ' ' + cList + ' id=&quot;target1&quot;&gt;';        
    strTarget += '&lt;w2:keyInfo&gt;';
    strTarget += '&lt;w2:key dataType=&quot;text&quot; id=&quot;key1&quot; name=&quot;name1&quot;&gt;&lt;/w2:key&gt;';
    strTarget += '&lt;w2:key dataType=&quot;text&quot; id=&quot;key2&quot; name=&quot;name1&quot;&gt;&lt;/w2:key&gt;';
    strTarget += '&lt;w2:key dataType=&quot;text&quot; id=&quot;key3&quot; name=&quot;name1&quot;&gt;&lt;/w2:key&gt;';
    strTarget += '&lt;w2:key dataType=&quot;text&quot; id=&quot;key4&quot; name=&quot;name1&quot;&gt;&lt;/w2:key&gt;';
    strTarget += '&lt;/w2:keyInfo&gt;';
    strTarget += '&lt;w2:data use=&quot;true&quot;&gt;';
    strTarget += '&lt;key1&gt;&lt;![CDATA[dm_data1]]&gt;&lt;/key1&gt;';
    strTarget += '&lt;key2&gt;&lt;![CDATA[dm_data2]]&gt;&lt;/key2&gt;';
    strTarget += '&lt;key3&gt;&lt;![CDATA[dm_data3]]&gt;&lt;/key3&gt;';
    strTarget += '&lt;key4&gt;&lt;![CDATA[dm_data4]]&gt;&lt;/key4&gt;';
    strTarget += '&lt;/w2:data&gt;';
    strTarget += '&lt;/w2:dataMap&gt;';      


    $p.data.create(strTarget);
    
    // input 생성
    $c.gcm.createEmptyInput('ref=&quot;data:target1.key1&quot; style=&quot;width:200px;&quot;', '', 'input1');  

    scwin.btn_getXML_onclick();
}   



scwin.btn_getXML_onclick = function (e) {
    let rtn = target1.getXML();

    const serializer = new XMLSerializer();
    let xmlString = serializer.serializeToString(rtn);
	
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.xml: &quot; + xmlString);
}



scwin.btn_setXML_onclick = function (e) {   
    let xmlData = WebSquare.xml.parse(par_xmlData.getText());   

    target1.setXML(xmlData);

    scwin.btn_getXML_onclick();
};



scwin.con_baseNode_onchange = function (info) {
	par_xmlData.setValue(info.newValue);
};
</script>
