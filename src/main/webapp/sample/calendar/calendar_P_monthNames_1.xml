		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[calendar > P > monthNames]<br/>Calendar 컴포넌트의 월 선택 영역에 표시되는 월 이름을 설정합니다.",
    "validation" : [
        "콤마(',')로 구분된 12 개의 월 이름 문자열을 설정합니다.",
        "12 개 미만으로 설정하면 부족한 월의 이름이 숫자(1~12)로 표시됩니다.",
        "값을 설정하지 않으면 언어 설정에 따라 '1월,2월,3월...', 'Jan,Feb,Mar...', '1月,2月,3月...' 이 적용됩니다."
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        monthNames : con_monthNames.getText(),
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



scwin.btn_getHeadMonth_onclick = function (e) {
    let element = document.querySelector('[id*="_selectbox_month_itemTable"]');
    wf_body_bottom.getObj("scwin").setReturnValue("월 : " + (element ? element.textContent : '(영역 없음)'));
};]]></script>
	</head>
