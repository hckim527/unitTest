		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[calendar > M > getSelectedDay]<br/>Calendar 컴포넌트에 선택된 날짜의 요일을 소문자 영문 문자열로 반환합니다.",
    "validation" : [
        "Calendar 컴포넌트에 선택된 날짜의 영문 요일명을 String 타입으로 반환합니다.",
        "반환값은 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday' 중 하나의 소문자 영문 요일명입니다.",
        "calendarValueType='yearMonth' 인 경우 빈 문자열('') 을 반환합니다."
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        calendarValueType : con_calendarValueType.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"]);

    await $c.gcm.createBasicCalendar(cList, eList);
    // createBasicCalendar 는 내부에서 gotoCalendar('20251111') 호출 → 기본 선택일: 2025-11-11(화요일)
}



// getSelectedDay() 반환값 출력
// validation: 선택된 날짜의 영문 요일명(소문자 String) 반환, calendarValueType='yearMonth' 인 경우 빈 문자열 반환
scwin.btn_getSelectedDay_onclick = function (e) {
    let day = target1.getSelectedDay();
    let value = target1.getValue();
    wf_body_bottom.getObj("scwin").setReturnValue("[getSelectedDay() 반환] '" + day + "' / [getValue() 원본] '" + value + "'");
};



// gotoCalendar 로 날짜 변경 후 getSelectedDay 호출 → 변경된 날짜의 요일명 반환 확인
// validation: 날짜를 변경한 후 호출하면 변경된 날짜의 요일명을 반환합니다.
scwin.btn_setAndGetSelectedDay_onclick = function (e) {
    target1.gotoCalendar(par_setDate.getValue());
    let day = target1.getSelectedDay();
    let value = target1.getValue();
    wf_body_bottom.getObj("scwin").setReturnValue("[gotoCalendar('" + par_setDate.getValue() + "') 후 getSelectedDay() 반환] '" + day + "' / [getValue() 원본] '" + value + "'");
};]]></script>
	</head>
