		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[calendar &gt; P &gt; cancelButtonHide]&lt;br/&gt;Calendar 컴포넌트에서 취소 버튼을 숨길지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;calendarValueType 속성값에 관계없이 취소 버튼을 표시하지 않습니다.&quot;,
        &quot;미설정(기본값 false) 시 Calendar 컴포넌트에 취소 버튼을 표시합니다.&quot;,
        &quot;true 설정 시 Calendar 컴포넌트에 취소 버튼이 표시되지 않습니다.&quot;,
        &quot;true 설정 시 cancelButtonShow 속성값에 관계없이 취소 버튼이 표시되지 않습니다. (cancelButtonHide 가 우선 적용됨)&quot;,
        &quot;true 설정 시 calendarValueType 속성값에 관계없이 취소 버튼이 표시되지 않습니다.&quot;,
        &quot;false 설정 시 calendarValueType='yearMonthDate' 이면 cancelButtonShow 속성값에 따라 취소 버튼의 표시 여부가 결정됩니다.&quot;,
        &quot;accessibility=true 일 때 cancelButtonShow=true 로 강제 설정되지만, cancelButtonHide 속성은 변경되지 않습니다.&quot;,
        &quot;accessibility=true 이고 cancelButtonHide=true 로 설정하면 accessibility 의 cancelButtonShow=true 강제 설정과 관계없이 취소 버튼을 숨길 수 있습니다.&quot;,
        &quot;취소 버튼 클릭 시 oncancel 이벤트가 발생합니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        cancelButtonHide : con_cancelButtonHide.getText(),
        cancelButtonShow : con_cancelButtonShow.getText(),
        calendarValueType : con_calendarValueType.getText(),
        accessibility : con_accessibility.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;, &quot;oncancel&quot;]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



// 취소 버튼 DOM 존재 여부 확인 (cancelButtonHide / cancelButtonShow / calendarValueType / accessibility 조합 결과)
scwin.getCancelButtonInfo = function () {
    let r = target1.render;
    // calendarValueType 별로 취소 버튼 DOM 클래스가 다름:
    // yearMonth/year → .w2calendar_header_btn_close / yearMonthDate → .w2calendar_date_cancel / yearMonthDateTime 등 → .w2calendar_time_cancel
    let cancelBtn = r.querySelector('[class*=&quot;w2calendar_header_btn_close&quot;]')
        || r.querySelector('[class*=&quot;w2calendar_date_cancel&quot;]')
        || r.querySelector('[class*=&quot;w2calendar_time_cancel&quot;]');

    // validation: cancelButtonHide=true 면 어떤 조합에서도 숨김 / false 면 calendarValueType + cancelButtonShow + accessibility 강제 설정 조건에 따라 표시
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[취소 버튼 표시 여부] &quot; + (cancelBtn ? &quot;표시됨&quot; : &quot;숨김&quot;));
}



scwin.target1_onclick = function (e) {
    setTimeout(() =&gt; {
        scwin.getOptions();
    }, 100);
}



// 취소 버튼 클릭 시 oncancel 이벤트 발생 검증
scwin.target1_oncancel = function (e) {
    // validation: 취소 버튼 클릭 시 oncancel 이벤트가 발생함
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[oncancel 이벤트 발생] 취소 버튼 클릭에 의해 oncancel 핸들러 호출됨&quot;);
}</script>
