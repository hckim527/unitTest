		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[calendar > M > setDateFormat]<br/>Calendar 컴포넌트의 날짜 포맷을 설정합니다.",
    "validation" : [
        "format(필수) 파라미터로 컴포넌트의 선택일이 반환되는 'y', 'M', 'd', 'H', 'm', 'S' 마스크 문자로 설정합니다.",
        "calendarValueType 속성에 따라 사용 가능한 마스크 문자가 다릅니다.",
        "'yyyy' 마스크는 년도와 매칭되며 네자리로 설정합니다.",
        "'MM' 마스크는 월과 매칭되며 두자리로 설정합니다.",
        "'dd' 마스크는 일과 매칭되며 두자리로 설정합니다.",
        "'HH' 마스크는 시와 매칭되며 두자리로 설정합니다.",
        "'mm' 마스크는 분과 매칭되며 두자리로 설정합니다.",
        "'SS' 마스크는 초와 매칭되며 두자리로 설정합니다.",
        "마스크 문자가 아닌 일반문자는 그대로 표시됩니다.",
        "설정된 포맷이 적용된 값은 getFormattedValue() 메소드로 반환받을 수 있습니다.",
        "getValue() 메소드는 포맷이 적용되지 않은 원본값을 반환합니다."
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        calendarValueType : con_calendarValueType.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"]);

    await $c.gcm.createBasicCalendar(cList, eList);

    // calendarValueType 별 자릿수에 맞춰 초기 선택 날짜/시간 설정
    let valueType = target1.options.calendarValueType || 'yearMonthDate';
    if (valueType === 'yearMonth') {
        target1.gotoCalendar('20251101');
    } else if (valueType === 'yearMonthDate') {
        target1.gotoCalendar('20251111');
    } else if (valueType === 'yearMonthDateHour') {
        target1.gotoCalendar('20251111');
        target1.gotoTime(14, 0, 0);
    } else if (valueType === 'yearMonthDateTime') {
        target1.gotoCalendar('20251111');
        target1.gotoTime(14, 30, 0);
    } else if (valueType === 'yearMonthDateTimeSec') {
        target1.gotoCalendar('20251111');
        target1.gotoTime(14, 30, 25);
    }
}



// setDateFormat 호출 후 getFormattedValue / getValue 비교 출력
scwin.btn_setDateFormat_onclick = function (e) {
    target1.setDateFormat(con_formatCase.getText());

    // validation: 'yyyy'/'MM'/'dd'/'EEE'/'HH'/'mm'/'SS' 마스크 매칭 + 마스크 외 일반문자 그대로 표시
    //             설정된 포맷이 적용된 값은 getFormattedValue() 메소드로 반환받을 수 있습니다.
    wf_body_bottom.getObj("scwin").setReturnValue("[getFormattedValue() 반환] '" + target1.getFormattedValue() + "'");
    // validation: getValue() 메소드는 포맷이 적용되지 않은 원본값을 반환합니다.
    wf_body_bottom.getObj("scwin").setReturnValue("[getValue() 반환] '" + target1.getValue() + "'");
};



]]></script>
