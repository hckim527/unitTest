		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[calendar > E > onconfirm]<br/>Calendar 컴포넌트에서 확인 버튼을 클릭할 때 발생합니다.",
    "validation" : [
        "Calendar 컴포넌트에서 확인 버튼을 클릭할 때 onconfirm 이벤트가 발생합니다.",        
        "calendarValueType=yearMonth 이고 skipConfirm=true 이면 월 SelectBox 변경 시 onconfirm 이벤트가 발생합니다.",
        "calendarValueType=yearMonth 이고 skipConfirmOnly=true 이면 월 SelectBox 변경 시 onconfirm 이벤트가 발생합니다."
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 라벨: 수동 테스트 안내
    $c.gcm.createLabel('label="[수동 테스트 안내] 표시된 확인 버튼을 클릭하면 onconfirm 이벤트가 발생합니다."', '', 'label1');

    // 확인 버튼이 표시되도록 calendarValueType=yearMonth 고정
    let properties = {
        calendarValueType : "yearMonth",
        skipConfirm : con_skipConfirm.getText(),
        skipConfirmOnly : con_skipConfirmOnly.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onconfirm"]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



// 확인 버튼 클릭 시 onconfirm 이벤트 발생 (validation 1, 2, 3)
scwin.target1_onconfirm = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("[onconfirm 발생] onconfirm 핸들러 실행됨");    
};]]></script>
	</head>
