		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[calendar &gt; P &gt; title]&lt;br/&gt;Calendar 컴포넌트의 최외곽 요소에 대한 title 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;최외곽 div 요소의 title 속성에 출력할 텍스트를 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 '' 로 적용되어 title 속성이 설정되지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        title : con_title.getValue()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



scwin.btn_getInfo_onclick = function (e) {
    // validation: 최외곽 div 요소의 title 속성에 출력할 텍스트를 설정 / 미설정 시 '' 로 적용되어 title 속성이 설정되지 않음
    let renderTitle = target1.render.getAttribute('title');
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[최외곽 div title 속성] target1.render.getAttribute('title')=&quot; + (renderTitle === null ? &quot;null (속성 미설정)&quot; : &quot;'&quot; + renderTitle + &quot;'&quot;));
}</script>
