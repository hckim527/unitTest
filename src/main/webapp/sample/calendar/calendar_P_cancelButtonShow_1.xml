		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[calendar &gt; P &gt; cancelButtonShow]&lt;br/&gt;calendarValueType=yearMonthDate 일때 컴포넌트에 취소 버튼을 표시할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;calendarValueType=yearMonthDate 가 아닌 경우 cancelButtonHide 속성으로 표시 여부를 설정합니다.&quot;,
        &quot;cancelButtonHide=true 이면 cancelButtonShow 속성은 무시됩니다.&quot;,
        &quot;미설정(기본값 false) 시 calendarValueType=yearMonthDate 일때 팝업 달력에 취소 버튼을 표시하지 않습니다.&quot;,
        &quot;true 설정 시 calendarValueType=yearMonthDate 일때 컴포넌트에 취소 버튼을 표시합니다.&quot;,
        &quot;false (기본값) 설정 시 calendarValueType=yearMonthDate 일때 팝업 달력에 취소 버튼을 표시하지 않습니다.&quot;,
        &quot;cancelButtonHide=true 이면 cancelButtonShow 속성은 무시되고 취소 버튼이 표시되지 않습니다.&quot;,
        &quot;calendarValueType 이 yearMonthDate 가 아닌 경우 cancelButtonShow 와 무관하게 cancelButtonHide 속성으로 표시 여부가 결정됩니다.&quot;,
        &quot;accessibility=true 일 때 cancelButtonShow=true 로 강제 설정됩니다.&quot;,
        &quot;renderType=native 인 경우 취소 버튼이 'a' 또는 'button' 태그로 렌더링됩니다.&quot;,
        &quot;renderType=native 가 아닌 경우 취소 버튼이 'div' 태그에 role='button' 과 tabindex='0' 을 부여하여 렌더링됩니다.&quot;,
        &quot;취소 버튼 클릭 시 oncancel 이벤트가 발생합니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        cancelButtonShow : con_cancelButtonShow.getText(),
        cancelButtonHide : con_cancelButtonHide.getText(),
        calendarValueType : con_calendarValueType.getText(),
        accessibility : con_accessibility.getText(),
        renderType : con_renderType.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;, &quot;oncancel&quot;]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



// 취소 버튼 표시 여부 + 렌더링 태그 (calendarValueType 별 DOM 클래스: yearMonthDate=date_cancel / yearMonth·year=header_btn_close / Hour·Time=time_cancel)
scwin.getCancelButtonInfo = function () {
    let r = target1.render;
    let cancelBtn = r.querySelector('[class*=&quot;w2calendar_date_cancel&quot;]')
        || r.querySelector('[class*=&quot;w2calendar_header_btn_close&quot;]')
        || r.querySelector('[class*=&quot;w2calendar_time_cancel&quot;]');

    // validation: yearMonthDate+true→표시 / yearMonthDate+false→숨김 / cancelButtonHide=true→무조건 숨김 / 그외 모드→cancelButtonHide 로 결정
    // validation: renderType=native → 'a' 또는 'button' 태그 / 그외 → 'div' + role='button' + tabindex='0'
    if (cancelBtn) {
        let visible = getComputedStyle(cancelBtn).display !== 'none' &amp;&amp; getComputedStyle(cancelBtn).visibility !== 'hidden';
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[취소 버튼] &quot; + (visible ? '표시됨' : '숨김') + &quot; / tag=&quot; + cancelBtn.tagName.toLowerCase() + &quot;, role=&quot; + cancelBtn.getAttribute('role') + &quot;, tabindex=&quot; + cancelBtn.getAttribute('tabindex'));
    } else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[취소 버튼] 숨김 (DOM 미생성)&quot;);
    }
}



scwin.btn_getInfo_onclick = function (e) {    
    scwin.getCancelButtonInfo();
}



// 취소 버튼 클릭 시 발생하는 oncancel 이벤트 확인
scwin.target1_oncancel = function (e) {
    // validation: 취소 버튼 클릭 시 oncancel 이벤트가 발생함
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[oncancel 이벤트 발생] 취소 버튼 클릭 → oncancel 핸들러 실행됨&quot;);
}



scwin.target1_onclick = function (e) {
    setTimeout(() =&gt; {        
        scwin.getCancelButtonInfo();
    }, 100);
}</script>
