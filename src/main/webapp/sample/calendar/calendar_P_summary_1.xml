		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[calendar &gt; P &gt; summary]&lt;br/&gt;웹접근성 향상을 위해 Calendar 의 table 태그에 summary 속성을 추가하고 추가 정보를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;table 태그의 summary 속성에 들어갈 추가 정보를 텍스트로 설정합니다.&quot;,
        &quot;renderType=component 인 경우에 적용되며, HTML5 인 경우는 적용되지 않습니다.&quot;,        
        &quot;문서 타입이 HTML5 인 환경에서는 적용되지 않으므로 설정값만 확인하면 됩니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        summary : con_summary.getValue(),
        renderType : con_renderType.getValue()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    await $c.gcm.createBasicCalendar(cList, eList);
}



scwin.btn_getInfo_onclick = function (e) {
    // validation: table 태그의 summary 속성에 들어갈 추가 정보를 텍스트로 설정 — options.summary 로 적용값 검증
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[options.summary 적용값] '&quot; + target1.options.summary + &quot;'&quot;);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
