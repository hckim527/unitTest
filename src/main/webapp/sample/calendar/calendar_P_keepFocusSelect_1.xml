		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[calendar &gt; P &gt; keepFocusSelect]&lt;br/&gt;renderType=natvie 일때 Calendar 컴포넌트 선택된 요소에 포커스를 유지할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;미설정(기본값 false) 시 상단의 버튼을 클릭하거나 년/월을 선택했을때 날짜 셀로 포커스가 이동합니다.&quot;,
        &quot;미설정(기본값 false) 시 최외곽 div 에 포커스 도달하면 내부의 선택된 날짜 셀로 포커스가 자동 이동됩니다.&quot;,
        &quot;true 설정 시 상단의 버튼을 클릭하거나 년/월을 선택했을때 해당 요소에 포커스를 유지합니다.&quot;,
        &quot;renderType='native' 인 경우에만 keepFocusSelect 속성이 동작하며, renderType='component' 이면 동작하지 않습니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        keepFocusSelect : con_keepFocusSelect.getText(),
        renderType : con_renderType.getText()
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onfocus&quot;]);

    await $c.gcm.createBasicCalendar(cList, eList);
}</script>
