		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[calendar > P > tooltipLocaleRef]<br/>클라이언트 다국어가 적용되었을 때 tooltip 속성의 툴팁에 표시할 텍스트의 Key 값을 설정합니다.",
    "validation" : [
        "툴팁에 표시할 다국어 텍스트의 Key 값을 String 으로 설정합니다.",
        "tooltip 속성이 설정되어 있고 클라이언트 다국어 기능이 활성화 되었을 때 동작합니다.",
        "설정한 Key 값이 JS 파일에 없다면 'global_undefined' 가 적용됩니다.",
        "다국어 기능은 Key:Value 형식으로 데이터가 정의된 JS 파일에서 Key 값에 해당하는 Value 값을 찾아 툴팁에 반영합니다. (브라우저 설정 언어 JS 파일 적용)",
        "config.xml 파일에서 languagePack 항목 설정 + WebSquare/useLocale/@value=true 설정이 필요합니다."
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        tooltip : con_tooltip.getValue(),
        tooltipLocaleRef : con_tooltipLocaleRef.getText(),
        useLocale : con_useLocale.getText(),
    }

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicCalendar(cList, 'ev:onclick="scwin.target1_onclick"');
}



scwin.target1_onclick = function (e) {
    // validation: tooltipLocaleRef 의 Key 가 JS 파일에서 찾아져 툴팁 textContent 로 반영됨 / 미존재 시 global_undefined
    let objTooltip = document.querySelector('.w2balloonTip_label');
    if (objTooltip) {
        wf_body_bottom.getObj("scwin").setReturnValue("tooltip : " + objTooltip.textContent);
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("tooltip : (표시 안됨)");
    }
}]]></script>
	</head>
