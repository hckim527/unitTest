		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabs &gt; P &gt; disabled]&lt;br/&gt;Tab 페이지의 비활성화(disabled) 상태를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;TabControl 컴포넌트의 selectIndex 속성값에 해당하는 Tabs 의 disabled 속성이 true 이면 적용된 alwaysDraw 속성값에 관계없이 Content 영역은 렌더링되지 않습니다. &quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    scwin.btn_getWindow_onclick();
}



scwin.btn_getWindow_onclick = function (e) {   
    setTimeout(function(){
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;content1 의 child 객체: &quot; + target1.getWindow(0).link_1);
    }, 100);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<w2:textbox style="" id="" label="tabs1 의 disabled=true 인 상태"></w2:textbox>
                    	<w2:tabControl id="target1" alwaysDraw="false" style="width:500px;height:200px;"
                    		ev:onchange="scwin.target1_onchange" selectedIndex="0">
                    		<w2:tabs disabled="true" style="height:40px;" id="tabs1" label="Tabs1"></w2:tabs>
                    		<w2:tabs disabled="false" style="height:40px" id="tabs2" label="Tabs2"></w2:tabs>
                    		<w2:tabs disabled="false" style="height:40px" id="tabs3" label="Tabs3"></w2:tabs>
                    		<w2:content alwaysDraw="" style="height:160px;" id="content1"
                    			src="/sample/common_link/tabControl_link_1.xml">
                    		</w2:content>
                    		<w2:content alwaysDraw="false" style="height:160px" id="content2"
                    			src="/sample/common_link/tabControl_link_2.xml">
                    		</w2:content>
                    		<w2:content alwaysDraw="false" style="height:160px" id="content3"></w2:content>
                    	</w2:tabControl>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
