		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; fixedDate]&lt;br/&gt;팝업 달력이 표시될때 선택일에 오늘 날짜를 적용할지 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;미설정 시 컴포넌트의 입력값이 팝업 달력의 선택일로 적용됩니다.&quot;,
        &quot;today 설정 시 컴포넌트의 입력값과 관계없이 팝업 달력의 선택일이 오늘 날짜로 적용됩니다.&quot;,        
        &quot;today 설정 시 오늘 날짜로 선택일이 적용되므로 defaultDate 속성은 무시됩니다.&quot;,
        &quot;팝업 달력에서 년/월을 탐색하면 dayMoveFixed, dateMoveFixed 속성값에 따라 선택일이 변경됩니다.&quot;,
        &quot;팝업 달력에 적용된 선택일에 맞는 날짜의 달력이 표시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        fixedDate : con_fixedDate.getText(),     
        defaultDate : con_defaultDate.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        // wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent); 

        let rtn = ''
        let serverDate = WebSquare.date.getCurrentServerDate(&quot;yyyy-MM-dd&quot;);

        rtn = element.textContent;

        if (rtn == serverDate)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is currentDate&quot;)
        else 
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is not currentDate : &quot; + rtn);             
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(&quot;&quot;);
};
</script>
