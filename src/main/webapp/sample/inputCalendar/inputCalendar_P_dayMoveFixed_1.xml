		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; dayMoveFixed]&lt;br/&gt;팝업 달력에서 년/월을 탐색할때 변경되는 선택일의 일자를 유지할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;팝업 달력에서 년/월의 탐색은 상단의 '이전해', '이전달', '다음해', '다음달' 버튼을 클릭하거나 SelectBox 에서 년/월을 선택합니다.&quot;,
        &quot;미설정 시 팝업 달력에서 년/월을 탐색할때 변경되는 선택일의 일자가 1일로 변경됩니다.&quot;,
        &quot;true 설정 시 팝업 달력에서 년/월을 탐색할때 변경되는 선택일의 일자를 유지합니다.&quot;,
        &quot;true 설정 시 이동된 월에 선택일의 일자가 없는 경우 마지막 일자가 선택됩니다.&quot;,
        &quot;false 설정 시 팝업 달력에서 년/월을 탐색할때 변경되는 선택일의 일자가 1일로 변경됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        dayMoveFixed : con_dayMoveFixed.getText(),
    }

    let cList = $c.gcm.createCList(properties);
        
    $c.gcm.createLabel('label=&quot;dayMoveFixed 설정 후 팝업 달력에서 탐색 후 선택일 확인&quot;', '', 'label1');
    $c.gcm.createBasicInputCalendar(cList); 
}


scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent)
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};
</script>
