		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; setValue]&lt;br/&gt;컴포넌트의 실제 입력값을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;setValue() 메소드로 입력값이 설정되면 팝업 달력의 선택일도 동일한 날짜로 설정됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onclick&quot;])
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;setValue 메소드 실행 후 팝업 달력 오픈하여 선택값 확인&quot;', '', 'label1');
    $c.gcm.createEmptyInputCalendar('', eList);
}


scwin.btn_setValue_onclick = function (e) {
	target1.setValue(par_value.getText());
};



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent)
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};



scwin.target1_onclick = function (e) {
    setTimeout(() =&gt; {   
        scwin.btn_getSelectedDate_onclick();
    }, 100);
}</script>
