		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; setRef]&lt;br/&gt;컴포넌트의 ref 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;ref(필수) 파라미터로 접근 가능한 DataCollection 의 컬럼을 'data:[DataCollection ID].[Key 또는 Column ID]' 형식으로 설정합니다.&quot;,
        &quot;형식에 맞지 않거나 접근할 수 없는 DataCollection 이면 적용되지 않습니다.&quot;,
        &quot;DataList 를 바인딩 한 경우 DataList 의 데이터를 선택하지 않으면 입력창에 빈값이 표시됩니다.&quot;,
        &quot;데이터를 선택하지 않은 상태에서 입력된 값은 데이터 선택 시 사라집니다.&quot;,
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }
    
    // comp 생성 함수 호출
    let grp_comp = $c.gcm.getTestGroup();
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    
    strTarget += '&lt;w2:inputCalendar ' + strNameSpace + ' style=&quot;width:150px; height:23px; &quot; calendarValueType=&quot;yearMonthDate&quot;&gt;&lt;/w2:inputCalendar&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;inputCalendar&quot;,
        strTarget,
        grp_comp
    );    
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
        
    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 확인 : &quot; + rtn);        
};



scwin.btn_setRowposition1_onclick = function (e) {
    dlt_ref.setRowPosition(0);
};



scwin.btn_setRowposition2_onclick = function (e) {
    dlt_ref.setRowPosition();
};



scwin.par_ref_onchange = function (info) {
    if (par_ref.getText() !== &quot;data:dlt_ref.label&quot;) {
        btn_setRowposition1.setDisabled(true);
        btn_setRowposition2.setDisabled(true);
    }
    else {
        btn_setRowposition1.setDisabled(false);
        btn_setRowposition2.setDisabled(false);        
    }
};



scwin.btn_setRef_onclick = function (e) {
	target1.setRef(par_ref.getText());
};
</script>
	</head>
