		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; getDataListInfo]&lt;br/&gt;컴포넌트의 ref 속성에 바인딩된 정보를 반환합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;ref 속성에 바인딩된 정보를 객체로 반환하여야 합니다.&quot;,
        &quot;ref 속성이 설정되어 있지 않으면 null 을 반환하여야 합니다.&quot;,
        &quot;반환된 객체의 id 속성은 바인딩 된 DataCollection 의 렌더링 ID 값을 가져야 합니다.&quot;,
        &quot;반환된 객체의 holidayRef 속성은 setHolidayRef() 메소드로 설정한 휴일 정보 DataCollection 값을 갖져야 합니다.&quot;,
        &quot;휴일 정보 DataCollection 을 설정하지 않으면 ''(Empty String)값을 갖습니다.&quot;,
        &quot;반환된 객체의 ref 속성은 컴포넌트의 ref 속성값을 가져야 합니다.&quot;,
        &quot;컴포넌트에 표시되는 내부 텍스트와 관계없이 ref 속성에 설정된 정보를 반환하여야 합니다.&quot;,
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        ref : con_ref.getText(),
    }
    
    let cList = $c.gcm.createCList(properties);  
    
    // comp 생성 함수 호출
    let grp_comp = $c.gcm.getTestGroup();
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    
    strTarget += '&lt;w2:inputCalendar ' + strNameSpace + ' ' + cList + ' style=&quot;width:150px; height:23px; &quot; calendarValueType=&quot;yearMonthDate&quot;&gt;&lt;/w2:inputCalendar&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;inputCalendar&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_getDataListInfo_onclick = function (e) {
    dlt_ref.setRowPosition(0);
    
    let rtn = '';
    
    rtn = target1.getDataListInfo();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDataListInfo : &quot; + rtn);    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDataListInfo.id : &quot; + rtn.id);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDataListInfo.holidayRef : &quot; + rtn.holidayRef);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDataListInfo.ref : &quot; + rtn.ref);
};



scwin.btn_setHolidayRef_onclick = function (e) {
	target1.setHolidayRef(&quot;data:dlt_holiday_ref.label&quot;);
};
</script>
