		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; getButtonTitle]&lt;br/&gt;컴포넌트의 buttonTitle 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트의 buttonTitle 속성값을 반환합니다.&quot;,
        &quot;buttonTitle 속성값이 없는 경우 null 을 반환합니다.&quot;,
        &quot;buttonTitle 속성은 컴포넌트의 버튼 영역에 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        buttonTitle : con_buttonTitle.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getButtonTitle_onclick = function (e) {
    let rtn = ''

    rtn = target1.getButtonTitle();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('getButtonTitle : ' + rtn); 
};</script>
