		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; showToday]&lt;br/&gt;팝업 달력의 하단에 'Today' 버튼의 표시 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;calendarValueType=year,yearMonth,yearMonthDateTimeSec 인 경우 동작하지 않습니다.&quot;,
        &quot;미설정 시 팝업 달력의 하단에 'Today' 버튼을 표시합니다.&quot;,
        &quot;false 설정 시 팝업 달력의 하단에 'Today' 버튼이 표시되지 않습니다.&quot;,
        &quot;true 설정 시 팝업 달력의 하단에 'Today' 버튼을 표시합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        showToday : con_showToday.getText(),
        calendarValueType : con_calendarValueType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)    
    
    // comp 생성 함수 호출    
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.isTodayButton_onclick = function (e) {
    let targetElement = document.querySelector('div[id*=&quot;target1_calendar&quot;]');

    if (targetElement) {
        let confirmElement = document.querySelector('div[class*=&quot;w2calendar_go_today_hidden&quot;]');

        if (confirmElement) {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('Today 버튼 미표시');
        }
        else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('Today 버튼 표시');
        }
    }
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 달력을 한번 오픈해야 정보 가져올 수 있음&quot;);
    }
}</script>
