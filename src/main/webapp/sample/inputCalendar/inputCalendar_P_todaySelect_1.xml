		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; todaySelect]&lt;br/&gt;팝업 달력에서 하단의 'Today' 버튼 클릭 시 오늘 날짜가 입력되도록 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;calendarValueType=year,yearMonth,yearMonthDateTimeSec 인 경우 동작하지 않습니다.&quot;,
        &quot;미설정 시 'Today' 버튼 클릭하면 오늘 날짜가 팝업 달력의 날짜 영역에 선택일로 표시됩니다.&quot;,
        &quot;true 설정 시 'Today' 버튼 클릭 시 오늘 날짜가 컴포넌트에 입력되고 팝업 달력이 닫힙니다.&quot;,
        &quot;false 설정 시 'Today' 버튼 클릭하면 오늘 날짜가 팝업 달력의 날짜 영역에 선택일로 표시됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        todaySelect : con_todaySelect.getText(),
        calendarValueType : con_calendarValueType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)    
    
    // comp 생성 함수 호출    
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getValue_onclick = function () {
    let rtn = ''
    let serverDateValue = WebSquare.date.getCurrentServerDate(&quot;yyyyMMdd&quot;);

    rtn = target1.getValue();

    if (rtn == serverDateValue)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is currentDateValue&quot;)
    else 
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is not currentDateValue : &quot; + rtn);           
}



scwin.btn_getDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {          
        let rtn = ''
        let serverDate = WebSquare.date.getCurrentServerDate(&quot;yyyy-MM-dd&quot;);

        rtn = element.textContent;

        if (rtn == serverDate)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is currentDate&quot;)
        else 
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is not currentDate : &quot; + rtn);             
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }

    scwin.btn_getValue_onclick();
};</script>
