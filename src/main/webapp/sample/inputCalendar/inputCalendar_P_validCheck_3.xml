    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        dateValidSet: con_dateValidSet.getText(),
        validCheck: con_validCheck.getText(),
    };

    let cList = $c.gcm.createCList(properties);    
    let eList = $c.gcm.createEList([&quot;onfocus&quot;])   

    $c.gcm.createLabel('label=&quot;value=20251301, 2025 는 유효하지 않은 값이고 20251225 는 유효한 값&quot;', '', 'label1');
    $c.gcm.createEmptyInputCalendar(cList, eList);
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = ''

    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 : &quot; + rtn);
}



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(par_value.getText());

    scwin.btn_getValue_onclick();
};



scwin.target1_onfocus = function(e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onfocus=====&quot;);
}
</script>
