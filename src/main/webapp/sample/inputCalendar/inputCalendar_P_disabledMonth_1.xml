		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; disabledMonth]&lt;br/&gt;날짜 선택을 제한하려는 연월을 'yyyyMM' 형식으로 한 개 이상 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;pikerType=dynamic 인 경우에 동작합니다.&quot;,
        &quot;팝업 달력에서 날짜 선택을 제한하려는 연월을 'yyyyMM' 형식으로 설정합니다.&quot;,
        &quot;연월이 두 개 이상이면 ' '(Space)를 구분자로 설정합니다.&quot;,
        &quot;형식이 다르거나 각 연월의 설정값이 6 자리가 아닌 경우 동작하지 않습니다.&quot;,
        &quot;팝업 달력의 상단 년/월 커스텀 버튼으로 표시되는 UI 에 disabledMonth 속성의 연월은 비활성화 처리됩니다.&quot;,
        &quot;'이전연월', '다음연월' 버튼도 disabledMonth 속성의 연월을 기준으로 비활성화 처리됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        disabledMonth : con_disabledMonth.getText(), 
        pickerType : &quot;dynamic&quot;,
    }
   
    let cList = $c.gcm.createCList(properties)
   
    $c.gcm.createLabel('label=&quot;disabledMonth 설정, 팝업 달력에서 제한 년월 클릭, 선택일 확인&quot;', '', 'label1');
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent);              
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};</script>
