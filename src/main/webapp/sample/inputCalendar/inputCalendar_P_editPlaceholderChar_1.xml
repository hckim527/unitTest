		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; editPlaceholderChar]&lt;br/&gt;displayFormat 속성에 설정된 마스크 문자 위치에 미리 표시될 문자를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;useEditFormat=true 인 경우에 동작합니다.&quot;,
        &quot;마스크 문자 위치에 표시할 문자를 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 왼쪽부터 마스크 문자와 입력값이 차례로 매칭됩니다.&quot;,
        &quot;editPlaceholderChar 속성을 설정하면 displayFormat 속성의 포맷을 미리 표시하고 입력 자리에 설정한 문자를 표시합니다.&quot;,
        &quot;표시된 입력 자리는 어느 자리에 먼저 설정하든 입력이 가능하지만, 입력값이 확정될때 입력되지 않는 자리는 모두 제거됩니다. 예를 들어 '_1_1_' 로 중간과 양쪽 자리를 비워둔채로 확정 시 '11' 이 최종값으로 처리됩니다.&quot;,
        &quot;붙여넣기 또는 setValue() 메소드로 입력값 설정 시 숫자가 아닌 문자는 입력되지 않고 빈값('_')으로 처리됩니다.&quot;,
        &quot;특정 위치에서 붙여넣기 하면 해당 위치부터 값이 입력됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        useEditFormat : true,
        editPlaceholderChar : con_editPlaceholderChar.getText(), 
        calendarValueType : con_calendarValueType.getText(),
        style : 'width:250px;',
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createEmptyInputCalendar(cList);
}



scwin.btn_getValue_onclick = function (e) {
    // id가 &quot;target1&quot;을 포함하는 요소를 찾기
    let targetEmement = document.querySelector('[id*=&quot;target1&quot;]');

    if (targetEmement) {
        let inputElement = null;

        // id가 &quot;target1_input&quot;을 포함하는 input 태그 찾기
        inputElement = targetEmement.querySelector('input[id*=&quot;target1_input&quot;]');

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('format : ' + inputElement.value);        
    }
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('getValue : ' + target1.getValue());
};



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(&quot;20ab01cd&quot;);
};
</script>
