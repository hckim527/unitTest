}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);    

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getDataMap_onclick = function (e) {
	let rtn = dm_ref.get(&quot;key1&quot;);
    let serverDate = WebSquare.date.getCurrentServerDate();

    if (rtn == serverDate)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is currentDate&quot;);
    else 
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;This is not currentDate&quot;);
};
</script>
