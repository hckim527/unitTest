		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; alt]&lt;br/&gt;웹접근성 향상을 위해 컴포넌트의 버튼 영역에 alt 속성을 추가합니다.&quot;,
    &quot;validation&quot; : [
        &quot;웹접근성 향상을 위한 alt 속성값을 텍스트로 설정합니다.&quot;,
        &quot;화면 렌더링 시 팝업 달력을 표시하는 버튼 영역 요소에 alt 속성으로 추가됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        alt : con_alt.getValue(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getAlt_onclick = function (e) {
    // id가 &quot;target1&quot;을 포함하는 요소를 찾기
    let targetEmement = document.querySelector('[id*=&quot;target1&quot;]');

    if (targetEmement) {
        let inputElement = null;
        let buttonElement = null;

        // id가 &quot;target1_img&quot;인 button 태그 찾기
        buttonElement = targetEmement.querySelector('button[id*=&quot;target1_img&quot;]');
                
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('button alt : ' + buttonElement.textContent);

    }
};</script>
