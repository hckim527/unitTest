		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; disableDateValidSet]&lt;br/&gt;선택을 제한한 날짜가 입력된 경우 이전 입력값으로 복원할지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;setDisableBeforeDate(), setDisableAfterDate(), setDisabledDate() 메소드로 제한한 날짜에 동작합니다.&quot;,
        &quot;미설정 시 컴포넌트에 입력된 날짜를 제한하지 않고 유지합니다.&quot;,
        &quot;true 설정 시 컴포넌트에 입력된 날짜가 제한된 날짜인 경우 컴포넌트가 포커스를 잃을때 이전 입력 날짜를 복원합니다.&quot;,
        &quot;이전 입력 날짜가 없는 경우 ''(Empty String)이 설정됩니다.&quot;,
        &quot;false 설정 시 컴포넌트에 입력된 날짜를 제한하지 않고 유지합니다.&quot;,
        &quot;사용자가 입력한 값에 대해 동작합니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        disableDateValidSet : con_disableDateValidSet.getText(),
    }

    let cList = $c.gcm.createCList(properties);
    
    $c.gcm.createBasicInputCalendar(cList); 
}



scwin.btn_getValue_onclick = function (e) {
	let rtn = ''
    
    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 : &quot; + rtn);
};



scwin.btn_setDisableBeforeDate_onclick = function (e) {
	target1.setDisableBeforeDate(&quot;20251111&quot;);
};



scwin.btn_setDisableAfterDate_onclick = function (e) {
	target1.setDisableAfterDate(&quot;20251116&quot;);
};



scwin.btn_setDisableDate_onclick = function (e) {
	target1.setDisableDate(&quot;20261101&quot;);
};
</script>
