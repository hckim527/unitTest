		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; skipConfirmOnly]&lt;br/&gt;팝업 달력에서 상단의 월을 선택하거나 '확인' 버튼 클릭 시 선택된 년/월이 컴포넌트에 반영되도록 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;pickerType=selectbox 이고 calendarValueType=yearMonth 인 경우에 동작합니다.&quot;,
        &quot;미설정 시 팝업 달력의 '확인' 버튼을 클릭하면 선택된 년/월이 컴포넌트에 반영됩니다.&quot;,
        &quot;true 설정 시 팝업 달력에서 상단의 월 영역 SelectBox 를 선택 시 선택된 년/월이 컴포넌트에 반영됩니다.&quot;,
        &quot;true 설정 시 년/월을 탐색 후 팝업 달력의 '확인' 버튼을 클릭하면 선택된 년/월이 컴포넌트에 반영됩니다.&quot;,
        &quot;false 설정 시 팝업 달력의 '확인' 버튼을 클릭하면 선택된 년/월이 컴포넌트에 반영됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        pickerType : &quot;selectbox&quot;,
        calendarValueType : &quot;yearMonth&quot;,        
        skipConfirmOnly : con_skipConfirmOnly.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)    
    
    // comp 생성 함수 호출    
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.isConfirmButton = function () {
    let confirmElement = document.querySelector('div[title*=&quot;확인&quot;]');

    if (confirmElement) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('확인 버튼 표시');
    }
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('확인 버튼 미표시');
    }
}




scwin.btn_getValue_onclick = function (e) {
	let rtn = ''

    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('입력일 : ' + rtn);

    scwin.isConfirmButton();
};
</script>
