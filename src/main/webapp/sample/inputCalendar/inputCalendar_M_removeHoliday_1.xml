scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; removeHoliday]&lt;br/&gt;setHoliday() 메소드로 설정된 휴일 정보를 모두 제거합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;setHoliday() 메소드로 설정된 휴일 정보를 모두 제거합니다.&quot;,
        &quot;setHolidayRef() 메소드로 설정된 휴일 정보는 제거되지 않습니다.&quot;,
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(eList);
}



scwin.btn_getHoliday_onclick = function (e) {
    setTimeout(() =&gt; {
        let targetElement = document.querySelector('div[id*=&quot;target1_calendar&quot;]');
        let arrHolidays = [];

        if (targetElement) {            
            let holidays = targetElement.querySelectorAll('td[class*=&quot;w2calendar_holiday&quot;]')

            for (var i=0; i &lt; holidays.length; i++) {
                arrHolidays.push(holidays[i].textContent);
            }
        }
        else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 달력을 한번 오픈해야 정보 가져올 수 있음&quot;);
        }    

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('휴일 : ' + arrHolidays);

    }, 100);
}



scwin.btn_setHoliday_onclick = function (e) {
	target1.setHoliday(par_date.getText(), par_deleted.getText());
};



scwin.target1_onclick = function (e) {
    scwin.btn_getHoliday_onclick();
}



scwin.btn_removeHoliday_onclick = function (e) {
	target1.removeHoliday();
};
</script>
