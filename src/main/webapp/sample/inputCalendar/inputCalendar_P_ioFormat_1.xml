		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; ioFormat]&lt;br/&gt;컴포넌트의 날짜 편집 영역이 편집 상태일때 입력값에 적용될 포맷을 마스크 문자로 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;날짜 편집 영역이 편집 상태일때 적용될 포맷을 'y', 'M', 'd', 'H', 'm', 'S' 마스크 문자로 설정합니다.&quot;,
        &quot;'yyyy' 마스크는 년도와 매칭되며 네자리로 설정합니다.&quot;,
        &quot;'MM' 마스크는 월과 매칭되며 두자리로 설정합니다.&quot;,
        &quot;'dd' 마스크는 일과 매칭되며 두자리로 설정합니다.&quot;,        
        &quot;'HH' 마스크는 시와 매칭되며 두자리로 설정합니다.&quot;,
        &quot;'mm' 마스크는 분과 매칭되며 두자리로 설정합니다.&quot;,
        &quot;'SS' 마스크는 마스크는 초와 매칭되며 두자리로 설정합니다.&quot;,
        &quot;마스크 문자가 아닌 일반문자는 설정할 수 없습니다.&quot;,
        &quot;값을 설정하지 않으면 calendarValueType 속성의 포맷에 맞게 'yyyyMMddHHmmSS' 을 잘라서 적용합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        ioFormat : con_ioFormat.getText(),      
        calendarValueType : con_calendarValueType.getText(),
        style : 'width:300px',        
    }
   
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onblur&quot;]);
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;ioFormat 설정 - 20251111030519 입력 - 포커스 아웃하여 값 확인&quot;', '', 'label1');
    $c.gcm.createEmptyInputCalendar(cList, eList);
}



scwin.target1_onblur = function (e) {
    let inputElement = document.querySelector('input[id*=&quot;target1_input&quot;]');

    if (inputElement)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('편집 상태 입력값 : ' + target1.getValue());         
}



scwin.con_ioFormat_onchange = function (info) {
    let ioFormatValue = con_ioFormat.getValue();

    con_calendarValueType.setValue(ioFormatValue);
};
</script>
