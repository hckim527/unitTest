		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; displayFormatFunc]&lt;br/&gt;컴포넌트의 포커스가 해제된 상태일때 표시되는 입력값에 적용할 포맷을 반환하는 사용자 정의 함수를 설정합니다. &quot;,
    &quot;validation&quot; : [        
        &quot;displayFormat 속성이 설정되면 displayFormatFunc 속성은 무시됩니다.&quot;,     
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        displayFormat : con_displayFormat.getText(),
        displayFormatFunc : &quot;scwin.fn_displayFormatFunc&quot;,        
        style : 'width:300px',
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;displayFormatFunc 에 의해 yyyy-MM-dd 포맷 적용상태&quot;', '', 'label1');
    $c.gcm.createEmptyInputCalendar(cList);
}



// 사용자 정의 함수
scwin.fn_displayFormatFunc = function(valueType) {   
    let dp_format = &quot;yyyy-MM-dd&quot;;

    return dp_format;
}



scwin.btn_setValue_onclick = function () {
    target1.setValue(&quot;20251111130519&quot;);

    scwin.btn_getDisplayValue_onclick();
}



scwin.btn_getDisplayValue_onclick = function (e) {
	let rtn = ''

    rtn = target1.getDisplayValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('입력값 : ' + rtn); 
};
</script>
