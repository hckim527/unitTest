		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; setDisabledDate]&lt;br/&gt;선택을 제한하려는 날짜를 ioFormat 속성의 포맷으로 한 개 이상 추가합니다.&quot;,
    &quot;validation&quot; : [
        &quot;pikerType 속성값에 관계없이 동작합니다.&quot;,
        &quot;date(필수) 파라미터로 팝업 달력에서 선택을 제한하려는 날짜를 ioFormat 속성의 포맷에 맞게 설정합니다.&quot;,
        &quot;추가할 날짜가 두 개 이상이면 ' '(Space)를 구분자로 설정합니다.&quot;,
        &quot;포맷이 다르거나 8 자리 날짜가 아닌 경우 추가되지 않습니다.&quot;,
        &quot;전체 날짜의 선택을 제한하려면 '*' 를 설정합니다. (단, setEnableDate() 메소드로 추가한 날짜는 제외됩니다.)&quot;,
        &quot;설정된 날짜는 팝업 달력에서 선택할 수 없습니다.&quot;,
        &quot;팝업 달력에서는 설정된 제한 날짜에 취소선이 표시되며 해당 날짜는 선택할 수 없습니다.&quot;,
        &quot;팝업 달력에서 년/월 탐색은 제한하지 않습니다.&quot;,
        &quot;동일 날짜 또는 '*' 값을 setEnabledDate() 메소드와 setDisabledDate() 메소드로 각 실행 시 나중에 실행된 메소드의 결과만 남습니다.&quot;,
        &quot;setDisabledDate() 로 설정된 날짜는 setEnabledDate() 메소드로 제거됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        pickerType : con_pickerType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    $c.gcm.createLabel('label=&quot;setDisabledDate 메소드 실행, 팝업 달력에서 제한된 날짜 선택, 선택일 확인&quot;', '', 'label1');
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');
    let disabledDates = [];

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent);           

        // 모든 td 태그를 가져온 후, 필터링하여 원하는 클래스를 가진 태그를 선택합니다.
        const disabledTds = Array.from(document.querySelectorAll('td')).filter(td =&gt; 
            td.classList.contains('w2calendar_date_disable')
        );       

        // 각 td 요소의 textContent를 배열에 넣습니다.
        disabledTds.forEach(td =&gt; {
            disabledDates.push(td.textContent);
        });   
        
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;취소선 적용일 : &quot; + disabledDates);        
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};



scwin.btn_setDisabledDate_onclick = function (e) {
    target1.setIoFormat(par_ioFormat.getText());
	target1.setDisabledDate(par_date.getText());
};


scwin.btn_setEnabledDate_onclick = function (e) {
    target1.setIoFormat(par_ioFormat.getText());
	target1.setEnabledDate(par_date.getText());	
};
</script>
