    &quot;validation&quot; : [
        &quot;pickerType 속성값과 관계없이 연도에 해당하는 SelectBox 와 커스텀 UI 에 모두 적용됩니다.&quot;,
        &quot;팝업 달력의 연도 영역에 표시되는 최대 연도를 'yyyy' 형식으로 설정합니다.&quot;,
        &quot;pickerType=selectbox 일때 연도 SelectBox 의 마지막 연도엔 '9999년'이 항상 표시됩니다.&quot;
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        maxYear : con_maxYear.getText(),
        pickerType : con_pickerType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}</script>
