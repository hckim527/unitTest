		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; delimiter]&lt;br/&gt;컴포넌트의 날짜 편집 영역과 팝업 달력의 우측 하단 선택일의 연/월/일을 구분하는 구분자를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;calendarDisplayFormat 또는 calendarDisplayFormatFunc 속성 설정 시 팝업 달력의 선택일에 delimiter 가 적용되지 않습니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        delimiter : con_delimiter.getText(),
        calendarDisplayFormat : con_calendarDisplayFormat.getText(),
        calendarDisplayFormatFunc : con_calendarDisplayFormatFunc.getText(),     
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;calendarDiplayFormat=yyyy-MM-dd, calendarDisplayFormatFunc=dd-MM-yyyy&quot;', '', 'label1');
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getDisplayValue_onclick = function (e) {
	let rtn = ''

    rtn = target1.getDisplayValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력일 : &quot; + rtn)	

    scwin.btn_getSelectedDate_onclick();
};



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent);              
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }	
};



scwin.fn_calendarDisplayFormatFunc = function (valueType) {
    return &quot;dd-MM-yyyy&quot;;
}</script>
