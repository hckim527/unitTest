		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; disableValidate]&lt;br/&gt;파라미터에 설정된 날짜가 InputCalendar 컴포넌트에서 선택이 제한된 날짜인지 확인합니다.&quot;,
    &quot;validation&quot; : [
        &quot;setDisabledDate() 메소드로 제한된 날짜에 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar();

    scwin.btn_setDisabledDate_onclick();   
}



scwin.btn_setDisabledDate_onclick = function (e) {    
	target1.setDisabledDate(&quot;20251101&quot;);
};



scwin.btn_disableValidate_onclick = function (e) {
    let rtn = '';

    rtn = target1.disableValidate(par_date.getText());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;return : &quot; + rtn);
};
</script>
