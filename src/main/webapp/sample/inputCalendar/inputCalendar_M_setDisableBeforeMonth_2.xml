    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        pickerType : &quot;dynamic&quot;,
    }
   
    let cList = $c.gcm.createCList(properties)
   
    $c.gcm.createLabel('label=&quot;setDisableBeforeMonth 메소드 실행, 날짜 편집 영역에 제한된 날짜 입력, 입력값 확인&quot;', '', 'label1');
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getValue_onclick = function (e) {
	let rtn = ''
    
    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 : &quot; + rtn);
};



scwin.btn_setDisableBeforeMonth_onclick = function (e) {
	target1.setDisableBeforeMonth(par_month.getText());
};

