		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; defaultDate]&lt;br/&gt;컴포넌트에 입력값이 없을때 팝업 달력에 설정될 날짜와 시간을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트에 입력값이 없을때 팝업 달력에 선택일로 설정될 날짜와 시간을 설정합니다.&quot;,
        &quot;'yyyyMMddHHmmSS' 포맷으로 설정하며 calendarValueType 속성값에 따라 4,6,8,10,12,14 자리로 설정해야 합니다.&quot;,
        &quot;컴포넌트에 입력값이 있는 경우 해당 날짜와 시간으로 팝업 달력의 선택일이 설정됩니다.&quot;,
        &quot;defaultDate 속성값의 자릿수와 calendarValueType 속성의 자릿수가 맞지 않으면 동작하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        defaultDate : con_defaultDate.getText(), 
        calendarValueType : con_calendarValueType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    $c.gcm.createLabel('label=&quot;defaultDate 설정 후 팝업 달력에 설정된 날짜 그대로 선택 후 날짜 확인&quot;', '', 'label1');
    // comp 생성 함수 호출
    $c.gcm.createEmptyInputCalendar(cList);
}



scwin.btn_getValue_onclick = function (e) {
	let rtn = ''

    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn)
};



scwin.con_defaultDate_onchange = function (info) {
	con_calendarValueType.setValue(con_defaultDate.getValue());
};



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(&quot;20250101&quot;);
};
</script>
