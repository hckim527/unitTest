		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; setSkin]&lt;br/&gt;컴포넌트의 calendarClass 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;displayDayType=image 일때 claendarClass 속성이 동작합니다.&quot;,
        &quot;skin(필수) 파라미터로 팝업 달력의 요일에 적용될 백그라운드 이미지를 설정합니다.&quot;,
        &quot;미설정 시 팝업 달력의 요일이 세자리 영단어 대문자('SUN','MON')로 표시됩니다.&quot;,
        &quot;class1 설정 시 팝업 달력의 요일이 세자리 영단어 대문자('SUN','MON')로 표시됩니다.&quot;,
        &quot;class2 설정 시 팝업 달력의 요일이 한자리 한글('일','월')로 표시됩니다.&quot;,
        &quot;class3 설정 시 팝업 달력의 요일이 두자리 영단어('Su','Mo')가 볼드체로 표시됩니다.&quot;,
        &quot;class4 설정 시 팝업 달력의 요일이 두자리 영단어('Su','Mo')로 표시됩니다.&quot;,
        &quot;class5 설정 시 팝업 달력의 요일이 한자리 한글('일','월') 이미지로 표시됩니다.&quot;,
        &quot;displayDayType=text 이면 팝업 달력의 요일이 한자리 한글('일','월') 텍스트로 표시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        displayDayType : con_displayDayType.getText(),        
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getCalendarClass_onclick = function (e) {
    // class 속성값에 &quot;w2calendar_day&quot;를 포함하는 모든 div 요소 찾기
    const elements = document.querySelectorAll('div[class*=&quot;w2calendar_day&quot;]');

    // 요소가 존재하면 true, 존재하지 않으면 false 반환
    if (elements.length &gt; 0) {        

        elements.forEach((element) =&gt; {
            if (target1.options.displayDayType == &quot;image&quot;) {
                // 각 요소의 배경 스타일 가져오기
                const computedStyle = getComputedStyle(element);
                const backgroundImage = computedStyle.backgroundImage;

                // &quot;url(...)&quot; 문자열에서 파일명을 추출
                const urlMatch = backgroundImage.match(/url\([&quot;']?([^&quot;']*)[&quot;']?\)/);

                if (urlMatch &amp;&amp; urlMatch[1]) {
                    // 파일명만 저장
                    const imageFileName = urlMatch[1].split('/').pop(); // 경로에서 파일명만 추출

                    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;backgroundImageFile : &quot; + imageFileName)
                }
            }
            else {
                 wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + element.textContent)
            }
        });
    } else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');
    }
};



scwin.btn_setSkin_onclick = function (e) {
	target1.setSkin(par_skin.getText());
};
</script>
