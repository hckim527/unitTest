		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; getIoFormat]&lt;br/&gt;컴포넌트의 ioFormat 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;컴포넌트의 ioFormat 속성값을 반환합니다.&quot;,
        &quot;ioFormat 속성을 설정하지 않은 경우 calendarValueType 속성값에 맞게 적용된 기본값이 반환됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {         
        editType : &quot;select&quot;,       
        style : 'width:300px',        
    }
   
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onblur&quot;]);
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;setIoFormat 메소드 실행 - 20251111030519 입력 - 포커스 아웃하여 값 확인&quot;', '', 'label1');
    $c.gcm.createEmptyInputCalendar(cList, eList);
}



scwin.target1_onblur = function (e) {
    let inputElement = document.querySelector('input[id*=&quot;target1_input&quot;]');

    if (inputElement)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('편집 상태 값 : ' + target1.getValue());        

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('디스플레이 상태 값 : ' + target1.getDisplayValue());        
}



scwin.par_ioFormat_onchange = function (info) {
    let ioFormatValue = par_ioFormat.getValue();

    par_calendarValueType.setValue(ioFormatValue);
};



scwin.btn_setIoFormat_onclick = function (e) {
    target1.setCalendarValueType(par_calendarValueType.getText());

    let ioFormat = par_ioFormat.getText();
    let displayFormat = par_displayFormat.getText();

    if (displayFormat == &quot;&quot;)
	    target1.setIoFormat(ioFormat);

    else
        target1.setIoFormat(ioFormat, displayFormat);
};



scwin.btn_getIoFormat_onclick = function (e) {
    let rtn = ''

    rtn = target1.getIoFormat();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('getIoFormat : ' + rtn);   	
};
</script>
