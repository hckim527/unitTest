		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; cancelButtonShow]&lt;br/&gt;calendarValueType=yearMonthDate 일때 팝업 달력의 하단에 취소 버튼을 표시할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;calendarValueType=yearMonthDate 가 아닌 경우 취소 버튼이 항상 표시됩니다.&quot;,
        &quot;미설정 시 calendarValueType=yearMonthDate 일때 팝업 달력의 하단에 취소 버튼을 표시하지 않습니다.&quot;,
        &quot;true 설정 시 calendarValueType=yearMonthDate 일때 팝업 달력의 하단에 취소 버튼을 표시합니다.&quot;,
        &quot;false 설정 시 calendarValueType=yearMonthDate 일때 팝업 달력의 하단에 취소 버튼을 표시하지 않습니다.&quot;,
        &quot;취소 버튼 클릭 시 팝업 달력에 선택 및 입력된 값을 취소하고 팝업 달력을 닫습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        cancelButtonShow : con_cancelButtonShow.getText(),
        calendarValueType : con_calendarValueType.getText(),
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    $c.gcm.createLabel('label=&quot;cancelButtonShow 설정 후 버튼 영역 클릭하여 확인&quot;', '', 'label1');
    $c.gcm.createBasicInputCalendar(cList, eList); 
}



scwin.target1_onclick = function (e) {
    setTimeout(() =&gt; {
        let targetElement = document.querySelector('div[id*=&quot;target1_calendar&quot;]');

        if (targetElement) {
            let buttons = document.querySelectorAll('div[title=&quot;닫기&quot;], div[title=&quot;취소&quot;]');

            if (buttons.length != 0) {    
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;cancelButton : 표시&quot;)
            }	
            else {
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('cancelButton : 미표시');        
            }	
        }
        else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 달력을 한번 오픈해야 정보 가져올 수 있음&quot;);
        }
    }, 100);    
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = ''

    rtn = target1.getValue();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn);
};
</script>
