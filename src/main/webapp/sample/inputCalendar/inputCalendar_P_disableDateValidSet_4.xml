		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; disableDateValidSet]&lt;br/&gt;선택을 제한한 날짜가 입력된 경우 이전 입력값으로 복원할지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;calendarValueType=year,yearMonth 인 경우 항상 false 로 동작합니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        disableDateValidSet : con_disableDateValidSet.getText(),
        calendarValueType : con_calendarValueType.getText(),
    }

    let cList = $c.gcm.createCList(properties);
    
    $c.gcm.createBasicInputCalendar(cList); 
}



scwin.btn_getValue_onclick = function (e) {
	let rtn = ''
    
    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 : &quot; + rtn);
};



scwin.btn_setDisabledDate_onclick = function (e) {
	target1.setDisabledDate(&quot;20261101&quot;);
};</script>
	</head>
