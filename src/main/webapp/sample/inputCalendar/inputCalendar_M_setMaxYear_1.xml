		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; M &gt; setMaxYear]&lt;br/&gt;컴포넌트의 maxYear 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;maxYear(필수) 파라미터로 팝업 달력 상단의 연도 영역에 표시되는 최대 연도를 'yyyy' 형식으로 설정합니다.&quot;,
        &quot;pickerType 속성값과 관계없이 연도에 해당하는 SelectBox 와 커스텀 UI 에 모두 적용됩니다.&quot;,
        &quot;pickerType=selectbox 일때 연도 SelectBox 의 마지막 연도엔 '9999년'이 항상 표시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        pickerType : con_pickerType.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getHeadYear_onclick = function (e) {
    let element = null;

    if (target1.options.pickerType == &quot;dynamic&quot;) {
        element = document.querySelector('div[class*=&quot;w2calendar_picker_header&quot;]');

        if(element)
            element = document.querySelector('div[class*=&quot;w2calendar_picker_header_dynamic_entity&quot;]');
    }
    else {
        element = document.querySelector('div[class*=&quot;w2calendar_header&quot;]');
    }    

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;년월 : &quot; + element.textContent);              
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};



scwin.btn_setMaxYear_onclick = function (e) {
	target1.setMaxYear(par_maxYear.getText());
};</script>
