		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; visibleHourList]&lt;br/&gt;팝업 달력 하단에 표시되는 시간 영역 SelectBox 의 아이템을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;calendarValueType=yearMonthDateHour,yearMonthDateTime,yearMonthDateTimeSec 인 경우에 동작합니다.&quot;,
        &quot;팝업 달력의 시간 영역 SelectBox 의 아이템을 &quot;,&quot; 문자로 구분하여 설정합니다.&quot;,
        &quot;',' 로 구분한 갯수에 관계없이 설정값은 모두 시간 영역 SelectBox 의 아이템으로 설정됩니다.&quot;,
        &quot;값을 설정하지 않으면 '0,1,...,22,23' 의 24개 값이 아이템으로 설정됩니다.&quot;,  
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        calendarValueType : con_calendarValueType.getText(),
        visibleHourList : con_visibleHourList.getText(),               
    }
   
    let cList = $c.gcm.createCList(properties)
       
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getHourList_onclick = function (e) {
    let targetElement = document.querySelector('div[id*=&quot;target1_calendar_selectbox_hour_itemTable&quot;]');

    if (targetElement) {            
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('HourList : ' + targetElement.textContent);
    }
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;팝업 달력의 시간 영역 아이템 리스트를 한번 오픈해야 정보 가져올 수 있음&quot;);
    }
};</script>
