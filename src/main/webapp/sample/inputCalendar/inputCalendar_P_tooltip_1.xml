		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[inputCalendar > P > tooltip]<br/>컴포넌트 영역으로 마우스가 들어왔을 때 표시할 툴팁을 설정합니다.",
    "validation" : [        
        "툴팁에 표시할 텍스트를 문자열로 설정할 수 있어야 합니다.",
        "값을 설정하지 않으면 툴팁을 표시하지 않아야 합니다.",
        "tooltip 속성을 설정하지 않으면 tooltipLocaleRef 속성은 모두 무시되어야 합니다.",
        "tooltipFormatter 속성을 설정하면 사용자 함수에 tooltip 속성값이 전달되고 함수의 반환값이 툴팁에 표시되어야 합니다.",
        "tooltip, useLocale, tooltipLocalRef 속성을 모두 설정하여 클라이언트 다국어가 적용되면 tooltip 속성값은 무시되어야 합니다.",
        "tooltip, useLocale, tooltipLocalRef 속성을 모두 설정하여 클라이언트 다국어가 적용된 상태에서 tooltipFormatter 속성을 설정하면 사용자 함수에 tooltipLocalRef 의 Value 값이 전달되고 함수의 반환값이 툴팁에 표시되어야 합니다.",                  
    ]
} 



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        tooltip: con_tooltip.getValue(),        
        tooltipLocaleRef: con_tooltipLocaleRef.getText(),
        useLocale: con_useLocale.getText(),
    };

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicInputCalendar(cList, 'ev:onclick="scwin.target1_onclick"');
}



scwin.fn_tooltip = function (id, text) {
    return "id - " + id + ", tooltip - " + text;   
}



scwin.target1_onclick = function (e) { 
    // tooltip 확인
    // if(target1.render.ariaDescribedByElements) {
    //     wf_body_bottom.getObj("scwin").setReturnValue("tooltip : " + target1.render.ariaDescribedByElements[0].textContent);
    // } 

    let objTooltip = document.querySelector('.w2balloonTip_label');    

    // tooltip 확인
    if (objTooltip) {
        wf_body_bottom.getObj("scwin").setReturnValue("tooltip : " + objTooltip.textContent);
    }       
}]]></script>
