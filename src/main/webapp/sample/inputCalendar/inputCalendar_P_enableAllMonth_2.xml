		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; enableAllMonth]&lt;br/&gt;컴포넌트의 disableAfterMonth, disableBeforeMonth 속성값을 제거합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트의 disableBeforeMonth 속성값을 제거합니다.&quot;,
        &quot;disableBeforeMonth 속성값이 제거되면 해당 속성으로 제한되던 팝업 달력의 날짜 선택이 가능해 집니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        disableBeforeMonth : con_disableBeforeMonth.getText(), 
        pickerType : &quot;dynamic&quot;,
    }
   
    let cList = $c.gcm.createCList(properties)
   
    $c.gcm.createLabel('label=&quot;disableBeforeMonth 설정, enableAllMonth 메소드 실행, 팝업 달력에서 이전월 버튼 클릭, 선택일 확인&quot;', '', 'label1');
    // comp 생성 함수 호출
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_getSelectedDate_onclick = function (e) {
    const element = document.querySelector('div[id*=&quot;calendar_currentDate&quot;]');

    if (element) {    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택일 : &quot; + element.textContent);              
    }	
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('팝업 달력을 한번 오픈해야 정보 가져올 수 있음');        
    }
};



scwin.btn_enableAllMonth_onclick = function (e) {
	target1.enableAllMonth();
};
</script>
