		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[inputCalendar &gt; P &gt; dateValidCheck]&lt;br/&gt;컴포넌트의 입력값에 대한 날짜와 시간의 유효성 체크를 활성화합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;validate() 메소드 실행 시 false 가 리턴되고, 실패 메시지는 출력되지 않습니다.&quot;,
        &quot;validateObject() 메소드에는 dateValidCheck 속성이 적용되지 않습니다.&quot;,
        &quot;invalidMessageFunc 속성의 사용자 정의 함수가 항상 실행됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        dateValidCheck: con_dateValidCheck.getText(),        
        invalidMessageFunc : &quot;scwin.fn_invalidMessageFunc&quot;
    };

    let cList = $c.gcm.createCList(properties);       

    $c.gcm.createLabel('label=&quot;value=20251301, 2025 는 유효하지 않은 값이고 20251225 는 유효한 값&quot;', '', 'label1');
    $c.gcm.createBasicInputCalendar(cList);
}



scwin.btn_validate_onclick = function (e) {
    let rtn = target1.validate();

    if (rtn) 
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : PASS&quot;);
    else
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : FAIL&quot;);
}



scwin.btn_validateObject_onclick = function (e) {
    let rtnObj  = target1.validateObject();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validateObject : &quot;+ rtnObj);

    if (rtnObj) {
        let callerId = rtnObj.callerId
        let type = rtnObj.type
        let value = rtnObj.value

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;callerId : &quot;+ callerId);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;type : &quot;+ type);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;value : &quot;+ value);
    }	
};



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(par_value.getText());
    scwin.btn_validate_onclick();
    scwin.btn_validateObject_onclick();
};



scwin.fn_invalidMessageFunc = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;사용자 정의 함수 실행&quot;);
}
</script>
