		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[datePicker > M > getDataListInfo]<br/>DatePicker 컴포넌트에 바인딩된 DataCollection 정보를 반환합니다.",
    "validation" : [
        "DatePicker 컴포넌트에 바인딩된 DataCollection 정보를 반환합니다.",
        "Object 타입으로 바인딩 된 DataCollection 의 정보를 객체로 반환합니다.",
        "DataCollection 과 바인딩되어 있지 않은 경우 null 을 반환합니다.",
        "result.id 에 바인딩된 DataCollection 컴포넌트의 ID 를 갖습니다.",
        "result.ref 에 현재 ref 속성값을 갖습니다."
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        ref : con_ref.getText()
    }

    let cList = $c.gcm.createCList(properties);

    // comp 생성 함수 호출
    let grp_comp = $c.gcm.getTestGroup();
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '<w2:datePicker ' + strNameSpace + ' ' + cList + ' style="width:300px; height:200px; position:relative;"></w2:datePicker>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "datePicker",
        strTarget,
        grp_comp
    );

    // dataList 바인딩 케이스: 행 선택해야 datePicker 에 값 바인딩됨 → 첫번째 행 자동 선택
    if (properties.ref && properties.ref.indexOf('dlt_ref') !== -1) {
        dlt_ref.setRowPosition(0);
    }
}



scwin.btn_getDataListInfo_onclick = function (e) {
    let rtn = target1.getDataListInfo();
    wf_body_bottom.getObj("scwin").setReturnValue("getDataListInfo : " + JSON.stringify(rtn));
    if (rtn === null) {
        return;
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("getDataListInfo.id : " + rtn.id);
        wf_body_bottom.getObj("scwin").setReturnValue("getDataListInfo.ref : " + rtn.ref);
    }
};
]]></script>
