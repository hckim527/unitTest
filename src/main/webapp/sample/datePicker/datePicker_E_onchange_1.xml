		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[datePicker > E > onchange]<br/>DatePicker 컴포넌트의 선택 날짜가 변경되면 발생합니다.",
    "validation" : [
        "DatePicker 컴포넌트의 선택 날짜가 변경되면 onchange 이벤트가 발생합니다.",
        "사용자의 스핀 조작과 스크립트(setValue())에 의한 값 변경 모두에서 발생합니다.",
        "사용자 조작에 의한 값 변경 시 'onviewchange -> onchange' 순서로 이벤트가 발생합니다."
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 라벨: 수동 테스트 안내 (사용자 스핀 조작 → onviewchange -> onchange 순서 검증)
    $c.gcm.createLabel('label="[수동 테스트 안내] DatePicker 의 스핀(휠) 영역을 조작하여 날짜를 변경하면 onviewchange - onchange 순서로 이벤트가 발생합니다."', '', 'label1');

    let calendarValueType = con_calendarValueType.getText();

    let properties = {
        calendarValueType : calendarValueType
    };

    let cList = $c.gcm.createCList(properties);

    // onchange / onviewchange 핸들러 모두 등록 - 공통 모듈 사용
    let eList = $c.gcm.createEList(["onchange", "onviewchange"]);

    await $c.gcm.createBasicDatePicker(cList, eList);
};



// 스크립트(setValue) 호출에 의한 onchange 발생 검증
scwin.btn_setValue_onclick = function (e) {
    let inputValue = par_value.getText();
    wf_body_bottom.getObj("scwin").setReturnValue("[setValue 호출] '" + inputValue + "'");
    target1.setValue(inputValue);
};



// 선택 날짜가 변경되면 발생
scwin.target1_onchange = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("[onchange 발생]");    
};



// 사용자의 스핀 조작에 의해 선택값이 변경된 경우 발생 (onviewchange -> onchange 순서 확인용)
scwin.target1_onviewchange = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("[onviewchange 발생]");
};]]></script>
