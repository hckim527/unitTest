		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; M &gt; setNodeSet]&lt;br/&gt;아이템이 BindItemSet 또는 ItemSet 으로 정의되었을때 아이템과 DataCollection 을 새롭게 바인딩합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;enableColumn, visibleColumn 등 컴포넌트의 다른 속성값을 그대로 유지되며 동일하게 적용됩니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // target 생성    
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '&lt;xf:checkcombobox ' + strNameSpace + ' enableColumn=&quot;enable_col&quot; style=&quot;width:200px; height:30px;&quot;&gt;';
    strTarget += '&lt;xf:choices&gt;';
    strTarget += '&lt;xf:itemset nodeset=&quot;data:dlt_enable_nodeset1&quot;&gt;';
    strTarget += '&lt;xf:label ref=&quot;label_col&quot;&gt;&lt;/xf:label&gt;';
    strTarget += '&lt;xf:value ref=&quot;value_col&quot;&gt;&lt;/xf:value&gt;';
    strTarget += '&lt;/xf:itemset&gt;';
    strTarget += '&lt;/xf:choices&gt;';
    strTarget += '&lt;/xf:checkcombobox&gt;';

    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;checkcombobox&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_setNodeSet_onclick = function (e) {
	target1.setNodeSet(&quot;data:dlt_nodeset1&quot;, &quot;label&quot;, &quot;value&quot;);
};



scwin.btn_getDisabled_onclick = function (e) {
    let comp = &quot;target1_itemTable_main&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);	

    let trs = targetElements[0].querySelectorAll('tr.w2table_ccb_row');
    
    // 각 input 요소의 disabled 속성 존재 여부 확인
    trs.forEach((tr, index) =&gt; {
        if (tr.hasAttribute('data-wqdisabled')) {            
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(comp + &quot; 의 index=&quot; + index + &quot; 은 비활성화&quot;);	
        } else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(comp + &quot; 의 index=&quot; + index + &quot; 은 활성화&quot;);	
        }
    });	
};</script>
