<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; title]&lt;br/&gt;컴포넌트에 대한 추가 정보를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;추가 정보를 텍스트로 설정합니다.&quot;,
        &quot;최상위 div 태그에 title 속성이 설정됩니다.&quot;,
        &quot;컴포넌트에 마우스 오버 시 설정된 문자열이 브라우저 기본 툴팁으로 표시되어야 합니다.&quot;,
        &quot;title 속성에 설정된 값은 컴포넌트에 표시되지 않습니다.&quot;,   
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getTitle_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.render.title  
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;title : &quot; + rtn);  
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.getText();
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);    
};</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<xf:checkcombobox id="target1" chooseOption="" displayMode="label" style="width: 148px;height: 21px;"
                    		submenuSize="auto" allOption="" disabled="false" direction="auto" title="title" ref="">
                    		<xf:choices>
                    			<xf:itemset nodeset="data:gdl_checkcombobox">
                    				<xf:label ref="label"></xf:label>
                    				<xf:value ref="value"></xf:value>
                    			</xf:itemset>
                    		</xf:choices>
                    	</xf:checkcombobox>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" id="btn_getTitle" label="getTitle" style=""
							ev:onclick="scwin.btn_getTitle_onclick">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText_onclick" id="btn_getText" label="text 확인" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>