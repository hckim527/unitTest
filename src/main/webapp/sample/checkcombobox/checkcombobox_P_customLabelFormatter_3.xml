						<w2:row>
							<label><![CDATA[dataList_item1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<value><![CDATA[2]]></value>
							<label><![CDATA[dataList_item2]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_Item" repeatNode="map" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="label" name="name1"></w2:column>
						<w2:column dataType="text" id="value" name="name2"></w2:column>
