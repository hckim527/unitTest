		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; customLabelFormatter]&lt;br/&gt;선택된 아이템들의 라벨 표시값을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트에서 아이템 리스트창이 표시되거나 사라질때마다 사용자 정의 함수가 실행됩니다.&quot;,
        &quot;ref 속성으로 바인딩 된 경우 GridView 에서 데이터 선택을 변경시 사용자 정의 함수가 실행됩니다.&quot;,        
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);    

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.fn_customlabelformatter = function(selectData, isOpen) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;사용자 정의 함수 실행됨&quot;);
    
    let data = [];
    for(var i=0;i &lt; selectData.length;i++){
        data.push(selectData[i].label);
    }

    data.push(&quot; isOpen : &quot;+isOpen);    

    return data;
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);    
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="background-color:silver;" id="" label="gridView 클릭하여 아이템 선택 변경 시 사용자 정의 함수 호출되면 정상"></w2:textbox>
						<xf:checkcombobox submenuSize="auto" ref="data:dlt_ref.value" customLabelFormatter="scwin.fn_customlabelformatter"
							chooseOption="" style="width: 148px;height: 21px;" disabled="false" id="target1" allOption="" displayMode="label" direction="auto">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_Item">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:checkcombobox>
						<w2:gridView checkAllType="false" dataList="data:dlt_ref" id="gridView1" style="width:282px;height:234px;">
							<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
							<w2:header id="header1" style="">
								<w2:row id="row1" style="">
									<w2:column displayMode="label" id="column9" inputType="text" style="" value="value" width="70"></w2:column>
									<w2:column displayMode="label" id="column10" inputType="text" style="" value="label" width="205"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1" style="">
								<w2:row id="row2" style="">
									<w2:column displayMode="label" id="value" inputType="text" style="" value="" width="70"></w2:column>
									<w2:column displayMode="label" id="label" inputType="text" style="" value="" width="205"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
                        <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText_onclick" id="btn_getText" label="text 확인" style=""></w2:button>
                    </xf:group>
				</xf:group>
				<w2:wframe src="/frame/page/body_bottom.xml" style="" id="wf_body_bottom"></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>