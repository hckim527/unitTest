		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > M > setValue]<br/>컴포넌트에서 선택하려는 아이템들의 Value 값을 구분자가 포함된 문자열로 설정합니다.",
    "validation" : [        
        "숨겨진 아이템도 선택 처리됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
        
    rtn = target1.getValue();
    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + rtn);    
};



scwin.btn_setValue_onclick = function (e) {       
    target1.setValue("2");    
};
]]></script>
