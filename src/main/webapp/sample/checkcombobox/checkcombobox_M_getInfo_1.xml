		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; M &gt; getInfo]&lt;br/&gt;컴포넌트에서 특정 아이템의 정보를 객체로 반환합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;index(필수) 파라미터로 정보를 조회하려는 아이템의 인덱스를 설정합니다.&quot;,
        &quot;아이템의 인덱스는 0 부터 시작합니다.&quot;,
        &quot;리턴값으로 아이템의 정보를 객체로 반환합니다.&quot;,
        &quot;index 파라미터값이 유효하지 않은 경우 undefined 값을 반환합니다.&quot;,
        &quot;반환된 객체의 index 속성으로 반환된 아이템의 인덱스값을 갖습니다.&quot;,
        &quot;반환된 객체의 label 속성으로 포맷이 적용된 아이템의 Label 값을 갖습니다. (displayMode 속성 등에 의해 포맷이 적용됨)&quot;,
        &quot;반환된 객체의 value 속성으로 반환된 아이템의 Value 값을 갖습니다.&quot;,
        &quot;반환된 객체의 checked 속성으로 반환된 아이템의 선택 상태를 true/false 값으로 갖습니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
            target1.remove();
    }

    let properties = {
        displayMode : con_displayMode.getText(),        
    }

    let cList = $c.gcm.createCList(properties)
    
    // comp 생성
    $c.gcm.createBasicCheckComboBox(cList);
}



scwin.btn_getInfo_onclick = function (e) {
    let rtn = target1.getInfo(par_index.getText());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;obj:&quot; +rtn);

    if (rtn) {
        let index = rtn.index;
        let label = rtn.label;
        let value = rtn.value;
        let checked = rtn.checked;
            
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Index:&quot;+index+&quot;, Label:&quot;+label+&quot;, Value:&quot;+value+ &quot;, Checked:&quot;+checked);
    }
};</script>
