		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > M > setSelectedInfo]<br/>컴포넌트에서 아이템들의 선택/해제를 아이템 정보를 가진 객체 배열로 설정합니다.",
    "validation" : [        
        "visibleColumn 속성으로 숨겨진 아이템을 포함하여 전체 아이템을 기준으로 인덱스를 설정합니다. ",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getSelectedInfo_onclick = function (e) {
    let rtn = target1.getSelectedInfo();
    wf_body_bottom.getObj("scwin").setReturnValue("objArray:" +rtn);

    if (rtn) {
        rtn.forEach(function(item, index) {
            wf_body_bottom.getObj("scwin").setReturnValue((index+1)+" 번째 선택된 Item 의 label : " +item.label);
            wf_body_bottom.getObj("scwin").setReturnValue((index+1)+" 번째 선택된 Item 의 checked : " +item.checked);
        });          
    }
};



scwin.btn_setLast_onclick = function (e) {
	target1.setSelectedInfo([{index:3,checked:true}]);
};

]]></script>
		<style type="text/css"><![CDATA[/* renderType=table */
