scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; E &gt; onviewchange]&lt;br/&gt;컴포넌트에서 사용자의 조작에 의해 아이템들의 선택 상태가 변경되면 발생합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;setValue(), setSelectedInfo() 등의 메소드로 아이템들의 선택을 변경한 경우 onviewchange 이벤트는 발생하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onviewchange&quot;]);

    // comp 생성
    $c.gcm.createBasicCheckComboBox('', eList);
}



scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onviewchange=====&quot;);
}



scwin.btn_setAll_onclick = function (e) {
    let itemarr = target1.getInfoArray();
    let rsltarr = [];

    for (let i = 0; i &lt; itemarr.length; i++) {
        let obj = {};
        obj.index = itemarr[i].index;
        if (itemarr[i].checked == true)    
            obj.checked = false;
        else
            obj.checked = true;
        
        rsltarr.push(obj);
    }

    target1.setSelectedInfo(rsltarr);
};



scwin.btn_setValue_onclick = function (e) {
    let value = par_value.getText();

    if (value == '')
	    target1.setValue();
    else
        target1.setValue(value);
};
</script>
