		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > M > setValue]<br/>컴포넌트에서 선택하려는 아이템들의 Value 값을 구분자가 포함된 문자열로 설정합니다.",
    "validation" : [        
        "아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "value(필수) 파라미터로 선택하려는 아이템들의 Value 값을 구분자로 구분한 문자열로 설정합니다.",
        "구분자는 separator 속성값을 사용하며 separator 속성 미설정 시 ''(Empty String)을 사용합니다.",
        "선택할 아이템이 한 개인 경우 구분자 없이 해당 아이템의 Value 값만 설정합니다.",
        "값을 설정하지 않으면 메소드가 실행되지 않습니다.",
        "파라미터값에서 구분자를 제거한 값들과 Value 값이 일치하는 아이템이 선택 처리됩니다.",
        "Value 값이 일치하는 아이템이 없는 경우 전체 아이템의 선택이 해제됩니다.",
        "setValue() 메소드로 아이템의 선택이 변경되면 onchange 이벤트가 발생합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



// comp 재생성
scwin.comp_init = function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList(["onchange"]);

    // target 생성    
    $c.gcm.createBasicCheckComboBox('', eList);
};



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
        
    rtn = target1.getValue();
    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + rtn);    
};



scwin.btn_setValue_onclick = function (e) {    
    let value = par_value.getText();
    
    target1.setValue(value);    
};



scwin.target1_onchange = function(info) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");    
}]]></script>
