		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; itemTooltipFormatter]&lt;br/&gt;itemTooltipDisplay=true 일때 각 아이템의 툴팁 내용을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [                
        &quot;아이템 정의가 itemSet 인 경우 동작합니다.&quot;,
    ]
}


scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.target1_ontooltipshow = function (e) { 
    $c.gcm.getTooltipInfo(wf_body_bottom)
}



scwin.fn_itemtooltip = function(label, idx) {
    return &quot;label - &quot; + label + &quot;, idx - &quot; + idx;  
}</script>
