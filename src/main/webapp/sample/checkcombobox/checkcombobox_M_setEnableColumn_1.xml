		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > M > setEnableColumn]<br/>컴포넌트의 enableColumn 속성값을 설정합니다.",
    "validation" : [                
        "아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "columnId(필수) 파라미터로 아이템의 비활성화 정보를 갖는 컬럼명을 문자열로 설정합니다.",
        "columnId(필수) 파라미터로 설정된 컬럼의 값이 enableColumnFalseValue 속성 또는 파라미터의 기준값에 있는 경우 해당 아이템은 비활성화 처리됩니다.",
        "enableColumnFalseValue(선택) 파라미터로 아이템의 비활성화에 대한 기준값 집합을 문자열로 설정합니다.",
        "enableColumnFalseValue(선택) 파라미터 설정값 사이에 공백이 있으면 해당 공백도 값에 포함됩니다.",
        "enableColumnFalseValue(선택) 파라미터 값을 생략하면 enableColumnFalseValue 속성값이 적용됩니다.",
        "columnId 파라미터에 설정된 값은 enableColumn 속성에 설정되고, enableColumnFalseValue 파라미터에 설정된 값은 enableColumnFalseValue 속성에 설정됩니다."
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getSelectedInfo_onclick = function (e) {
    let rtn = target1.getSelectedInfo();

    // 배열의 각 요소를 순회합니다.
    for (let i = 0; i < rtn.length; i++) {
        let item = rtn[i]; // 현재 요소를 가져옵니다.
        
        // index, label, value, checked 값을 가져옵니다.
        let index = item.index;
        let label = item.label;
        let value = item.value;
        let checked = item.checked;

        // 원하는 작업을 수행할 수 있습니다.
        wf_body_bottom.getObj("scwin").setReturnValue("Index:"+index+", Label:"+label+", Value:"+value+ ", Checked:"+checked);
    }    
};



scwin.btn_setEnableColumn_onclick = function (e) {
    if (par_enableColumnFalseValue.getText() == '')
	    target1.setEnableColumn(par_columnId.getText());
    else
        target1.setEnableColumn(par_columnId.getText(), par_enableColumnFalseValue.getText());    
};



scwin.btn_getDisabled_onclick = function (e) {
    let comp = "target1_itemTable_main";
    let targetElements = document.querySelectorAll('[id*=' + comp + ']');

    if (targetElements.length == 0) {
        wf_body_bottom.getObj("scwin").setReturnValue("CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");
        return; // function exit
    }

    let trs = targetElements[0].querySelectorAll('tr.w2table_ccb_row');
    
    // 각 tr에 대해 td의 class에 "_disabled"가 포함되어 있는지 확인
    trs.forEach((tr, index) => {
        // 모든 td 요소를 가져오기
        let tds = tr.querySelectorAll('td');
        let isDisabled = false;

        // 각 td의 className에 "_disabled"가 포함되어 있는지 확인
        tds.forEach(td => {
            if (td.className.includes('_disabled')) {
                isDisabled = true; // 한 개의 td라도 _disabled 클래스가 있으면 비활성화로 판단
            }
        });

        if (isDisabled) {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 비활성화");
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 활성화");
        }
    });
};]]></script>
