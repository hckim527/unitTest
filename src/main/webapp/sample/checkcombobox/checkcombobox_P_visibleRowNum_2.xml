scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemListSize_onclick = function (e) {
    let rtn = '';    
    let comp = &quot;target1_gridViewItemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Itemlist height : &quot; + rtn);
};



scwin.target1_onclose = function (e) {
    scwin.btn_getItemListSize_onclick();
}</script>
