		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; navBtn]&lt;br/&gt;아이템 리스트창의 하단에 '선택적용', '선택해제' 버튼을 표시할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;미설정 시 아이템 리스트창의 하단에 버튼을 표시하지 않습니다.&quot;,
        &quot;true 설정 시 아이템 리스트창의 하단에 '선택적용', '선택해제' 버튼을 표시합니다.&quot;,
        &quot;'선택적용' : 버튼 클릭 시 아이템 리스트창에 선택된 아이템을 CheckCombobox 컴포넌트에 반영하고 아이템 리스트창을 닫습니다.&quot;,
        &quot;'선택해제' : 버튼 클릭 시 아이템 리스트창에 선택된 아이템을 모두 해제한 후 아이템 리스트창을 유지합니다.&quot;,
        &quot;false 설정 시 아이템 리스트창의 하단에 버튼을 표시하지 않습니다.&quot;,
        &quot;checkboxClickSync=true 이면 '선택적용' 버튼은 아이템 리스트창을 닫는 동작만 합니다.&quot;,
        &quot;'선택해제' 버튼은 checkboxClickSync 속성값에 관계없이 아이템 리스트창의 선택을 해제하는 동작만 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        navBtn: con_navBtn.getText(),
        checkboxClickSync : con_checkboxClickSync.getText(),
    };

    let cList = $c.gcm.createCList(properties);  
    let eList = $c.gcm.createEList([&quot;onclose&quot;]);

    $c.gcm.createBasicCheckComboBox(cList, eList);
}



scwin.btn_getText_onclick = function (e) {
    let rtn = ''
    
    rtn = target1.render.textContent;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;label : &quot;+ rtn);
}



scwin.target1_onclose = function(closeOut) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onclose=====&quot;);
}
</script>
