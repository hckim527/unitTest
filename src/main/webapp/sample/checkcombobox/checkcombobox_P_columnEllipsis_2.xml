		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > P > columnEllipsis]<br/>아이템 리스트창에 아이템의 라벨값이 모두 표시되지 않을때 '...' 줄임표를 표시할지 설정합니다.",
    "validation" : [                
        "submenuSize=fixed 이고, 아이템이 ItemSet 으로 정의된 경우에 동작합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemClass_onclick = function (e) {
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    // 그 요소 내의 모든 label 태그를 선택
    let labels = document.getElementsByTagName('label');

    // 각 label을 반복하며 내용을 확인
    for (let i = 0; i < labels.length; i++) {
        wf_body_bottom.getObj("scwin").setReturnValue("index="+ i +" 인 item 의 className : " + labels[i].className);
    }
};]]></script>
