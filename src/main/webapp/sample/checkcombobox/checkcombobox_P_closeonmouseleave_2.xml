				<w2:dataList baseNode="list" id="dlt_gridviewItem" repeatNode="map" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="label" name="name1"></w2:column>
						<w2:column dataType="text" id="value" name="name2"></w2:column>
						<w2:column dataType="text" id="user" name="name3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[1]]></value>
							<user><![CDATA[u1]]></user>
						</w2:row>
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[2]]></value>
							<user><![CDATA[u2]]></user>
						</w2:row>
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[3]]></value>
							<user><![CDATA[u3]]></user>
