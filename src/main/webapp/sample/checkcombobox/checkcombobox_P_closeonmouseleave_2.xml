		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; closeonmouseleave]&lt;br/&gt;마우스가 CheckCombobox 컴포넌트 영역을 벗어날때 표시된 아이템 리스트창을 닫을지 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;true 설정 시 아이템이 GridViewItemSet 으로 정의된 경우 마우스가 컴포넌트 영역으로 벗어나야 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.get_isItemList_onclick = function (e) {    
    // id에 &quot;target1_itemTable&quot; 문자열이 포함된 div 요소를 선택합니다.
    let divs = document.querySelectorAll('div[class*=&quot;w2gridItemTable&quot;]');

    // 각 div 요소에 대해 작업을 수행
    divs.forEach(div =&gt; {
        // style의 display와 visibility 값을 가져옵니다.
        let displayValue = div.style.display;
        let visibilityValue = div.style.visibility;
        
        // 결과를 출력합니다.
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;display : &quot; + displayValue);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;visibility : &quot; + visibilityValue);
    });	
};



scwin.target1_onclose = function (e) {    
    scwin.get_isItemList_onclick();
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<w2:textbox style="background-color:silver;" id="" label="아이템이 GridViewItemSet 로 정의되어 있고 closeonmouseleave=true 설정된 상태"></w2:textbox>
                    	<xf:checkcombobox allOption="false" chooseOption="false" direction="auto" disabled="false" displayMode="label"
                    		id="target1" style="width: 148px;height: 21px;" submenuSize="auto" closeonmouseleave="true"
                    		ev:onclose="scwin.target1_onclose">
                    		<xf:choices>
                    			<w2:gridViewItemset autoFit="" checkColumn="0" height="" hideHeader="" label="label"
                    				nodeset="data:dlt_gridviewItem" rowMouseOver="" rowMouseOverColor="" selectedRowColor="" value="value"
                    				visibleRowNum="" width="">
                    				<w2:item header="checked" headerStyle="" hidden="" inputType="checkbox" ref="label" style=""></w2:item>
                    				<w2:item header="value" headerStyle="" hidden="" ref="value" style=""></w2:item>
                    				<w2:item header="user" headerStyle="" hidden="" ref="user" style=""></w2:item>
                    			</w2:gridViewItemset>
                    		</xf:choices>
                    	</xf:checkcombobox>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>