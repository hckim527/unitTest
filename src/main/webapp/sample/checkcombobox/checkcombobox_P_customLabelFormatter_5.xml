	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; customLabelFormatter]&lt;br/&gt;선택된 아이템들의 라벨 표시값을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;아이템이 ItemSet 으로 정의된 경우 컴포넌트가 처음 렌더링될때 사용자 정의 함수가 실행되지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;selectbox 의 label : &quot; + rtn);    
};



scwin.fn_customlabelformatter = function(selectData, isOpen) {    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;사용자 정의 함수 실행됨&quot;);

    let data = [];
    for(var i=0;i &lt; selectData.length;i++){        
        data.push(selectData[i].label);        
    }

    data.push(&quot; isOpen : &quot;+isOpen);    

    return data;
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<xf:checkcombobox id="target1" chooseOption="" displayMode="label" style="width: 148px;height: 21px;"
                    		submenuSize="auto" allOption="" disabled="false" direction="auto" ref="" customLabelFormatter="scwin.fn_customlabelformatter">
                    		<xf:choices>
                    			<xf:item>
                    				<xf:label><![CDATA[ItemSet_1]]></xf:label>
                    				<xf:value><![CDATA[1]]></xf:value>
                    			</xf:item>
                    			<xf:item>
                    				<xf:label><![CDATA[ItemSet_2]]></xf:label>
                    				<xf:value><![CDATA[2]]></xf:value>
                    			</xf:item>
                    			<xf:item>
                    				<xf:label><![CDATA[ItemSet_3]]></xf:label>
                    				<xf:value><![CDATA[3]]></xf:value>
                    			</xf:item>
                    		</xf:choices>
                    	</xf:checkcombobox>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
                        <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText_onclick" id="btn_getText" label="text 확인" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>