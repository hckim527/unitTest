		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; P &gt; checkboxClickSync]&lt;br/&gt;아이템 리스트창에서 아이템 선택과 동시에 선택 처리를 할지 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;아이템이 ItemSet 으로 정의된 경우에 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.btn_getText_onclick = function (e) {   
    let rtn = ''

    rtn = target1.getText();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + rtn);  
}



scwin.target1_oncheckboxclick = function (index, checked, value) {    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_oncheckboxclick=====&quot;);
    scwin.btn_getText_onclick();
}



scwin.target1_onchange = function (info) {    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);
}



scwin.target1_onviewchange = function (info) {    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onviewchange=====&quot;);
}</script>
