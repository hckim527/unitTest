    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemListSize_onclick = function (target) {
    let rtn = '';    
    let comp = target + "_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].style.width
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist width : " + rtn);
};



scwin.target1_onclose = function (e) {
    scwin.btn_getItemListSize_onclick("target1");
}



scwin.target2_onclose = function (e) {
    scwin.btn_getItemListSize_onclick("target2");
}



scwin.target3_onclose = function (e) {
    scwin.btn_getItemListSize_onclick("target3");
}



scwin.target4_onclose = function (closeOut) {
    scwin.btn_getItemListSize_onclick("target4");	
};
]]></script>
