		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > P > itemTooltipFormatter]<br/>itemTooltipDisplay=true 일때 각 아이템의 툴팁 내용을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.",
    "validation" : [                
        "아이템 정의가 BindItemSet 인 경우 동작합니다.",
        "각 아이템의 툴팁 내용을 생성할 사용자 정의 함수를 설정합니다.",
        "사용자 정의 함수는 마우스가 위치한 아이템의 라벨값과 인덱스값을 파라미터로 전달 받습니다.",
        "사용자 정의 함수의 반환값이 새로운 툴팁 텍스트로 적용됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        itemTooltipDisplay: true,
        itemTooltipFormatter: con_itemTooltipFormatter.getText(),
    };
  
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["ontooltipshow"]);     

    $c.gcm.createBasicCheckComboBox(cList, eList);
}



scwin.target1_ontooltipshow = function (e) { 
    $c.gcm.getTooltipInfo(wf_body_bottom)
}



scwin.fn_itemtooltip = function(label, idx) {
    return "label - " + label + ", idx - " + idx;  
}]]></script>
