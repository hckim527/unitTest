		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > M > setItemDisabled]<br/>컴포넌트에서 특정 아이템을 비활성화 상태를 설정합니다.",
    "validation" : [                
        "visibleColumn 속성으로 숨겨진 아이템의 비활성화 상태도 변경할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getDisabled_onclick = function (e) {

    target1.openTable();

    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    let inputs = targetElements[0].querySelectorAll('input.w2table_ccb_col_checkbox');

    // 각 input 요소의 disabled 속성 존재 여부 확인
    inputs.forEach((input, index) => {
        if (input.hasAttribute('disabled')) {            
            wf_body_bottom.getObj("scwin").setReturnValue("Item index=" + index + " 은 비활성화");	
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue("Item index=" + index + " 은 활성화");	
        }
    });	
};



scwin.btn_setItemDisabled_onclick = function (e) {
    let index = par_index.getValue();
    let disabled = par_disabled.getText();

	target1.setItemDisabled(index, disabled);
};]]></script>
