		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; M &gt; openTable]&lt;br/&gt;컴포넌트의 아이템 리스트창을 동적으로 표시합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;아이템 리스트창이 비활성화(disabled) 상태이거나 읽기전용(readOnly) 상태여도 아이템 리스트창이 표시됩니다.&quot;,

    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
            target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onchange&quot;]);

    // comp 생성
    $c.gcm.createBasicCheckComboBox('', eList);
}



scwin.target1_onchange = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);	
}



scwin.btn_openTable_onclick = function (e) {
    target1.openTable();

    let comp = &quot;target1_itemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;ItemList Close&quot;);
    else
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;ItemList Open&quot;);
};



scwin.btn_setDisabled_onclick = function (e) {
    if (par_disabled.getText() == &quot;true&quot;)
        target1.setDisabled(true);
    else if (par_disabled.getText() == &quot;false&quot;)
        target1.setDisabled(false);
    else
        target1.setDisabled();
};



scwin.btn_setReadOnly_onclick = function (e) {
    target1.setReadOnly(par_readOnly.getText());
};
</script>
	</head>
