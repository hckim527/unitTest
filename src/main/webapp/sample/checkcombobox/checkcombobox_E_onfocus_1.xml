		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > E > onfocus]<br/>컴포넌트가 포커스를 받을 때 발생합니다.",
    "validation" : [        
        "컴포넌트가 포커스를 받을 때 발생합니다.",
        "아이템 리스트창은 별도의 레이어로 처리되어 아이템 리스트창이 닫힐때 포커스가 컴포넌트로 이동하면 onfocus 이벤트가 발생합니다.",
        "아이템 리스트창이 표시된 상태에서 다른 컴포넌트나 빈공간을 클릭하면 onfocus 이벤트가 발생하지 않습니다.",        
        "컴포넌트가 비활성화(disabled)상태이면 이벤트가 발생하지 않습니다.",
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList(["onfocus"])

    // comp 생성 함수 호출    
    $c.gcm.createBasicSelectBox('', eList); 
}



scwin.target1_onfocus = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onfocus 이벤트 발생=====");
    wf_body_bottom.getObj("scwin").setReturnValue("e:" + e);   
}



scwin.btn_focus_onclick = function (e) {
    target1.focus();
};



scwin.btm_setDisabled_onclick = function (e) {
	target1.setDisabled(par_disabled.getText());
};
]]></script>
