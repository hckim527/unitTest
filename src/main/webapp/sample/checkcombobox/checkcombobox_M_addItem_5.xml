					<xf:group style="" id="grp_etc">
						<w2:button ev:onclick="scwin.btn_addItem_onclick" style="" id="btn_addItem" label="addItem" class="tc_btn_basic"></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
