		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkcombobox &gt; M &gt; addItem]&lt;br/&gt;컴포넌트에 신규 아이템을 추가합니다.&quot;,
    &quot;validation&quot; : [    
        &quot;allOption 속성으로 '전체 선택' 아이템이 추가되었을때 index 파라미터를 0 으로 설정 시 '전체 선택' 아이템 위에 추가됩니다.&quot;
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        allOption : true,
    }

    let cList = $c.gcm.createCList(properties)
    let eList = $c.gcm.createEList([&quot;onchange&quot;]);

    // target 생성
    $c.gcm.createLabel('label=&quot;addItem 후 추가된 아이템 클릭하여 값 확인&quot;', '', 'label1');
    $c.gcm.createBasicCheckComboBox(cList, eList);
}



scwin.btn_addItem_onclick = function (e) {
    let value = par_value.getValue();
    let label = par_label.getValue();
    let index = par_index.getValue();
    let rtn = '';

    if (index == '')
	    rtn = target1.addItem(value, label);
    else
        rtn = target1.addItem(value, label, index);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;return : &quot; + rtn);
};



scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;value : &quot; + info.newValue);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;label : &quot; + target1.getText());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;index : &quot; + target1.getSelectedIndex());
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
