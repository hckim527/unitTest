								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="value" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:input id="par_value" style="" initValue="1"></xf:input>
								</xf:group>
								<xf:group class="w2tb_th " tagname="th">
									<w2:attributes></w2:attributes>
									<w2:textbox class="" id="" label="" ref="" style="" userData2=""></w2:textbox>
									<w2:textbox class="" id="" label="label" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" tagname="td">
									<w2:attributes></w2:attributes>
									<xf:input id="par_label" style="" initValue="add_item1"></xf:input>
								</xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
