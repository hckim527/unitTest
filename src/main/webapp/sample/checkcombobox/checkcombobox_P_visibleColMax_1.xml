		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > P > visibleColMax]<br/>아이템 리스트창에 적용될 아이템 컬럼의 최대 갯수를 설정합니다.",
    "validation" : [                    
        "renderType=component 이고, 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "아이템 컬럼의 최대 갯수를 양의 정수로 설정합니다.",
        "설정값이 (아이템 전체 갯수 / visibleRowNum 속성값) 보다 작은 경우에 아이템 컬럼 갯수로 적용됩니다.",
        "설정값이 (아이템 전체 갯수 / visibleRowNum 속성값) 보다 큰 경우는 계산값이 아이템 컬럼 갯수로 적용됩니다. 즉, 아이템의 전체 갯수와 visibleRowNum 속성값에 따라 (1 ~ visibleColMax 속성값) 범위의 값이 컬럼 갯수로 자동 적용됩니다.",
        "아이템 리스트창에 아이템이 행 우선으로 렌더링됩니다. 즉, 첫번째 행에 차례로 아이템이 표시된 후 두번째 행에 아이템이 표시됩니다.",
        "아이템 전체 갯수가 (visibleRowNum 속성값 * visibleColMax 속성값) 보다 큰 경우 아이템 리스트창에 세로 스크롤이 표시됩니다.",
        "allOption 속성으로 추가된 '전체 선택' 아이템도 아이템 갯수에 포함됩니다."
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {                
        allOption : true,
        visibleRowNum : con_visibleRowNum.getText(),
        visibleColMax : con_visibleColMax.getText(),
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclose"]);

    // comp 생성
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '<xf:checkcombobox ' + strNameSpace + ' ' + cList + ' ' + eList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_Item">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:checkcombobox>';

    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "checkcombobox",
        strTarget,
        grp_comp
    );
}



scwin.btn_getColumnCount_onclick = function (e) {    
    let rtn = ''
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    let rows = targetElements[0].querySelectorAll('tr.w2table_ccb_row');

    // Item List 세로 크기
    rtn = targetElements[0].style.height
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist height : " + rtn);

    // row 개수
    wf_body_bottom.getObj("scwin").setReturnValue("rowcount : " + rows.length)

    // 각 row 의 col 개수  
    rows.forEach((row, index) => {  
        let tdCount = row.querySelectorAll('td[data-index]').length; // data-index 속성이 있는 td 태그만 선택
        wf_body_bottom.getObj("scwin").setReturnValue(`${index + 1} 번째 row 의 colcount :  ${tdCount}`);  
    });
};



scwin.btn_getItemListSize_onclick = function (e) {
    let rtn = '';    
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("CheckComboBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist height : " + rtn);
};



scwin.target1_onclose = function (e) {
    scwin.btn_getColumnCount_onclick();
}]]></script>
