		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkcombobox > P > visibleColumn]<br/>컴포넌트에서 특정 아이템의 표시 정보를 갖는 컬럼명을 설정합니다.",
    "validation" : [                
        "renderType=component 이고, visibleColumn 속성이 설정되었을때 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "아이템의 표시 정보가 있는 DataCollection 의 컬럼명을 문자열로 설정합니다.",
        "설정된 컬럼의 값이 visibleColumnFalseValue 속성값에 있는 경우 해당 아이템은 컴포넌트에 표시되지 않습니다.",        
        "DataCollection 바인딩으로 컴포넌트의 아이템이 정의된 경우에 동작합니다.",
        "컴포넌트에 표시되지 않은 아이템은 사용자의 액션으로 선택할 수 없습니다.",        
        "setSelectedInfo(), setValue() 등의 메소드를 사용하면 표시되지 않은 아이템도 선택할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getVisible_onclick = function (e) {
    let comp = "target1_itemTable_main";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    let trs = targetElements[0].querySelectorAll('tr.w2table_ccb_row');
    
    // 각 td 요소의 visible 확인
    trs.forEach((tr, index) => {   
        if (tr.hasAttribute('data-wqhidden')) {            
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 미표시");	
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 표시");	
        }
    });	
};



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(par_value.getText())
};



scwin.btn_getSelectedInfo_onclick = function (e) {
    let rtn = target1.getSelectedInfo();

    // 배열의 각 요소를 순회합니다.
    for (let i = 0; i < rtn.length; i++) {
        let item = rtn[i]; // 현재 요소를 가져옵니다.
        
        // index, label, value, checked 값을 가져옵니다.
        let index = item.index;
        let label = item.label;
        let value = item.value;
        let checked = item.checked;

        // 원하는 작업을 수행할 수 있습니다.
        wf_body_bottom.getObj("scwin").setReturnValue("Index:"+index+", Label:"+label+", Value:"+value+ ", Checked:"+checked);
    }    
};



scwin.btn_setSelectedInfo_onclick = function (e) {    
	target1.setSelectedInfo(eval(par_infoArray.getText()));
};
]]></script>
