		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; spanNode]&lt;br/&gt;인덱스값 또는 Depth(단계)값을 사용하여 특정 트리 아이템을 확장하거나 축소합니다.&quot;,
    &quot;validation&quot; : [
        &quot;itemInfo(필수) 파라미터로 확장/축소 하려는 트리 아이템을 객체로 설정합니다.&quot;,
        &quot;트리 아이템의 인덱스는 1 부터 시작합니다.&quot;,
        &quot;itemInfo.depth 속성값으로 확장/축소 하려는 트리 아이템을 Depth(단계)값으로 설정합니다.&quot;,
        &quot;트리 아이템의 인덱스는 1 부터 시작합니다.&quot;,        
        &quot;itemInfo.applyChildNodes 속성값으로 true 설정 시 재귀적으로 모든 자식 아이템을 확장/축소 합니다.&quot;,
        &quot;itemInfo.applyChildNodes 속성값으로 false 설정 시 depth 파라미터에 해당하는 트리 아이템만 확장/축소 합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // comp 생성 함수 호출    
    $c.gcm.createBasicTreeView();
}



scwin.btn_getOpened_onclick = function (e) {
    let tableElements = document.querySelectorAll('table[id*=&quot;target1_node&quot;]')

    if (tableElements.length &gt; 0) {
        for (var i =0; i &lt; tableElements.length; i++) {
            let opened = tableElements[i].getAttribute('data-opened')

            if (opened)
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Item[&quot;+i+&quot;] opened : &quot; + opened);            
        }
    }
};



scwin.btn_spanNode_onclick = function (e) {
    let itemInfo = {};
    let depth = Number(par_depth.getText());
    let applyChildNodes = par_applyChildNodes.getText();

    if (applyChildNodes == &quot;true&quot;) {
        applyChildNodes = true;
    }

    if (applyChildNodes == &quot;false&quot;) {
        applyChildNodes = false;
    }        

    itemInfo.depth = depth;
    itemInfo.applyChildNodes = applyChildNodes;

    debugger;

    target1.spanNode(itemInfo);

    scwin.btn_getOpened_onclick();
};</script>
