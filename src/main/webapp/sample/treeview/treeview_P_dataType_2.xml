		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[treeview > P > dataType]<br/>컴포넌트에 트리 아이템이 정의되는 형식을 설정합니다.",
    "validation" : [        
        "listed 설정 시  트리 아이템을 Inner XML 로 정의합니다.",
        "트리 아이템을 Innder XML 로 정의하는 경우 Label, Value 항목을 필수로 설정해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



// comp 재생성
scwin.comp_init = function () {

};



scwin.btn_getSelectedNode_onclick = function (e) {
    let node ='';
    let index = '';
        
    node = target1.getSelectedNode();    
    index = target1.getSelectedIndex(); 
    
    wf_body_bottom.getObj("scwin").setReturnValue("return object : "+ node);

    if (node) {
        wf_body_bottom.getObj("scwin").setReturnValue("checked : "+ node.checked);
        wf_body_bottom.getObj("scwin").setReturnValue("checkboxDisabled : "+ node.checkboxDisabled);
        wf_body_bottom.getObj("scwin").setReturnValue("depth : "+ node.depth);
        wf_body_bottom.getObj("scwin").setReturnValue("folder : "+ node.folder);
        wf_body_bottom.getObj("scwin").setReturnValue("index : "+ node.index);
        wf_body_bottom.getObj("scwin").setReturnValue("label : "+ node.label);
        wf_body_bottom.getObj("scwin").setReturnValue("value : "+ node.value);
        wf_body_bottom.getObj("scwin").setReturnValue("parentNode.label : "+ node.parentNode.label);
        wf_body_bottom.getObj("scwin").setReturnValue("childNodes.length : "+ node.childNodes.length);        
    }

    let spanElement = document.querySelector('span[id*="target1_label_'+index+'"]');

    if (spanElement) {
        wf_body_bottom.getObj("scwin").setReturnValue("className: "+ spanElement.className);  
    }        
};



scwin.target1_onclick = function (e) {
    scwin.btn_getSelectedNode_onclick();
}
]]></script>
