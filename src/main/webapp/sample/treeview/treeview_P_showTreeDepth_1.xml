		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; P &gt; showTreeDepth]&lt;br/&gt;컴포넌트가 렌더링될때 트리 아이템이 펼쳐져서 표시될 단계를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;alwaysDraw=false 인 경우에 동작합니다.&quot;,
        &quot;트리 아이템이 펼쳐질 단계를 숫자로 설정합니다.&quot;,
        &quot;컴포넌트의 'Depth' 항목값과 관계없이 Root 를 1 단계로 처리합니다.&quot;,
        &quot;0 으로 설정 시 모든 트리 아이템이 접혀서 표시됩니다.&quot;,
        &quot;값을 설정하지 않으면 1000 으로 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        alwaysDraw : false,        
        showTreeDepth : con_showTreeDepth.getText(),
    }

    let cList = $c.gcm.createCList(properties);    

    $c.gcm.createBasicTreeView(cList); 

    scwin.btn_isOpen_onclick();
}



scwin.btn_isOpen_onclick = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;showTreeDepth : &quot; + target1.options.showTreeDepth);   

    for (var i = 1; i &lt; 12; i++)    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item(&quot;+i+&quot;) : &quot; + target1.isOpen(i));   
};</script>
