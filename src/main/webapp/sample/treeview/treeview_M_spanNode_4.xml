scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; spanNode]&lt;br/&gt;인덱스값 또는 Depth(단계)값을 사용하여 특정 트리 아이템을 확장하거나 축소합니다.&quot;,
    &quot;validation&quot; : [
        &quot;renderType=table 일때 트리 아이템이 ItemSet 으로 정의 되었고, Folder 항목이 설정된 경우 확장/축소값이 DataCollection 에 적용됩니다.&quot;,
        &quot;확장된 상태는 false, 축소된 상태는 true, Leaf 인 경우 ''(Empty String) 이 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // comp 생성 함수 호출    
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    
    strTarget += '&lt;w2:treeview ' + strNameSpace + ' id=&quot;&quot; dataType=&quot;listed&quot; showCheckbox=&quot;true&quot; style=&quot;position: relative;width: 200px;height: 350px;&quot;&gt;';    
    strTarget += '&lt;w2:itemset nodeset=&quot;data:dlt_Item&quot;&gt;';
    strTarget += '&lt;w2:label ref=&quot;label&quot;&gt;&lt;/w2:label&gt;';
    strTarget += '&lt;w2:value ref=&quot;value&quot;&gt;&lt;/w2:value&gt;';
    strTarget += '&lt;w2:depth ref=&quot;depth&quot;&gt;&lt;/w2:depth&gt;';
    strTarget += '&lt;w2:folder ref=&quot;folder&quot;&gt;&lt;/w2:folder&gt;';
    strTarget += '&lt;w2:checkbox ref=&quot;checkbox&quot;&gt;&lt;/w2:checkbox&gt;';
    strTarget += '&lt;w2:checkboxDisabled ref=&quot;&quot;&gt;&lt;/w2:checkboxDisabled&gt;';
    strTarget += '&lt;w2:image ref=&quot;&quot;&gt;&lt;/w2:image&gt;';
    strTarget += '&lt;w2:iconImage ref=&quot;&quot;&gt;&lt;/w2:iconImage&gt;';
    strTarget += '&lt;w2:selectedImage ref=&quot;&quot;&gt;&lt;/w2:selectedImage&gt;';
    strTarget += '&lt;w2:expandedImage ref=&quot;&quot;&gt;&lt;/w2:expandedImage&gt;';
    strTarget += '&lt;w2:leafImage ref=&quot;&quot;&gt;&lt;/w2:leafImage&gt;';
    strTarget += '&lt;/w2:itemset&gt;';
    strTarget += '&lt;/w2:treeview&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;treeview&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_getOpened_onclick = function (e) {
    let tableElements = document.querySelectorAll('table[id*=&quot;target1_node&quot;]')

    if (tableElements.length &gt; 0) {
        for (var i =0; i &lt; tableElements.length; i++) {
            let opened = tableElements[i].getAttribute('data-opened')

            if (opened)
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Item[&quot;+i+&quot;] opened : &quot; + opened);            
        }
    }
};



scwin.btn_spanNode_onclick = function (e) {
    let itemInfo = par_itemInfo.getText();

    target1.spanNode(itemInfo);

    scwin.getDataList();
};



scwin.getDataList = function () {
    let rtn = dlt_Item.getColData(&quot;folder&quot;);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;folder : &quot; + rtn);
}</script>
