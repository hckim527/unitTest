scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; disableCheckboxByValue]&lt;br/&gt;Value 값을 사용하여 특정 트리 아이템의 CheckBox 비활성화(disabled) 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;showCheckbox=true 인 경우에 동작합니다.&quot;,
        &quot;value(필수) 파라미터로 CheckBox 의 비활성화(disableed)를 설정하려는 트리 아이템의 Value 값을 설정합니다.&quot;,
        &quot;disabled(선택) 파라미터로 트리 아이템의 CheckBox 비활성화(disabled) 상태를 true/false 로 설정합니다.&quot;,
        &quot;disabled(선택) 파라미터로 true 설정 시 트리 아이템의 CheckBox 를 비활성화(disabled) 상태로 설정합니다.&quot;,
        &quot;disabled(필수) 파라미터로 false 설정 시 트리 아이템의 CheckBox 를 활성화 상태로 설정합니다.&quot;,
        &quot;disabled(선택) 파라미터로 true 값 이외의 값(문자열 포함) 설정 시 모두 false 로 처리됩니다.&quot;,
        &quot;childDisabled(선택) 파라미터로 자식 아이템의 CheckBox 도 동일하게 적용할지 true/false 로 설정합니다.&quot;,
        &quot;childDisabled(선택) 파라미터로 true 설정 시 재귀적으로 모든 자식 아이템의 CheckBox 비활성화(disabled) 상태에 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        showCheckbox : true,
    }

    let cList = $c.gcm.createCList(properties);    

    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '&lt;w2:treeview ' + strNameSpace + ' ' + cList + ' id=&quot;&quot; dataType=&quot;listed&quot; tooltipGroupClass=&quot;false&quot; style=&quot;width:200px;&quot;&gt;';
    strTarget += '&lt;w2:itemset nodeset=&quot;data:dlt_Item&quot;&gt;';
    strTarget += '&lt;w2:label ref=&quot;label&quot;&gt;&lt;/w2:label&gt;';
    strTarget += '&lt;w2:value ref=&quot;value&quot;&gt;&lt;/w2:value&gt;';
    strTarget += '&lt;w2:depth ref=&quot;depth&quot;&gt;&lt;/w2:depth&gt;';
    strTarget += '&lt;w2:folder ref=&quot;&quot;&gt;&lt;/w2:folder&gt;';
    strTarget += '&lt;w2:checkbox ref=&quot;checkbox&quot;&gt;&lt;/w2:checkbox&gt;';
    strTarget += '&lt;w2:checkboxDisabled ref=&quot;disabled&quot;&gt;&lt;/w2:checkboxDisabled&gt;';
    strTarget += '&lt;w2:image ref=&quot;&quot;&gt;&lt;/w2:image&gt;';
    strTarget += '&lt;w2:iconImage ref=&quot;&quot;&gt;&lt;/w2:iconImage&gt;';
    strTarget += '&lt;w2:selectedImage ref=&quot;&quot;&gt;&lt;/w2:selectedImage&gt;';
    strTarget += '&lt;w2:expandedImage ref=&quot;&quot;&gt;&lt;/w2:expandedImage&gt;';
    strTarget += '&lt;w2:leafImage ref=&quot;&quot;&gt;&lt;/w2:leafImage&gt;';
    strTarget += '&lt;/w2:itemset&gt;';
    strTarget += '&lt;/w2:treeview&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;treeview&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_getDisabled_onclick = function (e) {
    let inputElements = document.querySelectorAll('input[id*=&quot;target1_checkbox&quot;]');

    if (inputElements.length &gt; 0) {
        for (var i = 0; i &lt; inputElements.length; i++){
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item[&quot;+i+&quot;] : &quot;+ inputElements[i].disabled);         
        }
    }        
};



scwin.btn_disableCheckboxByValue_onclick = function (e) {
    let value = par_value.getText();
    let disabled = par_disabled.getText();
    let childDisabled = par_childDisabled.getText();

    if (disabled == &quot;true&quot;)
        disabled = true;

    if (disabled == &quot;false&quot;)
        disabled = false;

    if (childDisabled == &quot;true&quot;)
        childDisabled = true;

    if (childDisabled == &quot;false&quot;)
        childDisabled = false;

    if (disabled == &quot;&quot; &amp;&amp; childDisabled == &quot;&quot;)
	    target1.disableCheckboxByValue(value);
    else if (disabled !== &quot;&quot; &amp;&amp; childDisabled == &quot;&quot;)
        target1.disableCheckboxByValue(value, disabled);
    else
        target1.disableCheckboxByValue(value, disabled, childDisabled);

    scwin.btn_getDisabled_onclick();
};</script>
