		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; setNodeSet]&lt;br/&gt;트리 아이템 정의에 DataCollection 을 바인딩하여 트리 아이템을 새롭게 렌더링합니다.&quot;,
    &quot;validation&quot; : [
        &quot;nodeset(필수) 파라미터로 아이템이 정의된 DataCollection 의 ID 를 'data:[DataCollection ID]' 형식으로 설정합니다.&quot;,
        &quot;columnInfo(선택) 파라미터로 아이템의 Label 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo(선택) 파라미터를 생략하면 기존에 바인딩된 컬럼 ID 값이 적용되지만 getDataListInfo() 메소드는 빈값을 반환합니다.&quot;,
        &quot;columnInfo.label 속성으로 트리 아이템의 Label 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo.value 속성으로 트리 아이템의 Value 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo.depth 속성으로 트리 아이템의 Depth(단계) 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo.checkbox 속성으로 트리 아이템의 CheckBox 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo.folder 속성으로 트리 아이템의 Folder 값으로 바인딩할 컬럼의 ID 를 설정합니다.&quot;,
        &quot;columnInfo 파라미터를 생략 시 nodeset 파라미터의 DataCollection 컬럼 정보와 기존 컬럼 정보가 일치하여야 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {            
        showCheckbox : true,    
    }

    let cList = $c.gcm.createCList(properties);    

    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '&lt;w2:treeview ' + strNameSpace + ' ' + cList + ' id=&quot;&quot; dataType=&quot;listed&quot; tooltipGroupClass=&quot;false&quot; style=&quot;width:200px; height:350px;&quot;&gt;';
    strTarget += '&lt;w2:itemset nodeset=&quot;data:dlt_org&quot;&gt;';
    strTarget += '&lt;w2:label ref=&quot;label&quot;&gt;&lt;/w2:label&gt;';
    strTarget += '&lt;w2:value ref=&quot;value&quot;&gt;&lt;/w2:value&gt;';
    strTarget += '&lt;w2:depth ref=&quot;depth&quot;&gt;&lt;/w2:depth&gt;';
    strTarget += '&lt;w2:folder ref=&quot;folder&quot;&gt;&lt;/w2:folder&gt;';
    strTarget += '&lt;w2:checkbox ref=&quot;checkbox&quot;&gt;&lt;/w2:checkbox&gt;';
    strTarget += '&lt;w2:checkboxDisabled ref=&quot;&quot;&gt;&lt;/w2:checkboxDisabled&gt;';
    strTarget += '&lt;w2:image ref=&quot;&quot;&gt;&lt;/w2:image&gt;';
    strTarget += '&lt;w2:iconImage ref=&quot;&quot;&gt;&lt;/w2:iconImage&gt;';
    strTarget += '&lt;w2:selectedImage ref=&quot;&quot;&gt;&lt;/w2:selectedImage&gt;';
    strTarget += '&lt;w2:expandedImage ref=&quot;&quot;&gt;&lt;/w2:expandedImage&gt;';
    strTarget += '&lt;w2:leafImage ref=&quot;&quot;&gt;&lt;/w2:leafImage&gt;';
    strTarget += '&lt;/w2:itemset&gt;';
    strTarget += '&lt;/w2:treeview&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;treeview&quot;,
        strTarget,
        grp_comp
    );
}



scwin.getDataListInfo = function () {
    let info = target1.getDataListInfo()
    let checkedIndexes = target1.getCheckedIndexes();
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDataListInfo().label : &quot; + info.label);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCheckedIndexs : &quot; + checkedIndexes);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + target1.render.textContent);    
}



scwin.btn_setNodeSet_onclick = function (e) {
    let nodeset = par_nodeset.getText();

    if (par_columnInfo.getText() == &quot;&quot;) {
        target1.setNodeSet(nodeset);
    }        
    else {
        let colinfo = {};
        colinfo.label = &quot;label&quot;;
        colinfo.value = &quot;value&quot;;
        colinfo.depth = &quot;depth&quot;;
        colinfo.checkbox = &quot;checkbox&quot;;
        colinfo.folder = &quot;folder&quot;;

        target1.setNodeSet(nodeset, colinfo);
    }
    scwin.getDataListInfo();
};</script>
