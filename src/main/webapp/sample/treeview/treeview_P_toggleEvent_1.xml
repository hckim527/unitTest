		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; P &gt; toggleEvent]&lt;br/&gt;트리 아이템을 접거나 펼치기 위해 라벨 영역에서 인식할 마우스 액션을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;미설정 또는 ondblclick 설정 시 트리 아이템의 라벨 영역을 마우스로 더블 클릭하면 자식 트리 아이템이 &quot;,
        &quot;onclick 설정 시 트리 아이템의 라벨 영역을 마우스로 클릭하면 자식 트리 아이템이 확장/축소됩니다.&quot;,
        &quot;none 설정 시 트리 아이템의 라벨 영역에서 마우스 액션으로 자식 트리 아이템을 확장/축소하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {           
        toggleEvent : con_toggleEvent.getText(),
    }

    let cList = $c.gcm.createCList(properties);   
    let eList = $c.gcm.createEList([&quot;onclick&quot;, &quot;ondblclick&quot;]);   

    $c.gcm.createBasicTreeView(cList, eList); 
}



scwin.btn_isOpen_onclick = function (e) {   
    for (var i = 1; i &lt; 12; i++)    
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item(&quot;+i+&quot;) : &quot; + target1.isOpen(i));   
};



scwin.target1_onclick = function (e) {
    let toggleEvent = target1.options.toggleEvent

    if (toggleEvent == &quot;&quot; || toggleEvent == &quot;onclick&quot;) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;target1_onclick&quot;);
        scwin.btn_isOpen_onclick();
    }
}



scwin.target1_ondblclick = function (e) {
    let toggleEvent = target1.options.toggleEvent

    if (toggleEvent == &quot;ondblclick&quot;) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;target1_ondblclick&quot;);
        scwin.btn_isOpen_onclick();
    }
}</script>
	</head>
