		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; collapseNode]&lt;br/&gt;특정 트리 아이템을 축소하여 자식 아이템을 TreVeiw 컴포넌트에 표시하지 않습니다.&quot;,
    &quot;validation&quot; : [
        &quot;트리 아이템의 인덱스는 Depth-First Search 방식으로 설정되며, moveNode() 메소드 실행 시 인덱스가 재설정 됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // comp 생성 함수 호출    
    $c.gcm.createLabel('label=&quot;moveNode 를 수행하여 첫번째 아이템을 마지막 위치로 이동 후 collapseNode 메소드 실행하여 확인&quot;', '', 'label1');
    $c.gcm.createBasicTreeView();    
}



scwin.btn_getOpened_onclick = function (e) {
    let tableElements = document.querySelectorAll('table[id*=&quot;target1_node&quot;]')

    if (tableElements.length &gt; 0) {
        for (var i =0; i &lt; tableElements.length; i++) {
            let opened = tableElements[i].getAttribute('data-opened')

            if (opened)
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Item[&quot;+i+&quot;] opened : &quot; + opened);            
        }
    }
};



scwin.btn_collapseNode_onclick = function (e) {
    let value = Number(par_value.getText());
    let hierarchy = par_hierarchy.getText();

	target1.collapseNode(value, hierarchy);

    scwin.btn_getOpened_onclick();
};



scwin.btn_moveNode_onclick = function (e) {
	target1.moveNode(1, 11);
};
</script>
