		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; P &gt; defaultImage]&lt;br/&gt;트리 아이템에 표시될 기본 아이콘의 이미지를 URL 로 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;트리 아이템의 기본 아이콘으로 사용할 이미지의 URL 을 설정합니다.&quot;,
        &quot;상대경로를 설정할 수 있어야 합니다.&quot;,        
        &quot;절대경로를 설정할 수 있어야 합니다.&quot;,        
        &quot;프로토콜 포함 경로를 설정할 수 있어야 합니다.&quot;,        
        &quot;PNG, JPG, JPEG, GIF, SVG 등 브라우저가 지원하는 모든 이미지 파일을 사용할 수 있어야 합니다.&quot;,
        &quot;기본 아이콘의 크기는 width:18px, height:20px 입니다.&quot;,
        &quot;defaultImage 속성은 전체 트리 아이템에 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        defaultImage : con_defaultImage.getText(),            
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicTreeView(cList);

    scwin.btn_getDefaultImage_onclick();
}



scwin.btn_getDefaultImage_onclick = function (e) {   
    // id가 &quot;target1_icon&quot;인 div 태그 찾기
    let imageElements = document.querySelectorAll('div[id*=&quot;target1_icon&quot;]');

    if (imageElements.length &gt; 0) {
        for (var i =0; i &lt; imageElements.length; i++) {            
            let backgroundImage = imageElements[i].style.backgroundImage;
            let offsetWidth = imageElements[i].offsetWidth
            let offsetHeight = imageElements[i].offsetHeight
            
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue('image['+i+'] : ' +backgroundImage+', width : '+offsetWidth+', height : '+offsetHeight);
        }
    }
};</script>
