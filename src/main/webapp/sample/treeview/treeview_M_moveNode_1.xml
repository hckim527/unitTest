		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; moveNode]&lt;br/&gt;인덱스를 사용하여 특정 트리 아이템의 위치를 이동합니다.&quot;,
    &quot;validation&quot; : [
        &quot;트리 아이템이 ItemSet 으로 정의된 경우에 동작합니다.&quot;,
        &quot;srcIndex(필수) 파라미터로 이동 시키려는 트리 아이템의 인덱스값을 설정합니다.&quot;,
        &quot;재귀적으로 모든 자식 트리 아이템이 함께 이동합니다.&quot;,
        &quot;트리 아이템의 인덱스는 1 부터 시작합니다.&quot;,
        &quot;destIndex(필수) 파라미터로 srcIndex 파라미터에 해당하는 트리 아이템이 이동 될 기준이 되는 트리 아이템의 인덱스값을 설정합니다.&quot;,
        &quot;bAppendChild(선택) 파라미터로 srcIndex 파라미터에 해당하는 트리 아이템이 자식 아이템으로 이동할지 true/false 로 설정합니다.&quot;,
        &quot;bAppendChild(선택) 파라미터로 미설정 또는 false 설정 시 srcIndex 파라미터의 아이템을 destIndex 파라미터의 아이템과 같은 Depth(Sibling)로 이동하며 moveSibling 속성값에 따라 위치가 정해집니다.&quot;,
        &quot;bAppendChild(선택) 파라미터로 true 설정 시 srcIndex 파라미터의 아이템을 destIndex 파라미터의 아이템의 첫번째 자식으로 이동합니다.&quot;,
        &quot;dynamicAppend 속성값과 관계없이 moveNode() 메소드는 동작합니다.&quot;,
        &quot;트리 아이템이 정의된 DataCollection 에 변경된 내용이 반영되며 트리 아이템의 인덱스도 재설정됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {            
        showCheckbox : true,    
    }

    let cList = $c.gcm.createCList(properties);    
    
    $c.gcm.createBasicTreeView(cList);
}



scwin.getDataList = function (index) {
    let nIndex = Number(index) - 1;
    let rtn = gdl_treeview.getCellData(nIndex, &quot;label&quot;);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;DataList label 컬럼값 : &quot; + rtn);
}



scwin.btn_getSelectedNode_onclick = function () {
    let node = null;
        
    node = target1.getSelectedNode();    
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====이동된 노드 정보=====&quot;);

    if (node) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;depth : &quot;+ node.depth);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;index : &quot;+ node.index);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;label : &quot;+ node.label);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;value : &quot;+ node.value);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;parentNode.label : &quot;+ node.parentNode.label);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;childNodes.length : &quot;+ node.childNodes.length);        
    } 

    scwin.getDataList(node.index);
};



scwin.btn_moveNode_onclick = function (e) {
    let srcIndex = par_srcIndex.getText();
    let destIndex = par_destIndex.getText();
    let bAppendChild = par_bAppendChild.getText();

    target1.findNodeByIndex(srcIndex, true);

    if (bAppendChild == &quot;&quot;)
	    target1.moveNode(srcIndex, destIndex);
    else
        target1.moveNode(srcIndex, destIndex, bAppendChild);

    scwin.btn_getSelectedNode_onclick()
};
</script>
