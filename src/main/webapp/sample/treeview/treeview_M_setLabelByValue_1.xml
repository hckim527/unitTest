		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; setLabelByValue]&lt;br/&gt;Value 값을 사용하여 특정 트리 아이템의 Label 값을 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;value(필수) 파라미터로 Label 값을 변경하려는 트리 아이템의  Value 값을 설정합니다.&quot;,        
        &quot;label(필수) 파라미터로 변경하려는 Label 값을 설정합니다.&quot;,
        &quot;트리 아이템이 ItemSet 으로 정의된 경우 변경된 Label 값이 DataCollection 에 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {            
        showCheckbox : true,    
    }

    let cList = $c.gcm.createCList(properties);    

    $c.gcm.createBasicTreeView(cList);
}



scwin.getDataList = function (index) {
    let nIndex = Number(index) - 1;
    let rtn = gdl_treeview.getCellData(nIndex, &quot;label&quot;);

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;DataList 값 : &quot; + rtn);
}



scwin.btn_setLabelByValue_onclick = function (e) {
    let value = par_value.getText();
    let label = par_label.getText();    
    let index = value;

    target1.setLabelByValue(value, label);

    let spanElement = document.querySelector('span[id*=&quot;target1_label_'+index+'&quot;]');

    if (spanElement)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;label : &quot; + spanElement.textContent);

    scwin.getDataList(index);
};
</script>
