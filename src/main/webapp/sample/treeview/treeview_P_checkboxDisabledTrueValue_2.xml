    &quot;validation&quot; : [
        &quot;트리 아이템이 'Inner XML' 로 정의된 경우 'CheckBoxDisabled' 항목만 설정해도 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getDisabled_onclick = function (e) {
    let inputElements = document.querySelectorAll('input[id*=&quot;target1_checkbox&quot;]');

    if (inputElements.length &gt; 0) {
        for (var i = 0; i &lt; inputElements.length; i++){
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;disabled[&quot;+i+&quot;] : &quot;+ inputElements[i].disabled);         
        }
    }        
};</script>
