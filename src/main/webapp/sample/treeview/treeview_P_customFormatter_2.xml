scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; P &gt; customFormatter]&lt;br/&gt;트리 아이템들의 라벨 표시값을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;사용자 정의 함수에서 반환값을 생략할 경우 원래 Label 값이 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {                  
        customFormatter : con_customFormatter.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '&lt;w2:treeview ' + strNameSpace + ' ' + cList + ' id=&quot;&quot; dataType=&quot;listed&quot; tooltipGroupClass=&quot;false&quot; style=&quot;width:200px;&quot;&gt;';
    strTarget += '&lt;w2:itemset nodeset=&quot;data:dlt_Item&quot;&gt;';
    strTarget += '&lt;w2:label ref=&quot;label&quot;&gt;&lt;/w2:label&gt;';
    strTarget += '&lt;w2:value ref=&quot;value&quot;&gt;&lt;/w2:value&gt;';
    strTarget += '&lt;w2:depth ref=&quot;depth&quot;&gt;&lt;/w2:depth&gt;';
    strTarget += '&lt;w2:folder ref=&quot;&quot;&gt;&lt;/w2:folder&gt;';
    strTarget += '&lt;w2:checkbox ref=&quot;checkbox&quot;&gt;&lt;/w2:checkbox&gt;';
    strTarget += '&lt;w2:checkboxDisabled ref=&quot;disabled&quot;&gt;&lt;/w2:checkboxDisabled&gt;';
    strTarget += '&lt;w2:image ref=&quot;&quot;&gt;&lt;/w2:image&gt;';
    strTarget += '&lt;w2:iconImage ref=&quot;&quot;&gt;&lt;/w2:iconImage&gt;';
    strTarget += '&lt;w2:selectedImage ref=&quot;&quot;&gt;&lt;/w2:selectedImage&gt;';
    strTarget += '&lt;w2:expandedImage ref=&quot;&quot;&gt;&lt;/w2:expandedImage&gt;';
    strTarget += '&lt;w2:leafImage ref=&quot;&quot;&gt;&lt;/w2:leafImage&gt;';
    strTarget += '&lt;/w2:itemset&gt;';
    strTarget += '&lt;/w2:treeview&gt;';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;treeview&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;tree item 의 label : &quot; + rtn);    
};



scwin.fn_customformatter = function(orgLabel, formLabel, node) {       
    if(orgLabel == &quot;1&quot; &amp;&amp; checkValue == &quot;&quot;) {       
        checkValue = orgLabel;

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;반환값 생략&quot;);     
    }        
    return;                       
}</script>
