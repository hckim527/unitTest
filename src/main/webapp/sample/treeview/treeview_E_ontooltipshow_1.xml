		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[treeview > E > ontooltipshow]<br/>tooltip 속성에 의해 툴팁이 표시될 때 발생합니다.",
    "validation" : [        
        "tooltip 속성에 의해 툴팁이 표시될 때 발생합니다.",
        "컴포넌트의 하위 요소나 트리 아이템 경계를 넘어갈때도 ontooltipshow 이벤트가 발생합니다.",
    ]
} 



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        tooltip: "tooltip",
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["ontooltipshow"]);

    // comp 생성 함수 호출    
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '<w2:treeview ' + strNameSpace + ' ' + cList + ' ' + eList + ' id="" dataType="listed" tooltipGroupClass="false" style="width:200px; border:1px solid black;">';
    strTarget += '<w2:itemset nodeset="data:gdl_treeview">';
    strTarget += '<w2:label ref="label"></w2:label>';
    strTarget += '<w2:value ref="value"></w2:value>';
    strTarget += '<w2:depth ref="depth"></w2:depth>';
    strTarget += '<w2:folder ref=""></w2:folder>';
    strTarget += '<w2:checkbox ref=""></w2:checkbox>';
    strTarget += '<w2:checkboxDisabled ref=""></w2:checkboxDisabled>';
    strTarget += '<w2:image ref=""></w2:image>';
    strTarget += '<w2:iconImage ref=""></w2:iconImage>';
    strTarget += '<w2:selectedImage ref=""></w2:selectedImage>';
    strTarget += '<w2:expandedImage ref=""></w2:expandedImage>';
    strTarget += '<w2:leafImage ref=""></w2:leafImage>';
    strTarget += '</w2:itemset>';
    strTarget += '</w2:treeview>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "treeview",
        strTarget,
        grp_comp
    );
}



scwin.target1_ontooltipshow = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_ontooltipshow 이벤트 발생=====");
    wf_body_bottom.getObj("scwin").setReturnValue("e:" + e);   
}]]></script>
