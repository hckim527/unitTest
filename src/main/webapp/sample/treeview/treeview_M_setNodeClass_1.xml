		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; M &gt; setNodeClass]&lt;br/&gt;특정 트리 아이템 요소에 클래스를 추가합니다.&quot;,
    &quot;validation&quot; : [
        &quot;index(필수) 파라미터로 클래스를 추가 하려는 트리 아이템의 인덱스 또는 Value 값을 설정합니다.&quot;,
        &quot;숫자로 설정 시 인덱스로 적용됩니다.&quot;,
        &quot;트리 아이템의 인덱스는 1 부터 시작합니다.&quot;,
        &quot;cssName(필수) 파라미터로 CSS 파일이나 style 블럭에 정의된 클래스 이름을 공백으로 구분하여 설정합니다.&quot;,
        &quot;이미 추가된 클래스는 다시 추가되지 않습니다.&quot;,
        &quot;applyChildNodes(선택) 파라미터로 자식 아이템에도 동일하게 적용할지 true/false 로 설정합니다.&quot;,
        &quot;renderType=table 이면 applyChildNodes(선택) 파라미터가 항상 true 로 동작합니다.&quot;,
        &quot;renderType=virtual 이면 트리 아이템이 선택되었을때 'treeview_select_nodedom' 클래스가 우선 적용됩니다.&quot;,
        &quot;renderType=table 이면 트리 아이템의 table 태그에 클래스가 추가됩니다.&quot;,
        &quot;renderType=virtual 이면 트리 아이템의 div 태그에 클래스가 추가됩니다.&quot;,
        &quot;트리 아이템의 인덱스는 렌더링 시 Depth-First Search 방식으로 부여됩니다.&quot;
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        renderType : con_renderType.getText(),
    }

    let cList = $c.gcm.createCList(properties);    

    $c.gcm.createBasicTreeView(cList);     
}



scwin.btn_getClassName_onclick = function (e) {
    let index = par_index.getText();

    if (index !== &quot;&quot;) {
        if (target1.options.renderType == &quot;virtual&quot;) {
            let divElement = document.querySelector('div[id*=&quot;target1_node_'+index+'&quot;]');

            if (divElement) {
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item[&quot;+index+&quot;] tagName: &quot; + divElement.tagName);   
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item[&quot;+index+&quot;] className: &quot; + divElement.className);   
            }        
        }
        else {
            let tableElement = document.querySelector('table[id*=&quot;target1_node_'+index+'&quot;]');

            if (tableElement) {
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item[&quot;+index+&quot;] tagName: &quot; + tableElement.tagName);               
                wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item[&quot;+index+&quot;] className : &quot; + tableElement.className);               
            }
        }
    }
};



scwin.brn_setNodeClass_onclick = function (e) {
    let index = Number(par_index.getText());
    let cssName = par_cssName.getText();
    let applyChildNodes = par_applyChildNodes.getText();

    if (applyChildNodes == &quot;&quot;)
	    target1.setNodeClass(index, cssName);
    else
        target1.setNodeClass(index, cssName, applyChildNodes);

    scwin.btn_getClassName_onclick();
};
</script>
