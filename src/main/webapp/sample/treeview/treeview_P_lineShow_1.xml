		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[treeview &gt; P &gt; lineShow]&lt;br/&gt;부모가 동일한 트리 아이템 사이를 세로선으로 표시할지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;미설정 또는 true 설정 시 부모가 동일한 트리 아이템 사이를 세로선으로 표시합니다.&quot;,
        &quot;false 설정 시 트리 아이템 사이에 세로선을 표시하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        lineShow : con_lineShow.getText(),                
    }

    let cList = $c.gcm.createCList(properties);    

    $c.gcm.createBasicTreeView(cList); 

    scwin.btn_getLineShow_onclick();
}



scwin.btn_getLineShow_onclick = function (e) {
    let lineElements = document.querySelectorAll('td[id*=&quot;target1_guideline&quot;]');

    if (lineElements.length &gt; 0) {
        for (var i=0; i &lt; lineElements.length; i++) {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;line[&quot;+i+&quot;] className : &quot; + lineElements[i].className);   
        }
    }       
};</script>
	</head>
