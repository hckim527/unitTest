		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > validator]<br/>컴포넌트에서 포커스가 해제될때 입력값 검증을 위한 사용자 정의 함수를 설정합니다.",
    "validation" : [
        "입력값 검증을 위한 사용자 정의 함수를 설정합니다.",
        "사용자 정의 함수의 파라미터로 입력값과 대상 컴포넌트의 렌더링 ID 가 전달됩니다.",
        "사용자 정의 함수의 반환값이 새로운 입력값으로 적용됩니다.",
        "사용자 정의 함수가 모두 수행된 후 onblur 이벤트가 발생합니다.",
        "enterBlur=false 일때 Enter 키에 의한 포커스 해제가 안되므로 사용자 정의 함수가 호출되지 않습니다.",
        "사용자 정의 함수의 반환값으로 입력값이 수정되면 onchange -> onviewchange -> onblur 순으로 이벤트가 발생합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// 공백 제거 사용자 정의 함수
objParent.scwin.fn_validator = function(val, id) { 
    let  rtn = "id : " + id + ", val : " + val

    return rtn;
}



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};




objParent.scwin.target1_onchange = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange 이벤트 발생=====");    
}



objParent.scwin.target1_onviewchange = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onviewchange 이벤트 발생=====");    
}



objParent.scwin.target1_onblur = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onblur 이벤트 발생=====");    
}



scwin.btn_focus_onclick = function (e) {
    objParent.target1.focus();
};
]]></script>
