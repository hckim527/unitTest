		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > maxlength]<br/>컴포넌트에 입력 가능한 최대 길이를 설정합니다.",
    "validation" : [
        "한 문자의 길이를 1 로 계산(다국어 포함)하여 입력 가능한 최대 길이를 숫자로 설정합니다.",
        "값을 설정하지 않으면 '-1' 로 적용되어 입력을 제한하지 않습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_validate_onclick = function (e) {
    let rtn = objParent.target1.validate();

    if (rtn) 
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : PASS");
    else
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : FAIL");
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    let tagName = objParent.target1.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = objParent.target1.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = objParent.target1.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }
};]]></script>
	</head>
