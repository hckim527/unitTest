		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > adjustMaxLength]<br/>입력값이 '+' 또는 '-' 부호로 시작할 때, 해당 부호를 maxlength 길이 계산에 포함할지 여부를 결정합니다.",
    "validation" : [
        "미설정 시 부호의 길이를 maxlength 계산에 포함합니다.",
        "true 설정 시 부호의 길이를 maxlength 계산에서 제외합니다.",
        "false 설정 시 부호의 길이를 maxlength 계산에 포함합니다.",
        "dataType='number' 이고 maxlength 속성이 설정된 경우에만 동작합니다.",
        "maxlength 속성이 설정되어 있어도, 우선순위에 의해 적용되지 않으면 adjustMaxLength 속성은 항상 false 로 동작합니다.",
        "'+','-' 부호는 입력값의 첫번째 문자일때만 적용됩니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    if (objParent.target1.render.tagName !== "INPUT") {
        rtn = objParent.target1.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = objParent.target1.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }
};
]]></script>
