		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();

let cAnimationColor = '';
let cAnimationType = '';
let cClass = '';




// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > animationType]<br/>컴포넌트를 클릭(터치) 시 재생될 애니메이션 효과를 설정합니다.",
    "validation" : [
        "class 속성에 'btn_bubble' 을 설정한 경우에 동작합니다.",
        "'bubble' 설정 시 클릭(터치) 위치에서 원이 퍼져 나가는 애니메이션 효과가 적용되어야 합니다.",
        "'' 설정 시 애니메이션 효과가 적용되지 않아야 합니다.",
        "미설정 시 애니메이션 효과가 적용되지 않아야 합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};




// comp 재생성
scwin.comp_init = function () {
    cAnimationColor = con_animationColor.getText();
    cAnimationType = con_animationType.getText();
    cClass = con_class.getValue();

    objParent.scwin.gVar["cAnimationColor"] = cAnimationColor;
    objParent.scwin.gVar["cAnimationType"] = cAnimationType;
    objParent.scwin.gVar["cClass"] = cClass;

    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getAnimation_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.options.animationColor
    wf_body_bottom.getObj("scwin").setReturnValue("animationColor : " + rtn);

    rtn = objParent.target1.options.animationType
    wf_body_bottom.getObj("scwin").setReturnValue("animationType : " + rtn);      
};
]]></script>
	</head>
