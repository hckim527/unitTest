		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();

let cName = '';



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > name]<br/>컴포넌트의 HTML name 속성을 설정합니다.",
    "validation" : [
        "name 속성에 설정할 값을 문자열로 설정할 수 있어야 합니다.",
        "렌더링 시 native 태그에 설정된 값이 name 속성으로 추가되어야 합니다.",
        "name 을 설정하지 않으면 native 태그에 name 속성이 추가되지 않아야 합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};




// comp 재생성
scwin.comp_init = function () {
    cName = con_name.getText();

    objParent.scwin.gVar["cName"] = cName;

    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getName_onclick = function (e) {
    let rtn = '';

    rtn = objParent.target1.render.getAttribute("name");
    wf_body_bottom.getObj("scwin").setReturnValue("name : " + rtn);
};]]></script>
