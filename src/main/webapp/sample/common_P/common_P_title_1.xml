		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();

let cTitle = '';



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > P > title]<br/>컴포넌트의 title 속성을 설정합니다.",
    "validation" : [
        "title 속성값을 문자열로 설정합니다.",
        "컴포넌트에 마우스 오버 시 설정된 문자열이 브라우저 기본 툴팁으로 표시되어야 합니다.",
        "title 속성에 설정된 값은 컴포넌트에 표시되지 않습니다.",   
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};




// comp 재생성
scwin.comp_init = function () {
    cTitle = con_title.getValue();

    objParent.scwin.gVar["cTitle"] = cTitle;

    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getTitle_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.render.title  
    wf_body_bottom.getObj("scwin").setReturnValue("title : " + rtn);  
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    let compName = objParent.target1.getPluginName();

    // value 로 확인
    if (compName == "trigger")
        rtn = objParent.target1.render.value
    // textContent 로 확인
    else
        rtn = objParent.target1.render.textContent
    
    wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
