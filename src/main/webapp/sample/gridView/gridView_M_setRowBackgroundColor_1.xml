		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; setRowBackgroundColor]&lt;br/&gt;Row 인덱스를 사용하여 특정 Row 의 배경색을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 배경색을 설정할 특정 Row 의 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;Row 인덱스는 0 부터 시작하며 GridView 컴포넌트에 표시된 Row 만 인덱스가 설정됩니다.&quot;,
        &quot;color(필수) 파라미터로 Row 에 적용할 배경색을 설정할 수 있어야 합니다.&quot;,        
        &quot;color 파라미터의 배경색은 Cell 의 Inline Style 에 background-color 로 적용되어야 합니다.&quot;,
        &quot;color 를 빈 문자열로 설정 시 GridView 의 배경색이 적용되어야 합니다.&quot;,
        &quot;배경색은 GridView, Row, Column, Cell 순서로 적용되며 Cell 에 설정된 배경색이 최우선 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 사전 설정 기본값 : 없음
    con_preset.setValue(&quot;1&quot;);

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 사전 설정 (1:없음, 2:GridView, 3:Column, 4:Cell)
    let preset = con_preset.getValue();

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
        class: (preset === &quot;2&quot;) ? &quot;gv_preset_bg&quot; : &quot;&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // validation 5, 6 확인용 상위/하위 단위 배경색 사전 설정
    if (preset === &quot;3&quot;) {
        target1.setColumnBackgroundColor(&quot;col2&quot;, &quot;green&quot;);
    } else if (preset === &quot;4&quot;) {
        target1.setCellBackgroundColor(0, &quot;col3&quot;, &quot;orange&quot;);
    }
}



scwin.btn_setRowBackgroundColor_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let color = par_color.getText();

    target1.setRowBackgroundColor(rowIndex, color);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setRowBackgroundColor(&quot; + rowIndex + &quot;, &quot; + color + &quot;)&quot;);

    // getRowBackgroundColor 로 설정값 확인
    let rtn = target1.getRowBackgroundColor(rowIndex);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getRowBackgroundColor(&quot; + rowIndex + &quot;) : &quot; + rtn);

    // validation 4~6 판정 출력 : 사전 설정 시 해당 Row Cell(col1~col4)의 Inline Style 과 실제 적용 배경색
    if (con_preset.getValue() !== &quot;1&quot;) {
        let inlineArr = [];
        let appliedArr = [];
        for (let c = 0; c &lt; 4; c++) {
            let td = document.querySelector(&quot;#&quot; + target1.id + &quot;_cell_&quot; + rowIndex + &quot;_&quot; + c);
            inlineArr.push(td.style.backgroundColor || &quot;없음&quot;);
            appliedArr.push(getComputedStyle(td).backgroundColor);
        }
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Inline background-color : &quot; + inlineArr.join(&quot;, &quot;));
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;적용 배경색 : &quot; + appliedArr.join(&quot;, &quot;));
    }
}</script>
