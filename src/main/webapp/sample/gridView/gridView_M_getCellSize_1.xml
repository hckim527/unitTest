		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getCellSize]&lt;br/&gt;Row 인덱스와 Cell 정보를 사용하여 특정 Cell 의 높이(Height) 또는 너비(Width)를 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 크기를 조회할 특정 Cell 의 Row 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;colInfo(필수) 파라미터로 크기를 조회할 특정 Cell 의 Column 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;sizeName(필수) 파라미터를 'height' 로 설정 시 Cell 의 높이(Height)를 반환해야 합니다.&quot;,
        &quot;sizeName(필수) 파라미터를 'width' 로 설정 시 Cell 의 너비(Width)를 반환해야 합니다.&quot;,
        &quot;반환값으로 sizeName 파라미터값에 맞게 특정 Cell 의 높이(Height) 또는 너비(Width)값을 반환합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    $c.gcm.createBasicGridView(cList);

    // Cell 크기를 각각 다르게 설정
    target1.setColumnWidth(&quot;col1&quot;, 80);
    target1.setColumnWidth(&quot;col2&quot;, 120);
    target1.setColumnWidth(&quot;col3&quot;, 150);
    target1.setColumnWidth(&quot;col4&quot;, 200);
    document.querySelector(&quot;td[id*='target1_cell_0_0']&quot;).style.height = &quot;30px&quot;;
    document.querySelector(&quot;td[id*='target1_cell_1_0']&quot;).style.height = &quot;40px&quot;;
    document.querySelector(&quot;td[id*='target1_cell_2_0']&quot;).style.height = &quot;50px&quot;;
    document.querySelector(&quot;td[id*='target1_cell_3_0']&quot;).style.height = &quot;60px&quot;;
}



scwin.btn_getCellSize_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let colInfo = Number(par_colInfo.getText());
    let sizeName = par_sizeName.getText();

    let rtn = target1.getCellSize(rowIndex, colInfo, sizeName);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellSize(&quot; + rowIndex + &quot;, &quot; + colInfo + &quot;, &quot; + sizeName + &quot;) : &quot; + rtn);
}</script>
