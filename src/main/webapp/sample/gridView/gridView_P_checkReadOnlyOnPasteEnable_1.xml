scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; P &gt; checkReadOnlyOnPasteEnable]&lt;br/&gt;읽기 전용(readonly) 상태인 Cell 에서 Ctrl+V 로 데이터 붙여넣기를 허용할 Column 의 ID 를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;checkReadOnlyOnPasteEnable 에 설정된 Column 의 읽기 전용 Cell 에는 Ctrl+V 로 데이터를 붙여넣기 할 수 있어야 합니다.&quot;,
        &quot;--- 두 개 이상의 Column 을 설정 시 콤마(&quot;,&quot;)를 사용하여 목록 형태로 공백 없이 설정합니다.&quot;,
        &quot;--- Ctrl+V 로 데이터를 붙여넣기 하면 Row 상태값이 변경되어야 합니다.&quot;,
        &quot;checkReadOnlyOnPasteEnable 에 설정되지 않은 Column 의 읽기 전용 Cell 에는 Ctrl+V 로 데이터 붙여넣기를 허용하지 않아야 합니다.&quot;,        
        &quot;Column 단위로 데이터 붙여넣기를 허용합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // textarea 초기값 설정
    par_copyValue.setValue(&quot;paste_1\npaste_2\npaste_3\npaste_4&quot;);

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getFocusedRowStatus_onclick = function () {
    let rtn = target1.getFocusedRowStatus();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getFocusedRowStatus : &quot; + rtn);
}



scwin.btn_getAllDisplayJSON_onclick = function () {
    let rtn = JSON.stringify(target1.getAllDisplayJSON());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getAllDisplayJSON() : &quot; + rtn);
}</script>
