		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; removeCellClass]&lt;br/&gt;Body Cell 정보를 사용하여 특정 Body Cell 에 설정된 CSS 클래스를 제거합니다.&quot;,
    &quot;validation&quot; : [
        &quot;columnInfo(필수) 파라미터로 CSS 클래스를 제거할 Body Cell 의 Column ID 를 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성 (기본 4행)
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성 (Body Column ID: col1 ~ col4, 전부 표시)
    await $c.gcm.createBasicGridView(cList);
}



scwin.btn_setCellClass_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let columnInfo = par_columnInfo.getValue();

    // 준비: Column ID 로 Body Cell 에 CSS 클래스(cRed cBlue) 설정
    target1.setCellClass(rowIndex, columnInfo, &quot;cRed cBlue&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setCellClass(&quot; + rowIndex + &quot;, '&quot; + columnInfo + &quot;', 'cRed cBlue')&quot;);

    // getCellClass 로 설정값 확인
    let rtn = target1.getCellClass(rowIndex, columnInfo);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellClass(&quot; + rowIndex + &quot;, '&quot; + columnInfo + &quot;') : &quot; + rtn);
}



scwin.btn_removeCellClass_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let columnInfo = par_columnInfo.getValue();
    let className = par_className.getText();

    // Column ID 로 Body Cell 에 설정된 CSS 클래스 제거
    target1.removeCellClass(rowIndex, columnInfo, className);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;removeCellClass(&quot; + rowIndex + &quot;, '&quot; + columnInfo + &quot;', '&quot; + className + &quot;')&quot;);

    // getCellClass 로 제거 후 남은 클래스 확인 (공백구분 복수 제거 시 일부만 남는지 포함)
    let rtn = target1.getCellClass(rowIndex, columnInfo);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellClass(&quot; + rowIndex + &quot;, '&quot; + columnInfo + &quot;') : &quot; + rtn);

    // Body Cell 의 td 요소에 적용된 className 확인 (기본 클래스 공존)
    let colIndex = target1.getColumnIndex(columnInfo);
    let cellEl = document.querySelector(&quot;td[id*='target1_cell_&quot; + rowIndex + &quot;_&quot; + colIndex + &quot;']&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;td className : &quot; + cellEl.className);
}</script>
	</head>
