		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getCellReadOnly]&lt;br/&gt;Row 인덱스와 Column 정보를 사용하여 특정 Cell 의 readOnly 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 readOnly 속성값을 조회할 특정 Cell 의 Row 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;colInfo(필수) 파라미터로 readOnly 속성값을 조회할 특정 Cell 의 Column 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;setCellReadOnly() 메소드로 readOnly 속성을 설정하지 않은 Cell 은 빈 문자열을 반환해야 합니다.&quot;,
        &quot;반환값이 빈 문자열인 Cell 은 상위 모듈의 읽기 전용(readonly) 상태가 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 상위 모듈 readOnly 사전 설정 기본값 : 없음
    con_parentReadOnly.setSelectedIndex(0);

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 상위 모듈(GridView/Row/Column) readOnly 사전 설정 (Target 재생성 시 반영)
    let parentReadOnly = con_parentReadOnly.getValue();
    let parentLabel = con_parentReadOnly.getText();

    $c.gcm.createLabel('label=&quot;Cell(0,0)/(3,3) 은 readOnly 설정, Cell(1,2)/(2,2) 는 readOnly 해제, Column 1 은 숨겨진 상태' + (parentReadOnly ? ', 상위 모듈 readOnly 사전 설정 : ' + parentLabel : '') + '&quot;', '', 'label1');

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
        readOnlyBackgroundColor: &quot;#D3D3D3&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // 두번째 컬럼 숨김
    target1.setColumnVisible(1, false);

    // Cell(0,0)/(3,3) 에 readOnly 설정
    target1.setCellReadOnly(0, 0, true);
    target1.setCellReadOnly(3, 3, true);
    // Cell(1,2)/(2,2) 에 readOnly 해제
    target1.setCellReadOnly(1, 2, false);
    target1.setCellReadOnly(2, 2, false);

    // 상위 모듈 readOnly 사전 설정 (validation 4 확인용)
    if (parentReadOnly === &quot;grid&quot;) {
        target1.setGridReadOnly(true);
    } else if (parentReadOnly === &quot;row&quot;) {
        target1.setRowReadOnly(0, true);
    } else if (parentReadOnly === &quot;column&quot;) {
        target1.setColumnReadOnly(2, true);
    }
}



scwin.btn_getCellReadOnly_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let colInfo = Number(par_colInfo.getText());

    let rtn = target1.getCellReadOnly(rowIndex, colInfo);
    let msg = &quot;getCellReadOnly(&quot; + rowIndex + &quot;, &quot; + colInfo + &quot;) : &quot; + rtn;
    // validation 4 판정 출력 : 상위 모듈 readOnly 사전 설정 시 Cell 에 실제 적용된 readOnly 상태
    if (con_parentReadOnly.getValue()) {
        msg += &quot; / 적용 readOnly : &quot; + target1.getReadOnly(&quot;all&quot;, rowIndex, colInfo);
    }
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(msg);
}</script>
