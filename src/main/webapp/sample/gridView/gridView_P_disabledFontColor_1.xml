		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[gridView > P > disabledFontColor]<br/>비활성화(disabled) 상태인 Body Cell 의 글자색으로 적용될 색상을 설정합니다.",
    "validation" : [
        "비활성화(disabled) 상태인 Body Cell 의 글자색으로 적용될 색상을 설정합니다.",
        "색상이름('blue','red'), 색상코드('#rrggbb'), 함수형 색상('rgb(255,0,255)','rgba(255,0,255,0.5)')등 다양한 형식으로 설정할 수 있습니다.",
        "속성값은 각 Body Cell 의 style 속성에 color 로 적용됩니다.",
        "rowNum, rowStatus Column 에는 적용되지 않습니다.",
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // [target1] disabledFontColor='blue' (색상이름) / RowNum, RowStatus Column 표시 → 미적용 확인
    //  Row 0 → Row 단위 disabled
    target1.setRowDisabled(0, true);

    // [target2] disabledFontColor='red' (색상이름) / Row 0 → Row 단위 disabled
    target2.setRowDisabled(0, true);

    // [target3] disabledFontColor='#7FFFD4' (색상코드) / Column col2 → Column 단위 disabled
    target3.setColumnDisabled("col2", true);

    // [target4] disabledFontColor='rgb(255,0,255)' (함수형) / Cell(0, col1) → Cell 단위 disabled
    target4.setCellDisabled(0, "col1", true);

    // [target5] disabledFontColor='rgba(255,0,255,0.5)' (함수형) / Cell(0, col1) → Cell 단위 disabled
    target5.setCellDisabled(0, "col1", true);
};



scwin.btn_checkFontColor_onclick = function () {
    // [target1] disabled Body Cell(0,col1) 글자색 + RowNum / RowStatus Column 미적용 확인
    let t1_body = document.querySelector("td[id*='target1_cell_0_0']");
    wf_body_bottom.getObj("scwin").setReturnValue("[target1=blue] disabled Body Cell(0,col1) : " + t1_body.style.color);
    let t1_row = t1_body.closest("tr");
    let t1_rowNum = t1_row ? t1_row.querySelector("td[class*='_rowNumber']") : null;
    if (t1_rowNum) {
        wf_body_bottom.getObj("scwin").setReturnValue("[target1] RowNum Column (미적용) : " + t1_rowNum.style.color);
    }
    let t1_rowStatus = t1_row ? t1_row.querySelector("td[class*='_rowStatus']") : null;
    if (t1_rowStatus) {
        wf_body_bottom.getObj("scwin").setReturnValue("[target1] RowStatus Column (미적용) : " + t1_rowStatus.style.color);
    }

    // [target2] disabled Body Cell(0,col1) 글자색
    let t2_body = document.querySelector("td[id*='target2_cell_0_0']");
    wf_body_bottom.getObj("scwin").setReturnValue("[target2=red] disabled Body Cell(0,col1) : " + t2_body.style.color);

    // [target3] Column 단위 disabled Cell(0,col2) 글자색
    let t3_body = document.querySelector("td[id*='target3_cell_0_1']");
    wf_body_bottom.getObj("scwin").setReturnValue("[target3=#7FFFD4] disabled Body Cell(0,col2) : " + t3_body.style.color);

    // [target4] Cell 단위 disabled Cell(0,col1) 글자색
    let t4_body = document.querySelector("td[id*='target4_cell_0_0']");
    wf_body_bottom.getObj("scwin").setReturnValue("[target4=rgb(255,0,255)] disabled Body Cell(0,col1) : " + t4_body.style.color);

    // [target5] Cell 단위 disabled Cell(0,col1) 글자색
    let t5_body = document.querySelector("td[id*='target5_cell_0_0']");
    wf_body_bottom.getObj("scwin").setReturnValue("[target5=rgba(255,0,255,0.5)] disabled Body Cell(0,col1) : " + t5_body.style.color);
}]]></script>
