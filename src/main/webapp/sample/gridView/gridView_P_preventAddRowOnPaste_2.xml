		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; P &gt; preventAddRowOnPaste]&lt;br/&gt;줄바꿈 구분자가 포함된 데이터를 붙여넣기(Ctrl+V)할 때 새로운 Row 추가를 차단할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;preventPaste 속성으로 붙여넣기(Ctrl+V)가 차단된 경우 preventAddRowOnPaste 속성은 무시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출 (gdl_boolean 등)
    $c.gcm.createCommonDatalist();

    // con 옵션 초기값 : preventPaste=true (붙여넣기 차단), preventAddRowOnPaste=true
    con_preventPaste.setValue(&quot;true&quot;);
    con_preventAddRowOnPaste.setValue(&quot;true&quot;);

    // comp 초기 생성
    scwin.comp_init();

    // 붙여넣기 시도용 값 초기화 (줄바꿈 구분 3줄 → 2행 그리드보다 많음)
    par_copyValue.setValue(&quot;paste_1\npaste_2\npaste_3&quot;);

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target / dataList 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정 : checkEditOnPaste=true, copyType='default' 하드코딩 + con 옵션 반영
    let properties = {
        checkEditOnPaste: &quot;true&quot;,
        copyType: &quot;default&quot;,
        preventPaste: con_preventPaste.getText(),
        preventAddRowOnPaste: con_preventAddRowOnPaste.getText(),
        dataList: &quot;data:dlt_bind&quot;,
        rowStatusVisible: &quot;true&quot;,
        rowStatusHeaderValue: &quot;St.&quot;,
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onviewchange&quot;]);

    // dataList 생성 (공통 함수, 4행)
    await $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList, eList);
}



// Cell 단위 붙여넣기 발생 시(차단되지 않았을 때만) 발화 → 자동 출력
scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;[onviewchange] row:&quot; + info.rowIndex + &quot; col:&quot; + info.colIndex + &quot; &quot; + info.oldValue + &quot;→&quot; + info.newValue);
}</script>
