		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; setRowColor]&lt;br/&gt;Row 인덱스를 사용하여 특정 Row 의 글자색을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 글자색을 설정할 특정 Row 의 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;Row 인덱스는 0 부터 시작하며 GridView 컴포넌트에 표시된 Row 만 인덱스가 설정됩니다.&quot;,
        &quot;color(필수) 파라미터로 Row 에 적용할 글자색을 설정할 수 있어야 합니다.&quot;,
        &quot;color 파라미터의 글자색은 Cell 의 Inline Style 에 color 로 적용되어야 합니다.&quot;,
        &quot;color 를 빈 문자열로 설정 시 GridView 의 글자색이 적용되어야 합니다.&quot;,
        &quot;글자색은 GridView, Row, Column, Cell 순서로 적용되며 Cell 에 설정된 글자색이 최우선 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    $c.gcm.createBasicGridView(cList);
}



scwin.btn_setRowColor_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let color = par_color.getText();

    target1.setRowColor(rowIndex, color);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setRowColor(&quot; + rowIndex + &quot;, &quot; + color + &quot;)&quot;);

    // getRowColor 로 설정값 확인
    let rtn = target1.getRowColor(rowIndex);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getRowColor(&quot; + rowIndex + &quot;) : &quot; + rtn);
}</script>
	</head>
