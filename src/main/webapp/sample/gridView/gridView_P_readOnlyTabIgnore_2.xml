<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260313" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[col1_1]]></col1>
							<col2><![CDATA[col2_1]]></col2>
							<col3><![CDATA[col3_1]]></col3>
							<col4><![CDATA[col4_1]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_2]]></col1>
							<col2><![CDATA[col2_2]]></col2>
							<col3><![CDATA[col3_2]]></col3>
							<col4><![CDATA[col4_2]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_3]]></col1>
							<col2><![CDATA[col2_3]]></col2>
							<col3><![CDATA[col3_3]]></col3>
							<col4><![CDATA[col4_3]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_4]]></col1>
							<col2><![CDATA[col2_4]]></col2>
							<col3><![CDATA[col3_4]]></col3>
							<col4><![CDATA[col4_4]]></col4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; P &gt; readOnlyTabIgnore]&lt;br/&gt;Tab 키로 Cell 포커스를 이동할때 읽기 전용(readonly) 상태의 Cell 을 건너 뛸지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;false(기본값) 설정 시 Tab 키로 Cell 포커스 이동 시 읽기 전용(readonly) 상태의 Cell 에도 포커스가 이동해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Column 1, Column 3 readOnly 설정
    target1.setColumnReadOnly(1, true);
    target1.setColumnReadOnly(3, true);

    // 첫번째 Cell 에 포커스 이동
    target1.setFocusedCell(0, 0, true);

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.target1_onkeydown = function (e) {
    if (e.key === &quot;Tab&quot;) {
        let row = target1.getFocusedRowIndex();
        let col = target1.getFocusedColumnIndex();
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Tab 키 입력 → 포커스 위치 (row: &quot; + row + &quot;, col: &quot; + col + &quot;)&quot;);
    }
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="" id="label1" label="readOnlyTabIgnore=false / Column 1 readOnly=true, Column 3 readOnly=true" class="" escape="false"></w2:textbox>
						<w2:gridView checkAllType="false" id="target1" style="width:500px;height:300px;" dataList="data:dlt_bind"
							readOnlyTabIgnore="false" readOnlyBackgroundColor="#D3D3D3" ev:onkeydown="scwin.target1_onkeydown">
							<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="70" inputType="text" id="column1" value="name1"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="name2(RO)"></w2:column>
									<w2:column width="70" inputType="text" id="column3" value="name3"></w2:column>
									<w2:column width="70" inputType="text" id="column4" value="name4(RO)"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="70" inputType="text" id="col1"></w2:column>
									<w2:column width="70" inputType="text" id="col2"></w2:column>
									<w2:column width="70" inputType="text" id="col3"></w2:column>
									<w2:column width="70" inputType="text" id="col4"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>