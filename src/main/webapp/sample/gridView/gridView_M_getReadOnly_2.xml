		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getReadOnly]&lt;br/&gt;파라미터에 맞게 특정 단위의 readOnly 속성값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;colInfo(필수) 파라미터로 Column 의 ID 를 설정할 수 있어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    $c.gcm.createLabel('label=&quot;Grid readOnly=true, Row 0 readOnly=false, Column col2 readOnly=true, Cell(3,col4) readOnly=false&quot;', '', 'label1');

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
        readOnlyBackgroundColor: &quot;#D3D3D3&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // readOnly 설정
    target1.setGridReadOnly(true);
    target1.setRowReadOnly(0, false);
    target1.setColumnReadOnly("col2", true);
    target1.setCellReadOnly(3, "col4", false);
}



scwin.btn_getReadOnly_onclick = function () {
    let type = par_type.getText();
    let rowIndex = Number(par_rowIndex.getText());
    let colInfo = par_colInfo.getText();

    let rtn;
    if (type === 'grid') {
        rtn = target1.getReadOnly(&quot;grid&quot;);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('grid') : &quot; + JSON.stringify(rtn));
    } else if (type === 'row') {
        rtn = target1.getReadOnly(&quot;row&quot;, rowIndex);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('row', &quot; + rowIndex + &quot;) : &quot; + JSON.stringify(rtn));
    } else if (type === 'column') {
        rtn = target1.getReadOnly(&quot;column&quot;, colInfo);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('column', '&quot; + colInfo + &quot;') : &quot; + JSON.stringify(rtn));
    } else if (type === 'cell') {
        rtn = target1.getReadOnly(&quot;cell&quot;, rowIndex, colInfo);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('cell', &quot; + rowIndex + &quot;, '&quot; + colInfo + &quot;') : &quot; + JSON.stringify(rtn));
    } else if (type === 'all') {
        rtn = target1.getReadOnly(&quot;all&quot;, rowIndex, colInfo);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('all', &quot; + rowIndex + &quot;, '&quot; + colInfo + &quot;') : &quot; + JSON.stringify(rtn));
    }
}</script>
	</head>
