		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getRowColor]&lt;br/&gt;Row 인덱스를 사용하여 특정 Row 의 글자색을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 글자색을 조회할 특정 Row 의 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;setRowColor 등으로 글자색을 설정한 Row 의 글자색을 반환하여야 합니다.&quot;,
        &quot;글자색을 설정하지 않은 Row 는 빈 문자열을 반환하여야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // 글자색 조회를 위해 일부 Row 에 글자색 설정
    target1.setRowColor(0, &quot;red&quot;);
    target1.setRowColor(2, &quot;blue&quot;);
}



scwin.btn_getRowColor_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());

    let rtn = target1.getRowColor(rowIndex);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getRowColor(&quot; + rowIndex + &quot;) : &quot; + (rtn === &quot;&quot; ? '&quot;&quot;(Empty String)' : rtn));
}</script>
	</head>
