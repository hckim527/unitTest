		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getCellColor]&lt;br/&gt;Row 인덱스와 Column 정보를 사용하여 특정 Cell 의 글자색을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;rowIndex(필수) 파라미터로 글자색을 조회할 특정 Cell 의 Row 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;colInfo(필수) 파라미터로 글자색을 조회할 특정 Cell 의 Column 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;파라미터값에 맞게 특정 Cell 의 글자색을 반환하여야 합니다.&quot;,
        &quot;setCellColor 등의 메소드로 글자색을 설정하지 않았으면 빈 문자열을 반환하여야 합니다.&quot;,
        &quot;반환값이 빈 문자열인 Cell 은 상위 모듈의 글자색이 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    $c.gcm.createBasicGridView(cList);

    // 글자색 설정 (조회 확인용)
    target1.setCellColor(0, 0, &quot;red&quot;);
    target1.setCellColor(0, 1, &quot;blue&quot;);
    target1.setCellColor(0, 2, &quot;#00ff00&quot;);
    target1.setCellColor(0, 3, &quot;rgb(255,0,255)&quot;);
    target1.setCellColor(1, 0, &quot;orange&quot;);
    target1.setCellColor(2, 0, &quot;skyblue&quot;);
    target1.setCellColor(3, 0, &quot;yellow&quot;);
}



scwin.btn_getCellColor_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let colInfo = Number(par_colInfo.getText());

    let rtn = target1.getCellColor(rowIndex, colInfo);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellColor(&quot; + rowIndex + &quot;, &quot; + colInfo + &quot;) : &quot; + rtn);
}</script>
	</head>
