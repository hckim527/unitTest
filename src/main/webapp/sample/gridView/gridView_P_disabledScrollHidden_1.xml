		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[gridView > P > disabledScrollHidden]<br/>GridView 컴포넌트가 비활성화(disabled) 상태일때 스크롤바를 함께 숨길지 설정합니다.",
    "validation" : [
        "GridView 컴포넌트가 비활성화(disabled) 상태일때 스크롤바를 함께 숨길지 설정합니다.",
        "Row/Column/Cell 단위로 비활성화(disabled) 상태가 설정된 경우는 적용되지 않습니다.",
        "true : GridView 컴포넌트가 disabled 상태이면 가로/세로 스크롤바 영역을 모두 숨깁니다.",
        "false (default) : GridView 컴포넌트가 disabled 상태여도 가로/세로 스크롤바를 숨기지 않고 유지합니다.",
        "미설정 시 기본값 false 로 동작하여 disabled 상태여도 스크롤바를 유지합니다.",
        "GridView 컴포넌트의 disabled 상태가 해제되면 overflowX, overflowY 속성값에 맞게 스크롤바가 다시 표시됩니다.",
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // [target3] disabledScrollHidden='true' 이지만 Row/Cell 단위 disabled 만 적용 (컴포넌트 전체 disabled 아님)
    //  → @description 에 따라 스크롤바 숨김 미적용
    target3.setRowDisabled(0, true);
    target3.setCellDisabled(2, "col3", true);
};



// GridView 컴포넌트 전체 setDisabled(true)
//  target3 는 컴포넌트 전체 disabled 대상에서 제외 (Row/Cell 단위 disabled 만 유지하여 "단위 disabled 미적용" 검증)
scwin.btn_setDisabledTrue_onclick = function () {
    target1.setDisabled(true);
    target2.setDisabled(true);
    target4.setDisabled(true);
};

// GridView 컴포넌트 전체 setDisabled(false) — disabled 해제
scwin.btn_setDisabledFalse_onclick = function () {
    target1.setDisabled(false);
    target2.setDisabled(false);
    target4.setDisabled(false);
};

// 각 target 의 가로(scrollX_div) / 세로(scrollY_div) 스크롤바 영역 표시 상태 확인
//  - 가로 스크롤바 : scrollX_div 의 style.height ('0px' 이면 숨김, 그 외이면 표시)
//  - 세로 스크롤바 : scrollY_div 의 style.width  ('0px' 이면 숨김, 그 외이면 표시)
scwin.getScrollState = function (targetId) {
    let xDiv = document.querySelector("div[id*='" + targetId + "_scrollX_div']");
    let yDiv = document.querySelector("div[id*='" + targetId + "_scrollY_div']");
    let xHidden = (xDiv.style.height === "0px");
    let yHidden = (yDiv.style.width === "0px");
    return "가로 스크롤바 " + (xHidden ? "숨김" : "표시") + " / 세로 스크롤바 " + (yHidden ? "숨김" : "표시");
};

scwin.btn_checkScroll_onclick = function () {
    // [target1] disabledScrollHidden='true' → 컴포넌트 전체 disabled 시 가로/세로 스크롤바 모두 숨김
    wf_body_bottom.getObj("scwin").setReturnValue("[target1 disabledScrollHidden=true] " + scwin.getScrollState("target1"));

    // [target2] disabledScrollHidden='false'(기본값) → 컴포넌트 전체 disabled 여도 스크롤바 유지
    wf_body_bottom.getObj("scwin").setReturnValue("[target2 disabledScrollHidden=false] " + scwin.getScrollState("target2"));

    // [target3] disabledScrollHidden='true' + Row/Cell 단위 disabled 만 적용 → 스크롤바 숨김 미적용 (스크롤바 유지)
    wf_body_bottom.getObj("scwin").setReturnValue("[target3 Row/Cell 단위 disabled] " + scwin.getScrollState("target3"));

    // [target4] disabledScrollHidden 미설정(기본값 false) → 컴포넌트 전체 disabled 여도 스크롤바 유지
    wf_body_bottom.getObj("scwin").setReturnValue("[target4 disabledScrollHidden 미설정] " + scwin.getScrollState("target4"));
}]]></script>
	</head>
