		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; setStyleAll]&lt;br/&gt;JSON 객체를 사용하여 특정 단위에 Inline Style 을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;styleInfo.type 을 column 으로 설정하여 특정 Column 전체에 Inline Style 을 설정할 수 있어야 합니다.&quot;,
        &quot;styleInfo.colIndex(필수) 파라미터로 Inline Style 을 설정할 Column 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;styleInfo.styleName(필수) 파라미터로 설정하려는 Inline Style 의 CSS 속성명을 설정할 수 있어야 합니다.&quot;,
        &quot;styleInfo.styleValue(필수) 파라미터로 CSS 속성에 적용될 속성값을 설정할 수 있어야 합니다.&quot;,
        &quot;styleInfo.target 을 all 로 설정 시 고정 영역에 관계없이 대상 전체에 Inline Style 을 설정하여야 합니다.&quot;,
        &quot;styleInfo.target 을 fixed 로 설정 시 고정된 영역에만 Inline Style 을 설정하여야 합니다.&quot;,
        &quot;styleInfo.target 을 data 로 설정 시 고정되지 않은 영역에만 Inline Style 을 설정하여야 합니다.&quot;,
        &quot;type 이 column 일때 Inline Style 은 해당 Column 의 각 Cell 에 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        fixedColumn: 1,
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // 가로 스크롤 생성을 위해 gridView 너비 축소
    target1.setStyle(&quot;width&quot;, &quot;250px&quot;);
}



scwin.btn_setStyleAll_onclick = function () {
    let colIndex = Number(par_colIndex.getText());
    let styleName = par_styleName.getText();
    let styleValue = par_styleValue.getText();
    let target = par_target.getText();

    let styleInfo = {
        &quot;type&quot;: &quot;column&quot;,
        &quot;styleName&quot;: styleName,
        &quot;styleValue&quot;: styleValue,
        &quot;colIndex&quot;: colIndex,
        &quot;target&quot;: target
    };

    target1.setStyleAll(styleInfo);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setStyleAll(&quot; + JSON.stringify(styleInfo) + &quot;)&quot;);

    // 고정 영역(colIndex:0) 과 비고정 영역(colIndex:1) 의 style 값 확인
    let fixedCellEl = document.querySelector(&quot;td[id*='target1_cell_0_0']&quot;);
    let dataCellEl = document.querySelector(&quot;td[id*='target1_cell_0_1']&quot;);

    if (fixedCellEl) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;고정 영역 Cell(0, 0) style.&quot; + styleName + &quot; : &quot; + fixedCellEl.style.getPropertyValue(styleName));
    }
    if (dataCellEl) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;비고정 영역 Cell(0, 1) style.&quot; + styleName + &quot; : &quot; + dataCellEl.style.getPropertyValue(styleName));
    }
}</script>
	</head>
