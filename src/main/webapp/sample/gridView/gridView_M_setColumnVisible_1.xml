	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260312" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; setColumnVisible]&lt;br/&gt;Column 의 ID 또는 인덱스값을 사용하여 특정 Column 을 숨김 처리합니다.&quot;,
    &quot;validation&quot; : [
        &quot;columnInfo(필수) 파라미터로 숨기거나 표시할 특정 Column 의 인덱스를 설정할 수 있어야 합니다.&quot;,
        &quot;columnVisible 파라미터를 true 로 설정 시 해당 Column 을 GridView 컴포넌트에 표시해야 합니다.&quot;,
        &quot;columnVisible 파라미터를 false 로 설정 시 해당 Column 을 GridView 컴포넌트에서 숨겨야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);
}



scwin.btn_setColumnVisible_onclick = function () {
    let columnInfo = Number(par_columnInfo.getText());
    let columnVisible = par_columnVisible.getText() === 'true';

    target1.setColumnVisible(columnInfo, columnVisible);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setColumnVisible(&quot; + columnInfo + &quot;, &quot; + columnVisible + &quot;)&quot;);
}



scwin.btn_checkColumnVisible_onclick = function () {
    let columnInfo = Number(par_columnInfo.getText());

    // 설정된 Column 의 표시 여부 확인
    let thEl = document.querySelector(&quot;th[id*='target1_column&quot; + (columnInfo + 1) + &quot;']&quot;);

    if (thEl) {
        let isVisible = thEl.offsetWidth &gt; 0;
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Column(&quot; + columnInfo + &quot;) visible : &quot; + isVisible);
    }
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
