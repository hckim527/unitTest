		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; M &gt; getCellDisabled]&lt;br/&gt;Row 인덱스와 Column 정보를 사용하여 특정 Cell 의 disabled 상태를 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;colInfo(필수) 파라미터로 disabled 상태를 조회할 Cell 의 Column ID 를 설정할 수 있어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof dlt_bind !== 'undefined') {
        $p.data.remove(&quot;dlt_bind&quot;);
    }

    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    $c.gcm.createLabel('label=&quot;Cell(0,col1) 은 disabled 설정, Cell(0,col3) 는 disabled 해제, Row 2 는 setRowDisabled, Column col4 는 setColumnDisabled&quot;', '', 'label1');

    // 조건 설정 (disabled/readonly Cell 을 배경색으로 구분: disabled=회색, readonly=연노랑)
    let properties = {
        dataList: &quot;data:dlt_bind&quot;,
        disabledBackgroundColor: &quot;#D3D3D3&quot;,
        readOnlyBackgroundColor: &quot;#FFF8DC&quot;,
    };

    let cList = $c.gcm.createCList(properties);

    // dataList 생성
    $c.gcm.createBasicDataList('', '', 'dlt_bind');

    // target 생성
    await $c.gcm.createBasicGridView(cList);

    // Cell(0,col1) 에 disabled 설정
    target1.setCellDisabled(0, &quot;col1&quot;, true);
    // Cell(0,col3) 에 disabled 해제
    target1.setCellDisabled(0, &quot;col3&quot;, false);

    // 상위 단위 disabled 설정 (Cell 단위는 미설정 → getCellDisabled 는 '' 반환하지만 실제 disabled 적용)
    target1.setRowDisabled(2, true);
    target1.setColumnDisabled(&quot;col4&quot;, true);
}



scwin.btn_getCellDisabled_onclick = function () {
    let rowIndex = Number(par_rowIndex.getText());
    let colInfo = par_colInfo.getValue();

    let rtn = target1.getCellDisabled(rowIndex, colInfo);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellDisabled(&quot; + rowIndex + &quot;, \&quot;&quot; + colInfo + &quot;\&quot;) : &quot; + rtn);
}</script>
	</head>
