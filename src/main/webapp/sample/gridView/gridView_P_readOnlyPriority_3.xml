<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260313" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[col1_1]]></col1>
							<col2><![CDATA[col2_1]]></col2>
							<col3><![CDATA[col3_1]]></col3>
							<col4><![CDATA[col4_1]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_2]]></col1>
							<col2><![CDATA[col2_2]]></col2>
							<col3><![CDATA[col3_2]]></col3>
							<col4><![CDATA[col4_2]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_3]]></col1>
							<col2><![CDATA[col2_3]]></col2>
							<col3><![CDATA[col3_3]]></col3>
							<col4><![CDATA[col4_3]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_4]]></col1>
							<col2><![CDATA[col2_4]]></col2>
							<col3><![CDATA[col3_4]]></col3>
							<col4><![CDATA[col4_4]]></col4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; P &gt; readOnlyPriority]&lt;br/&gt;Row 또는 Column 단위에 readOnly 속성이 적용되는 우선 순위를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;readOnlyPriority=row 설정 시 Row 단위의 readOnly 속성을 빈값으로 설정하면 Column 또는 GridView 단위의 readOnly 속성값이 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Row 0 readOnly=true
    target1.setRowReadOnly(0, true);

    // Column 0 readOnly=true, Column 2 readOnly=false
    target1.setColumnReadOnly(0, true);
    target1.setColumnReadOnly(2, false);

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.target1_oncelldblclick = function (row, col) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;oncelldblclick 이벤트 발생 (row: &quot; + row + &quot;, col: &quot; + col + &quot;)&quot;);
    scwin.btn_isEditing_onclick();
}



scwin.btn_isEditing_onclick = function () {
    let rtn = target1.isEditing();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;isEditing() : &quot; + rtn);
}



// Row 0 readOnly 를 빈값으로 변경
scwin.btn_setRowReadOnlyEmpty_onclick = function () {
    target1.setRowReadOnly(0, &quot;&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;setRowReadOnly(0, '') 실행 완료&quot;);
}



scwin.btn_getCellClassName_onclick = function () {
    let cell = document.querySelector(&quot;td[id*='target1_cell_0_0']&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;cell(0,0) Column 0 readOnly=true className : &quot; + cell.className);

    cell = document.querySelector(&quot;td[id*='target1_cell_0_2']&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;cell(0,2) Column 2 readOnly=false className : &quot; + cell.className);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="" id="label1" label="readOnlyPriority=row / Row 0 readOnly=true / Column 0 readOnly=true, Column 2 readOnly=false" class="" escape="false"></w2:textbox>
						<w2:gridView checkAllType="false" id="target1" style="width:500px;height:300px;" dataList="data:dlt_bind"
							readOnlyPriority="row" readOnlyBackgroundColor="#D3D3D3" ev:oncelldblclick="scwin.target1_oncelldblclick">
							<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="70" inputType="text" id="column1" value="name1"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="name2"></w2:column>
									<w2:column width="70" inputType="text" id="column3" value="name3"></w2:column>
									<w2:column width="70" inputType="text" id="column4" value="name4"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="70" inputType="text" id="col1"></w2:column>
									<w2:column width="70" inputType="text" id="col2"></w2:column>
									<w2:column width="70" inputType="text" id="col3"></w2:column>
									<w2:column width="70" inputType="text" id="col4"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setRowReadOnlyEmpty_onclick" id="btn_setRowReadOnlyEmpty"
							label="setRowReadOnly(0, '')" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getCellClassName_onclick" id="btn_getCellClassName"
							label="getCellClassName" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>