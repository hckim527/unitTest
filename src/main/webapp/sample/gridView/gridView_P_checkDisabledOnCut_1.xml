		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[gridView > P > checkDisabledOnCut]<br/>disabled 상태인 Body Cell 값의 잘라내기(Ctrl+X)를 허용할지 설정합니다.",
    "validation" : [
        "false 설정 시 disabled 상태인 Body Cell 값의 잘라내기(Ctrl+X)를 허용합니다.",
        "true(기본값) 설정 시 disabled 상태인 Body Cell 값의 잘라내기(Ctrl+X)를 허용하지 않습니다.",
        "preventCopy=true 인 경우 checkDisabledOnCut 속성은 항상 true 로 동작합니다.",
        "preventCopyColumn 속성에 설정된 Column 인 경우 checkDisabledOnCut 속성은 항상 true 로 동작합니다.",        
        "checkDisabledOnCut 속성값에 관계없이 disabled 상태인 Body Cell 의 값은 Delete 키로 삭제되지 않아야 합니다.",        
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // [target1] checkDisabledOnCut=false
    //  GridView/Row/Column/Cell 중 하나라도 disabled 가 설정되면 해당 Body Cell 은 disabled 상태가 됨
    //   - Row 0      : setRowDisabled(0, true)             → Row 단위 disabled
    //   - Column col2 : setColumnDisabled("col2", true)    → Column 단위 disabled
    //   - Cell (2, col3) : setCellDisabled(2, "col3", true) → Cell 단위 disabled
    target1.setRowDisabled(0, true);
    target1.setColumnDisabled("col2", true);
    target1.setCellDisabled(2, "col3", true);

    // [target2] checkDisabledOnCut=true (기본값) — disabled 상태인 Cell 잘라내기 차단 확인
    target2.setRowDisabled(0, true);

    // [target3] preventCopy=true 인 경우 checkDisabledOnCut=false 여도 항상 true 로 동작
    target3.setRowDisabled(0, true);

    // [target4] preventCopyColumn 에 설정된 Column 인 경우 checkDisabledOnCut=false 여도 항상 true 로 동작
    //   preventCopyColumn="col1" → col1 Cell 은 disabled 잘라내기 차단
    target4.setRowDisabled(0, true);
};



scwin.btn_getAllDisplayJSON_onclick = function () {
    wf_body_bottom.getObj("scwin").setReturnValue("[target1] getAllDisplayJSON : " + JSON.stringify(target1.getAllDisplayJSON()));
    wf_body_bottom.getObj("scwin").setReturnValue("[target2] getAllDisplayJSON : " + JSON.stringify(target2.getAllDisplayJSON()));
    wf_body_bottom.getObj("scwin").setReturnValue("[target3] getAllDisplayJSON : " + JSON.stringify(target3.getAllDisplayJSON()));
    wf_body_bottom.getObj("scwin").setReturnValue("[target4] getAllDisplayJSON : " + JSON.stringify(target4.getAllDisplayJSON()));
}]]></script>
