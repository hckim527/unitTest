		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[gridView > P > checkEditOnPaste]<br/>Body Cell 이 편집모드일때 붙여넣기(Ctrl+V)가 적용되는 영역을 설정합니다.",
    "validation" : [
        "true 설정 시 클립보드에 복사된 데이터를 Cell 단위로 붙여넣기 합니다.",
        "true 설정 + 복사된 데이터에 탭/줄바꿈 구분자가 포함되어 있다면 현재 편집모드인 Cell 을 기준으로 n*n Cell 에 붙여넣기 됩니다. (예: (2,2) Cell 이 편집상태일때 '1\\t2\\r\\n3\\t4' 값을 붙여넣으면 (2,2),(2,3),(3,2),(3,3) Cell 에 각각 1,2,3,4 가 붙여넣기 됩니다.)",
        "true 설정 + 복사된 데이터에 탭/줄바꿈 구분자가 없다면 현재 편집모드인 Cell 에 한 줄로 붙여넣기 됩니다.",
        "false (default) 설정 시 클립보드에 복사된 데이터를 현재 편집모드인 Cell 에 한 줄로 붙여넣기 합니다.",
        "copyType='native' 이면 checkEditOnPaste 설정과 관계없이 false 로 동작합니다.",
        "Body Cell 이 편집모드가 아닌 경우엔 checkEditOnPaste 설정과 관계없이 false 로 동작합니다.",
        "preventPaste 속성에 관계없이 편집모드일때는 붙여넣기(Ctrl+V)가 차단되지 않습니다.",
        "preventPasteColumn 속성으로 설정된 Body Column 엔 붙여넣기(Ctrl+V)가 차단됩니다.",
        "checkEditOnPaste=false 일때 붙여넣기가 발생한 후 편집 종료 시점에 해당 Cell 값이 DataCollection 에 반영됩니다.",
        "Cell 단위로 붙여넣기 되면 onviewchange 이벤트가 Cell 단위로 발생합니다.",
    ]
}



scwin.onpageload = function () {
    // 클립보드 사전 설정용 textarea 초기값 (탭/줄바꿈 구분자 포함 2x2 데이터)
    par_copyValue.setValue("1\t2\r\n3\t4");

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// 클립보드에 par_copyValue 의 값을 복사 (Ctrl+V 사전 준비)
scwin.btn_setClipboard_onclick = async function () {
    let strVal = par_copyValue.getValue();
    try {
        await navigator.clipboard.writeText(strVal);
        wf_body_bottom.getObj("scwin").setReturnValue("[클립보드 설정 완료] " + JSON.stringify(strVal));
    } catch (err) {
        wf_body_bottom.getObj("scwin").setReturnValue("[클립보드 설정 실패] " + err.message);
    }
}



// onviewchange 이벤트 발생 추적 (Cell 단위 발생 여부 확인용)
scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("[target1_onviewchange] rowIndex : " + info.rowIndex + ", colIndex : " + info.colIndex + ", colId : " + info.colId + ", oldValue : " + info.oldValue + ", newValue : " + info.newValue);
}

scwin.target2_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("[target2_onviewchange] rowIndex : " + info.rowIndex + ", colIndex : " + info.colIndex + ", colId : " + info.colId + ", oldValue : " + info.oldValue + ", newValue : " + info.newValue);
    // checkEditOnPaste=false : 붙여넣기 후 편집 종료 시점에 해당 Cell 값이 DataCollection 에 반영됨 (@spec)
    wf_body_bottom.getObj("scwin").setReturnValue("[target2] DataCollection 반영 값 : " + dlt_bind2.getCellData(info.rowIndex, info.colId));
}

scwin.target3_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("[target3_onviewchange] rowIndex : " + info.rowIndex + ", colIndex : " + info.colIndex + ", colId : " + info.colId + ", oldValue : " + info.oldValue + ", newValue : " + info.newValue);
}

scwin.target4_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("[target4_onviewchange] rowIndex : " + info.rowIndex + ", colIndex : " + info.colIndex + ", colId : " + info.colId + ", oldValue : " + info.oldValue + ", newValue : " + info.newValue);
}

scwin.target5_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("[target5_onviewchange] rowIndex : " + info.rowIndex + ", colIndex : " + info.colIndex + ", colId : " + info.colId + ", oldValue : " + info.oldValue + ", newValue : " + info.newValue);
}]]></script>
