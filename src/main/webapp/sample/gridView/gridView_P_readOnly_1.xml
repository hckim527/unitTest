				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[gridView &gt; P &gt; readOnly]&lt;br/&gt;GridView 의 읽기 전용(readonly) 상태를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;true 설정 시, GridView 를 읽기전용(readonly) 상태로 설정합니다.&quot;,
        &quot;true 설정 시 Cell 에 값을 직접 입력하거나 편집할 수 없어야 합니다.&quot;,
        &quot;읽기 전용(readonly) 상태일때 disabled 속성과 달리 마우스/키보드 관련 이벤트는 발생해야 합니다.&quot;,
        &quot;readOnlyBackgroundColor 에 설정된 배경색이 적용되어야 합니다.&quot;,
        &quot;모든 Cell 에 readOnlyClass(w2grid_default_readonly) 클래스가 적용되어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.target1_oncelldblclick = function (row, col) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;oncelldblclick 이벤트 발생 (row: &quot; + row + &quot;, col: &quot; + col + &quot;)&quot;);
    scwin.btn_isEditing_onclick();
}



scwin.target1_onkeydown = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;onkeydown 이벤트 발생 (key: &quot; + e.key + &quot;)&quot;);
}



scwin.btn_getGridReadOnly_onclick = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getGridReadOnly() : &quot; + target1.getGridReadOnly());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getReadOnly('grid') : &quot; + target1.getReadOnly(&quot;grid&quot;));
}



scwin.btn_isEditing_onclick = function () {
    let rtn = target1.isEditing();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;isEditing() : &quot; + rtn);
}



scwin.btn_getCellClassName_onclick = function () {
    let cell = document.querySelector(&quot;td[id*='target1_cell_0_0']&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;cell(0,0) className : &quot; + cell.className);

    cell = document.querySelector(&quot;td[id*='target1_cell_3_3']&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;cell(3,3) className : &quot; + cell.className);
}



scwin.btn_getAllDisplayJSON_onclick = function () {
    let rtn = JSON.stringify(target1.getAllDisplayJSON());
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getAllDisplayJSON() : &quot; + rtn);
}</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:gridView checkAllType="false" id="target1" style="width:500px;height:300px;" dataList="data:dlt_bind"
							readOnly="true" readOnlyBackgroundColor="#D3D3D3" ev:oncelldblclick="scwin.target1_oncelldblclick" ev:onkeydown="scwin.target1_onkeydown">
							<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="70" inputType="text" id="column1" value="name1"></w2:column>
									<w2:column width="70" inputType="text" id="column2" value="name2"></w2:column>
									<w2:column width="70" inputType="text" id="column3" value="name3"></w2:column>
									<w2:column width="70" inputType="text" id="column4" value="name4"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="70" inputType="text" id="col1"></w2:column>
									<w2:column width="70" inputType="text" id="col2"></w2:column>
									<w2:column width="70" inputType="text" id="col3"></w2:column>
									<w2:column width="70" inputType="text" id="col4"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getGridReadOnly_onclick" id="btn_getGridReadOnly"
							label="getGridReadOnly()" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getCellClassName_onclick" id="btn_getCellClassName"
							label="getCellClassName" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getAllDisplayJSON_onclick" id="btn_getAllDisplayJSON"
							label="getAllDisplayJSON()" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>