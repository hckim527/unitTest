<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] getValue" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260416" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > getValue]<br/>XPath 로 검색한 노드의 텍스트 값 또는 속성(attribute) 값을 반환합니다.",
    "validation" : [
        "doc(필수) 파라미터로 검색 기준이 되는 XML Element 노드를 설정할 수 있어야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<root>" +
            "<book idx='1'>" +
                "<title lang='eng'>Harry Potter</title>" +
                "<price currency='USD'>29.99</price>" +
                "<desc>Save completed. <![CDATA" + "[<b>Order</b>]]" + "> Please check.</desc>" +
            "</book>" +
        "</root>"
    );
};



scwin.btn_getValue_onclick = function () {
    var key = par_key.getValue();
    var attribute = par_attribute.getValue();

    var bookNode = WebSquare.xml.findNode(scwin.testDoc, "root/book");
    var result;
    if (attribute === "") {
        result = WebSquare.xml.getValue(bookNode, key);
    } else {
        result = WebSquare.xml.getValue(bookNode, key, attribute);
    }

    wf_body_bottom.getObj("scwin").setReturnValue("getValue(bookNode, '" + key + "'" + (attribute ? ", '" + attribute + "'" : "") + ")");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : '" + result + "'");
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="key" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_key" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[title ('Harry Potter')]]></xf:label><xf:value><![CDATA[title]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[price ('29.99')]]></xf:label><xf:value><![CDATA[price]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[desc (텍스트+CDATA 연결)]]></xf:label><xf:value><![CDATA[desc]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[notExist (존재하지 않는 노드 → '')]]></xf:label><xf:value><![CDATA[notExist]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="attribute" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_attribute" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[(생략 → 텍스트+CDATA 모드)]]></xf:label><xf:value><![CDATA[]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[lang]]></xf:label><xf:value><![CDATA[lang]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[currency]]></xf:label><xf:value><![CDATA[currency]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[notExist (없는 속성 → '')]]></xf:label><xf:value><![CDATA[notExist]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getValue_onclick" id="btn_getValue"
							label="getValue" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
