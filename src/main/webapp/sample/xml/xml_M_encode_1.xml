		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > encode]<br/>문자열 내의 XML 특수 문자를 XML Entity 로 인코딩하여 반환합니다.",
    "validation" : [
        "str(필수) 파라미터로 인코딩할 대상을 설정할 수 있어야 합니다.",
        "인코딩된 문자열을 반환해야 합니다.",
        "앰퍼샌드를 amp Entity 로 인코딩해야 합니다.",
        "여는 꺾쇠 문자를 lt Entity 로 인코딩해야 합니다.",
        "닫는 꺾쇠 문자를 gt Entity 로 인코딩해야 합니다.",
        "작은따옴표를 apos Entity 로 인코딩해야 합니다.",
        "큰따옴표를 quot Entity 로 인코딩해야 합니다.",
        "개행 문자(CR LF, LF, CR) 를 #xA Entity 로 변환해야 합니다.",
        "null 을 전달하면 빈 문자열로 변환한 후 인코딩해야 합니다.",
        "XML Document 를 전달하면 직렬화한 후 인코딩해야 합니다.",
        "문자열, null, XML Document 이외의 타입을 전달하면 인코딩 없이 그대로 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_encode_onclick = function () {
    let strKey = par_str.getValue();
    let input;

    if (strKey === 'null') {
        input = null;
    } else if (strKey === 'xmlDoc') {
        input = WebSquare.xml.parse("<root><item>test</item></root>");
    } else if (strKey === 'number') {
        input = 12345;
    } else if (strKey === 'newline') {
        input = "line1\nline2\r\nline3";
    } else {
        input = strKey;
    }

    var result = WebSquare.xml.encode(input);

    // wf_body_bottom.getObj("scwin").setReturnValue("encode 입력 : " + (input === null ? "null" : typeof input === 'object' ? "[XML Document]" : "'" + input + "'"));
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : " + result);
    wf_body_bottom.getObj("scwin").setReturnValue("typeof : " + typeof result);
}]]></script>
