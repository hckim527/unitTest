		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > hasChildElement]<br/>XML Element 노드가 Element 타입의 자식 노드를 가지고 있는지 여부를 반환합니다.",
    "validation" : [
        "doc(필수) 파라미터로 Element 자식 존재 여부를 확인할 노드를 설정할 수 있어야 합니다.",
        "Element 타입의 자식 노드가 하나라도 존재하면 true 를 반환해야 합니다.",
        "Element 타입의 자식 노드가 없으면 false 를 반환해야 합니다.",
        "텍스트 노드나 CDATA 노드만 있는 경우 false 를 반환해야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<root>" +
            "<parent1><title>Harry Potter</title><price>29.99</price></parent1>" +
            "<parent2>text only</parent2>" +
            "<parent3></parent3>" +
            "<parent4><![CDATA" + "[cdata only]]" + "></parent4>" +
        "</root>"
    );
};



scwin.btn_hasChildElement_onclick = function () {
    var elementName = par_doc.getValue();

    var targetNode = WebSquare.xml.findNode(scwin.testDoc, "root/" + elementName);
    var result = WebSquare.xml.hasChildElement(targetNode);

    wf_body_bottom.getObj("scwin").setReturnValue("hasChildElement(" + elementName + ")");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : " + result);
}]]></script>
	</head>
