											<xf:item><xf:label><![CDATA[USD]]></xf:label><xf:value><![CDATA[USD]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[KRW]]></xf:label><xf:value><![CDATA[KRW]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
