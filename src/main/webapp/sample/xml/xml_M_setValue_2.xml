											<xf:item><xf:label><![CDATA[currency (속성 모드용 - 속성명)]]></xf:label><xf:value><![CDATA[currency]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[lang (속성 모드용 - 속성명)]]></xf:label><xf:value><![CDATA[lang]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
