	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] setValue" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260416" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > setValue]<br/>XPath 로 검색한 노드에 텍스트 노드 또는 속성(attribute) 을 설정합니다.",
    "validation" : [
        "doc(필수) 파라미터로 검색 기준이 되는 XML Element 노드를 설정할 수 있어야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.resetDoc();
};

scwin.resetDoc = function () {
    scwin.testDoc = WebSquare.xml.parse(
        "<root>" +
            "<book>" +
                "<title>Harry Potter</title>" +
                "<price>29.99</price>" +
            "</book>" +
        "</root>"
    );
};

scwin.btn_setValue_onclick = function () {
    var key = par_key.getValue();
    var attributeInfo = par_attributeInfo.getValue();
    var value = par_value.getValue();

    var bookNode = WebSquare.xml.findNode(scwin.testDoc, "root/book");

    if (value === "") {
        WebSquare.xml.setValue(bookNode, key, attributeInfo);
    } else {
        WebSquare.xml.setValue(bookNode, key, attributeInfo, value);
    }

    wf_body_bottom.getObj("scwin").setReturnValue("setValue(bookNode, '" + key + "', '" + attributeInfo + "'" + (value ? ", '" + value + "'" : "") + ")");

    var verifyResult = WebSquare.xml.getValue(bookNode, key, value ? attributeInfo : undefined);
    wf_body_bottom.getObj("scwin").setReturnValue("getValue 확인 : '" + verifyResult + "'");
    wf_body_bottom.getObj("scwin").setReturnValue("전체 XML : " + WebSquare.xml.serialize(scwin.testDoc));
}

scwin.btn_reset_onclick = function () {
    scwin.resetDoc();
    wf_body_bottom.getObj("scwin").setReturnValue("XML 초기화 완료");
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
