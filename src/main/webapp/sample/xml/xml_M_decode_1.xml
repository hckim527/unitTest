        "amp Entity 를 앰퍼샌드로 디코딩해야 합니다.",
        "#xA Entity 를 개행문자로 디코딩해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_decode_onclick = function () {
    let str = par_str.getValue();

    let result = WebSquare.xml.decode(str);

    // wf_body_bottom.getObj("scwin").setReturnValue("decode('" + str + "')");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : " + result);
    wf_body_bottom.getObj("scwin").setReturnValue("typeof : " + typeof result);
}]]></script>
