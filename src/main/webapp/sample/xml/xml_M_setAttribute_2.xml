		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > setAttribute]<br/>XML Document 또는 XML Element 에 속성(attribute) 을 설정합니다.",
    "validation" : [
        "XPath 모드: XPath 로 노드를 검색한 후 해당 노드에 속성을 설정할 수 있어야 합니다.",
        "XPath 모드에서 XPath 에 해당하는 노드가 없으면 노드를 자동으로 생성해야 합니다.",
        "value(선택) 파라미터 유무에 따라 key, attributeInfo 파라미터의 역할이 변경되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_setAttribute_xpath_onclick = function () {
    let xpath = par_xpath.getValue();
    let attrName = par_attrName.getValue();
    let attrValue = par_attrValue.getValue();

    var doc = WebSquare.xml.parse("<book idx='1'><title>Harry Potter</title><price>29.99</price></book>");
    var bookNode = WebSquare.xml.findNode(doc, "book");

    WebSquare.xml.setAttribute(bookNode, xpath, attrName, attrValue);

    var targetNode = WebSquare.xml.findNode(bookNode, xpath);
    var xmlStr = WebSquare.xml.serialize(doc);
    var setVal = targetNode ? targetNode.getAttribute(attrName) : null;

    // wf_body_bottom.getObj("scwin").setReturnValue("XPath 모드: setAttribute(element, '" + xpath + "', '" + attrName + "', '" + attrValue + "')");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 XML : " + xmlStr);
    wf_body_bottom.getObj("scwin").setReturnValue(xpath + "/@" + attrName + " : " + setVal);
    wf_body_bottom.getObj("scwin").setReturnValue("속성 설정 확인 : " + (setVal === attrValue ? "PASS" : "FAIL"));
}



]]></script>
	</head>
