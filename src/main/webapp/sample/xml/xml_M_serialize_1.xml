										disabledClass="w2selectbox_disabled" id="par_doc" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[XML Document]]></xf:label><xf:value><![CDATA[document]]></xf:value></xf:item>
