		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > serialize]<br/>XML Document 또는 XML Element 를 XML 문자열로 직렬화하여 반환합니다.",
    "validation" : [
        "doc(필수) 파라미터로 XML 문자열로 변환할 XML Document 노드를 설정할 수 있어야 합니다.",
        "직렬화된 XML 문자열을 반환해야 합니다.",
        "doc 파라미터값이 null, undefined, false, 0, 빈 문자열('') 이면 빈 문자열('')을 반환해야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<data><title>WebSquare</title><items><item>A</item><item>B</item></items></data>"
    );
};



scwin.btn_serialize_onclick = function () {
    var docType = par_doc.getValue();

    var doc;
    var docDesc = "";
    if (docType === "document") {
        doc = scwin.testDoc;
        docDesc = "XML Document";
    } else if (docType === "null") {
        doc = null;
        docDesc = "null";
    } else if (docType === "undefined") {
        doc = undefined;
        docDesc = "undefined";
    } else if (docType === "false") {
        doc = false;
        docDesc = "false";
    } else if (docType === "zero") {
        doc = 0;
        docDesc = "0";
    } else if (docType === "empty") {
        doc = "";
        docDesc = "빈 문자열";
    }

    var result = WebSquare.xml.serialize(doc);

    wf_body_bottom.getObj("scwin").setReturnValue("serialize(" + docDesc + ")");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : '" + result + "'");
}]]></script>
	</head>
