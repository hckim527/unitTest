<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] setString" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260416" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > setString]<br/>XPath 로 검색한 노드에 'value' 속성값을 설정합니다.",
    "validation" : [
        "doc(필수) 파라미터로 검색 기준이 되는 XML Document 노드를 설정할 수 있어야 합니다.",
        "key(필수) 파라미터로 노드를 검색하기 위한 XPath 문자열을 설정할 수 있어야 합니다.",
        "value(필수) 파라미터로 'value' 속성에 설정할 값을 설정할 수 있어야 합니다.",
        "설정 후 getString 으로 조회하면 설정한 값이 반환되어야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<root>" +
            "<config>" +
                "<option1/>" +
                "<option2 value='old'/>" +
            "</config>" +
        "</root>"
    );
};



scwin.btn_setString_onclick = function () {
    var key = par_key.getValue();
    var value = par_value.getValue();

    WebSquare.xml.setString(scwin.testDoc, key, value);

    var result = WebSquare.xml.getString(scwin.testDoc, key);

    wf_body_bottom.getObj("scwin").setReturnValue("setString(doc, '" + key + "', '" + value + "')");
    wf_body_bottom.getObj("scwin").setReturnValue("getString 확인 : '" + result + "'");
    wf_body_bottom.getObj("scwin").setReturnValue("전체 XML : " + WebSquare.xml.serialize(scwin.testDoc));
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="key" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_key" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[config/option1 (value 속성 없음)]]></xf:label><xf:value><![CDATA[config/option1]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[config/option2 (기존 value='old')]]></xf:label><xf:value><![CDATA[config/option2]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="value" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_value" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[enabled]]></xf:label><xf:value><![CDATA[enabled]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[disabled]]></xf:label><xf:value><![CDATA[disabled]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[100]]></xf:label><xf:value><![CDATA[100]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setString_onclick" id="btn_setString"
							label="setString" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
