<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] getAttribute" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260415" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > getAttribute]<br/>XML Document 또는 XML Element 에서 속성(attribute) 값을 반환합니다.",
    "validation" : [
        "XPath 모드: XPath 로 노드를 검색한 후 해당 노드에서 속성값을 조회할 수 있어야 합니다.",
        "attribute 파라미터 유무에 따라 key 파라미터의 역할이 변경되어야 합니다.",
        "속성이 없거나 null 인 경우 빈 문자열을 반환해야 합니다.",
    ]
}

scwin.bookNode = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    var doc = WebSquare.xml.parse("<book idx='1' category='fiction'><title lang='eng'>Harry Potter</title><price currency='USD'>29.99</price></book>");
    scwin.bookNode = WebSquare.xml.findNode(doc, "book");
};



scwin.btn_getAttribute_xpath_onclick = function () {
    let xpath = par_xpath.getValue();
    let attribute = par_attribute.getValue();

    var result = WebSquare.xml.getAttribute(scwin.bookNode, xpath, attribute);

    wf_body_bottom.getObj("scwin").setReturnValue("XPath 모드: getAttribute(bookNode, '" + xpath + "', '" + attribute + "')");
    wf_body_bottom.getObj("scwin").setReturnValue("결과 : '" + result + "'");
    wf_body_bottom.getObj("scwin").setReturnValue("typeof : " + typeof result);
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="xpath" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_xpath" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[title]]></xf:label><xf:value><![CDATA[title]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[price]]></xf:label><xf:value><![CDATA[price]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="attribute" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_attribute" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[lang (결과: eng)]]></xf:label><xf:value><![CDATA[lang]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[currency (결과: USD)]]></xf:label><xf:value><![CDATA[currency]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[notExist (없는 속성 → 빈문자열)]]></xf:label><xf:value><![CDATA[notExist]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getAttribute_xpath_onclick" id="btn_getAttribute_xpath"
							label="getAttribute (XPath)" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
