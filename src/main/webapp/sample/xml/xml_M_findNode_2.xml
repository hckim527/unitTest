	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] findNode" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260415" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > findNode]<br/>XPath 표현식으로 검색하여 일치하는 첫 번째 노드를 반환합니다.",
    "validation" : [
        "doc(필수) 파라미터로 검색 기준이 되는 Element 노드를 설정할 수 있어야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<bookstore>" +
            "<book id='b1'><title>Harry Potter</title><author>J.K. Rowling</author><price>29.99</price></book>" +
            "<book id='b2'><title>Learning XML</title><author>Erik T. Ray</author><price>39.95</price></book>" +
            "<book id='b3'><title>Clean Code</title><author>Robert C. Martin</author><price>33.00</price></book>" +
        "</bookstore>"
    );
};



scwin.btn_findNode_onclick = function () {
    let bookIndex = par_bookIndex.getValue();
    let xpath = par_xpath.getValue();

    // Element 노드 기준 검색
    var bookNodes = scwin.testDoc.getElementsByTagName("book");
    var targetBook = bookNodes[Number(bookIndex)];

    var result = WebSquare.xml.findNode(targetBook, xpath);

    wf_body_bottom.getObj("scwin").setReturnValue("Element 기준 : book[" + bookIndex + "] 내에서 findNode('" + xpath + "')");

    if (result) {
        wf_body_bottom.getObj("scwin").setReturnValue("nodeName : " + result.nodeName);
        wf_body_bottom.getObj("scwin").setReturnValue("내용 : " + WebSquare.xml.serialize(result));
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("결과 : null (일치하는 노드 없음)");
    }
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="기준 Element" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_bookIndex" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[book[0] (Harry Potter)]]></xf:label><xf:value><![CDATA[0]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[book[1] (Learning XML)]]></xf:label><xf:value><![CDATA[1]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[book[2] (Clean Code)]]></xf:label><xf:value><![CDATA[2]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="xpath" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_xpath" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[title]]></xf:label><xf:value><![CDATA[title]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[author]]></xf:label><xf:value><![CDATA[author]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[price]]></xf:label><xf:value><![CDATA[price]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[notExist (없는 노드)]]></xf:label><xf:value><![CDATA[notExist]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_findNode_onclick" id="btn_findNode"
							label="findNode (Element 기준)" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
