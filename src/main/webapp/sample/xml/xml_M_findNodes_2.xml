<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[xml] findNodes" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260415" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > findNodes]<br/>XPath 표현식으로 검색하여 일치하는 모든 노드를 배열로 반환합니다.",
    "validation" : [
        "doc(필수) 파라미터로 검색 기준이 되는 Element 노드를 설정할 수 있어야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.testDoc = WebSquare.xml.parse(
        "<library>" +
            "<shelf id='s1'><book>Book A</book><book>Book B</book><magazine>Mag 1</magazine></shelf>" +
            "<shelf id='s2'><book>Book C</book><magazine>Mag 2</magazine><magazine>Mag 3</magazine></shelf>" +
        "</library>"
    );
};



scwin.btn_findNodes_onclick = function () {
    let shelfIndex = par_shelfIndex.getValue();
    let xpath = par_xpath.getValue();

    var shelfNodes = scwin.testDoc.getElementsByTagName("shelf");
    var targetShelf = shelfNodes[Number(shelfIndex)];

    var result = WebSquare.xml.findNodes(targetShelf, xpath);

    wf_body_bottom.getObj("scwin").setReturnValue("Element 기준 : shelf[" + shelfIndex + "] 내에서 findNodes('" + xpath + "')");

    if (result) {
        wf_body_bottom.getObj("scwin").setReturnValue("결과 개수 : " + result.length);
        for (var i = 0; i < result.length; i++) {
            wf_body_bottom.getObj("scwin").setReturnValue("[" + i + "] " + WebSquare.xml.serialize(result[i]));
        }
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("결과 : null (일치하는 노드 없음)");
    }
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="기준 Element" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_shelfIndex" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[shelf[0] (Book A, B + Mag 1)]]></xf:label><xf:value><![CDATA[0]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[shelf[1] (Book C + Mag 2, 3)]]></xf:label><xf:value><![CDATA[1]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="xpath" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_xpath" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[book]]></xf:label><xf:value><![CDATA[book]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[magazine]]></xf:label><xf:value><![CDATA[magazine]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[notExist (없는 노드)]]></xf:label><xf:value><![CDATA[notExist]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_findNodes_onclick" id="btn_findNodes"
							label="findNodes (Element 기준)" style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
