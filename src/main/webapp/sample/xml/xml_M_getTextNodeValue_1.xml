		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[xml > M > getTextNodeValue]<br/>XML Element 노드의 모든 텍스트 노드 값을 연결하여 반환합니다.",
    "validation" : [
        "element(필수) 파라미터로 텍스트 값을 조회할 XML Element 노드를 설정할 수 있어야 합니다.",
        "모든 텍스트 노드의 값을 연결한 문자열을 반환해야 합니다.",
        "텍스트 노드(nodeType==3)만 수집하며, CDATA 노드(nodeType==4)는 포함하지 않아야 합니다.",
        "텍스트 노드가 없으면 null 을 반환해야 합니다.",
    ]
}

scwin.testDoc = null;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    var rps = "<root>" +
                "<msg1>Save completed. " + "<![CDATA" + "[<b>Order</b>]]" + "> Please check.</msg1>" +
                "<msg2>Hello World</msg2>" +
                "<msg3><![CDATA" + "[only cdata]]" + "></msg3>" +
                "<msg4><child>element only</child></msg4>" +
              "</root>";

    scwin.testDoc = WebSquare.xml.parse(rps);
};



scwin.btn_getTextNodeValue_onclick = function () {
    var elementName = par_element.getValue();

    var targetNode = WebSquare.xml.findNode(scwin.testDoc, "root/" + elementName);
    var result = WebSquare.xml.getTextNodeValue(targetNode);

    wf_body_bottom.getObj("scwin").setReturnValue("getTextNodeValue(" + elementName + ")");

    if (result !== null) {
        wf_body_bottom.getObj("scwin").setReturnValue("결과 : '" + result + "'");
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("결과 : null");
    }
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
