scwin.tData = {
    "description" : "[common > M > setDataType]<br/>컴포넌트의 dataType 속성을 설정합니다.",
    "validation" : [
        "dataType(필수) 파라미터로 'text', 'number', 'float', 'data', 'time', 'bigDecimal' 값 중 하나를 문자열로 설정할 수 있습니다.",
        "dataType(필수) 파라미터로 'euro', 'rupee', 'tenge'  설정 시 메소드가 실행되지 않습니다.",
        "dataType(필수) 파라미터 미설정 시 메소드가 실행되지 않습니다.",
        "dataType 속성이 'euro', 'rupee', 'tenge' 값일때 setDataType 메소드를 통해 다른 값으로 변경할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};




scwin.btn_getDataType_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.getDataType();
    wf_body_bottom.getObj("scwin").setReturnValue("getDataType : " + rtn);    
};



scwin.btn_setDataType_onclick = function (e) {
    if (par_dataType.getText() == '')
        objParent.target1.setDataType();
    else
        objParent.target1.setDataType(par_dataType.getText());
};
]]></script>
