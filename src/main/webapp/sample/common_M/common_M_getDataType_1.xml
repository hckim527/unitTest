		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();

let cDataType = '';
let cDisplayFormat = '';
let cLabel = '';



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > M > getDataType]<br/>컴포넌트의 dataType 속성값을 반환합니다.",
    "validation" : [
        "컴포넌트의 dataType 속성값을 문자열로 반환하여야 합니다.",
        "dataType 속성을 설정하지 않은 경우 기본값이 'text' 가 반환되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // 조건 설정
    cDataType = con_dataType.getText();
    cDisplayFormat = con_displayFormat.getValue();
    cLabel = con_label.getValue();

    // 테스트 샘플에 재생성 조건 값 전달    
    objParent.scwin.gVar["cDataType"] = cDataType;
    objParent.scwin.gVar["cDisplayFormat"] = cDisplayFormat;
    objParent.scwin.gVar["cLabel"] = cLabel;

    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.render.textContent
    wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
};



scwin.con_dataType_onchange = function (info) {
    if (con_dataType.getText() == "text") {
        con_displayFormat.setValue("#:##-##");
        con_label.setValue("langkoKR");
    }
    else if (con_dataType.getText() == "number") {
        con_displayFormat.setValue("₩ #,##0.##[floor] won");
        con_label.setValue("-1234.5678");
    }
    else if (con_dataType.getText() == "date") {
        con_displayFormat.setValue("dd/MM/yyyy (E)");
        con_label.setValue("20080501");
    }
    else if (con_dataType.getText() == "time") {
        con_displayFormat.setValue("HH:mm:ss");
        con_label.setValue("121521");
    }
    else {
        con_displayFormat.setValue("");
        con_label.setValue("");        
    }
};



scwin.btn_getDataType_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.getDataType();
    wf_body_bottom.getObj("scwin").setReturnValue("getDataType : " + rtn);    
};
]]></script>
	</head>
