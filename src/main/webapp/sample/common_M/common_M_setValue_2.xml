		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();

let cLocaleRef = '';
let cUseLocale = '';
let cRef = '';



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > M > setValue]<br/>화면에 표시되고 있는 컴포넌트의 내부 텍스트를 설정합니다.",
    "validation" : [
        "label(필수) 파라미터로 내부 텍스트로 표시할 내용을 문자열로 설정할 수 있어야 합니다.",
        "localeRef, useLocale 속성으로 클라이언트 다국어가 적용된 경우에도 내부 텍스트가 변경되어야 합니다.",
        "ref 속성으로 데이터가 바인딩 된 상태이면 DataCollection 의 데이터가 변경되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};




// comp 재생성
scwin.comp_init = function () {
    // 조건 설정
    cLocaleRef = con_localeRef.getValue();
    cUseLocale = con_useLocale.getText();
    cRef = con_ref.getText();

    // 테스트 샘플에 재생성 조건 값 전달
    objParent.scwin.gVar["cLocaleRef"] = cLocaleRef;
    objParent.scwin.gVar["cUseLocale"] = cUseLocale;
    objParent.scwin.gVar["cRef"] = cRef;

    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
    
    rtn = objParent.target1.getValue();  
    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + rtn);    
};



scwin.btn_setValue_onclick = function (e) {
    objParent.target1.setValue(par_label.getValue());
};



scwin.btn_setIDisabled_onclick = function (e) {
    objParent.target1.setDisabled(par_disabled.getText());
};



scwin.btn_get_onclick = function (e) {
    let rtn = '';

    rtn = objParent.dm_ref.get("key1");
    wf_body_bottom.getObj("scwin").setReturnValue("dm_ref.key1 : " + rtn);      
};
]]></script>
	</head>
