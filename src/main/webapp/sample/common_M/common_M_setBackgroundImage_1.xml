		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > M > setBackgroundImage]<br/>컴포넌트의 배경 이미지를 URL 로 설정합니다.",
    "validation" : [
        "imgUrl(필수) 파라미터로 배경으로 사용할 이미지의 URL 을 설정할 수 있어야 합니다.",
        "상대경로를 설정할 수 있어야 합니다.",        
        "절대경로를 설정할 수 있어야 합니다.",        
        "프로토콜 포함 경로를 설정할 수 있어야 합니다.",        
        "PNG, JPG, JPEG, GIF, SVG 등 브라우저가 지원하는 모든 이미지 파일을 사용할 수 있어야 합니다.",
        "설정한 URL 값은 CSS 의 background-image 속성에 적용되어야 합니다.",
        "배경 이미지와 관련된 background-repeat, background-size 등의 속성은 CSS 설정값 또는 브라우저의 기본값이 적용되어야 합니다.",     
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_getStyle_onclick = function (e) {
    let rtn = '';

    
    rtn = objParent.target1.render.style.backgroundImage;
    wf_body_bottom.getObj("scwin").setReturnValue("backgroundImage : " + rtn);
    
    // rtn = objParent.target1.getStyle("background-image");
    // wf_body_bottom.getObj("scwin").setReturnValue("background-image : " + rtn);

    rtn = objParent.target1.getStyle("background-repeat");
    wf_body_bottom.getObj("scwin").setReturnValue("background-repeat : " + rtn);

    rtn = objParent.target1.getStyle("background-size");
    wf_body_bottom.getObj("scwin").setReturnValue("background-size : " + rtn);
};



scwin.btn_setBackgroundImage_onclick = function (e) {
    objParent.target1.setBackgroundImage(par_imgUrl.getValue());
};



scwin.par_imgUrl_sub_onchange = function (info) {
    par_imgUrl.setValue(par_imgUrl_sub.getText());
};]]></script>
