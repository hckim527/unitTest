		<script lazy="false" type="text/javascript"><![CDATA[let objParent = $p.parent();



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[common > M > setMandatory]<br/>컴포넌트의 mandatory 속성을 설정합니다.",
    "validation" : [
        "status(필수) 파라미터로 입력값 유무에 대한 유효성 체크 여부를 논리자료형으로 설정합니다.",
        "status(필수) 파라미터로 true 설정 시 입력값 유무에 대한 유효성을 체크합니다.",
        "status(필수) 파라미터로 false 설정 시 입력값 유무에 대한 유효성을 체크하지 않습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = function () {
    // comp 생성 호출
    objParent.scwin.comp_init();
};



scwin.btn_validate_onclick = function (e) {
    let rtn = objParent.target1.validate();

    if (rtn) 
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : PASS");
    else
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : FAIL");
};



scwin.btn_setMandatory_onclick = function (e) {
    if (par_status.getText() == "true")
        objParent.target1.setMandatory(true);
    else if (par_status.getText() == "false")
        objParent.target1.setMandatory(false);
    else
        objParent.target1.setMandatory();
};



scwin.btn_getMandatory_onclick = function (e) {
    let rtn = objParent.target1.getMandatory();

    wf_body_bottom.getObj("scwin").setReturnValue("getMandatory : " + rtn);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
