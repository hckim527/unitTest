		<script lazy="false" type="text/javascript">let chunkCount = 1;
let userFuncCount = 1;

// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[column &gt; P &gt; importFormatter]&lt;br/&gt;XML 또는 JSON 형식으로 Row 데이터를 설정할때 적용될 데이터 변환 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [         
        &quot;loadData() 메소드 실행 시 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   

}



scwin.callback = function(data, msg) {
	if (msg) {
		wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;====== callback msg : &quot; + msg);
	}
    else {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;chunkcount : &quot; + chunkCount);
    }

    if (chunkCount == 10) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;======loadData Complete=====&quot;);   
        scwin.btn_getTotalRow_onclick();  
    }   
    
    chunkCount++;
}



scwin.btn_loadData_json_onclick = function (e) {
    target1.removeAll();
    chunkCount = 1;

	var options = {
		dataType: &quot;JSON&quot;,
		msaName: &quot;msa_server&quot;,
        withCredentials: true,
		dataProvider: &quot;sample.ProviderSample&quot;,
		maxRowCount: &quot;&quot;,
		chunkRowCount: &quot;100&quot;,
		callback: &quot;scwin.callback&quot;,
		optionParam: {
			key1: &quot;value1&quot;,
			key2: &quot;value2&quot;
		},
		timeout: &quot;10000&quot;,
	}

	target1.loadData(options)
};



scwin.btn_getTotalRow_onclick = function (e) {
    setTimeout(() =&gt; {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;row count : &quot; + target1.getTotalRow());
    }, 500);	
};



// 사용자 정의 함수
scwin.fn_importFormatter = function (rowData, rowIdx, colInfo) {
    if (userFuncCount == 1) {
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====사용자 정의 함수 실행=====&quot;);
        
        userFuncCount ++;
    }    

    return &quot;userFuncData&quot;;
};</script>
