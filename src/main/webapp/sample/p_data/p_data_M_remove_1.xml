    "validation" : [
       "dataCollectionId(필수) 파라미터로 삭제할 DataCollection 의 ID 를 설정합니다.",
    ]
}



scwin.onpageload = function () {
    // $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_getInfo_onclick = function (e) {
    let rtn = $p.data.getInfo(["mf_dlt_exam", "mf_dma_exam"]);

    let jsonString = JSON.stringify(rtn);

	wf_body_bottom.getObj("scwin").setReturnValue("result: " + rtn);
	wf_body_bottom.getObj("scwin").setReturnValue("result.json: " + jsonString);
};



scwin.btn_remove_onclick = function (e) {
	let dataCollectionId = par_dataCollectionId.getText();

    $p.data.remove(dataCollectionId);
};
]]></script>
