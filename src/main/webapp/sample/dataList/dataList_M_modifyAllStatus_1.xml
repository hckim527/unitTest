		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; M &gt; modifyAllStatus]&lt;br/&gt;필터가 적용되지 않은 상태를 기준으로 전체 Row 의 상태값을 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;status(필수) 파라미터로 전체 Row 의 상태값을 'R', 'U', 'C', 'D', 'V' 중 하나로 설정합니다.&quot;,        
        &quot;ignoreStatus 속성값에 관계없이 modifyAllStatus() 메소드로 Row 의 상태값이 변경됩니다.&quot;,
        &quot;modifyAllStatus() 메소드에 의해 Row 상태가 변경되면 onrowstatuschange 이벤트가 발생합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }    
    
    // 조건 설정       
    let properties = {
        ignoreStatus: con_ignoreStatus.getText(),
    };

    let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
    // target 생성
    $c.gcm.createBasicDataList(cList);

    // event 바인딩
    target1.bind(&quot;onrowstatuschange&quot;, function(e){ wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onrowstatuschange=====&quot;);});

    // gridView 생성
    $c.gcm.createBasicGridView('dataList=&quot;data:target1&quot; rowStatusVisible=&quot;true&quot;', '', 'gridView1');

    scwin.btn_insertRow_onclick();
    scwin.btn_deleteRow_onclick();
    scwin.btn_setCellData_onclick();
    scwin.btn_removeRow_onclick();
}   



scwin.btn_insertRow_onclick = function (e) {
    let insertIndex = target1.insertRow();
    target1.setRowData(insertIndex,[&quot;insert1&quot;,&quot;insert2&quot;,&quot;insert3&quot;,&quot;insert4&quot;],true);
};



scwin.btn_deleteRow_onclick = function (e) {
    target1.deleteRow(0);
};



scwin.btn_setCellData_onclick = function (e) {
    target1.setCellData(2, &quot;col1&quot;, &quot;change&quot;);
};



scwin.btn_removeRow_onclick = function (e) {
    target1.removeRow(3);
}



scwin.btn_getRowStatus_onclick = function (e) {
    let rtn = '';
    let rowCount = target1.getTotalRow();

    for (var i=0; i &lt; rowCount; i++) {
        rtn = target1.getRowStatus(i);

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(`row[${i}] status : ${rtn}`);
    }
};



scwin.btn_modifyAllStatus_onclick = function (e) {
    let status = par_status.getText();

    target1.modifyAllStatus(status);

    scwin.btn_getRowStatus_onclick();
};



scwin.target1_onrowstatuschange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onrowstatuschange=====&quot;);
}</script>
