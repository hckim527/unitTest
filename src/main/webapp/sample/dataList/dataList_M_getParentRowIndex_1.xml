		<script lazy="false" type="text/javascript">let isFilter = false;
let isSort = false;



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; M &gt; getParentRowIndex]&lt;br/&gt;Row 의 인덱스값을 사용하여 특정 Row 의 부모 Row 인덱스값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;DataList 모듈이 GridView 와 바인드 되어 DrillDown 기능이 적용된 상태일때 동작합니다.&quot;,
        &quot;필터와 정렬이 적용되지 않은 상태를 기준으로 동작합니다.&quot;,
        &quot;rowIndex(필수) 파라미터로 부모 Row 의 인덱스값을 조회하려는 Row 의 인덱스값을 숫자로 설정합니다.&quot;,
        &quot;Row 의 인덱스는 0 부터 시작하며 필터링/정렬이 적용되지 않은 상태를 기준으로 인덱스를 설정합니다.&quot;,
        &quot;반환값으로 파라미터에 해당하는 Row 의 부모 Row 인덱스값을 반환합니다.&quot;,
        &quot;파라미터에 해당하는 Row 의 부모 Row 가 없는 경우 -1 을 반환합니다.&quot;,
        &quot;DrillDown 기능으로 화면에 표시되지 않는 Row 와 관계없이 전체 Row 를 기준으로 동작합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   

}   



scwin.btn_setColumnFilter_onclick = function (e) {
    if (isFilter) {
        target1.clearFilter();  
        isFilter = false;  
    }
    else {
	    target1.setColumnFilter( {type:'row', colIndex:'level', key:&quot;2&quot;, condition:'and'})          
        isFilter = true;
    }	
};



scwin.btn_sort_onclick = function (e) {
    if (isSort) {    
        target1.clearSort();
        isSort = false;
    }
    else {
        target1.sort(&quot;label&quot;, 1);
        isSort = true;
    }
};



scwin.btn_getParentRowIndex_onclick = function (e) {
    let rowIndex = par_rowIndex.getText();
    let rtn = '';

    rtn = target1.getParentRowIndex(Number(rowIndex));
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result : &quot; + rtn);
};</script>
