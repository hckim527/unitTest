		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; M &gt; restore]&lt;br/&gt;DataList 모듈에서 수정된 데이터를 한단계 전으로 되돌립니다.&quot;,
    &quot;validation&quot; : [
        &quot;DataList 모듈에서 수정된 데이터를 한단계 전으로 되돌립니다.&quot;,
        &quot;최대 10 개의 수정 사항을 되돌릴 수 있습니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    scwin.btn_setCellData_onclick();
}   



scwin.btn_setCellData_onclick = function (e) {
    for (var i=0; i &lt; 11; i++) {
        target1.setCellData(i, &quot;col1&quot;, &quot;change&quot;+(i+1));
    }
};



scwin.btn_getAllData_onclick = function (e) {
    let rtn = target1.getAllData();

	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;return: &quot; + rtn);
};



scwin.btn_restore_onclick = function (e) {
    for (var i=0; i &lt; 11; i++) {
        target1.restore();
    }

    scwin.btn_getAllData_onclick();
};
</script>
