		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; P &gt; valueAttribute]&lt;br/&gt;DataList 모듈에서 XML 형식으로 데이터를 전달하거나 받을때 XML 의 태그 데이터값이 적용될 속성명을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;valueAttribute 속성을 설정하면 Row 의 데이터값이 태그의 데이터가 아닌 속성으로 적용됩니다.&quot;,
        &quot;Row 의 데이터값이 적용될 태그의 속성명을 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }  

    // 조건 설정       
    let properties = {
        valueAttribute : con_valueAttribute.getText(),
    };

    let cList = $c.gcm.createCList(properties);  

    // target 생성
    $c.gcm.createBasicDataList(cList);
    
    // gridView 생성
    $c.gcm.createBasicGridView('dataList=&quot;data:target1&quot; rowStatusVisible=&quot;true&quot;', '', 'gridView1');    

    scwin.btn_getAllXML_onclick();
}   



scwin.btn_getAllXML_onclick = function (e) {
    let rtn = target1.getAllXML();

    const serializer = new XMLSerializer();
    let xmlString = serializer.serializeToString(rtn);
	
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.xml: &quot; + xmlString);
}



scwin.btn_setXML_onclick = function (e) {   
    let xmlData = WebSquare.xml.parse(par_xmlData.getText());   

    target1.setXML(xmlData);

    scwin.btn_getAllXML_onclick();
};



scwin.con_valueAttribute_onchange = function (info) {
	par_xmlData.setValue(con_valueAttribute.getValue());
};</script>
