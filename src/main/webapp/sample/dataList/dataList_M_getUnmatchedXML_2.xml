		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; M &gt; getUnmatchedXML]&lt;br/&gt;지정한 Row 범위에서 파라미터 조건에 만족하지 않는 Row 데이터를 XML 형태로 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;columnInfo(필수) 파라미터로 data 파라미터값과 비교하려는 Column 의 ID 값을 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }    
    
    // 조건 설정       
    let properties = {
        getMatchedFromAllData : con_getMatchedFromAllData.getText(),
    };

    let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
    // target 생성
    $c.gcm.createBasicDataList(cList);

    // gridView 생성
    $c.gcm.createBasicGridView('dataList=&quot;data:target1&quot; rowStatusVisible=&quot;true&quot;', '', 'gridView1');

    scwin.btn_insertRow_onclick();
    scwin.btn_deleteRow_onclick();
    scwin.btn_setCellData_onclick();
    scwin.btn_removeRow_onclick();
}   



scwin.btn_insertRow_onclick = function (e) {
    let insertIndex = target1.insertRow();
    target1.setRowData(insertIndex,[&quot;insert1&quot;,&quot;insert2&quot;,&quot;insert3&quot;,&quot;insert4&quot;],true);
};



scwin.btn_deleteRow_onclick = function (e) {
    target1.deleteRow(0);
};



scwin.btn_setCellData_onclick = function (e) {
    target1.setCellData(2, &quot;col1&quot;, &quot;change&quot;);
};



scwin.btn_removeRow_onclick = function (e) {
    target1.removeRow(3);
}



scwin.btn_setColumnFilter_onclick = function (e) {
	target1.setColumnFilter( {type:'row', colIndex:'col1', key:&quot;col1_2&quot;, condition:'and'})    
    target1.setColumnFilter( {type:'row', colIndex:'col1', key:&quot;insert1&quot;, condition:'or'})
};



scwin.btn_sort_onclick = function (e) {
    target1.sort(&quot;col1&quot;, 1);
};



scwin.btn_getUnmatchedXML_onclick = function (e) {
    let rtn = '';
    let columnInfo = par_columnInfo.getText();
    let data = par_data.getValue();
    let exactMatch = par_exactMatch.getText();
    let startRowIndex = par_startRowIndex.getText();
    let lastRowIndex = par_lastRowIndex.getText();
    
    if (exactMatch == &quot;true&quot;)
        exactMatch = true;
    else if (exactMatch == &quot;false&quot;)
        exactMatch = false;
    else
        exactMatch = true;

    if (startRowIndex == &quot;&quot; &amp;&amp; lastRowIndex == &quot;&quot;)
        rtn = target1.getUnmatchedXML(columnInfo, data, exactMatch);
    else if (lastRowIndex == &quot;&quot;)
        rtn = target1.getUnmatchedXML(columnInfo, data, exactMatch, Number(startRowIndex));
    else
        rtn = target1.getUnmatchedXML(columnInfo, data, exactMatch, Number(startRowIndex), Number(lastRowIndex));

    
    const serializer = new XMLSerializer();
    let xmlString = serializer.serializeToString(rtn);

	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result: &quot; + rtn);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.xml: &quot; + xmlString);  
};</script>
