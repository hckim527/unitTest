		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; M &gt; setData]&lt;br/&gt;1차원 배열과 Row 상태값을 사용하여 DataList 모듈의 데이터를 새로 설정하거나 추가합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;array(필수) 파라미터로 새로 설정하거나 추가할 데이터를 배열 형식의 문자열로 설정합니다.&quot;,
        &quot;columnArray(선택) 파라미터로 array 파라미터의 데이터와 매칭될 Column 의 ID 를 배열 형식의 문자열로 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }    
    
    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
    // target 생성
    $c.gcm.createBasicDataList();

    // gridView 생성
    $c.gcm.createBasicGridView('dataList=&quot;data:target1&quot; rowStatusVisible=&quot;true&quot;', '', 'gridView1');
}



scwin.btn_getAllJSON_onclick = function (e) {
    let rtn = target1.getAllJSON();
    let jsonString = JSON.stringify(rtn);

	// wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result: &quot; + rtn);
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.json: &quot; + jsonString);
};



scwin.btn_setColumnFilter_onclick = function (e) {
	target1.setColumnFilter( {type:'row', colIndex:'col1', key:&quot;col1_2&quot;, condition:'and'})    
    target1.setColumnFilter( {type:'row', colIndex:'col1', key:&quot;col1_4&quot;, condition:'or'})
};



scwin.btn_sort_onclick = function (e) {
    target1.sort(&quot;col1&quot;, 1);
};



scwin.btn_setData_onclick = function (e) {   
    // let array = eval('{' + par_array.getText() + '}');
    let array = par_array.getText();
    let append = par_append.getText();
    // let columnArray = eval('{' + par_columnArray.getText() + '}');
    let columnArray = par_columnArray.getText();
    let rowStatus =  eval('{' + par_rowStatus.getText() + '}');

    if (append == &quot;true&quot;)
        append = true;
    else if (append == &quot;false&quot;)
        append = false;
    else
        append = &quot;&quot;;


    if (columnArray == [] &amp;&amp; rowStatus == [] &amp;&amp; append == &quot;&quot;)
        target1.setData(array);
    else if (columnArray == [] &amp;&amp; rowStatus == [])
        target1.setData(array, append);
    else if (rowStatus == [])
        target1.setData(array, append, columnArray);
    else
        target1.setData(array, append, columnArray, rowStatus);

    scwin.btn_getAllJSON_onclick();
};</script>
