		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[dataList &gt; P &gt; initRowPosition]&lt;br/&gt;DataList 모듈이 렌더링 되거나 전체 데이터가 다시 로드될때 선택할 Row 의 인덱스를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;ref 속성으로 바인드 된 컴포넌트에는 선택된 Row 의 값이 반영됩니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    scwin.btn_getValue_onclick();
}   



scwin.btn_getValue_onclick = function (e) {
    let rtn = input1.getValue();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;input1 value : &quot; + rtn);    
};</script>
