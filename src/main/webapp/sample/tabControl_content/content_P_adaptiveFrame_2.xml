scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = async function () {

};



scwin.btn_setContentWidth_onclick = function (e) {
    let width = par_contentWidth.getText();

    let contentEl = document.querySelector('[id*="target1_contents_content1"]');
    if (contentEl) {
        contentEl.style.width = width;
        window.dispatchEvent(new Event('resize'));
    }
};



scwin.btn_hasClass_onclick = function (e) {
    let tabWin = target1.getWindow();
    let rtn = '';

    rtn = tabWin.target2.hasClass("w2tb_adaptive_layout");
    wf_body_bottom.getObj("scwin").setReturnValue("layout : " + rtn);
};]]></script>
