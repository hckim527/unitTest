		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[content > P > adaptiveFrame]<br/>Content 내부에 적응형 웹(Adaptive Web) 방식의 레이아웃이 적용되는 기준을 설정합니다.",
    "validation" : [        
        "true 설정 시 Content 의 Frame 크기를 기준으로 적응형 웹(Adaptive Web) 방식의 레이아웃이 적용됩니다.",
    ]
