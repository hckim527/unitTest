		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabControl &gt; M &gt; setTabOrder]&lt;br/&gt;Tabs ID 값을 사용하여 Tab 페이지의 순서를 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;tabOrderArray(필수) 파라미터로 변경하려는 Tab 페이지의 순서를 Tabs ID 의 배열로 설정합니다.&quot;,
        &quot;배열에 설정된 ID 의 순서대로 Tab 페이지의 순서가 변경됩니다.&quot;,
        &quot;배열의 길이가 Tab 페이지의 갯수와 다르거나 잘못된 ID 값을 설정하면 동작하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    $c.gcm.createBasicTabControl();
}



// 사용자 정의 함수로 설정
scwin.set_tabHtml = function(label) {
    return '&lt;input type=&quot;button&quot; value=&quot;' + label + '_userFunc&quot;&gt;';
};



scwin.btn_getText_onclick = function (e) {      
    // let rtn = target1.render.textContent;

    // wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);
    let tabs = document.querySelectorAll('li[id*=target1_tab_tabs]');
    let arrTabs = []

    tabs.forEach((tab) =&gt; {
        arrTabs.push(tab.textContent)
    });

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;TabOrder : &quot; + arrTabs);
}



scwin.btn_setTabOrder_onclick = function (e) {
    let tabOrderArray = eval('( ' + par_tabOrderArray.getText() + ' )');

    target1.setTabOrder(tabOrderArray);

    scwin.btn_getText_onclick();
};
</script>
