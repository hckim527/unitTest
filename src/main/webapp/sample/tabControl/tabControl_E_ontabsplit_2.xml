		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabControl &gt; E &gt; ontabsplit]&lt;br/&gt;tabSplit=true 일때 Tab 버튼을 DragDrop 하면 발생하며 반환값으로 취소할 수 있습니다.&quot;,
    &quot;validation&quot; : [
        &quot;tabMove=true 이면 이벤트가 발생하지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        tabSplit : con_tabSplit.getText(),
        tabMove : true,
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;ontabsplit&quot;]);

    $c.gcm.createBasicTabControl(cList, eList);
}


scwin.target1_ontabsplit = function (dragIndex, e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_ontabsplit=====&quot;);
}</script>
