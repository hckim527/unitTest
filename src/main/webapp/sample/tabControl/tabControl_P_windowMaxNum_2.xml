    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    scwin.getTabCount();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.getTabCount = function () {
    let rtn = target1.getTabCount();

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getTabCount : &quot; + rtn);
}</script>
