		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[tabControl > P > adaptiveThreshold]<br/>adaptive=layout 일때 TabControl 컴포넌트에 적응형 웹(Adaptive Web) 레이아웃이 적용되는 임계값을 설정합니다.",
    "validation" : [        
        "적응형 웹(Adaptive Web) 레이아웃이 적용될 기준 너비를 픽셀(px) 단위의 숫자로 설정합니다.",
        "값을 설정하지 않으면 480 으로 적용됩니다.",
        "adaptiveThreshold 속성값보다 웹브라우저의 너비가 작아지면 adaptive 속성에 설정한 적응형 웹(Adaptive Web) 레이아웃이 적용됩니다.",
        "속성값보다 웹브라우저의 너비가 커지면 TabControl 컴포넌트에 정의된 CSS 레이아웃이 적용됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 재생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        adaptive : "layout",
        adaptiveThreshold : con_adaptiveThreshold.getText(),
    }

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicTabControl(cList);
};



scwin.btn_hasClass_onclick = function (e) {
    let rtn = '';

    rtn = target1.hasClass("w2tab_adaptive_layout");
    wf_body_bottom.getObj("scwin").setReturnValue("target1 layout 적용 여부 : " + rtn);   
};
]]></script>
	</head>
