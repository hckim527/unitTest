		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabControl &gt; P &gt; useMoveNextTabFocus]&lt;br/&gt;Tab 페이지의 Content 에서 Tab 키로 포커스를 이동할때 마지막 컴포넌트에서 이동할 대상을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;false 설정 시 TabControl 컴포넌트의 다음 순서인 컴포넌트로 포커스가 이동합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.target1_onchange = function (tabId, index, userTabId) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);
}



scwin.startcomp_onfocus = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====startcomp_onfocus=====&quot;);
}



scwin.target1_onfocus = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onfocus=====&quot;);
}



scwin.nextcomp_onfocus = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====nextcomp_onfocus=====&quot;);
}



scwin.btn_setInitFocus_onclick = function (e) {
	startcomp.focus();    
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
                <xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<w2:textbox style="" id="" label="useMoveNextTabFocus=false 인 상태"></w2:textbox>
                    	<xf:input id="startcomp" style="width: 144px;height: 21px;" initValue="start" inputMode="start"
                    		ev:onfocus="scwin.startcomp_onfocus">
                    	</xf:input>
                    	<w2:tabControl id="target1" alwaysDraw="false" style="width:500px;height:200px;"
                    		ev:onchange="scwin.target1_onchange" useMoveNextTabFocus="false">
                    		<w2:tabs disabled="false" style="height:40px;" id="tabs1" label="Tabs1"></w2:tabs>
                    		<w2:tabs disabled="false" style="height:40px" id="tabs2" label="Tabs2"></w2:tabs>
                    		<w2:content alwaysDraw="false" style="height:160px;" id="content1">
                    			<w2:button style="width:100px;height:40px;" id="button1" label="button1"></w2:button>
                    		</w2:content>
                    		<w2:content alwaysDraw="false" style="height:160px" id="content2">
                    			<w2:button style="width:100px; height:40px;" id="button2" label="button2"></w2:button>
                    		</w2:content>
                    	</w2:tabControl>
                    	<xf:input id="nextcomp" style="width: 144px;height: 21px;" initValue="next" ev:onfocus="scwin.nextcomp_onfocus"></xf:input>
                    </xf:group>
                </xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setInitFocus_onclick" id="btn_setInitFocus" label="초기포커스이동" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
