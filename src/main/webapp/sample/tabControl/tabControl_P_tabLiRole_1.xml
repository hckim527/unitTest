		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabControl &gt; P &gt; tabLiRole]&lt;br/&gt;웹접근성 향상을 위해 Tab 버튼 요소에 role 속성을 추가할지 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;Tab 버튼의 li 요소에 추가될 role 속성의 값을 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 role 속성이 추가되지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        tabLiRole : con_tabLiRole.getText(),
    }

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicTabControl(cList);

    scwin.getTabButtonInfo();
}



scwin.getTabButtonInfo = function () {    
    const tabsId = [
        'li[id*=target1_tab_tabs1]',
        'li[id*=target1_tab_tabs2]',
        'li[id*=target1_tab_tabs3]',
    ]

    tabsId.forEach((tabId, index) =&gt; {
        let tabButton = document.querySelector(tabId);
        let tabButtonRole = tabButton.role;

        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(`tabs${index + 1} role: ${tabButtonRole}`);
    });
}</script>
