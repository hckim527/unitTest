		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[tabControl &gt; E &gt; ontabclose]&lt;br/&gt;Tab 페이지가 제거된 후 발생합니다.&quot;,
    &quot;validation&quot; : [
        &quot;hideTab() 메소드로 Tab 페이지를 숨김 처리하는 경우는 ontabclose 이벤트가 발생하지 않습니다.&quot;,        
        &quot;deleteAllTabs() 메소드로 전체 Tab 페이지를 제거하는 경우는 ontabclose 이벤트가 발생하지 않습니다.&quot;
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        closable : true,
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;ontabclose&quot;]);

    $c.gcm.createBasicTabControl(cList, eList);    
}



scwin.target1_ontabclose = function (tabId, index, userTabId) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_ontabclose=====&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;tabId : &quot; + tabId);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;index : &quot; + index);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;userTabId : &quot; + userTabId);
}



scwin.btn_deleteAllTabs_onclick = function (e) {
	target1.deleteAllTabs();    
};



scwin.btn_hideTab_onclick = async function (e) {
    let tabIndex = par_tabIndex.getText();

    await target1.hideTab(tabIndex);   	
};
</script>
