		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[searchbox > P > ariaLabel]<br/>웹접근성 향상을 위해 SearchBox 컴포넌트에 추가 정보를 설정합니다.",
    "validation" : [
        "웹접근성 추가 정보를 텍스트로 설정할 수 있어야 합니다.",
        "ariaLabel 속성을 설정하지 않으면 기본값 '검색서식' 이 적용되어야 합니다.",
        "스크린리더와 같은 접근성 도구가 해당 요소를 읽을 때 사용되는 속성입니다.",
        "화면 렌더링 시 SearchBox 컴포넌트에 aria-label 속성으로 적용되어야 합니다.",
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        ariaLabel : con_ariaLabel.getValue(),
    }

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicSearchBox(cList);
}



scwin.btn_getAriaLabelDom_onclick = function (e) {
    let elem = document.getElementById(target1.getID());

    if (elem) {
        wf_body_bottom.getObj("scwin").setReturnValue("aria-label : " + elem.getAttribute('aria-label'));
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("target1 element not found");
    }
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
