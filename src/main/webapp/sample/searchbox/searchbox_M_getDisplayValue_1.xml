// getValue 비교용 - 실제 입력값 확인
scwin.btn_getValue1_onclick = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + target1.getValue());
}


scwin.btn_setAll_onclick = function (e) {
    for (var i = 1; i < 9; i ++)
        eval("scwin.btn_setValue"+i+"_onclick()");
}

scwin.btn_getAll_onclick = function (e) {
    for (var i = 1; i < 9; i ++)
        eval("scwin.btn_getDisplayValue"+i+"_onclick()");
};]]></script>
