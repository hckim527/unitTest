		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[searchbox > M > getDisplayValue]<br/>displayFormat, displayFormatter 속성으로 컴포넌트에 표시되고 있는 입력값을 반환합니다.",
    "validation" : [
        "displayFormat, displayFormatter 속성이 적용된 입력값을 반환합니다.",
        "컴포넌트의 실제 입력값을 반환 받으려면 getValue() 메소드를 사용하여야 합니다.",
        "컴포넌트가 포커스 된 경우 getDisplayValue() 메소드와 반환값이 달라질 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.getDisplayValue = function(target) {
    let rtn = '';
    rtn = target.getDisplayValue();

    wf_body_bottom.getObj("scwin").setReturnValue("getDisplayValue : " + rtn);
}



 // 사용자 정의 함수
 scwin.fn_dpformatter = function(val) {
    return "language -> " + val;
 };



// target1
scwin.btn_setValue1_onclick = function (e) {
    target1.setValue("langkoKR");
};

scwin.btn_getDisplayValue1_onclick = function (e) {
    scwin.getDisplayValue(target1);
}

// target2
scwin.btn_setValue2_onclick = function (e) {
