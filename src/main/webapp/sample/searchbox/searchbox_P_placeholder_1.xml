		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[searchbox > P > placeholder]<br/>SearchBox 컴포넌트의 입력값이 없을때 표시될 PlaceHolder 텍스트를 설정합니다.",
    "validation" : [
        "입력창에 PlaceHolder 로 표시될 텍스트를 문자열로 설정할 수 있어야 합니다.",
        "PlaceHolder 텍스트는 입력창에 값이 있거나 값을 입력하는 순간 사라져야 합니다.",
        "readOnly=true 이거나 disabled=true 이면 PlaceHolder 기능이 적용되지 않으며 showPlaceHolderOnReadOnly 속성을 설정해야 합니다.",
        "입력창이 포커스되면 웹브라우저에 따라 PlaceHolder 텍스트가 사라지거나 유지될 수 있습니다.",
        "PlaceHolder 텍스트는 선택 및 복사할 수 없습니다.",
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        placeholder : con_placeholder.getValue(),
        readOnly : con_readOnly.getText(),
        disabled : con_disabled.getText(),
        showPlaceHolderOnReadOnly : con_showPlaceHolderOnReadOnly.getText(),
    }

    let cList = $c.gcm.createCList(properties);

    await $c.gcm.createBasicSearchBox(cList);
};



// placeholder 속성/DOM 확인
scwin.btn_getPlaceholder_onclick = function (e) {
    // options 의 placeholder 속성값 확인
    // wf_body_bottom.getObj("scwin").setReturnValue("options.placeholder : " + target1.options.placeholder);

    // 내부 input 의 DOM placeholder 속성 확인
    let elem = document.querySelector("#" + target1.getID() + " input");

    if (elem) {
        wf_body_bottom.getObj("scwin").setReturnValue("placeholder : " + elem.getAttribute('placeholder'));
        wf_body_bottom.getObj("scwin").setReturnValue("value : " + elem.value);
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("target1 input element not found");
    }
};



// 입력창에 값 입력 (placeholder 사라짐 확인)
scwin.btn_setValue_onclick = function (e) {
    target1.setValue(par_setValue.getValue());

    wf_body_bottom.getObj("scwin").setReturnValue("setValue('" + par_setValue.getValue() + "') 실행");
    wf_body_bottom.getObj("scwin").setReturnValue("target1.getValue() : " + target1.getValue());
};



// 입력창 값 초기화
scwin.btn_clearValue_onclick = function (e) {
    target1.setValue("");

    wf_body_bottom.getObj("scwin").setReturnValue("target1.setValue('') 실행 (값 비움)");
    wf_body_bottom.getObj("scwin").setReturnValue("target1.getValue() : " + target1.getValue());
};]]></script>
	</head>
