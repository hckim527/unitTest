	<head meta_screenName="[searchbox] title" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260514" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[searchbox > P > title]<br/>SearchBox 컴포넌트의 title 속성을 설정합니다.",
    "validation" : [
        "title 속성값을 문자열로 설정할 수 있어야 합니다.",
        "컴포넌트에 마우스 오버 시 설정된 텍스트가 웹브라우저 기본 툴팁으로 표시되어야 합니다.",
        "title 속성에 설정된 값은 컴포넌트에 표시되지 않아야 합니다.",
        "CSS 로 스타일링 할 수 없으며 웹접근성 향상 목적으로 적합하지 않습니다.",
    ]
}



scwin.onpageload = function () {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        title : con_title.getValue(),
    }

    let cList = $c.gcm.createCList(properties);

    $c.gcm.createBasicSearchBox(cList);
}



scwin.btn_getTitleDom_onclick = function (e) {
    // searchbox 는 wrapper div 안의 inner input 에 title 속성이 적용됨
    let inputEl = target1.render.querySelector("input");
    wf_body_bottom.getObj("scwin").setReturnValue("title : " + (inputEl ? inputEl.title : ""));
};



scwin.btn_getText_onclick = function (e) {
    // 컴포넌트 표시 영역(wrapper)의 textContent — title 값이 화면에 표시되지 않음을 검증
    wf_body_bottom.getObj("scwin").setReturnValue("text : " + target1.render.textContent);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
