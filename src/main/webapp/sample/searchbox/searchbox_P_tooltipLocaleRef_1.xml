		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[searchbox > P > tooltipLocaleRef]<br/>클라이언트 다국어가 적용되었을 때 tooltip 속성의 툴팁에 표시할 텍스트의 Key 값을 설정합니다.",
    "validation" : [
        "툴팁에 표시할 다국어 텍스트의 Key 값을 문자열로 설정할 수 있어야 합니다.",
        "tooltip 속성이 설정되어 있고, 클라이언트 다국어 기능(useLocale=true)이 활성화 되었을 때 동작해야 합니다.",
        "설정한 Key 값이 JS 파일에 없다면 'global_undefined' 가 적용되어야 합니다.",
        "Key:Value 형식으로 정의된 JS 파일에서 Key 값에 해당하는 Value 값을 찾아 툴팁에 반영해야 하며, 클라이언트(웹브라우저)에 설정된 언어에 해당하는 JS 파일이 적용되어야 합니다.",           
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        tooltip: con_tooltip.getValue(),
        tooltipLocaleRef: con_tooltipLocaleRef.getText(),
        useLocale: con_useLocale.getText(),
    };

    let cList = $c.gcm.createCList(properties);

    await $c.gcm.createBasicSearchBox(cList, 'ev:onclick="scwin.target1_onclick"');
};



// 컴포넌트 클릭 시 현재 표시 중인 툴팁 정보 출력
scwin.target1_onclick = function (e) {
    $c.gcm.getTooltipInfo(wf_body_bottom);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
