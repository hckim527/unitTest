												<xf:value><![CDATA[1]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[websquare_name]]></xf:label>
												<xf:value><![CDATA[2]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[invalid]]></xf:label>
												<xf:value><![CDATA[3]]></xf:value>
											</xf:item>
										</xf:choices>
