												<xf:value ref="value"></xf:value>
											</xf:itemset>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group tagname="th" class="w2tb_th "></xf:group>
								<xf:group tagname="td" class="w2tb_td"></xf:group>
							</xf:group>
						</xf:group>
