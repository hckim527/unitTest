									<w2:textbox class="" id="" label="tooltipLocaleRef" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" class="w2tb_td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" id="con_tooltipLocaleRef" ref=""
										style="" submenuSize="auto">
