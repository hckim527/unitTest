		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[multiselect > E > ondblclick]<br/>MultiSelect 컴포넌트를 마우스 왼쪽 버튼으로 더블 클릭할 때 발생합니다.",
    "validation" : [
        "accessibility=true 이면 리스트 항목(li 요소) 더블 클릭 시 이벤트가 발생합니다.",
        "accessibility=false 이면 테이블 행(tr 요소) 더블 클릭 시 이벤트가 발생합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let cAccessibility = con_accessibility.getText();

    let properties = {
        accessibility : cAccessibility,
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["ondblclick"]);

    $c.gcm.createBasicMultiSelect(cList, eList);
}



// ondblclick 이벤트 핸들러
scwin.target1_ondblclick = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("===== target1 ondblclick =====");
    wf_body_bottom.getObj("scwin").setReturnValue("e: " + e);
}]]></script>
	</head>
