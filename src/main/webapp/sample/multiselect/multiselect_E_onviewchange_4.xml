					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setValue_onclick" id="btn_setValue" label="setValue" style=""></w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setText_onclick" id="btn_setText" label="setText" style=""></w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setSelectedIndex_onclick" id="btn_setSelectedIndex" label="setSelectedIndex" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
