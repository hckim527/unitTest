<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[multiselect] onviewchange (메서드 호출 시 미발생)" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260508" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.tData = {
    "description" : "[multiselect > E > onviewchange]<br/>MultiSelect 컴포넌트에서 사용자의 조작에 의해 아이템 선택이 변경되면 발생합니다.",
    "validation" : [
        "setValue(), setText(), setSelectedIndex() 등의 메소드로 아이템의 선택을 변경한 경우 onviewchange 이벤트는 발생하지 않습니다.",        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("===== target1 onviewchange =====");
};



scwin.comp_init = async function () {
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let cList = $c.gcm.createCList({ separator: "," });
    let eList = $c.gcm.createEList(["onviewchange"]);

    await $c.gcm.createBasicMultiSelect(cList, eList);
}



// setValue 호출 - onviewchange 미발생 검증
scwin.btn_setValue_onclick = function (e) {
    let v = par_value.getValue();
    target1.setValue(v);
};



// setText 호출 - onviewchange 미발생 검증
scwin.btn_setText_onclick = function (e) {
    let t = par_label.getValue();
    target1.setText(t);
};



// setSelectedIndex 호출 - onviewchange 미발생 검증
scwin.btn_setSelectedIndex_onclick = function (e) {
    let idx = par_index.getValue();
    target1.setSelectedIndex(idx);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
