<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[multiselect] onviewchange (ref 바인딩)" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260508" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_ref">
					<w2:columnInfo>
						<w2:column id="value" name="name1" dataType="text"></w2:column>
						<w2:column id="label" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<value><![CDATA[1]]></value>
							<label><![CDATA[multiselect_item1]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[2]]></value>
							<label><![CDATA[multiselect_item2]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[3]]></value>
							<label><![CDATA[multiselect_item3]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[1,2]]></value>
							<label><![CDATA[multiselect_item1,2 (복수 선택)]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[2,3]]></value>
							<label><![CDATA[multiselect_item2,3 (복수 선택)]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.tData = {
    "description" : "[multiselect > E > onviewchange]<br/>MultiSelect 컴포넌트에서 사용자의 조작에 의해 아이템 선택이 변경되면 발생합니다.",
    "validation" : [
        "ref 속성으로 DataCollection 을 바인딩 한 경우 데이터 선택이 변경되어도 onviewchange 이벤트는 발생하지 않습니다. (onchange 는 발생)",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("===== target1 onviewchange =====");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<xf:select id="target1" appearance="minimal" style="width:200px;height:80px;"
								ref="data:dlt_ref.value" separator=","
								ev:onviewchange="scwin.target1_onviewchange" ev:onchange="">
							<xf:choices>
								<xf:itemset nodeset="data:gdl_multiselect">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
						<w2:gridView checkAllType="false" id="gridView1" style="width:400px;height:200px;" dataList="data:dlt_ref">
							<w2:caption style="" id="caption1" value="dlt_ref - row 클릭 시 ref 바인딩으로 multiselect 에 반영 (onchange 만 발생, onviewchange 미발생)"></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="70" inputType="text" style="" id="column1" value="value" displayMode="label"></w2:column>
									<w2:column width="280" inputType="text" style="" id="column2" value="label" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="70" inputType="text" style="" id="value" value="" displayMode="label"></w2:column>
									<w2:column width="280" inputType="text" style="" id="label" value="" displayMode="label"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
