		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[multiselect > M > setRef]<br/>유효한 DataCollection 의 컬럼을 ref 로 설정하는 케이스를 검증합니다.",
    "validation" : [
        "ref(필수) 파라미터로 접근 가능한 DataCollection 의 컬럼을 'data:[DataCollection ID].[Key 또는 Column ID]' 형식으로 설정합니다.",
        "유효한 ref 적용 시 컴포넌트에서 선택한 아이템의 Value 값이 바인딩 된 DataCollection 에 반영됩니다.",
        "메소드가 실행되어 ref 속성이 설정되면 현재 선택된 아이템이 모두 해제됩니다.",
        "해제 과정에서 Value 값이 변경되면 onchange 이벤트가 발생합니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 (gdl_multiselect 포함)
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// onchange 이벤트 핸들러 — multiselect onchange 는 파라미터 없음 (engine spec)
// setRef 후 선택 해제 과정에서 Value 가 변경되면 발생
scwin.target1_onchange = function () {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");
    wf_body_bottom.getObj("scwin").setReturnValue("getValue() : " + target1.getValue());
    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex() : " + target1.getSelectedIndex());
};



// setRef: par_ref 의 값으로 setRef 호출 (유효한 ref - 'data:dlt_ref.value')
scwin.btn_setRef_onclick = function (e) {
    let ref = par_ref.getValue();
    target1.setRef(ref);
    wf_body_bottom.getObj("scwin").setReturnValue("setRef('" + ref + "') 호출");
    wf_body_bottom.getObj("scwin").setReturnValue("options.ref : " + target1.options.ref);
    wf_body_bottom.getObj("scwin").setReturnValue("getValue() : " + target1.getValue());
    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex() : " + target1.getSelectedIndex());
};



// 바인딩된 dlt_ref 의 현재 row 값 확인
scwin.btn_getDataList_onclick = function (e) {
    let rsData = dlt_ref.getAllJSON();
    for (let i = 0; i < rsData.length; i++) {
        wf_body_bottom.getObj("scwin").setReturnValue("Row " + i + " value : " + rsData[i].value);
    }
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
