<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[multiselect] ref" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260507" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_ref">
					<w2:columnInfo>
						<w2:column id="value" name="name1" dataType="text"></w2:column>
						<w2:column id="label" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<value><![CDATA[1]]></value>
							<label><![CDATA[multiselect_item1]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[2]]></value>
							<label><![CDATA[multiselect_item2]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[3]]></value>
							<label><![CDATA[multiselect_item3]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[multiselect > P > ref]<br/>Multiselect 컴포넌트의 선택값에 바인딩할 DataCollection 정보를 설정합니다.",
    "validation" : [
        "유효하지 않은 값으로 설정 시 바인딩 처리되지 않고 아이템 선택이 연동되지 않습니다.",
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 (gdl_multiselect 포함)
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// onchange 이벤트 핸들러 — multiselect onchange 는 파라미터 없음 (engine spec)
// 유효하지 않은 ref 이므로 dlt_ref 에는 반영되지 않으나 multiselect 자체 선택값은 getValue 로 확인 가능
scwin.target1_onchange = function () {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");
    wf_body_bottom.getObj("scwin").setReturnValue("getValue() : " + target1.getValue());
    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex() : " + target1.getSelectedIndex());
};



// 바인딩된 dlt_ref 의 현재 row 값 확인 (유효하지 않은 ref 이므로 변경되지 않아야 함)
scwin.btn_getDataList_onclick = function (e) {
    let rsData = dlt_ref.getAllJSON();
    for (let i = 0; i < rsData.length; i++) {
        wf_body_bottom.getObj("scwin").setReturnValue("Row " + i + " value : " + rsData[i].value);
    }
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="background-color:silver;" id="" label="유효하지 않은 ref(data:dlt_invalid.value) 설정 시 미연동 되어야 함"></w2:textbox>
						<xf:select id="target1" appearance="minimal" style="width:200px;height:80px;"
								ref="data:dlt_invalid.value" separator="," ev:onchange="scwin.target1_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:gdl_multiselect">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
						<w2:gridView checkAllType="false" id="gridView1" style="width:400px;height:200px;" dataList="data:dlt_ref">
							<w2:caption style="" id="caption1" value="dlt_ref - 유효하지 않은 ref 이므로 multiselect 선택 시 변경되지 않아야 함"></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="70" inputType="text" style="" id="column1" value="value" displayMode="label"></w2:column>
									<w2:column width="280" inputType="text" style="" id="column2" value="label" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="70" inputType="text" style="" id="value" value="" displayMode="label"></w2:column>
									<w2:column width="280" inputType="text" style="" id="label" value="" displayMode="label"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button ev:onclick="scwin.btn_getDataList_onclick" style="" id="btn_getDataList" label="DataList 값 확인" class="tc_btn_basic"></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
