		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p.local > M > removeItem]<br/>localStorage 에서 파라미터에 해당하는 데이터를 삭제합니다.",
    "validation" : [
       	"$p.local.removeItem() 메소드는 'Page Scope' 가 적용되지 않습니다.",
	   	"key(필수) 파라미터로 삭제할 항목의 키 이름을 설정합니다.",
    ]
}



scwin.onpageload = function () {
    // $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 데이터 초기화
    WebSquare.localStorage.clear();
}



scwin.btn_removeItem_onclick = function (e) {
    let key = par_key.getText();

    $p.local.removeItem(key);

    scwin.btn_getAllitem_onclick();
}



scwin.btn_getAllitem_onclick = function () {
    let rtn = $p.local.getAllItem();
    let jsonString = JSON.stringify(rtn);

	wf_body_bottom.getObj("scwin").setReturnValue("result: " + rtn);
	wf_body_bottom.getObj("scwin").setReturnValue("result.json: " + jsonString);
}



scwin.btn_setItem_onclick = function (e) {
	let key = par_key.getText();
    let value = par_value.getText();

    $p.local.setItem(key, value);

    scwin.btn_getAllitem_onclick();
};]]></script>
