		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > setTimeout]<br/>특정 함수를 setTimeout 으로 등록하여 일정 시간 후에 실행되도록 합니다.",
    "validation" : [
        "options.caller(선택) 파라미터로 func 내에서 this 로 사용될 객체를 설정할 수 있어야 합니다.",
        "options.caller(선택) 파라미터 생략 시 기본값 window 로 동작해야 합니다.",
        "options.args(선택) 파라미터로 func 에 전달할 인자 배열을 설정할 수 있어야 합니다.",
        "options.args(선택) 파라미터 생략 시 기본값 빈 배열로 동작해야 합니다.",
        "options.before_call(선택) 파라미터로 func 실행 직전에 호출되는 함수를 설정할 수 있어야 합니다.",
        "options.callback(선택) 파라미터로 func 실행 후 호출되는 콜백 함수를 설정할 수 있어야 합니다. func 의 반환값을 인자로 받습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_setTimeout_onclick = function () {
    var callerVal = par_caller.getValue();
    var argsVal = par_args.getValue();
    var beforeCallVal = par_before_call.getValue();
    var callbackVal = par_callback.getValue();
    var options = {key: "advanced_test", delay: 500};

    if (callerVal === "btn_setTimeout") {
        options.caller = btn_setTimeout;
    }

    if (argsVal === "true") {
        options.args = ["api_example", "C0001"];
    }

    if (beforeCallVal === "true") {
        options.before_call = function (data) {
            wf_body_bottom.getObj("scwin").setReturnValue("before_call 실행됨");
        };
    }

    if (callbackVal === "true") {
        options.callback = function (result) {
            wf_body_bottom.getObj("scwin").setReturnValue("callback 실행됨, result : " + JSON.stringify(result));
        };
    }

    $p.setTimeout(function (arg1, arg2) {
        if (typeof arg1 !== "undefined") {
            wf_body_bottom.getObj("scwin").setReturnValue("arg1 : " + arg1);
            wf_body_bottom.getObj("scwin").setReturnValue("arg2 : " + arg2);
        }
        wf_body_bottom.getObj("scwin").setReturnValue("this === window : " + (this === window));
        if (this !== window) {
            wf_body_bottom.getObj("scwin").setReturnValue("this.id : " + this.id);
        }
        return {"EXEC": "DONE"};
    }, options);

    wf_body_bottom.getObj("scwin").setReturnValue("setTimeout 호출 완료, 500ms 후 결과 확인");
}]]></script>
