		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > reinitialize]<br/>현재 페이지를 다시 로딩하거나 웹브라우저를 새로고침합니다.",
    "validation" : [
        "refresh(선택) 파라미터를 true 로 설정하면 브라우저를 새로고침해야 합니다.",
        "refresh(선택) 파라미터를 false 로 설정하면 SPA 방식으로 현재 페이지만 다시 로딩해야 합니다.",
        "refresh(선택) 파라미터를 생략하면 기본값(false)으로 동작해야 합니다.",
        "main 에서 실행 시 전체 화면이, wframe 에서 실행 시 해당 wframe 내부만 재로딩되어야 합니다."
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // 메인 페이지 로드 카운터
    var count = parseInt(sessionStorage.getItem("$p_reinit_main_count") || "0", 10) + 1;
    sessionStorage.setItem("$p_reinit_main_count", String(count));
    wf_body_bottom.getObj("scwin").setReturnValue("메인 loadCount : " + count);
};



scwin.btn_reinit_main_onclick = function () {
    var refresh = par_refresh.getValue();
    if (refresh === "true") {
        // 브라우저 새로고침 전 카운터 초기화 → 새로고침 후 loadCount 가 1 로 리셋되어 SPA 와 구분
        sessionStorage.removeItem("$p_reinit_main_count");
        sessionStorage.removeItem("$p_reinit_mid_count");
        $p.reinitialize(true);
    } else if (refresh === "false") {
        $p.reinitialize(false);
    } else {
        $p.reinitialize();
    }
};



scwin.btn_reset_counter_onclick = function () {
    sessionStorage.removeItem("$p_reinit_main_count");
    sessionStorage.removeItem("$p_reinit_mid_count");
    wf_body_bottom.getObj("scwin").setReturnValue("로드 카운터 초기화");
};]]></script>
	</head>
