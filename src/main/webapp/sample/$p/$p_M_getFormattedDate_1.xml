		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > getFormattedDate]<br/>Date 객체 또는 날짜 문자열을 받아서 지정한 포맷으로 날짜/시간 문자열을 반환합니다.",
    "validation" : [
        "date(필수) 파라미터로 JavaScript Date 객체 또는 날짜 문자열을 설정할 수 있어야 합니다.",
        "문자열을 설정한 경우 문자열의 날짜 형식과 pattern 파라미터의 날짜 형식이 일치해야 합니다.",
        "pattern(선택) 파라미터로 날짜 형식 패턴을 설정할 수 있어야 합니다.",
        "지정된 pattern 파라미터값으로 포맷된 날짜/시간 문자열을 반환해야 합니다.",
        "date 가 유효하지 않은 객체이거나 null 이면 null 을 반환해야 합니다.",
        "pattern 파라미터를 설정하지 않으면 Date.getTime() 값(밀리초 타임스탬프)을 문자열로 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_getFormattedDate_onclick = function () {
    var dateType = par_date.getValue();
    var pattern = par_pattern.getValue();

    var date;
    if (dateType === "dateObj") {
        date = new Date(2023, 11, 25, 11, 24, 33, 707);
    } else if (dateType === "null") {
        date = null;
    } else {
        date = dateType;
    }

    var ret;
    if (pattern === "omit") {
        ret = $p.getFormattedDate(date);
        wf_body_bottom.getObj("scwin").setReturnValue("getFormattedDate(" + (dateType === "dateObj" ? "new Date(2023,11,25,11,24,33,707)" : "'" + dateType + "'") + ") : " + ret);
    } else {
        ret = $p.getFormattedDate(date, pattern);
        wf_body_bottom.getObj("scwin").setReturnValue("getFormattedDate(" + (dateType === "dateObj" ? "new Date(2023,11,25,11,24,33,707)" : "'" + dateType + "'") + ", '" + pattern + "') : " + ret);
    }
}



scwin.par_date_onchange = function (info) {
    par_pattern.setValue("yyyy.MM.dd");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
