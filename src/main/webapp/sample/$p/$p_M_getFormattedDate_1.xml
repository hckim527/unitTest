									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="par_pattern" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item><xf:label><![CDATA[yyyy.MM.dd]]></xf:label><xf:value><![CDATA[yyyy.MM.dd]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[yyyy-MM-dd EEEE]]></xf:label><xf:value><![CDATA[yyyy-MM-dd EEEE]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[yyyy-MM-dd HH:mm:ss]]></xf:label><xf:value><![CDATA[yyyy-MM-dd HH:mm:ss]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[yyyyMMddHHmmssSSS]]></xf:label><xf:value><![CDATA[yyyyMMddHHmmssSSS]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[yy/M/d E]]></xf:label><xf:value><![CDATA[yy/M/d E]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[(생략 → 밀리초 타임스탬프)]]></xf:label><xf:value><![CDATA[omit]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
