		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > getMetaValue]<br/>WebSquare 페이지의 head 영역에 정의된 메타 정보에서 지정한 key 에 해당하는 값을 반환합니다.",
    "validation" : [
        "key(필수) 파라미터로 조회하려는 메타 정보의 key 를 설정할 수 있어야 합니다.",
        "해당 key 의 메타 속성값을 반환해야 합니다.",
        "head 영역이 없거나 해당 key 의 속성이 없으면 빈 문자열('')을 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    $c.gcm.createLabel('label="head 메타 속성: meta_screenName, meta_author, meta_type"', '', 'label1');
};



scwin.btn_getMetaValue_onclick = function () {
    var key = par_key.getValue();

    var result = $p.getMetaValue(key);

    wf_body_bottom.getObj("scwin").setReturnValue("getMetaValue('" + key + "') : '" + result + "'");
}]]></script>
	</head>
