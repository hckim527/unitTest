		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > getRuntimeId]<br/>디자인 시 설정한 ID 를 사용하여 컴포넌트의 런타임 ID 를 반환합니다.",
    "validation" : [
        "id(필수) 파라미터로 디자인 시 정의한 컴포넌트 ID 를 설정할 수 있어야 합니다.",
        "컴포넌트의 런타임 ID 를 반환해야 합니다.",
        "WFrame 의 Scope 기능을 사용하면 각 화면의 컴포넌트 ID 는 런타임에 고유 ID 로 변경되어야 합니다.",
        "WFrame 에 구성된 컴포넌트의 런타임 ID 생성 규칙은 'mf' + '_' + 'Frame 의 ID' + '_' + '컴포넌트 ID' 형식이어야 합니다.",
        "id 에 해당하는 컴포넌트가 없으면 빈 문자열('')을 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_getRuntimeId_main_onclick = function () {
    var id = par_id.getValue();
    var runtimeId = $p.getRuntimeId(id);

    wf_body_bottom.getObj("scwin").setReturnValue("메인 $p.getRuntimeId('" + id + "') : '" + runtimeId + "'");
}



scwin.btn_getRuntimeId_wframe_onclick = function () {
    var id = par_id.getValue();
    var runtimeId = wf_sub.getObj("$p").getRuntimeId(id);

    wf_body_bottom.getObj("scwin").setReturnValue("WFrame $p.getRuntimeId('" + id + "') : '" + runtimeId + "'");
}]]></script>
