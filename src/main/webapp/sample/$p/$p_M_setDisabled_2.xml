        "info.includeAll(선택) 파라미터를 true 로 설정하면 info.includeIdList 파라미터에 설정한 ID 를 가진 컴포넌트가 여러 개인 경우 동일 ID 를 가진 컴포넌트를 모두 처리해야 합니다.",
        "info.includeAll(선택) 파라미터를 false 로 설정하면 info.includeIdList 파라미터에 설정한 ID 를 가진 컴포넌트가 여러 개인 경우 동일 ID 를 가진 컴포넌트 중 첫 번째 하나만 처리해야 합니다.",
        "info.includeAll(선택) 파라미터 생략 시 기본값 false 로 동작해야 합니다.",
        "info.excludeAll(선택) 파라미터를 true 로 설정하면 info.excludeIdList 파라미터에 설정한 ID 를 가진 컴포넌트가 여러 개인 경우 동일 ID 를 가진 컴포넌트를 모두 처리해야 합니다.",
        "info.excludeAll(선택) 파라미터를 false 로 설정하면 info.excludeIdList 파라미터에 설정한 ID 를 가진 컴포넌트가 여러 개인 경우 동일 ID 를 가진 컴포넌트 중 첫 번째 하나만 처리해야 합니다.",
        "info.excludeAll(선택) 파라미터 생략 시 기본값 false 로 동작해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_setDisabled_onclick = function () {
    var componentId = "grp_target";
    var disabled = par_disabled.getText() === "true";
    var includeIdList = par_includeIdList.getValue();
    var excludeIdList = par_excludeIdList.getValue();
    var includeAll = par_includeAll.getValue();
    var excludeAll = par_excludeAll.getValue();

    var info = {componentId: componentId, disabled: disabled};

    if (includeIdList !== "미설정") {
        info.includeIdList = JSON.parse(includeIdList);
    }

    if (excludeIdList !== "미설정") {
        info.excludeIdList = JSON.parse(excludeIdList);
    }

    if (includeAll !== "") {
        info.includeAll = includeAll === "true";
    }

    if (excludeAll !== "") {
        info.excludeAll = excludeAll === "true";
    }

    wf_body_bottom.getObj("scwin").setReturnValue("info : " + JSON.stringify(info));

    var result = $p.setDisabled(info);

    wf_body_bottom.getObj("scwin").setReturnValue("result.doneComponents : " + JSON.stringify(result.doneComponents));
    wf_body_bottom.getObj("scwin").setReturnValue("result.skipComponents : " + JSON.stringify(result.skipComponents));

    var inputElems = document.querySelectorAll("[id^='mf_target_input']");
    var states = [];
    for (var i = 0; i < inputElems.length; i++) {
        var el = inputElems[i];
        var hasDisabledClass = el.classList.contains("w2input_disabled");
        var isDisabledAttr = el.querySelector("input") ? el.querySelector("input").disabled : false;
        states.push(el.id + "=" + (hasDisabledClass || isDisabledAttr));
    }
    wf_body_bottom.getObj("scwin").setReturnValue("disabled 상태(DOM) : " + states.join(", "));
}]]></script>
