		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > dateAdd]<br/>날짜 및 시간 문자열에 지정된 수만큼 더하거나 뺀 결과를 문자열로 반환합니다.",
    "validation" : [
        "date(필수) 파라미터로 지정 날짜와 시간을 문자열로 설정할 수 있어야 합니다.",
        "offset(필수) 파라미터로 날짜 및 시간에 더할 숫자를 설정할 수 있어야 합니다.",
        "offset 에 음수를 설정하면 날짜를 빼는 연산을 수행해야 합니다.",
        "type(선택) 파라미터로 offset 값을 더할 대상 단위를 설정할 수 있어야 합니다.",
        "type 을 'day' 로 설정하면 일 단위로 더하고 yyyyMMdd 형식으로 반환해야 합니다.",
        "type 을 'month' 로 설정하면 월 단위로 더하고 yyyyMM 형식으로 반환해야 합니다.",
        "type 을 'hour' 로 설정하면 시 단위로 더하고 yyyyMMddHH 형식으로 반환해야 합니다.",
        "type 을 'minute' 로 설정하면 분 단위로 더하고 yyyyMMddHHmm 형식으로 반환해야 합니다.",
        "type 을 'year' 로 설정하면 년 단위로 더하고 yyyy 형식으로 반환해야 합니다.",
        "type(선택) 파라미터 생략 시 기본값 'day' 로 동작해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_dateAdd_onclick = function () {
    var date = par_date.getValue();
    var offset = Number(par_offset.getValue());
    var type = par_type.getValue();

    var ret;
    if (type === "") {
        ret = $p.dateAdd(date, offset);
    } else {
        ret = $p.dateAdd(date, offset, type);
    }

    wf_body_bottom.getObj("scwin").setReturnValue("dateAdd('" + date + "', " + offset + (type ? ", '" + type + "'" : "") + ") : " + ret);
}]]></script>
	</head>
