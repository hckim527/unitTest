											<xf:item><xf:label><![CDATA[/websquare/websquare.html?w2xPath=/sample/common_link/util_url_1.xml (전체 URL)]]></xf:label><xf:value><![CDATA[/websquare/websquare.html?w2xPath=/sample/common_link/util_url_1.xml]]></xf:value></xf:item>
