										<xf:choices>
											<xf:item><xf:label><![CDATA[(생략 → false)]]></xf:label><xf:value><![CDATA[]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[true (히스토리 덮어쓰기)]]></xf:label><xf:value><![CDATA[true]]></xf:value></xf:item>
											<xf:item><xf:label><![CDATA[false (새 히스토리 추가)]]></xf:label><xf:value><![CDATA[false]]></xf:value></xf:item>
										</xf:choices>
									</xf:select1>
