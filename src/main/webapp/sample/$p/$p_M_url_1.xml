		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[$p > M > url]<br/>전체 URL 대신 w2xPath(XML 파일 경로) 만 지정하여 페이지를 이동합니다.",
    "validation" : [
        "w2xPath(필수) 파라미터로 이동할 XML 파일의 경로 또는 전체 URL 을 설정할 수 있어야 합니다.",
        "options(선택) 파라미터로 페이지 이동 옵션을 설정할 수 있어야 합니다.",
        "options(선택) 파라미터 생략 시 기본 옵션으로 동작해야 합니다.",
        "options.spa(선택) 파라미터를 true 로 설정하면 w2xPath 를 해시(#) 방식으로 전달해야 합니다.",
        "options.spa(선택) 파라미터를 false 로 설정하면 w2xPath 를 쿼리스트링(?) 방식으로 전달해야 합니다.",
        "options.spa(선택) 파라미터 생략 시 config.xml 의 /WebSquare/spa/@value 설정값을 사용하며, 해당 설정이 없으면 false 가 적용되어야 합니다.",
        "options.replaceHistory(선택) 파라미터를 true 로 설정하면 현재 히스토리를 덮어써야 합니다.",
        "options.replaceHistory(선택) 파라미터를 false 로 설정하면 새 히스토리를 추가해야 합니다.",
        "options.param(선택) 파라미터로 {key: value} 형태의 JSON 객체를 설정하면 URL 에 &key=value 형태로 추가되어야 합니다.",
        "options.param(선택) 파라미터 객체의 값은 URLEncoder 로 인코딩되어야 합니다.",
        "options.shortURL(선택) 파라미터를 true 로 설정하면 w2xPath 를 경로로 사용하여 SPA/non-SPA 분기 로직을 실행해야 합니다.",
        "options.shortURL(선택) 파라미터를 false 로 설정하면 w2xPath 를 전체 URL 로 간주하여 직접 이동해야 합니다.",
        "options.shortURL(선택) 파라미터 생략 시 w2xPath 에 '?w2xPath' 또는 '#w2xPath' 가 없고 '.xml' 로 끝나면 true 로 자동 판단해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_url_onclick = function () {
    var w2xPath = par_w2xPath.getValue();
    var spa = par_spa.getValue();
    var replaceHistory = par_replaceHistory.getValue();
    var param = par_param.getValue();
    var shortURL = par_shortURL.getValue();
    var options = {};

    if (spa !== "") {
        options.spa = (spa === "true");
    }
    if (replaceHistory !== "") {
        options.replaceHistory = (replaceHistory === "true");
    }
    if (param === "true") {
        options.param = {"name": "123", "ID": "asdf"};
    }
    if (shortURL !== "") {
        options.shortURL = (shortURL === "true");
    }

    wf_body_bottom.getObj("scwin").setReturnValue("url 호출 : w2xPath=" + w2xPath);
    wf_body_bottom.getObj("scwin").setReturnValue("options : " + JSON.stringify(options));

    $p.url(w2xPath, options);
}]]></script>
	</head>
