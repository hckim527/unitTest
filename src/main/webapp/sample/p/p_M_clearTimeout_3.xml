		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[p > M > clearTimeout]<br/>$p.setTimeout() 메소드로 등록한 일회성 타이머를 제거합니다.",
    "validation" : [
        "존재하지 않는 키값을 전달하면 아무 동작도 하지 않아야 합니다.",
    ]
}

scwin.count = 0;

scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.comp_init = function () {
    scwin.count = 0;
}



scwin.timerFunc = function () {
    scwin.count++;
    wf_body_bottom.getObj("scwin").setReturnValue("타이머 실행 횟수 : " + scwin.count);
}



scwin.btn_setTimeout_onclick = function () {
    var key = "timer1";

    scwin.count = 0;
    $p.setTimeout(scwin.timerFunc, {key:key, delay:1000});
    wf_body_bottom.getObj("scwin").setReturnValue("setTimeout 등록 완료 (key: '" + key + "', 1초)");
    wf_body_bottom.getObj("scwin").setReturnValue("※ 1초 내에 clearTimeout 을 실행하세요.");
}



scwin.btn_clearTimeout_onclick = function () {
    var key = par_key.getValue();

    $p.clearTimeout(key, false);

    wf_body_bottom.getObj("scwin").setReturnValue("clearTimeout('" + key + "', false)");
    wf_body_bottom.getObj("scwin").setReturnValue("타이머 실행 횟수 : " + scwin.count);
}]]></script>
	</head>
