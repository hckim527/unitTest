		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[p > M > getBASE64Parameter]<br/>URL 쿼리 문자열(GET 방식)에서 특정 파라미터를 Base64 디코딩하여 반환합니다.",
    "validation" : [
        "param(필수) 파라미터로 값을 가져올 파라미터명을 설정할 수 있어야 합니다.",
        "param 에 해당하는 값을 Base64 디코딩하여 반환해야 합니다.",
        "파라미터가 존재하지 않거나 값이 없으면 빈 문자열('')을 반환해야 합니다.",
        "※ WebSquare.text.BASE64URLEncoder 로 인코딩한 값을 사용해야 합니다. 표준 btoa 와 인코딩 방식이 다릅니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_getBASE64Parameter_onclick = function () {
    var param = par_param.getValue();

    var result = $p.getBASE64Parameter(param);

    wf_body_bottom.getObj("scwin").setReturnValue("getBASE64Parameter('" + param + "') : '" + result + "'");
}



scwin.btn_navigateWithBase64_onclick = function () {
    var enc1 = WebSquare.text.BASE64URLEncoder("Hello");
    var enc2 = WebSquare.text.BASE64URLEncoder("World");

    wf_body_bottom.getObj("scwin").setReturnValue("$p.url 로 Base64 파라미터 전달하여 이동합니다.");
    wf_body_bottom.getObj("scwin").setReturnValue("key1=" + enc1 + " (Hello), key2=" + enc2 + " (World)");

    $p.url("/sample/p/p_M_getBASE64Parameter_1.xml", {
        spa: false,
        param: {"key1": enc1, "key2": enc2}
    });
}]]></script>
