		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[p > M > toTimestampString]<br/>JavaScript Date 객체를 Java 의 java.sql.Timestamp 와 동일한 형식의 문자열로 변환하여 반환합니다.",
    "validation" : [
        "date(필수) 파라미터로 변환할 JavaScript Date 객체를 설정할 수 있어야 합니다.",
        "yyyy-MM-dd HH:mm:ss.ffffff 형식의 문자열을 반환해야 합니다.",
        "밀리초(3자리) 뒤에 '000' 을 추가하여 6자리 마이크로초 형식으로 반환해야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.timestampRegex = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01]) ([01]\d|2[0-3]):([0-5]\d):([0-5]\d)\.\d{6}$/;



scwin.btn_toTimestampString_onclick = function () {
    var dateType = par_date.getValue();

    var date;
    if (dateType === "fixed") {
        date = new Date(2023, 11, 25, 11, 1, 47, 219);
    } else {
        date = new Date();
    }

    var ret = $p.toTimestampString(date);

    if (dateType === "now") {
        var isValid = scwin.timestampRegex.test(ret);
        wf_body_bottom.getObj("scwin").setReturnValue("toTimestampString(new Date()) 형식 검증 : " + (isValid ? "PASS" : "FAIL"));
    } else {
        wf_body_bottom.getObj("scwin").setReturnValue("toTimestampString(new Date(2023,11,25,11,1,47,219)) : " + ret);
    }
}]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
