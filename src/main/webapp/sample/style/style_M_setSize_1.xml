		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[style > M > setSize]<br/>Element 의 너비(width)와 높이(height)를 px 단위로 설정합니다.",
    "validation" : [
        "element(필수) 파라미터로 크기를 설정할 대상 Element 를 설정할 수 있어야 합니다.",
        "width(필수) 파라미터로 너비값을 px 단위로 설정할 수 있어야 합니다.",
        "height(필수) 파라미터로 높이값을 px 단위로 설정할 수 있어야 합니다.",
        "width 와 height 파라미터는 독립적으로 동작하여 한쪽이 유효하지 않아도 다른 쪽만 설정되어야 합니다.",
        "파라미터값은 parseInt() 로 정수 변환되므로 소수점 이하는 절삭되어야 합니다.",
        "0 미만의 음수값은 적용되지 않으며 해당 방향의 크기는 변경되지 않아야 합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_setSize_onclick = function () {
    let width = par_width.getValue();
    let height = par_height.getValue();
    let targetEl = document.querySelector("[id*='grp_target']");

    // 설정 전 크기
    var beforeW = targetEl.style.width;
    var beforeH = targetEl.style.height;

    // width, height 를 Number 또는 NaN 으로 변환
    var w = (width === 'NaN') ? NaN : Number(width);
    var h = (height === 'NaN') ? NaN : Number(height);

    WebSquare.style.setSize(targetEl, w, h);

    // 설정 후 크기
    var afterW = targetEl.style.width;
    var afterH = targetEl.style.height;

    wf_body_bottom.getObj("scwin").setReturnValue("setSize(element, " + width + ", " + height + ") 호출");
    wf_body_bottom.getObj("scwin").setReturnValue("width : " + beforeW + " → " + afterW);
    wf_body_bottom.getObj("scwin").setReturnValue("height : " + beforeH + " → " + afterH);
}]]></script>
	</head>
