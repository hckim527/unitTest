						<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 테스트 샘플" style=""></w2:textbox>
						<xf:group class="tc_group_basic" id="grp_comp" style="">
							<w2:textbox id="" label="tooltip 에 escape 미적용 확인, 기대값: 입니다" style="background-color:silver;"></w2:textbox>
							<xf:select appearance="full" style="width:148px;" id="target1" selectedindex="-1" cols="" rows="" ref=""
								tooltip="&lt;tag&gt;입니다" ev:oncheckboxclick="scwin.target1_oncheckboxclick" ev:onlabelclick="scwin.target1_onlabelclick">
								<xf:choices>
									<xf:item>
										<xf:label><![CDATA[aaaaaaa]]></xf:label>
										<xf:value><![CDATA[1]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[bbbbbbb]]></xf:label>
										<xf:value><![CDATA[2]]></xf:value>
									</xf:item>
								</xf:choices>
							</xf:select>
							<w2:textbox id="" label="tooltipItemLabel 에 escape 적용 확인, 기대값:&lt;tag&gt;입니다"
								style="background-color:silver;">
							</w2:textbox>
							<xf:select selectedindex="-1" id="target2" appearance="full" style="width:148px;" cols="" rows=""
								ref="" tooltipItemLabel="&lt;tag&gt;입니다" tooltipDisplay="true" useItemLocale="true" ev:oncheckboxclick="scwin.target2_oncheckboxclick" ev:onlabelclick="scwin.target2_onlabelclick">
								<xf:choices>
									<xf:item>
										<xf:label><![CDATA[abcdefghijklmnopqrstuvwxyz]]></xf:label>
										<xf:value><![CDATA[1]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[bbbbbbb]]></xf:label>
										<xf:value><![CDATA[2]]></xf:value>
									</xf:item>
								</xf:choices>
							</xf:select>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
