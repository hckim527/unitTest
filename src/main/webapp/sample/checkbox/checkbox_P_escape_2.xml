		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > escape]<br/>렌더링 과정에서 내부 텍스트에 대한 이스케이프 처리 여부를 설정합니다.",
    "validation" : [
        "tooltip 속성값은 escape 속성에 관계없이 이스케이프 처리되지 않습니다.",
        "tooltipItemLabel 속성값은 escape 속성에 따라 이스케이프 처리됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);    
};



scwin.target1_onlabelclick = function (id, text) { 
    $c.gcm.getTooltipInfo(wf_body_bottom);
}



scwin.target1_oncheckboxclick = function (id, text) { 
    scwin.target1_onlabelclick();
}



scwin.target2_onlabelclick = function (id, text) { 
    $c.gcm.getTooltipInfo(wf_body_bottom);
}



scwin.target2_oncheckboxclick = function (id, text) { 
    scwin.target2_onlabelclick();
}
]]></script>
		<style type="text/css"><![CDATA[/* renderType=table */
.w2checkbox table {
    table-layout: fixed;
}

.w2checkbox table td.w2checkbox_td_label {
