<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_checkboxItem">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<value><![CDATA[1]]></value>
							<label><![CDATA[<tag> 입니다]]></label>
						</w2:row>
						<w2:row>
							<value><![CDATA[2]]></value>
							<label><![CDATA[<tag> 입니다]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > tooltipFormatter]<br/>툴팁 내용을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.",
    "validation" : [                
        "tooltipDisplay, tooltipShowAlways 속성의 툴팁이면 사용자 정의 함수의 파라미터에 마우스가 위치한 아이템의 라벨값과 인덱스값이 전달됩니다.",
        "사용자 정의 함수의 파라미터에 마우스가 위치한 아이템의 라벨값은 escape 속성에 의해 이스케이프 처리가 적용된 값이 전달됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);    
};



scwin.fn_tooltip = function (id, text) {
    return "id - " + id + ", tooltip - " + text;     
}



scwin.target1_onlabelclick = function (index, checked, value) {     
    $c.gcm.getTooltipInfo(wf_body_bottom);
}

scwin.target1_oncheckboxclick = function (index, checked, value) { 
    scwin.target1_onlabelclick();
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
					<xf:group id="grp_sample" style="">
						<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 테스트 샘플" style=""></w2:textbox>
						<xf:group class="tc_group_basic" id="grp_comp" style="">
							<w2:textbox style="height: 23px;" id=""
								label="label:&lt;tag&gt;입니다, escape:true, 기대값: id - &amp;lt;tag&amp;gt; 입니다, tooltip - 0 또는 1">
							</w2:textbox>
							<xf:select selectedindex="-1" id="target1" appearance="full" style="width:148px;"
								tooltipFormatter="scwin.fn_tooltip" tooltipShowAlways="true" cols="" rows="" ref="" ev:oncheckboxclick="scwin.target1_oncheckboxclick" ev:onlabelclick="scwin.target1_onlabelclick">
								<xf:choices>
									<xf:itemset nodeset="data:dlt_checkboxItem">
										<xf:label ref="label"></xf:label>
										<xf:value ref="value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText_onclick" id="btn_getText" label="text 확인" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>