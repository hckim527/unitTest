<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			<w2:dataList baseNode="list" repeatNode="map" id="dlt_checkboxItem">
				<w2:columnInfo>
					<w2:column id="label" name="name1" dataType="text"></w2:column>
					<w2:column id="value" name="name2" dataType="text"></w2:column>
				</w2:columnInfo>
				<w2:data use="true">
					<w2:row>
						<label><![CDATA[a]]></label>
						<value><![CDATA[1]]></value>
					</w2:row>
					<w2:row>
						<label><![CDATA[b]]></label>
						<value><![CDATA[2]]></value>
					</w2:row>
					<w2:row>
						<label><![CDATA[c]]></label>
						<value><![CDATA[3]]></value>
					</w2:row>
				</w2:data>
			</w2:dataList></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > displayMessage]<br/>입력값에 대한 유효성 체크를 통과하지 못한 경우 실패 메시지의 출력 여부를 설정합니다.",
    "validation" : [        
        "미설정 시 유효성 체크를 통과하지 못해도 실패 메시지를 출력하지 않습니다.",
        "true 설정 시 유효성 체크를 통과하지 못한 경우 실패 메시지를 출력합니다.",
        "false 설정 시 유효성 체크를 통과하지 못해도 실패 메시지를 출력하지 않습니다.",
        "유효성 체크를 통과하지 못한 경우 표시되는 시스템 기본 메시지는 원인이 되는 속성에 따라 달라집니다.",
        "실패 메시지는 alert() 메소드로 출력됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};


scwin.check_validate = function (target) {
    let rtn = target.validate();
    
    if (rtn) 
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : PASS");
    else
        wf_body_bottom.getObj("scwin").setReturnValue("validate check : FAIL");
}

scwin.check_validateObject = function (target) {
    let rtnObj  = target.validateObject();
    wf_body_bottom.getObj("scwin").setReturnValue("validateObject : "+ rtnObj);

    if (rtnObj) {
        let callerId = rtnObj.callerId
        let type = rtnObj.type
        let value = rtnObj.value

        wf_body_bottom.getObj("scwin").setReturnValue("callerId : "+ callerId);
        wf_body_bottom.getObj("scwin").setReturnValue("type : "+ type);
        wf_body_bottom.getObj("scwin").setReturnValue("value : "+ value);
    }
}


scwin.btn_validate1_onclick = function (e) {
    scwin.check_validate(target1);
}

scwin.btn_validate2_onclick = function (e) {
    scwin.check_validate(target2);
}

scwin.btn_validate3_onclick = function (e) {
    scwin.check_validate(target3);
}

scwin.btn_validateObject1_onclick = function (e) {
	scwin.check_validateObject(target1);
};

scwin.btn_validateObject2_onclick = function (e) {
	scwin.check_validateObject(target2);
};

scwin.btn_validateObject3_onclick = function (e) {
	scwin.check_validateObject(target3);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
                <xf:group style="" id="grp_sample">
                    <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                    <xf:group style="" id="grp_comp" class="tc_group_basic">
                    	<w2:textbox id="" label="displaymessage : 미설정, mandatory : true" style="background-color:silver;"></w2:textbox>
                    	<xf:select appearance="full" style="width:148px;" id="target1" selectedindex="-1" mandatory="true" cols="" rows=""
                    		ref="">
                    		<xf:choices>
                    			<xf:itemset nodeset="data:dlt_checkboxItem">
                    				<xf:label ref="label"></xf:label>
                    				<xf:value ref="value"></xf:value>
                    			</xf:itemset>
                    		</xf:choices>
                    	</xf:select>
                    	<w2:button style="" id="btn_validate1" label="validate" ev:onclick="scwin.btn_validate1_onclick"
                    		class="tc_btn_basic">
                    	</w2:button>
                    	<w2:button style="" id="btn_validateObject1" label="validateObject" class="tc_btn_basic"
                    		ev:onclick="scwin.btn_validateObject1_onclick">
                    	</w2:button>
                    	<w2:textbox style="background-color:silver;" id="" label="displaymessage : true 설정, mandatory : true"></w2:textbox>

                    	<xf:select appearance="full" cols="" id="target2" mandatory="true" ref="" rows="" selectedindex="-1"
                    		style="width:148px;" displaymessage="true">
                    		<xf:choices>
                    			<xf:itemset nodeset="data:dlt_checkboxItem">
                    				<xf:label ref="label"></xf:label>
                    				<xf:value ref="value"></xf:value>
                    			</xf:itemset>
                    		</xf:choices>
                    	</xf:select>
                    	<w2:button style="" id="btn_validate2" label="validate" ev:onclick="scwin.btn_validate2_onclick"
                    		class="tc_btn_basic">
                    	</w2:button>
                    	<w2:button class="tc_btn_basic" id="btn_validateObject2" label="validateObject" style=""
                    		ev:onclick="scwin.btn_validateObject2_onclick">
                    	</w2:button>

                    	<w2:textbox id="" label="displaymessage : false 설정, mandatory : true" style="background-color:silver;"></w2:textbox>



                    	<xf:select appearance="full" cols="" displaymessage="false" id="target3" mandatory="true" ref="" rows=""
                    		selectedindex="-1" style="width:148px;">
                    		<xf:choices>
                    			<xf:itemset nodeset="data:dlt_checkboxItem">
                    				<xf:label ref="label"></xf:label>
                    				<xf:value ref="value"></xf:value>
                    			</xf:itemset>
                    		</xf:choices>
                    	</xf:select>
                    	<w2:button style="" id="btn_validate3" label="validate" ev:onclick="scwin.btn_validate3_onclick"
                    		class="tc_btn_basic">
                    	</w2:button>
                    	<w2:button class="tc_btn_basic" id="btn_validateObject3" label="validateObject" style=""
                    		ev:onclick="scwin.btn_validateObject3_onclick">
                    	</w2:button>
                    </xf:group>
                </xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>