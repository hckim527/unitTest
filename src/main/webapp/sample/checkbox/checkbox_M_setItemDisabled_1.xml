		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkbox &gt; M &gt; setItemDisabled]&lt;br/&gt;컴포넌트에서 특정 아이템을 비활성화 상태를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;index(필수) 파라미터로 비활성화 상태를 설정하려는 아이템의 인덱스를 문자열로 설정합니다.&quot;,
        &quot;아이템의 인덱스는 0 부터 시작합니다.&quot;,
        &quot;disalbed(필수) 파라미터로 true 설정 시 해당 아이템을 비활성화 상태로 설정합니다.&quot;,
        &quot;disalbed(필수) 파라미터로 false 설정 시 해당 아이템을 활성화 상태로 설정합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }
    
    // target 생성    
    $c.gcm.createBasicCheckBox('');
}



scwin.btn_getDisabled_onclick = function (e) {
    let comp = &quot;target1&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');
    let inputs = targetElements[0].querySelectorAll('input.w2checkbox_input');

    // 각 input 요소의 disabled 속성 존재 여부 확인
    inputs.forEach((input, index) =&gt; {
        if (input.hasAttribute('disabled')) {            
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(comp + &quot; 의 index=&quot; + index + &quot; 은 비활성화&quot;);	
        } else {
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(comp + &quot; 의 index=&quot; + index + &quot; 은 활성화&quot;);	
        }
    });	
};



scwin.btn_setItemDisabled_onclick = function (e) {
    let index = par_index.getValue();
    let disabled = par_disabled.getText();

	target1.setItemDisabled(index, disabled);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
