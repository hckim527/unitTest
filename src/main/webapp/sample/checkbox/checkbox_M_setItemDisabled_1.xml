				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group class="tblbox" id="" meta_snippetCategory="05_입출력테이블" meta_snippetKeyComponent="true"
						meta_snippetName="5_02 2단테이블" style="">
						<xf:group adaptive="layout" adaptiveThreshold="600" class="w2tb tbl" id="" style="" tagname="table">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
								<xf:group style="width:150px;" tagname="col"></xf:group>
								<xf:group style="" tagname="col"></xf:group>
							</xf:group>
							<xf:group style="" tagname="tr">
								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="index" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:input id="par_index" style="" initValue="1"></xf:input>
								</xf:group>
								<xf:group class="w2tb_th " tagname="th">
									<w2:attributes></w2:attributes>
									<w2:textbox class="" id="" label="" ref="" style="" userData2=""></w2:textbox>
									<w2:textbox class="" id="" label="" ref="" style="" userData2=""></w2:textbox>
									<w2:textbox class="" id="" label="disabled" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" tagname="td">
									<w2:attributes></w2:attributes>
									<xf:select1 id="par_disabled" chooseOption="" style="" submenuSize="auto" allOption="" disabled=""
										direction="" appearance="minimal" disabledClass="" ref="">
										<xf:choices>
											<xf:itemset nodeset="data:gdl_boolean">
												<xf:label ref="label"></xf:label>
												<xf:value ref="value"></xf:value>
											</xf:itemset>
										</xf:choices>
									</xf:select1>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setItemDisabled_onclick" id="btn_setItemDisabled"
							label="setItemDisabled" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getDisabled_onclick" id="btn_getDisabled" label="disabled 확인"
							style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
