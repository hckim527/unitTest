		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > M > setValue]<br/>컴포넌트에서 선택하려는 아이템들의 Value 값을 구분자가 포함된 문자열로 설정합니다.",
    "validation" : [        
        "동일한 Value 값을 가진 아이템은 모두 선택됩니다.",        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



// comp 재생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        separator : ",",
    }
    
    let cList = $c.gcm.createCList(properties);

    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    // target 생성    
    strTarget += '<xf:select ' + strNameSpace + ' ' + cList + ' selectedindex="-1" appearance="full" style="background-color:var(--ws-gray-300);">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_Item">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "checkbox",
        strTarget,
        grp_comp
    );
};



scwin.btn_setValue_onclick = function (e) {
    let value = par_value.getText();

    target1.setValue(value);
}



scwin.btn_getValue_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getValue();
    wf_body_bottom.getObj("scwin").setReturnValue("getValue : " + rtn);    
};]]></script>
	</head>
