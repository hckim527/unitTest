		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > tooltipFormatter]<br/>툴팁 내용을 동적으로 생성하기 위한 사용자 정의 함수를 설정합니다.",
    "validation" : [                
        "tooltipDisplay, tooltipShowAlways 속성의 툴팁으로 실행된 사용자 정의 함수에서 false 반환 시 해당 아이템엔 툴팁이 표시되지 않습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        tooltipDisplay: con_tooltipDisplay.getText(),
        tooltipFormatter: con_tooltipFormatter.getText(),
        tooltipShowAlways: con_tooltipShowAlways.getText(),
    };
  
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onlabelclick", "oncheckboxclick"]);     

    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    let grp_comp = $c.gcm.getTestGroup();
   
    strTarget += '<xf:select ' + strNameSpace + ' ' + cList + ' ' + eList + ' selectedindex="-1" appearance="full" style="width:148px;height:100px;background-color:var(--ws-gray-300);">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_checkboxItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "checkbox",
        strTarget,
        grp_comp
    );     
}



scwin.fn_tooltip = function (id, text) {
    // return "id - " + id + ", tooltip - " + text; 
    return false;      
}



scwin.target1_onlabelclick = function (index, checked, value) {     
    $c.gcm.getTooltipInfo(wf_body_bottom);
}

scwin.target1_oncheckboxclick = function (index, checked, value) { 
    scwin.target1_onlabelclick();
}]]></script>
