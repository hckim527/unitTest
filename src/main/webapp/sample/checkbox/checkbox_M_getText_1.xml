		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > M > getText]<br/>컴포넌트에 선택된 아이템들의 라벨값을 구분자로 구분한 문자열로 반환합니다.",
    "validation" : [        
        "delimeter(필수) 파라미터로 선택된 아이템들의 라벨값을 구분하는 구분자를 텍스트로 설정합니다.",
        "delimeter(필수) 파라미터를 설정하지 않거나 ''(Empty String)으로 설정 시 separator 속성값이 적용됩니다.",
        "선택된 아이템들의 라벨값을 구분자가 포함된 문자열로 반환합니다.",
        "컴포넌트에 선택된 아이템이 한 개인 경우 구분자 없이 해당 아이템의 라벨값만 반환합니다.",
        "컴포넌트에 선택된 아이템이 없는 경우 ''(Empty String)을 반환합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    scwin.comp_init();
};



// comp 재생성
scwin.comp_init = function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        separator : "-seprator-",
    }
    
    let cList = $c.gcm.createCList(properties);

    // target 생성    
    $c.gcm.createBasicCheckBox(cList);
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    let delimeter = par_delimeter.getText();
    
    rtn = target1.getText(delimeter);
    wf_body_bottom.getObj("scwin").setReturnValue("getText : " + rtn);    
};
]]></script>
