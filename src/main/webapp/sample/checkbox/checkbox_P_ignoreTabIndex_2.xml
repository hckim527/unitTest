		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > ignoreTabIndex]<br/>Tab 키를 사용하여 컴포넌트 간 포커스를 이동할때 CheckBox 컴포넌트를 제외할지 설정합니다.",
    "validation" : [                
        "nextTabID 속성에 의해 포커스가 이동될때는 ignoreTabIndex 속성값에 관계없이 포커스가 이동합니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.btn_setStartFocus_onclick = function (e) {
	startcomp.focus();
};


scwin.startcomp_onfocus = function (e) {
	wf_body_bottom.getObj("scwin").setReturnValue("start_onfocus");
};

scwin.target1_onchange = function (info) {
	wf_body_bottom.getObj("scwin").setReturnValue("target1_onchange");
};]]></script>
		<style type="text/css"><![CDATA[/* renderType=table */
.w2radio table {
    table-layout: fixed;
}

.w2radio table td.w2radio_td_label {
    width: 50px;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
}]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<xf:input ev:onfocus="scwin.startcomp_onfocus" nextTabID="target1" style="width: 144px;height: 21px;" tabIndex="1"
							id="startcomp" initValue="start">
						</xf:input>
						<w2:textbox style="background-color:silver;" id=""
							label="ignoreTabIndex=true, nextTabID 로 지정됨, tab 키로 CheckBox 의 item 에 포커스 간 후 스페이스 버튼 클릭, 기대값: onchange 이벤트 발생">
						</w2:textbox>
						<xf:select selectedindex="-1" id="target1" appearance="full" style="width:148px;" nextTabID="startcomp"
							tabIndex="2" ignoreTabIndex="true" cols="" rows="" ref="" ev:onchange="scwin.target1_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_checkboxItem">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button ev:onclick="scwin.btn_setStartFocus_onclick" style="" id="btn_setInitFocus" label="초기포커스이동"
							class="tc_btn_basic">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
