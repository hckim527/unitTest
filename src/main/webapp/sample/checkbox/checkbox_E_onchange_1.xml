		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[checkbox &gt; E &gt; onchange]&lt;br/&gt;컴포넌트에서 아이템의 선택이 변경되면 발생합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;컴포넌트에서 아이템의 선택이 변경되면 발생합니다.&quot;,
        &quot;info 파라미터로 선택이 변경된 아이템의 정보가 객체로 전달됩니다.&quot;,
        &quot;info.oldValue 속성값으로 기존에 선택되어 있던 아이템의 인덱스값을 갖습니다.&quot;,
        &quot;info.oldValue 속성값으로 기존에 선택된 아이템이 없는 경우 ''(Empty String)값을 갖습니다.&quot;,
        &quot;info.newValue 속성값으로 새로 선택된 아이템의 인덱스값을 갖습니다.&quot;,
        &quot;info.newValue 속성값으로 아이템 선택이 해제된 경우 ''(Empty String)값을 갖습니다.&quot;,
        &quot;기존과 동일한 아이템을 선택한 경우 onchange 이벤트는 발생하지 않습니다.&quot;,
        &quot;click() 메소드에 의해 아이템의 선택이 변경된 경우도 onchange 이벤트가 발생합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList([&quot;onchange&quot;]);

    // comp 생성
    $c.gcm.createBasicCheckBox('', eList);
}



scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info : &quot; + info);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info.oldValue : &quot; + info.oldValue);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info.newValue : &quot; + info.newValue);
}



scwin.btn_click_onclick = function (e) {
    target1.click(par_index.getText());
};



scwin.btn_reset_onclick = function (e) {
	target1.reset();
};
</script>
