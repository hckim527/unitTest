		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > M > checkAll]<br/>컴포넌트에 정의된 전체 아이템의 선택 상태를 변경합니다.",
    "validation" : [                
        "enableColumn 속성으로 비활성화 상태인 아이템의 선택 상태도 변경됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_checkAll_onclick = function (e) {
    let checked = par_checked.getText();

    if (checked == "true")
	    target1.checkAll(true);
    else if (checked == "false")
        target1.checkAll(false);
    else
        target1.checkAll();
};



scwin.btn_getSelectedIndex_onclick = function (e) {
    let rtn = '';

    rtn = target1.getSelectedIndex();

    wf_body_bottom.getObj("scwin").setReturnValue("getSelectedIndex : " + rtn);	
};
]]></script>
