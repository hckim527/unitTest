		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[checkbox > P > ignoreTabIndex]<br/>Tab 키를 사용하여 컴포넌트 간 포커스를 이동할때 CheckBox 컴포넌트를 제외할지 설정합니다.",
    "validation" : [                
        "미설정 시 Tab 키로 포커스 이동 시 CheckBox 컴포넌트를 대상에 포함합니다.",
        "true 설정 시 Tab 키로 포커스 이동 시 CheckBox 컴포넌트를 대상에서 제외됩니다.",
        "false 설정 시 Tab 키로 포커스 이동 시 CheckBox 컴포넌트를 대상에 포함합니다.",
        "renderType=native 인 경우 해당 속성은 무시됩니다.",
        "tabIndex 속성을 함께 설정한 경우 컴포넌트의 최상위 태그에는 tabIndex 속성값을 갖는 tabindex 속성이 설정되고, 각 아이템 항목의 input 태그에는 -1 값을 갖는 tabindex 속성이 설정됩니다."
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.btn_setStartFocus_onclick = function (e) {
	startcomp.focus();
};


scwin.startcomp_onfocus = function (e) {
	wf_body_bottom.getObj("scwin").setReturnValue("start_onfocus");
};

scwin.target1_onchange = function (info) {
	wf_body_bottom.getObj("scwin").setReturnValue("target1_onchange");
};


scwin.target2_onchange = function (info) {
	wf_body_bottom.getObj("scwin").setReturnValue("target2_onchange");
};

scwin.target3_onchange = function (info) {
	wf_body_bottom.getObj("scwin").setReturnValue("target3_onchange");
};

scwin.target4_onchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("target4_onchange");
};

scwin.target5_onchange = function (info) {
	wf_body_bottom.getObj("scwin").setReturnValue("target5_onchange");	
};
]]></script>
