	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<xf:input ev:onfocus="scwin.startcomp_onfocus" nextTabID="" style="width: 144px;height: 21px;" tabIndex="1"
							id="startcomp" initValue="start">
						</xf:input>
						<w2:textbox style="background-color:silver;" id=""
							label="ignoreTabIndex=미설정, tab 키로 CheckBox 의 item 에 포커스 간 후 스페이스 버튼 클릭, 기대값: onchange 이벤트 발생">
						</w2:textbox>
						<xf:select appearance="full" style="width:148px;" id="target1" selectedindex="-1" cols="" rows="" ref=""
							tabIndex="2" ev:onchange="scwin.target1_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_checkboxItem">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
						<w2:textbox id=""
							label="ignoreTabIndex=true, tab 키로 CheckBox 에 포커스 간 후 tab 키 한번더 입력, 기대값: 포커스가 아래로 이동"
							style="background-color:silver;">
						</w2:textbox>
						<xf:select appearance="full" style="width:148px;" id="target2" selectedindex="-1" ignoreTabIndex="true" tabIndex="3"
							cols="" rows="" ref="" ev:onchange="scwin.target2_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_checkboxItem">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
						<w2:textbox id=""
							label="ignoreTabIndex=false, tab 키로 CheckBox 의 item 에 포커스 간 후 스페이스 버튼 클릭, 기대값: onchange 이벤트 발생"
							style="background-color:silver;">
						</w2:textbox>
						<xf:select appearance="full" style="width:148px;" id="target3" selectedindex="-1" ignoreTabIndex="false"
							tabIndex="4" cols="" rows="" ref="" ev:onchange="scwin.target3_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_checkboxItem">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
						<w2:textbox id=""
							label="renderType=native, ignoreTabIndex=true, tab 키로 CheckBox 의 item 에 포커스 간 후 스페이스 버튼 클릭, 기대값: onchange 이벤트 발생"
							style="background-color:silver;">
						</w2:textbox>
						<xf:select appearance="full" style="" id="target4" selectedindex="-1" ignoreTabIndex="true" renderType="native" tabIndex="5" ev:onchange="scwin.target4_onchange"></xf:select>
						<w2:textbox id="" label="a" style="width:50px; height:23px; display:inline-block;" tabIndex="6"></w2:textbox>
						<w2:textbox id=""
							label="renderType=checkboxgroup, ignoreTabIndex=true, tab 키로 CheckBox 에 포커스 간 후 tab 키 한번더 입력, 기대값: 포커스가 아래로 이동"
							style="background-color:silver;">
						</w2:textbox>
						<xf:select selectedindex="-1" id="target5" appearance="full" style="width: 148px;height: 21px;"
							ignoreTabIndex="true" renderType="checkboxgroup" tabIndex="6" cols="" rows="" ref="" ev:onchange="scwin.target5_onchange">
							<xf:choices>
								<xf:itemset nodeset="data:dlt_checkboxItem">
									<xf:label ref="label"></xf:label>
									<xf:value ref="value"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:select>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button ev:onclick="scwin.btn_setStartFocus_onclick" style="" id="btn_setInitFocus" label="초기포커스이동"
							class="tc_btn_basic" tabIndex="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
