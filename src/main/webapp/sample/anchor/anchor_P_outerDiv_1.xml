						<w2:button class="tc_btn_basic" id="btn_getTagName" label="tagName 확인" style="" ev:onclick="scwin.btn_getTagName_onclick"></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
