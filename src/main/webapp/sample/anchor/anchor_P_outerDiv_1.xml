		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[anchor &gt; P &gt; outerDiv]&lt;br/&gt;컴포넌트가 a 태그로 렌더링될때 div 태그로 감쌀지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;true 설정 시 a 태그를 div 태그가 감싼 형태로 컴포넌트가 렌더링 되어야 합니다.&quot;,
        &quot;false 설정 시 a 태그로 컴포넌트가 렌더링 되어야 합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // let wf_body_left = wf_sample.getObj(&quot;wf_body_left&quot;);
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	

    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        clickEventElement: con_clickEventElement.getText(),
        outerDiv: con_outerDiv.getText(),
    }
   
    let cList = $c.gcm.createCList(properties);

    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    // comp 생성 함수 호출
    $c.gcm.createBasicAnchor(cList, eList);   
}



scwin.btn_getTagName_onclick = function (e) {
    let rtn = '';

    rtn = target1.render.tagName;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;tagName : &quot; + rtn);
};



scwin.target1_onclick = function () {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onclick=====&quot;);    
}
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
