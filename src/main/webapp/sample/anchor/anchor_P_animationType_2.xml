<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[common &gt; P &gt; animationType]&lt;br/&gt;컴포넌트를 클릭(터치) 시 재생될 애니메이션 효과를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;animationType 속성 설정 시 useChild 속성값은 false 로 강제 적용되어야 합니다.&quot;,
        &quot;outerDiv 속성값에 관계없이 Anchor 컴포넌트 영역에 애니메이션 효과가 적용됩니다.&quot;,
    ]
} 



scwin.onpageload = function() {
    // let wf_body_left = wf_sample.getObj(&quot;wf_body_left&quot;);
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
};



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.render.textContent
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;animationType 설정 : &quot; + rtn);

    rtn = target2.render.textContent
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;animationType 미설정 : &quot; + rtn);
};



scwin.btn_getAnimation_onclick = function (e) {
    let rtn = '';
    
    rtn = target3.options.animationColor
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;animationColor : &quot; + rtn);

    rtn = target3.options.animationType
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;animationType : &quot; + rtn);      
};
</script>
	</head>
    <body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
                    <xf:group style="" id="grp_sample">
                        <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                        <xf:group style="" id="grp_comp" class="tc_group_basic">
                        	<w2:textbox style="height: 23px;" id="" label='animationType="bubble", useChild=true'></w2:textbox>
                        	<w2:anchor id="target1"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		animationType="bubble" useChild="true">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        		<span>child</span>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='animationType="미설정", useChild=true'></w2:textbox>
                        	<w2:anchor id="target2"
                        		style="display: block;width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		useChild="true">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        		<span>child</span>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='animationType="bubble", outterDiv=false'></w2:textbox>
                        	<w2:anchor id="target3"
                        		style="display: block;width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		outerDiv="false" animationColor="yellow" animationType="bubble" class="btn_bubble">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        		<span>child</span>
                        	</w2:anchor>
                        </xf:group>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" id="btn_getText" label="useChild 적용여부 확인" style=""
							ev:onclick="scwin.btn_getText_onclick">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getAnimation_onclick" id="btn_getAnimation" label="getAnimation"
							style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>