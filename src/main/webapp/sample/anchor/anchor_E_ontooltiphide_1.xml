		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[anchor > E > ontooltiphide]<br/>컴포넌트에서 tooltip 속성에 의해 표시된 툴팁이 사라질 때 발생합니다.",
    "validation" : [        
        "tooltip 속성이 설정된 상태에서 툴팁이 사라질 때 이벤트가 발생하여야 합니다.",
        "tooltip 속성이 설정되지 않은 상태에서는 이벤트가 발생하지 않아야 합니다.",
        "outerDiv=true 일 때 a 태그 영역으로 마우스가 이동하면 이벤트가 발생합니다.",        
    ]
} 



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    // let wf_body_left = wf_sample.getObj("wf_body_left");
    wf_body_left.getObj("scwin").createValidation(scwin.tData);	
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        tooltip: con_tooltip.getValue(),
        outerDiv: true,    
    };

    let cList = $c.gcm.createCList(properties);

    // comp 생성
    $c.gcm.createBasicAnchor(cList, 'ev:ontooltiphide="scwin.target1_ontooltiphide"');
}



scwin.target1_ontooltiphide = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_ontooltiphide 이벤트 발생=====");
}]]></script>
