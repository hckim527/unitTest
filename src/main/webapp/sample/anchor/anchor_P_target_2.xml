<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[anchor > P > target]<br/>컴포넌트의 링크 기능으로 페이지가 이동되는 방법을 설정합니다.",
    "validation" : [
        "페이지가 이동되는 방법을 설정합니다.(속성 set, get 확인)",
    ]
}



scwin.onpageload = function() {
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.btn_getTarget_onclick = function (e) {
    let rtn = '';
    let aTag = null;

    aTag = target1.render.querySelector('a');
    rtn = aTag ? aTag.getAttribute('target') : null;
    wf_body_bottom.getObj("scwin").setReturnValue("target1(_self) : " + rtn);

    aTag = target2.render.querySelector('a');
    rtn = aTag ? aTag.getAttribute('target') : null;
    wf_body_bottom.getObj("scwin").setReturnValue("target2(_blank) : " + rtn);

    aTag = target3.render.querySelector('a');
    rtn = aTag ? aTag.getAttribute('target') : null;
    wf_body_bottom.getObj("scwin").setReturnValue("target3(_parent) : " + rtn);

    aTag = target4.render.querySelector('a');
    rtn = aTag ? aTag.getAttribute('target') : null;
    wf_body_bottom.getObj("scwin").setReturnValue("target4(_top) : " + rtn);

    aTag = target5.render.querySelector('a');
    rtn = aTag ? aTag.getAttribute('target') : null;
    wf_body_bottom.getObj("scwin").setReturnValue("target5(미설정) : " + rtn);
};
]]></script>
	</head>
    <body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
                    <xf:group style="" id="grp_sample">
                        <w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
                        <xf:group style="" id="grp_comp" class="tc_group_basic">
                        	<w2:textbox style="height: 23px;" id="" label='target="_self"'></w2:textbox>
                        	<w2:anchor id="target1"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		target="_self">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='target="_blank"'></w2:textbox>
                        	<w2:anchor id="target2"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		target="_blank">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='target="_parent"'></w2:textbox>
                        	<w2:anchor id="target3"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		target="_parent">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='target="_top"'></w2:textbox>
                        	<w2:anchor id="target4"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;"
                        		target="_top">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        	</w2:anchor>
                        	<w2:textbox style="height: 23px;" id="" label='target="미설정"'></w2:textbox>
                        	<w2:anchor id="target5"
                        		style="width: 200px;height: 50px;background-color:var(--ws-gray-300);border: 1px solid silver;">
                        		<xf:label><![CDATA[Insert Text]]></xf:label>
                        	</w2:anchor>
                        </xf:group>
                    </xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" id="btn_getTarget" label="target 확인" style=""
							ev:onclick="scwin.btn_getTarget_onclick">
						</w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>