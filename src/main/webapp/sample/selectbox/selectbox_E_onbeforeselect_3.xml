        "리턴값을 false 로 반환한 경우 선택 아이템이 변경되지 않고 기존 선택을 유지합니다.",
        "리턴값을 true 로 반환한 경우 사용자가 선택한 아이템으로 변경합니다.",
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let eList = $c.gcm.createEList(["onbeforeselect", "onchange"]);

    // comp 생성 함수 호출    
    $c.gcm.createBasicSelectBox('', eList); 
}



scwin.target1_onbeforeselect = function (selectedIndex, index) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onbeforeselect=====");	

    if (par_return.getText() == "true")
        return true;
    else if (par_return.getText() == "false")
        return false;
}



scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");	    
}]]></script>
