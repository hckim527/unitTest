		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > E > onbeforeselect]<br/>컴포넌트에서 사용자의 액션으로 아이템이 선택되면 발생합니다.",
    "validation" : [        
        "선택 아이템의 변경을 허용할지 여부를 true/false 로 반환합니다.",
