		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > M > setVisibleRowNum]<br/>컴포넌트의 visibleRowNum 속성을 설정합니다.",
    "validation" : [            
        "renderType=component 인 경우에 동작합니다.",
        "rowCount(필수) 파라미터로 아이템 리스트창에 한번에 표시될 아이템의 갯수를 숫자로 설정합니다.",
        "값을 설정하지 않거나 0 을 설정한 경우 아이템 리스트창이 정상적으로 표시되지 않으므로 적절한 값으로 설정하여야 합니다.",
        "allOption, chooseOption 속성에 의해 추가된 아이템도 갯수에 포함됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        allOption : con_allOption.getText(),
        chooseOption : con_chooseOption.getText(),        
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"]);

    // comp 생성
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' ' + eList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_selectboxItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "selectbox",
        strTarget,
        grp_comp
    );
}



scwin.btn_getItemListSize_onclick = function (e) {
    let rtn = '';    
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist height : " + rtn);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getItemListSize_onclick();
}



scwin.btn_setVisibleRowNum_onclick = function (e) {
    let rowCount = par_rowCount.getText();

	target1.setVisibleRowNum(rowCount);
};
]]></script>
