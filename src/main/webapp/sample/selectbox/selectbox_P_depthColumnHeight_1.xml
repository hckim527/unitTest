		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > depthColumnHeight]<br/>depthColumn 속성이 설정되었을때 아이템 리스트창의 높이(Height)를 설정합니다.",
    "validation" : [            
        "renderType=component 이고, 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "픽셀 단위 숫자로 아이템 리스트창의 높이를 설정합니다.",
        "값을 설정하지 않으면 스크롤 없이 모든 아이템이 표시될 수 있도록 높이가 자동 계산됩니다.",
        "설정된 높이로 아이템이 모두 표시되지 않으면 스크롤이 생성됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemListSize_onclick = function (target) {
    let rtn = '';    
    let comp = target + "_itemTable";
    console.log(comp);
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist height : " + rtn);

    rtn = targetElements[0].scrollWidth
    wf_body_bottom.getObj("scwin").setReturnValue("scrollWidth : " + rtn);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getItemListSize_onclick("target1");
}



scwin.target2_onclick = function (e) {
    scwin.btn_getItemListSize_onclick("target2");
}



scwin.target3_onclick = function (e) {
    scwin.btn_getItemListSize_onclick("target3");
}]]></script>
