		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > depthColumn]<br/>아이템 리스트창에 아이템을 계층 구조로 표시하기 위한 계층(Depth)값을 갖는 컬럼의 ID 를 설정합니다.",
    "validation" : [            
        "depthColumn 속성 설정 시 visibleRowNum 속성은 무시됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemListSize_onclick = function (e) {
    let rtn = '';    
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist height : " + rtn);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getItemListSize_onclick();
}]]></script>
