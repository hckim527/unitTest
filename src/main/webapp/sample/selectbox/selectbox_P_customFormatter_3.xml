<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; customFormatter]&lt;br/&gt;컴포넌트에 정의된 각 아이템의 값을 동적으로 수정하기 위한 사용자 정의 함수를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;아이템이 ItemSet 으로 정의되어 있으면 컴포넌트 렌더링 시 사용자 정의 함수가 한번 실행됩니다.&quot;,
    ]
}


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);    

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.fn_customformatter = function(items) {
    for (var i = 0; i &lt; items.length; i++) {
        items[i].label = items[i].orgLabel + &quot; Custom&quot; + items[i].value;
    }
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;사용자 정의 함수 실행됨&quot;);

    return items;
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);    
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="background-color:silver;" id="" label="화면 로딩 시 사용자 정의 함수 호출되면 정상"></w2:textbox>
						<xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
							style="width:200px; height:30px;" disabled="" id="target1" allOption="" direction="" enableColumn=""
							ev:onchange="scwin.target1_onchange" visibleColumn="visible_col" customFormatter="scwin.fn_customformatter">
							<xf:choices>
								<xf:item>
									<xf:label><![CDATA[ItemSet_1]]></xf:label>
									<xf:value><![CDATA[1]]></xf:value>
								</xf:item>
								<xf:item>
									<xf:label><![CDATA[ItemSet_2]]></xf:label>
									<xf:value><![CDATA[2]]></xf:value>
								</xf:item>
								<xf:item>
									<xf:label><![CDATA[ItemSet_3]]></xf:label>
									<xf:value><![CDATA[3]]></xf:value>
								</xf:item>
							</xf:choices>
						</xf:select1>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
                        <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText_onclick" id="btn_getText" label="text 확인" style=""></w2:button>
                    </xf:group>
				</xf:group>
				<w2:wframe src="/frame/page/body_bottom.xml" style="" id="wf_body_bottom"></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>