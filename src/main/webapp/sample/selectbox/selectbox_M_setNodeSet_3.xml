    &quot;validation&quot; : [        
        &quot;useItemLocale 속성으로 다국어가 적용된 상태이면 아이템이 새롭게 렌더링되며 다국어가 동일하게 적용됩니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }
    
    // target 생성    
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
  
    strTarget += '&lt;xf:select1 ' + strNameSpace + ' useLocale=&quot;true&quot; useItemLocale=&quot;true&quot; style=&quot;width:200px; height:30px;&quot;&gt;';
    strTarget += '&lt;xf:choices&gt;';
    strTarget += '&lt;xf:itemset nodeset=&quot;data:gdl_selectbox&quot;&gt;';
    strTarget += '&lt;xf:label ref=&quot;label&quot;&gt;&lt;/xf:label&gt;';
    strTarget += '&lt;xf:value ref=&quot;value&quot;&gt;&lt;/xf:value&gt;';
    strTarget += '&lt;/xf:itemset&gt;';
    strTarget += '&lt;/xf:choices&gt;';
    strTarget += '&lt;/xf:select1&gt;';


    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;selectbox&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_setNodeSet_onclick = function (e) {
    let nodeset = par_nodeset.getText();
    let label = par_label.getText();
    let value = par_value.getText();

	target1.setNodeSet(nodeset, label, value);
};



scwin.btn_getItem_onclick = function (e) {
    let rtn = '';
    rtn = target1.getText();
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;selectbox 의 label : &quot; + rtn); 

    let comp = &quot;target1_itemTable_main&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    let tds = targetElements[0].querySelectorAll('td.w2table_sb_col');
    
    // 각 td 요소의 visible 확인
    tds.forEach((td, index) =&gt; {   
        let itemLabel = td.textContent;
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item index=&quot; + index + &quot; 의 label : &quot; + itemLabel);	
    });	 
};</script>
