		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > E > onchange]<br/>컴포넌트에서 아이템의 선택이 변경되면 발생합니다.",
    "validation" : [        
        "valueNotInList=default, emptyItem=true 일때 정상 아이템이 선택된 상태에서 없는 아이템을 입력하면 onchange 이벤트가 발생합니다.",
        "없는 아이템이 입력된 상태에서 다시 없는 아이템을 입력하는 경우는 onchange 이벤트가 발생하지 않습니다.",
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정    
    let properties = {
        valueNotInList: "default",
        emptyItem: true,
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onchange"])

    // comp 생성 함수 호출    
    $c.gcm.createBasicSelectBox(cList, eList); 
}



scwin.btn_setSelectedIndex_onclick = function (e) {
	target1.setSelectedIndex(par_index.getText());
};



scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onchange=====");
}]]></script>
