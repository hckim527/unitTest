		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; animation]&lt;br/&gt;컴포넌트의 아이템 리스트가 표시될때 적용될 애니메이션 효과를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;renderType=component 이고, 아이템 정의가 GridViewItemSet 이 아닌 경우 동작합니다.&quot;,
        &quot;미설정 시 애니메이션 효과를 설정하지 않습니다.&quot;,
        &quot;show 설정 시 좌상단에서 우하단으로 아이템 리스트가 대각선으로 펼쳐지는 애니메이션 효과를 설정합니다.&quot;,
        &quot;fadeIn 설정 시 아이템 리스트의 투명도가 점점 선명해지는 애니메이션 효과를 설정합니다.&quot;,
        &quot;slideDown 설정 시 하단으로 아이템 리스트가 펼쳐지는 애니메이션 효과를 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        animation : con_animation.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_getAnimation_onclick = function (e) {
    let rtn = '';    
    let comp = &quot;target1_itemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    rtn = targetElements[0].className
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;className : &quot; + rtn);
};</script>
