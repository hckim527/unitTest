		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; emptyItem]&lt;br/&gt;메소드로 아이템 리스트에 없는 아이템을 선택했을때 처리하는 방식을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;미설정 시 아이템 리스트의 첫번째 아이템이 선택 처리됩니다.&quot;,
        &quot;true 설정 시 아이템이 선택되지 않은 상태로 처리됩니다.&quot;,
        &quot;true 설정 시 SelectBox 컴포넌트의 아이템 표시 영역은 빈값이 표시되고 Value 값은 emptyValue 속성값을 갖습니다.&quot;,
        &quot;false 설정 시 아이템 리스트의 첫번째 아이템이 선택 처리됩니다.&quot;,
        &quot;false 설정 시 allOption, chooseOption 으로 추가된 아이템이 있는 경우 해당 아이템이 선택됩니다.&quot;,
        &quot;setValue(), setSelectedIndex() 메소드를 사용하여 아이템을 동적으로 선택할 수 있습니다.&quot;,
        // &quot;setText() 메소드로 없는 아이템을 선택하면 emptyItem 속성이 false 로 동작합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        allOption : con_allOption.getText(),
        chooseOption : con_chooseOption.getText(),
        emptyItem : con_emptyItem.getText(),
    }

    let cList = $c.gcm.createCList(properties)
    
    // target 생성    
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(100);
    scwin.btn_getInfo_onclick();
};



scwin.btn_setSelectedIndex_onclick = function (e) {
	target1.setSelectedIndex(100);
    scwin.btn_getInfo_onclick();
};



scwin.btn_setText_onclick = function (e) {
	target1.setText(&quot;invalid&quot;);
    scwin.btn_getInfo_onclick();	
};



scwin.btn_getInfo_onclick = function (e) {
    let rtn = '';

    rtn = target1.getText();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + rtn);

    rtn = target1.getValue();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn);    
};
</script>
