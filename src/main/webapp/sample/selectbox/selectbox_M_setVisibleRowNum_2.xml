}



scwin.btn_getItemListSize_onclick = function (e) {
    let rtn = '';    
    let comp = &quot;target1_gridViewItemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    rtn = targetElements[0].style.height
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Itemlist height : &quot; + rtn);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getItemListSize_onclick();
}



scwin.btn_setVisibleRowNum_onclick = function (e) {
    let rowCount = par_rowCount.getText();

	target1.setVisibleRowNum(rowCount);
};</script>
