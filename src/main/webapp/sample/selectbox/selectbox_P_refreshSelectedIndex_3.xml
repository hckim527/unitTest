		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; refreshSelectedIndex]&lt;br/&gt;아이템이 정의된 DataCollection 의 값이 변경되었을때, SelectBox 컴포넌트의 선택 상태을 유지시킬지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;아이템이 GridViewItemSet 으로 정의된 경우에 동작합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};


scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }    

    let properties = {
        refreshSelectedIndex : con_refreshSelectedIndex.getText(),
    }

    let cList = $c.gcm.createCList(properties)

    // target 생성
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '&lt;xf:select1 ' + strNameSpace + ' ' + cList + ' id=&quot;target1&quot; style=&quot;width:200px; height:30px;&quot;&gt;';
    strTarget += '&lt;xf:choices&gt;';
    strTarget += '&lt;w2:gridViewItemset nodeset=&quot;data:dlt_gridviewItem&quot; width=&quot;300&quot; label=&quot;label&quot; value=&quot;value&quot;&gt;';
    strTarget += '&lt;w2:item ref=&quot;label&quot; hidden=&quot;&quot; header=&quot;column1&quot; style=&quot;&quot; headerStyle=&quot;&quot;&gt;&lt;/w2:item&gt;';
    strTarget += '&lt;w2:item ref=&quot;value&quot; hidden=&quot;&quot; header=&quot;column2&quot; style=&quot;&quot; headerStyle=&quot;&quot;&gt;&lt;/w2:item&gt;';
    strTarget += '&lt;/w2:gridViewItemset&gt;';
    strTarget += '&lt;/xf:choices&gt;';
    strTarget += '&lt;/xf:select1&gt;';

    scwin.target1 = await $p.dynamicCreate(
        &quot;target1&quot;,
        &quot;selectbox&quot;,
        strTarget,
        grp_comp
    );
}



scwin.btn_setCellData_onclick = function (e) {
    let rowIndex = par_rowIndex.getText();
    let columnInfo = par_columnInfo.getValue();
    let data = par_data.getValue();

    dlt_gridviewItem.setCellData(rowIndex, columnInfo, data);

    scwin.btn_getItemList_onclick();
};



scwin.btn_getItemList_onclick = function (e) {
    let rtn = '';    

    rtn = target1.getText();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + rtn);

    let comp = &quot;target1_gridViewItemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    rtn = targetElements[0].textContent
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Itemlist label : &quot; + rtn);
};</script>
