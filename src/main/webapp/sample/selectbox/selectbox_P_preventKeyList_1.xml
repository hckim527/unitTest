		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; preventKeyList]&lt;br/&gt;컴포넌트에서 입력을 막으려는 키의 KeyCode 값을 집합으로 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;renderType=component 인 경우에 동작합니다.&quot;,
        &quot;입력을 막으려는 키의 KeyCode 값들을 &quot;,&quot; 로 구분하여 문자열로 설정합니다.&quot;,
        &quot;입력되는 모든 키를 막으려면 'all' 을 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 키 입력을 막지 않습니다.&quot;,
        &quot;Enter 키 입력을 막으면 아이템 리스트 표시 및 아이템 선택 액션이 발생하지 않습니다.&quot;,
        &quot;화살표 키 입력을 막으면 아이템 이동 및 선택 액션이 발생하지 않습니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        preventKeyList : con_preventKeyList.getText(),
    }

    let cList = $c.gcm.createCList(properties)
    let eList = $c.gcm.createEList([&quot;onviewchange&quot;, &quot;onselected&quot;]);
    
    // target 생성
    $c.gcm.createLabel('label=&quot;Enter(13), Up(38), Down(40) 키 입력을 막음 &quot;', '', 'label1');
    $c.gcm.createBasicSelectBox(cList, eList);

    target1.focus();
}



scwin.target1_onviewchange = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onviewchange=====&quot;);
    // wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + target1.getText());
}



scwin.target1_onselected = function (e) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onselected=====&quot;);
}</script>
