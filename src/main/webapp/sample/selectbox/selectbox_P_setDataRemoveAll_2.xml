scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; setDataRemoveAll]&lt;br/&gt;ref 속성으로 바인딩된 DataCollection 에 removeAll() 메소드로 변경된 값을 반영시킬지 여부를 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;false 설정 시 removeAll() 메소드로 아이템이 모두 삭제되어도 ref 속성으로 바인딩된 DataCollection 에 반영하지 않습니다.&quot;,
        &quot;false 설정 시 DataCollection 에 변경값이 반영되지 않아 DataCollection 은 마지막에 선택되었던 값을 유지합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);    

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getDataList_onclick = function (e) {
	let rsData  = dlt_ref.getAllJSON();    

    for(var i = 0; i &lt; rsData.length; i++) {        
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;value 값 : &quot; + rsData[i].value);
    }

    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getRowPosition : &quot; + dlt_ref.getRowPosition());

};



scwin.btn_removeAll_onclick = function (e) {
    let exceptLabel = par_exceptLabel.getText();

    if (exceptLabel == &quot;true&quot;)
        target1.removeAll(true);
    else if (&quot;false&quot;)
        target1.removeAll(false);
    else
        target1.removeAll();
};</script>
