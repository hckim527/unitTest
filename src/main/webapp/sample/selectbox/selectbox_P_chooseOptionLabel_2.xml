		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; chooseOptionLabel]&lt;br/&gt;chooseOption=true 일때 추가되는 '선택 안내' 아이템의 Label 값을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;useLocale=true 이고 chooseOptionLabelLocaleRef 속성 설정 시 해당 속성은 무시됩니다.&quot;
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        useLocale: true,
        chooseOptionLabelLocaleRef : &quot;websquare_name&quot;,
        chooseOption : true,
        chooseOptionLabel : con_chooseOptionLabel.getValue(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createLabel('label=&quot;useLocale=true, chooseOptionLabelLocaleRef=websquare_name 설정된 상태임&quot;', '', 'label1');
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn); 
};</script>
