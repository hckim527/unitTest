		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; disabledClass]&lt;br/&gt;컴포넌트가 비활성화(disabled) 상태일때 적용할 CSS 클래스를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;disabled=true 인 경우에 동작합니다.&quot;,
        &quot;CSS 파일이나 style 블럭에 정의된 클래스 이름을 공백으로 구분하여 문자열로 설정합니다.&quot;,
        &quot;값을 설정하지 않으면 'w2selectbox_disabled' 클래스가 적용됩니다.&quot;,
        &quot;disabledClass 속성을 설정하면 기본값인 'w2selectbox_disabled' 클래스는 적용되지 않습니다.&quot;,
        &quot;비활성화(disabled) 상태가 해제되면 적용된 CSS 클래스가 제거됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {              
        disabledClass : con_disabledClass.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)    
   
    // comp 생성 함수 호출    
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_getClassName_onclick = function (e) {
    let rtn = '';    
    let comp = &quot;target1&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');   

    rtn = targetElements[0].className
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;className : &quot; + rtn);		
};



scwin.btn_setDisabled_onclick = function (e) {
	target1.setDisabled(par_disabled.getText());
};
</script>
