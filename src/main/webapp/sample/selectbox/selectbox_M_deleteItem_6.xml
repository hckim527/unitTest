		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; M &gt; deleteItem]&lt;br/&gt;컴포넌트에서 특정 아이템을 제거합니다.&quot;,
    &quot;validation&quot; : [                        
        &quot;renderType=component 가 아닌 경우 deleteItem() 실행 후 첫번째 아이템이 선택됩니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }    

    let properties = {
        renderType : con_renderType.getText(),
    }

    let cList = $c.gcm.createCList(properties)

    // target 생성    
    $c.gcm.createLabel('label=&quot;첫번째가 아닌 아이템 선택 상태에서 deleteItem 후 선택된 아이템 값 확인&quot;', '', 'label1');
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_deleteItem_onclick = function (e) {
    let index = par_index.getValue();
    let refresh = par_refresh.getText();
    let rtn = '';

    if (refresh == '')
	    rtn = target1.deleteItem(index);
    else
        if (refresh == &quot;true&quot;)
            rtn = target1.deleteItem(index, true);
        else
            rtn = target1.deleteItem(index, false);

    rtn = target1.dom.select.value;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;선택 item 확인 : &quot; + rtn);
};</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
