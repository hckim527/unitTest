		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; M &gt; deleteItem]&lt;br/&gt;컴포넌트에서 특정 아이템을 제거합니다.&quot;,
    &quot;validation&quot; : [                        
        &quot;아이템이 GridViewItemSet 으로 정의된 경우도 아이템이 제거됩니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}




scwin.btn_deleteItem_onclick = function (e) {
    let index = par_index.getValue();
    let refresh = par_refresh.getText();
    let rtn = '';

    if (refresh == '')
	    rtn = target1.deleteItem(index);
    else
        if (refresh == &quot;true&quot;)
            rtn = target1.deleteItem(index, true);
        else
            rtn = target1.deleteItem(index, false);
        
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;object : &quot; + rtn);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;object.label : &quot; + rtn.label);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;object.value : &quot; + rtn.value);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;object.orgLabel : &quot; + rtn.orgLabel);
};



scwin.btn_getText_onclick = function (e) {
    let targetElement = document.querySelector('[id*=&quot;target1_gridViewItemTable_gridView_main_div&quot;]');

    if (!targetElement)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    let textContent = targetElement.textContent;
    
    // 결과 출력
   wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + textContent);   
};
</script>
