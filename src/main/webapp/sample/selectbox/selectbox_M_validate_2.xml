		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; M &gt; validate]&lt;br/&gt;mandatory=true 일때 입력값에 대한 유효성 체크를 실행한 후 결과값을 반환합니다.&quot;,
    &quot;validation&quot; : [ 
        &quot;SelectBox 에 입력값이 없는 조건은 emptyItem=true 일 때 선택된 아이템이 없어야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        // displaymessage: true,
        emptyItem: true,
        mandatory: true,
    };

    let cList = $c.gcm.createCList(properties);       

    $c.gcm.createBasicSelectBox(cList);

    target1.setSelectedIndex(4);
}



scwin.btn_validate_onclick = function (e) {
    let rtn = target1.validate();

    if (rtn) 
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : PASS&quot;);
    else
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : FAIL&quot;);
};</script>
