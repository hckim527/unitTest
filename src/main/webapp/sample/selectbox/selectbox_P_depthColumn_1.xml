		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > depthColumn]<br/>아이템 리스트창에 아이템을 계층 구조로 표시하기 위한 계층(Depth)값을 갖는 컬럼의 ID 를 설정합니다.",
    "validation" : [            
        "renderType=component 이고, 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "아이템의 계층(Depth)값를 갖는 컬럼의 ID 를 문자열로 설정합니다.",
        "계층값은 숫자로 설정하며 첫번째 아이템은 1 로 시작하여야 합니다.",
        "아이템의 순서에 맞게 계층값이 정의되어야 하며 부모와 자식 아이템의 계층값은 반드시 1 차이가 나야 합니다.",
        "계층값이 1 인 아이템이 제일 처음 표시되고, 해당 아이템을 선택하면 자식 아이템이 표시됩니다.",
        "선택한 아이템은 자식 아이템의 유무에 관계 없이 선택 처리됩니다.",
        "아이템 리스트창에서 아이템을 선택해도 아이템 리스트창은 자동으로 닫히지 않습니다.",
    ]
}



scwin.onpageload = function () {
