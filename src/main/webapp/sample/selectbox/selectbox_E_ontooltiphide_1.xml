		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > E > ontooltiphide]<br/>컴포넌트에 표시된 툴팁이 사라질 때 발생합니다.",
    "validation" : [        
        "툴팁을 표시한 속성에 관계없이 컴포넌트에서 툴팁이 사라질때 항상 이벤트가 발생합니다.",           
    ]
} 


scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정
    let properties = {
        tooltip: con_tooltip.getValue(),
        tooltipDisplay: con_tooltipDisplay.getText(),
        itemTooltipDisplay: con_itemTooltipDisplay.getText(),
    };

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["ontooltiphide"])

    // comp 생성
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    let grp_comp = $c.gcm.getTestGroup();
   
    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' ' + eList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_selectboxItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "selectbox",
        strTarget,
        grp_comp
    ); 
}



scwin.target1_ontooltiphide = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_ontooltiphide 이벤트 발생=====");
}]]></script>
