								</xf:itemset>
							</xf:choices>
						</xf:select1>
						<w2:textbox id="" label="customLabelFormatter=scwin.fn_customlabelformatter, depthColumnShowPath=true 설정"
							style="background-color:silver;">
						</w2:textbox>
						<xf:select1 allOption="" appearance="minimal" chooseOption="" depthColumn="depth_col" depthColumnShowPath="true"
							direction="auto" disabled="false" disabledClass="w2selectbox_disabled" enableColumn="" ev:onchange="scwin.target4_onchange"
							id="target4" ref="" style="width:150px; height:30px;" submenuSize="auto" customLabelFormatter="scwin.fn_customlabelformatter">
							<xf:choices>
