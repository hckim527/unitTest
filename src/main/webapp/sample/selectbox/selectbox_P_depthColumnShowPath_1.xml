		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > depthColumnShowPath]<br/>선택된 아이템이 라벨 표시 영역에 표시될때 부모의 라벨값을 포함할지 여부를 설정합니다.",
    "validation" : [            
        "renderType=component 이고, depthColumn 속성이 설정되었을때 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",        
        "미설정 시 선택된 아이템의 라벨값만 라벨 표시 영역에 표시합니다.",
        "true 설정 시 선택된 아이템이 라벨 표시 영역에 표시될때 모든 부모의 라벨값을 함께 포함합니다.",
        "false 설정 시 선택된 아이템의 라벨값만 라벨 표시 영역에 표시합니다.",
        "getText() 등의 메소드로 라벨값 조회 시 선택된 아이템의 라벨값만 반환됩니다.",
        "구분자는 depthColumnPathDelimiter 속성값을 사용하며 해당 속성을 설정하지 않으면 '-'가 적용됩니다.",
        "customLabelFormatter 속성 설정 시 해당 속성은 무시됩니다. ",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getText_onclick = function (target) {
    let rtn = '';
    
    rtn = target.render.textContent;    
    wf_body_bottom.getObj("scwin").setReturnValue("selectbox 의 label : " + rtn);

    rtn = target.getText();
    wf_body_bottom.getObj("scwin").setReturnValue("selectbox 의 getText : " + rtn);
}



scwin.fn_customlabelformatter = function(label, idx) {
    return idx + ", " + label;
}



scwin.target1_onchange = function (e) {
    scwin.btn_getText_onclick(target1);
}



scwin.target2_onchange = function (e) {
    scwin.btn_getText_onclick(target2); 
}



scwin.target3_onchange = function (info) {
    scwin.btn_getText_onclick(target3); 	
};



scwin.target4_onchange = function (info) {
    scwin.btn_getText_onclick(target4); 	
};]]></script>
