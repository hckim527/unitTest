									<w2:textbox class="" id="" label="renderType" ref="" style="" userData2=""></w2:textbox>
								</xf:group>
								<xf:group class="w2tb_td" style="" tagname="td">
									<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
										disabledClass="w2selectbox_disabled" id="con_renderType" ref="" style="" submenuSize="auto">
										<xf:choices>
											<xf:item>
												<xf:label><![CDATA[native]]></xf:label>
												<xf:value><![CDATA[1]]></xf:value>
											</xf:item>
											<xf:item>
												<xf:label><![CDATA[select]]></xf:label>
												<xf:value><![CDATA[2]]></xf:value>
											</xf:item>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group class="w2tb_th " tagname="th">
