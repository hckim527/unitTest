		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; valueNotInList]&lt;br/&gt;아이템 리스트에 없는 아이템을 선택했을때 처리하는 방식을 설정합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;renderType=native,select 인 경우 valueNotInList 속성은 항상 'default' 로 동작합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {                
        emptyItem : true,
        valueNotInList : &quot;keepValue&quot;,
        renderType : con_renderType.getText(),
    }

    let cList = $c.gcm.createCList(properties)
    
    // target 생성    
    $c.gcm.createLabel('label=&quot;valueNotInList=true 인 상태로 setValue(100) 시 빈 값 출력되면 정상&quot;', '', 'label1');
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_setValue_onclick = function (e) {
	target1.setValue(100);
    scwin.btn_getInfo_onclick();
};



scwin.btn_getInfo_onclick = function (e) {
    let rtn = '';

    rtn = target1.getText();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + rtn);

    rtn = target1.getValue();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn);    

    rtn = target1.getSelectedIndex();
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getSelectedIndex : &quot; + rtn);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
