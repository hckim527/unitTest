		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; delimiter]&lt;br/&gt;아이템 리스트에 Label 값과 Value 값이 함께 표시될때 각 값을 구분하는 구분자를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;customFormatter 또는 customLablFormatter 속성으로 displayMode 가 적용되지 않으면 해당 속성은 무시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {          
        delimiter : con_delimiter.getText(),
        customFormatter : con_customFormatter.getText(),
        customLabelFormatter : con_customLabelFormatter.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicSelectBox(cList);
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);  

    let comp = &quot;target1_itemTable_main&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    let tds = targetElements[0].querySelectorAll('td.w2table_sb_col');
    
    // 각 td 요소의 visible 확인
    tds.forEach((td, index) =&gt; {   
        let itemLabel = td.textContent;
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item index=&quot; + index + &quot; 의 label : &quot; + itemLabel);	
    });	      
};



scwin.fn_customformatter = function(items) {
    for (var i = 0; i &lt; items.length; i++) {
        items[i].label = items[i].orgLabel + &quot; Custom&quot;;
    }
    return items;
}



scwin.fn_customlabelformatter = function(label, idx) {
    return idx + &quot;, &quot; + label;
}</script>
