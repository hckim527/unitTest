		<script lazy="false" type="text/javascript"><![CDATA[// 샘플에 직접 유효성 설정
scwin.tData = {
    "description" : "[selectbox > M > addItem]<br/>컴포넌트에 신규 아이템을 추가합니다.",
    "validation" : [        
        "visibleColumn 속성으로 숨겨진 아이템을 기준으로 인덱스를 설정합니다.",
    ]
} 



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        visibleColumn: "visible_col",
    };
  
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onchange"]);     

    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    $c.gcm.createLabel('label="index=0~3 은 visibleColumn 에 의해 미표시 상태임"', '', 'label1')

    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' ' + eList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_selectboxItem">';
    strTarget += '<xf:label ref="label_col"></xf:label>';
    strTarget += '<xf:value ref="value_col"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "selectbox",
        strTarget,
        grp_comp
    ); 

    // $c.gcm.createBasicRadio(cList, eList);
}



scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj("scwin").setReturnValue("value : " + info.newValue);
    wf_body_bottom.getObj("scwin").setReturnValue("label : " + target1.getText());
    wf_body_bottom.getObj("scwin").setReturnValue("index : " + target1.getSelectedIndex());
}


scwin.btn_addItem_onclick = function (e) {
    let value = par_value.getValue();
    let label = par_label.getValue();
    let index = par_index.getValue();
    let refresh = par_refresh.getText();
    let rtn = '';

    if (index == '')
	    rtn = target1.addItem(value, label);
    else {
        if (refresh == '')
            rtn = target1.addItem(value, label, index);
        else
            rtn = target1.addItem(value, label, index, refresh);
    }
        
    wf_body_bottom.getObj("scwin").setReturnValue("return : " + rtn);
    
};
]]></script>
