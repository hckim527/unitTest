		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; M &gt; showChooseOption]&lt;br/&gt;컴포넌트의 chooseOption 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;chooseOption(필수) 파라미터로 '선택 안내' 아이템의 추가/제거 여부를 설정합니다.&quot;,
        &quot;chooseOption(필수) 파라미터로 true 설정 시 '선택 안내'아이템을 추가합니다.&quot;,
        &quot;chooseOption(필수) 파라미터로 false 설정 시 '선택 안내'아이템을 제거합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // comp 생성 함수 호출
    $c.gcm.createBasicSelectBox();
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);
};



scwin.btn_showChooseOption_onclick = function (e) {
    let chooseOption = par_chooseOption.getText();
    
    if (chooseOption == &quot;true&quot;)
	    target1.showChooseOption(true);
    else
        target1.showChooseOption(false);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition">
				</xf:group>
				<w2:wframe id="wf_body_sample" src="/frame/page/body_sample.xml" style=""></w2:wframe>
				<xf:group id="grp_parameter">
					<xf:group meta_snippetCategory="05_입출력테이블" meta_snippetName="5_02 2단테이블" meta_snippetKeyComponent="true" style="" id=""
						class="tblbox">
						<xf:group adaptive="layout" adaptiveThreshold="600" tagname="table" style="" id="" class="w2tb tbl">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
							</xf:group>
							<xf:group tagname="tr" style="">
								<xf:group tagname="th" style="" class="w2tb_th">
									<w2:textbox ref="" style="" userData2="" id="" label="chooseOption" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" style="" class="w2tb_td">
									<xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="" chooseOption="" style=""
										disabled="" id="par_chooseOption" allOption="" direction="">
										<xf:choices>
											<xf:itemset nodeset="data:gdl_boolean">
												<xf:label ref="label"></xf:label>
												<xf:value ref="value"></xf:value>
											</xf:itemset>
										</xf:choices>
									</xf:select1>
								</xf:group>
								<xf:group tagname="th" class="w2tb_th ">
									<w2:attributes></w2:attributes>
									<w2:textbox ref="" style="" userData2="" id="" label="" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" class="w2tb_td">
									<w2:attributes></w2:attributes>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">

						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_showChooseOption_onclick" id="btn_showChooseOption" label="showChooseOption" style=""></w2:button>
						<w2:button ev:onclick="scwin.btn_getText_onclick" style="" id="btn_getText" label="text 확인" class="tc_btn_basic"></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>