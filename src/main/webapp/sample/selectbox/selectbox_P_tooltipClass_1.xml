		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > tooltipClass]<br/>tooltipDisplay, tooltipShowAlways 속성에 의해 표시되는 툴팁에 적용할 클래스 이름을 설정합니다.",
    "validation" : [                
        "CSS 파일이나 style 블럭에 정의된 클래스 이름을 공백으로 구분하여 문자열로 설정합니다.",
        "속성값엔 'w2selectbox_tooltip' 클래스가 기본값으로 항상 추가됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {
        tooltipClass: con_tooltipClass.getText(),
        tooltipShowAlways: con_tooltipShowAlways.getText(),
        tooltipDisplay: con_tooltipDisplay.getText(),   
    };
  
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList(["onclick"]);     

    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();
    let grp_comp = $c.gcm.getTestGroup();
   
    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' ' + eList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_selectboxItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    // target 생성
    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "selectbox",
        strTarget,
        grp_comp
    ); 
}



scwin.target1_onclick = function (e) {     
    $c.gcm.getTooltipInfo(wf_body_bottom);   

    let rtn = '';
    let element = document.querySelector('[class*="w2selectbox_tooltip"]'); 
    rtn = element.className;

    wf_body_bottom.getObj("scwin").setReturnValue("className : " + rtn);
}]]></script>
