		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; P &gt; optionOrder]&lt;br/&gt;chooseOption 과 allOption 을 모두 true 설정했을때 추가된 아이템이 표시되는 순서를 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;컴포넌트의 아이템이 ItemSet 으로 정의된 경우 정상적으로 동작합니다.&quot;,
        &quot;미설정 시 chooseOption 속성으로 추가된 '선택 안내' 아이템이 먼저 표시됩니다.&quot;,
        &quot;all 설정 시 allOption 속성으로 추가된 '전체 선택' 아이템이 먼저 표시됩니다.&quot;,
        &quot;choose 설정 시 chooseOption 속성으로 추가된 '선택 안내' 아이템이 먼저 표시됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;target1 text : &quot; + rtn);    

    rtn = target2.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;target2 text : &quot; + rtn);    

    rtn = target3.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;target3 text : &quot; + rtn);    
};</script>
