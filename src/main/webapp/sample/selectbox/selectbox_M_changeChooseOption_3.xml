				<xf:group id="grp_parameter">
					<xf:group meta_snippetCategory="05_입출력테이블" meta_snippetName="5_02 2단테이블" meta_snippetKeyComponent="true" style="" id=""
						class="tblbox">
						<xf:group adaptive="layout" adaptiveThreshold="600" tagname="table" style="" id="" class="w2tb tbl">
							<w2:attributes>
								<w2:summary></w2:summary>
							</w2:attributes>
							<xf:group tagname="colgroup">
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
								<xf:group tagname="col" style="width:150px;"></xf:group>
								<xf:group tagname="col" style=""></xf:group>
							</xf:group>
							<xf:group tagname="tr" style="">
								<xf:group tagname="th" style="" class="w2tb_th">
									<w2:textbox ref="" style="" userData2="" id="" label="newValue" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" style="" class="w2tb_td">
									<xf:input id="par_newValue" style="" initValue="newValue"></xf:input>
								</xf:group>
								<xf:group tagname="th" class="w2tb_th ">
									<w2:attributes></w2:attributes>
									<w2:textbox ref="" style="" userData2="" id="" label="newLabel" class=""></w2:textbox>
								</xf:group>
								<xf:group tagname="td" class="w2tb_td">
									<w2:attributes></w2:attributes>
									<xf:input id="par_newLabel" style="" initValue="newLabel"></xf:input>
								</xf:group>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" id="grp_etc">

						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_changeChooseOption_onclick" id="btn_changeChooseOption"
							label="changeChooseOption" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_validate_onclick" id="button1" label="validate" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
