		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[selectbox &gt; M &gt; changeChooseOption]&lt;br/&gt;chooseOption 속성으로 추가된 '선택 안내' 아이템의 Value, Label 값을 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;''(Empty String)이 아닌 값을 설정하면 mandatory=true 일때 입력값 유효성 체크를 통과합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        mandatory : true,
        chooseOption : true,        
    }
   
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onviewchange&quot;]);
   
    // comp 생성 함수 호출
    $c.gcm.createBasicSelectBox(cList, eList);
}



scwin.btn_changeChooseOption_onclick = function (e) {
    let newValue = par_newValue.getValue();
    let newLabel = par_newLabel.getValue();

	target1.changeChooseOption(newValue, newLabel);
};



scwin.btn_validate_onclick = function (e) {
    let rtn = target1.validate();

    if (rtn) 
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : PASS&quot;);
    else
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;validate check : FAIL&quot;);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
