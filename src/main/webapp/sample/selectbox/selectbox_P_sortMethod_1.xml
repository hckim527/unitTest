		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[selectbox > P > sortMethod]<br/>아이템 리스트에 아이템이 정렬되는 순서를 설정합니다.",
    "validation" : [            
        "아이템이 정렬되는 기준값은 sortOption 속성으로 설정하며 sortOption 속성을 설정하지 않은 경우 동작하지 않습니다.",
        "미설정 시 아이템을 오름차순으로 정렬합니다.",
        "descending 설정 시 아이템을 내림차순으로 정렬합니다.",
        "ascending 설정 시 아이템을 오름차순으로 정렬합니다.",

    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    // 조건 설정   
    let properties = {        
        sortOption : "label",
        sortMethod : con_sortMethod.getText(),
    };

    let cList = $c.gcm.createCList(properties);

    // comp 생성
    let grp_comp = document.querySelector('.tc_group_basic');
    let strTarget = '';
    let strNameSpace = $c.gcm.getNameSpace();

    strTarget += '<xf:select1 ' + strNameSpace + ' ' + cList + ' style="width:200px; height:30px;">';
    strTarget += '<xf:choices>';
    strTarget += '<xf:itemset nodeset="data:dlt_selectboxItem">';
    strTarget += '<xf:label ref="label"></xf:label>';
    strTarget += '<xf:value ref="value"></xf:value>';
    strTarget += '</xf:itemset>';
    strTarget += '</xf:choices>';
    strTarget += '</xf:select1>';

    scwin.target1 = await $p.dynamicCreate(
        "target1",
        "selectbox",
        strTarget,
        grp_comp
    );
}



scwin.btn_getItemList_onclick = function (e) {
    let rtn = '';    
    let comp = "target1_itemTable";
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    rtn = targetElements[0].textContent
    wf_body_bottom.getObj("scwin").setReturnValue("Itemlist label : " + rtn);
};]]></script>
