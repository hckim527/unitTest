		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > M > setDefaultValue]<br/>컴포넌트의 initValue 속성을 설정합니다.",
    "validation" : [        
        "initValue(필수) 파라미터로 입력값으로 설정될 초기값을 문자열로 설정합니다.",
        "''(Empty String) 설정 시 초기값 설정이 해제됩니다.",
        "InputBox 컴포넌트가 Group 컴포넌트의 자식일때 Group 컴포넌트의 init() 메소드를 실행하면 InputBox 컴포넌트가 초기화되며 initValue 속성값이 입력값으로 설정됩니다.",
        "onpageload() 이벤트에서 setDefaultValue() 메소드 실행 시 initValue 속성에는 설정되지만 초기 화면에는 반영되지 않습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    target1.setDefaultValue("WebSquare");
};



scwin.get_text_display = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



// target1
scwin.btn_init_onclick = function (e) {
    group1.init();
};

scwin.btn_getText1_onclick = function (e) {
    scwin.get_text_display(target1);
};


scwin.btn_setValue1_onclick = function (e) {
    target1.setValue("change value");
};

scwin.btn_setDefaultValue_onclick = function (e) {
    target1.setDefaultValue(par_initValue.getValue());
};
]]></script>
