        "readonly=true 인 경우에 동작합니다.",
        "미설정 시 onfocus/onblur 이벤트가 발생하지 않습니다.",
        "true 설정 시 onfocus/onblur 이벤트가 발생합니다.",
        "false 설정 시 onfocus/onblur 이벤트가 발생하지 않습니다.", 
    ]
}



scwin.onpageload = function () {
    // 테스트 설명, 유효성 생성
    // let wf_body_left = wf_sample.getObj("wf_body_left");
    wf_body_left.getObj("scwin").createValidation(scwin.tData);	

    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target1 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        readOnly : con_readOnly.getText(),        
        readOnlyFocusEvent : con_readOnlyFocusEvent.getText(),
    }

    let cList = $c.gcm.createCList(properties);

    let eList = $c.gcm.createEList(["onfocus", "onblur"]);
 
    $c.gcm.createBasicInput(cList, eList); 
}



scwin.target1_onfocus = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onfocus=====");    
}



scwin.target1_onblur = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target1_onblur=====");    
}]]></script>
