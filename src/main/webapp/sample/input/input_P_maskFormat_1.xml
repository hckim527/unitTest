};



scwin.get_text = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



 // 사용자 정의 함수
 scwin.fn_dpformatter = function(val) {
