		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > maxlength]<br/>컴포넌트에 입력 가능한 최대 길이를 설정합니다.",
    "validation" : [
        "maxByteLength 와 maxlength 를 모두 설정하면 설정값이 작은 속성이 적용됩니다. ",
        "maxByteLength 와 maxlength 를 같은 값으로 설정하면 maxByteLength 가 적용됩니다.",        
        "datatype=float 일때 '+', '-', '.' 문자는 maxlength 계산에서 제외됩니다.",        
        "datatype 속성값이 숫자 유형일때 한글과 같은 다국어는 maxlength 를 초과해서 입력 되고, 포커스가 해제되거나 Enter 키 입력 시 제거됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.get_text = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



// target1
scwin.btn_setValue1_onclick = function (e) {
    target1.setValue("가나다라마바");
    target1.focus();
};

scwin.btn_getText1_onclick = function (e) {
    scwin.get_text(target1);
}

// target2
scwin.btn_setValue2_onclick = function (e) {
    target2.setValue("가나다라마바");
    target2.focus();
};

scwin.btn_getText2_onclick = function (e) {
    scwin.get_text(target2);
}

// target3
scwin.btn_setValue3_onclick = function (e) {
    target3.setValue(+123456.789);
    target3.focus();
};

scwin.btn_getText3_onclick = function (e) {
    scwin.get_text(target3);
};

// target4
scwin.btn_setValue4_onclick = function (e) {
    target4.setValue(-123456.789);
    target4.focus();
};

scwin.btn_getText4_onclick = function (e) {
