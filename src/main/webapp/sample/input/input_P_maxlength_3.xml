};

// target5
scwin.btn_setValue5_onclick = function (e) {
    target5.setValue("가나다라마바사");
    target5.focus();
};

scwin.btn_getText5_onclick = function (e) {
    scwin.get_text(target5);
};



scwin.btn_setAll_onclick = function (e) {
    for (var i = 1; i < 6; i ++)
        eval("scwin.btn_setValue"+i+"_onclick()");
}

scwin.btn_getAll_onclick = function (e) {
    for (var i = 1; i < 6; i ++)
        eval("scwin.btn_getText"+i+"_onclick()");
};]]></script>
