		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > M > setEditPlaceholderChar]<br/>컴포넌트의 editPlaceholderChar 속성을 설정합니다.",
    "validation" : [        
        "placeholder(필수) 파라미터로 마스크 문자 위치에 표시될 문자를 설정합니다.",
        "''(Empty String) 설정 시 속성을 설정하지 않은 상태로 초기화합니다.",
        "setEditPlaceholderChar() 메소드로 editPlaceholderChar 속성을 변경하는 경우 입력중인 값은 확정처리됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};


scwin.getFormattedValue = function (target) {
    let rtn = '';
    rtn = target.getFormattedValue();

    wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
}



// target1
scwin.btn_setEditPlaceholderChar1_onclick = function (e) {
    target1.setEditPlaceholderChar("_");
};


scwin.btn_getText1_onclick = function (e) {    
    scwin.getFormattedValue(target1);
};


// target2
scwin.btn_setEditPlaceholderChar2_onclick = function (e) {
    target2.setEditPlaceholderChar("");
};


scwin.btn_getText2_onclick = function (e) {    
    scwin.getFormattedValue(target2);
};



// target3
scwin.btn_setEditPlaceholderChar3_onclick = function (e) {
    target3.setEditPlaceholderChar("0");
};


scwin.btn_getText3_onclick = function (e) {    
    scwin.getFormattedValue(target3);
};


// target4
scwin.btn_setEditPlaceholderChar4_onclick = function (e) {
    target4.setEditPlaceholderChar("_");
};


scwin.btn_getText4_onclick = function (e) {    
    scwin.getFormattedValue(target4);
};


scwin.btn_setAll_onclick = function (e) {
    for (var i = 1; i < 5; i ++)
        eval("scwin.btn_setEditPlaceholderChar"+i+"_onclick()");
}

scwin.btn_getAll_onclick = function (e) {
    for (var i = 1; i < 5; i ++)
        eval("scwin.btn_getText"+i+"_onclick()");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox id="" label='editPlaceholderChar 로 "_" 설정' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target1"
							style="width: 200px;height: 30px;">
						</xf:input>
						<w2:button style="" id="btn_setEditPlaceholderChar1" label="setEditPlaceholderChar" class="tc_btn_basic"
							ev:onclick="scwin.btn_setEditPlaceholderChar1_onclick">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText1_onclick" id="btn_getText1" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='editPlaceholderChar 가 "_" 로 설정된 상태에서 초기화' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target2"
							style="width: 200px;height: 30px;" editPlaceholderChar="_">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setEditPlaceholderChar2_onclick"
							id="btn_setEditPlaceholderChar2" label="setEditPlaceholderChar" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText2_onclick" id="btn_getText2" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='editPlaceholderChar 를 "_" -&gt; "0" 으로 변경' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target3"
							style="width: 200px;height: 30px;" editPlaceholderChar="_">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setEditPlaceholderChar3_onclick"
							id="btn_setEditPlaceholderChar3" label="setEditPlaceholderChar" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" id="btn_getText3" label="text 확인" style=""
							ev:onclick="scwin.btn_getText3_onclick">
						</w2:button>
						<w2:textbox id="" label='값 입력 중 editPlaceholderChar 를 "-" 에서 "_" 로 변경' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" id="target4" style="width: 200px;height: 30px;"
							editPlaceholderChar="-">
						</xf:input>

						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setEditPlaceholderChar4_onclick" id="btn_setEditPlaceholderChar4"
							label="setEditPlaceholderChar" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText4_onclick" id="btn_getText4" label="text 확인"
							style="">
						</w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setAll_onclick" id="btn_setAll" label="setAll" style=""></w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getAll_onclick" id="btn_getAll" label="getAll" style=""></w2:button>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
