		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > editPlaceholderChar]<br/>editFormat 속성에 설정된 마스크 문자 위치에 미리 표시될 문자를 설정합니다.",
    "validation" : [        
        "마스크 문자 위치에 표시할 문자를 설정합니다.",
        "값을 설정하지 않으면 왼쪽부터 마스크 문자와 입력값이 차례로 매칭됩니다.",
        "붙여넣기 또는 setValue() 메소드로 입력값 설정 시 마스크 문자와 매칭되지 않는 문자는 입력되지 않고 빈값('_')으로 처리됩니다.",
        "특정 위치에서 붙여넣기 하면 해당 위치부터 값이 입력됩니다.",
        "editFormat 속성에 '||' 기호로 다중 포맷이 설정되어 있으면 마스크 문자의 갯수가 제일 많은 포맷이 표시됩니다.",
        "마스크 문자의 갯수가 동일한 포맷이 있는 경우 마지막에 정의한 포맷이 표시됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};


scwin.getFormattedValue = function (target) {
    let rtn = '';
    rtn = target.getFormattedValue();

    wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
}



// target1
scwin.btn_getText1_onclick = function (e) {
    // scwin.get_text_display(target1);
    scwin.getFormattedValue(target1)
};



// target2
scwin.btn_getText2_onclick = function (e) {
    scwin.getFormattedValue(target2);
};


// target3
scwin.btn_getText3_onclick = function (e) {
    scwin.getFormattedValue(target3);
};



// target4
scwin.btn_setValue4_onclick = function (e) {    
    target4.setValue("abc11111111");
    target4.focus();
};

scwin.btn_getText4_onclick = function (e) {
    scwin.getFormattedValue(target4);
};


// target5
scwin.btn_getText5_onclick = function (e) {
    scwin.getFormattedValue(target5);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox id="" label="editFormat=####/##/##, editPlaceholderChar=_" style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target1"
							style="width: 200px;height: 30px;" editPlaceholderChar="_">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText1_onclick" id="btn_getText1" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='editFormat=####/##/##, editPlaceholderChar=미설정' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target2"
							style="width: 200px;height: 30px;" editDisplayChar="*">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText2_onclick" id="btn_getText2" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='매칭되지 않는 문자 붙여넣기' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" editPlaceholderChar="_" ev:onfocus="scwin.target_onfocus"
							id="target3" style="width: 200px;height: 30px;">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText3_onclick" id="btn_getText3" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='매칭되지 않는 문자 setValue' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" editPlaceholderChar="_" ev:onfocus="scwin.target_onfocus"
							id="target4" style="width: 200px;height: 30px;">
						</xf:input>

						<w2:button class="tc_btn_basic" id="btn_setValue4" label="setValue" style=""
							ev:onclick="scwin.btn_setValue4_onclick">
						</w2:button>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText4_onclick" id="btn_getText4" label="text 확인"
							style="">
						</w2:button>
						<w2:textbox id="" label='editFormat 속성에 "||" 기호로 다중 포맷 설정, 마스크 문자의 갯수가 동일한 포맷있음' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="##-###-####||###-###-####||####-##-#####||###-####-####" editPlaceholderChar="_"
							ev:onfocus="scwin.target_onfocus" id="target5" style="width: 200px;height: 30px;">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getText5_onclick" id="btn_getText5" label="text 확인" style=""></w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
