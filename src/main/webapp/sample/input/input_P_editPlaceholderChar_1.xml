						<w2:textbox style="width: 150px;height: 23px;" id="" label="copy &amp; paste 용"></w2:textbox>
						<xf:input id="" style="width: 200px;height: 30px;" initValue="abc11111111"></xf:input>
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
