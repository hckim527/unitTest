		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > fireEventOnInvalid]<br/>허용하지 않는 문자가 입력되었을때 oninputinvalid 이벤트를 발생시킬지 여부를 설정합니다.",
    "validation" : [
        "미설정 시 허용하지 않는 문자가 입력되어도 oninputinvalid 이벤트를 발생시키지 않습니다.",                
        "true 설정 시 허용하지 않는 문자 입력 시 oninputinvalid 이벤트를 발생시킵니다.",              
        "false 설정 시 허용하지 않는 문자가 입력되어도 oninputinvalid 이벤트를 발생시키지 않습니다.",           
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.target_oninputinvalid = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("=====target_oninputinvalid=====")
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox id="" label='dataType="number", fireEventOnInvalid=미설정, 입력값=a, 기대값=oninputinvalid 이벤트 미발생' style="height: 23px;"></w2:textbox>
						<xf:input id="target1" style="width: 200px;height: 30px;" dataType="number" ev:oninputinvalid="scwin.target_oninputinvalid">
						</xf:input>
                        <w2:textbox id="" label='dataType="number", fireEventOnInvalid=true, 입력값=a, 기대값=oninputinvalid 이벤트 발생' style="height: 23px;"></w2:textbox>
						<xf:input id="target2" style="width: 200px;height: 30px;" dataType="number" ev:oninputinvalid="scwin.target_oninputinvalid" fireEventOnInvalid="true">
						</xf:input>
                        <w2:textbox id="" label='dataType="number", fireEventOnInvalid=false, 입력값=a, 기대값=oninputinvalid 이벤트 미발생' style="height: 23px;"></w2:textbox>
						<xf:input id="target3" style="width: 200px;height: 30px;" dataType="number" ev:oninputinvalid="scwin.target_oninputinvalid" fireEventOnInvalid="false">
						</xf:input>
                        <w2:textbox id="" label='ignoreChar="a", fireEventOnInvalid=true, 입력값=a, 기대값=oninputinvalid 이벤트 발생' style="height: 23px;"></w2:textbox>
						<xf:input id="target4" style="width: 200px;height: 30px;" ev:oninputinvalid="scwin.target_oninputinvalid" fireEventOnInvalid="true" ignoreChar="a-z">
						</xf:input>
                        <w2:textbox id="" label='allowChar="0-9", fireEventOnInvalid=true, 입력값=a, 기대값=oninputinvalid 이벤트 발생' style="height: 23px;"></w2:textbox>
						<xf:input id="target5" style="width: 200px;height: 30px;" ev:oninputinvalid="scwin.target_oninputinvalid" fireEventOnInvalid="true" allowChar="0-9">
						</xf:input>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc"></xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
