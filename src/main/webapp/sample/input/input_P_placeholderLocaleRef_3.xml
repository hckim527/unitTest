		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[input &gt; P &gt; placeholderLocaleRef]&lt;br/&gt;클라이언트 다국어가 적용되었을 때 PlaceHolder 로 적용될 다국어 텍스트의 Key 값을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;disabled=true 이면 PlaceHolder 기능이 적용되지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        placeholder : &quot;placeholder&quot;,
        useLocale : true,
        placeholderLocaleRef : con_placeholderLocaleRef.getText(),
        disabled : true,        
        style : &quot;width:200px;height:30px;&quot;,
    }

    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onclick&quot;]);

    $c.gcm.createLabel('label=&quot;placeholderLocaleRef 설정 후 [placeholder 확인] 버튼 클릭&quot;', '', 'label1');
    // comp 생성 함수 호출
    await $c.gcm.createEmptyInput(cList, eList);
}



scwin.btn_getValue_onclick = function (e) {
	let rtn = ''

    rtn = target1.getValue();
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;입력값 : &quot; + rtn)
};



// placeholderLocaleRef 적용 결과 확인 - 실제 input element 의 placeholder 속성 조회
scwin.btn_getPlaceholder_onclick = function (e) {
    // input 의 render 는 input element 자체
    let placeholderVal = target1.render.placeholder;
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;placeholder : &quot; + placeholderVal);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getPlaceholder_onclick();
    scwin.btn_getValue_onclick();
}</script>
