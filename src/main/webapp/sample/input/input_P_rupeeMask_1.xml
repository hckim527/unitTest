scwin.tData = {
    "description" : "[input > P > rupeeMask]<br/>인도 rupee 통화의 포맷을 적용하기 위한 마스크 문자를 설정합니다.",
    "validation" : [
        "dataType=rupee 인 경우에 동작합니다.",
        "editFormat, displayForamtter 중 한개의 속성이 설정된 경우 해당 속성은 무시됩니다.",
