		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > M > getEditPlaceholderChar]<br/>컴포넌트의 editPlaceholderChar 속성값을 반환합니다.",
    "validation" : [        
        "컴포넌트의 editPlaceholderChar 속성값을 반환합니다.",
        "editPlaceholderChar 속성을 설정하지 않은 경우 ''(Empty String)이 반환됩니다.",        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};


scwin.getEditPlaceholderChar = function (target) {
    let rtn = '';
    rtn = target.getEditPlaceholderChar();

    wf_body_bottom.getObj("scwin").setReturnValue("getEditPlaceholderChar : " + rtn);   
}



// target1
scwin.btn_setEditPlaceholderChar1_onclick = function (e) {
    target1.setEditPlaceholderChar("_");
};


scwin.btn_getEditPlaceholderChar1_onclick = function (e) {    
    scwin.getEditPlaceholderChar(target1);
};


// target2
scwin.btn_setEditPlaceholderChar2_onclick = function (e) {
    target2.setEditPlaceholderChar("");
};


scwin.btn_getEditPlaceholderChar2_onclick = function (e) {    
    scwin.getEditPlaceholderChar(target2);
};



// target3
scwin.btn_setEditPlaceholderChar3_onclick = function (e) {
    target3.setEditPlaceholderChar("0");
};


scwin.btn_getEditPlaceholderChar3_onclick = function (e) {    
    scwin.getEditPlaceholderChar(target3);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox id="" label='editPlaceholderChar ""(Empty String) 설정된 상태에서 getEditPlaceholderChar' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target1"
							style="width: 200px;height: 30px;">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getEditPlaceholderChar1_onclick" id="btn_getEditPlaceholderChar1" label="getEditPlaceholderChar"
							style="">
						</w2:button>
						<w2:textbox id="" label='editPlaceholderChar 가 "_" 로 설정된 상태에서 getEditPlaceholderChar' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target2"
							style="width: 200px;height: 30px;" editPlaceholderChar="_">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getEditPlaceholderChar2_onclick" id="btn_getEditPlaceholderChar2" label="getEditPlaceholderChar"
							style="">
						</w2:button>
						<w2:textbox id="" label='editPlaceholderChar 를 "_" -&gt; "0" 으로 변경 후 getEditPlaceholderChar' style=""></w2:textbox>
						<xf:input dataType="text" editFormat="####/##/##" ev:onfocus="scwin.target_onfocus" id="target3"
							style="width: 200px;height: 30px;" editPlaceholderChar="_">
						</xf:input>
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setEditPlaceholderChar3_onclick"
							id="btn_setEditPlaceholderChar3" label="setEditPlaceholderChar" style="">
						</w2:button>
						<w2:button class="tc_btn_basic" id="btn_getEditPlaceholderChar3" label="getEditPlaceholderChar" style=""
							ev:onclick="scwin.btn_getEditPlaceholderChar3_onclick">
						</w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
