		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > applyFormat]<br/>입력값 편집시에도 displayFormat 속성에 설정된 포맷을 적용할지 설정합니다.",
    "validation" : [
        "dataType 속성값이 text, date, time 이면 항상 'display' 로 동작합니다.",
        "editFormat 속성이 설정되면 항상 'all' 로 동작합니다.",
        "미설정 시 입력이 완료된 후 포커스가 해제되면 displayFormat 속성의 포맷이 적용됩니다.",
        "all 설정 시 입력값을 편집하는 중에도 displayFormat 속성의 포맷이 적용됩니다.",
        "display 설정 시 입력이 완료된 후 포커스가 해제되면 displayFormat 속성의 포맷이 적용됩니다.",
        "InputBox 의 입력값은 포맷이 제거된 실제 입력값이 저장됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.get_text_edit = function(target) {    
    let rtn = '';
    let tagName = target.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



scwin.get_text_display = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



// target1
scwin.btn_setValue1_onclick = function (e) {
    target1.setValue("123456789");
    target1.focus();
};

scwin.btn_getText1_onclick = function (e) {
    scwin.get_text_display(target1);
}

