scwin.tData = {
    "description" : "[input > P > ioFormat]<br/>dataType 속성값이 date 또는 time 일때 입력되는 숫자의 포맷을 설정합니다.",
    "validation" : [
        "dataType 속성값이 date 또는 time 일때 적용됩니다.",
        "입력값이 ioFormat 의 포맷과 일치하면 displayFormat 에 동일한 마스크 문자를 사용하여 포맷을 변경할 수 있습니다.",
        "값을 설정하지 않으면 'yyyyMMdd' 가 적용됩니다.",
        "dataType=date 일때 'yyyy' 마스크는 년도와 매칭되며 네자리로 설정합니다.",
        "dataType=date 일때 'MM' 마스크는 월과 매칭되며 두자리로 설정합니다.",
        "dataType=date 일때 'dd' 마스크는 일과 매칭되며 두자리로 설정합니다.",
        "dataType=time 일때 'HH' 마스크는 시와 매칭되며 두자리로 설정합니다.",
        "dataType=time 일때 'mm' 마스크는 분과 매칭되며 두자리로 설정합니다.",
        "dataType=time 일때 'ss' 마스크는 초과 매칭되며 두자리로 설정합니다.",
        "입력값이 ioFormat 속성의 포맷과 매칭되지 않으면 입력값 그대로 처리됩니다.",
        "dataType=date 일때 입력값은 8자리 숫자가 모두 입력되어야 합니다.",
        "dataType=time 일때 입력값이 마스크 문자에 맞지 않으면 잘리거나 0 으로 채워집니다.",
        "ref 속성으로 DataCollection 의 날짜 컬럼이 바인딩 되어 있을때 날짜 또는 시간의 포맷을 변경하여 표시할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.get_text = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



scwin.get_text_edit = function(target) {    
    let rtn = '';
    let tagName = target.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



// target1
