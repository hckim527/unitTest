<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[컴포넌트 소개] 텍스트 입력" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20220428" meta_user="InswaveSystems"></w2:history>
			<w2:history meta_no="02" meta_desc="미사용 객체 제거 및 화면 구성 변경" meta_date="20240621" meta_user="InswaveSystems" ></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_target1">
					<w2:columnInfo>
						<w2:column id="col1" name="col1" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[row1_value]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[row2_value]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > placeholderLocaleRef]<br/>클라이언트 다국어가 적용되었을 때 PlaceHolder 로 적용될 다국어 텍스트의 Key 값을 설정합니다.",
    "validation" : [
        "ref 속성으로 DataCollection 을 바인딩 한 데이터가 빈값인 경우 PlaceHolder 텍스트가 표시됩니다.",
        "DataList 를 바인딩 했을때 GridView 에서 행을 선택하지 않으면 PlaceHolder 텍스트가 표시됩니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // DataList currentRow + GridView 포커스 모두 미선택 상태로 초기화
    dlt_target1.setRowPosition(-1);
    gridview1.setFocusedCell(-1, -1);
};



// target1 (DataList 바인딩) input 값 + placeholder 확인
scwin.btn_getPlaceholder_onclick = function (e) {
    wf_body_bottom.getObj("scwin").setReturnValue("input value : " + target1.getValue());
    wf_body_bottom.getObj("scwin").setReturnValue("placeholder : " + target1.render.placeholder);
};



]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox style="height: 23px;" id="" label="DataList 바인딩 - GridView 행 미선택 또는 빈값 row(첫번째) 선택 시 placeholder('websquare') 표시, 정상값 row 선택 시 placeholder 사라짐"></w2:textbox>
						<xf:input id="target1" style="width: 200px;height: 30px;" useLocale="true" placeholder="placeholder" placeholderLocaleRef="websquare_name" ref="data:dlt_target1.col1"></xf:input>
						<w2:gridView dataList="data:dlt_target1" style="width: 500px;height: 150px;" id="gridview1">
							<w2:caption style="" id="caption1" value="dlt_target1"></w2:caption>
							<w2:header style="" id="header1">
								<w2:row style="" id="row1">
									<w2:column width="200" inputType="text" style="" id="column1" value="col1" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody style="" id="gBody1">
								<w2:row style="" id="row2">
									<w2:column width="200" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
						<w2:button style="" id="btn_getPlaceholder" label="placeholder 확인" ev:onclick="scwin.btn_getPlaceholder_onclick" class="tc_btn_basic"></w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc">
					</xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>
