		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[input > P > byteCheckIgnoreChar]<br/>maxByteLength 속성이 적용되었을때 입력값의 Byte 수 계산에서 제외할 문자의 집합을 설정합니다.",
    "validation" : [
        "Byte 수 계산에서 제외할 문자를 구분자 없이 문자열로 설정합니다.",        
        "우선 순위에 의해 maxlength 속성이 적용된 경우는 동작하지 않습니다.",
        "한글과 같은 다국어 문자도 설정할 수 있습니다.",
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);
};



scwin.get_text = function(target) {    
    let rtn = '';
    let tagName = target.render.tagName
    
    if (tagName !== "INPUT") {
        rtn = target.render.textContent
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);    
    }
    else {
        rtn = target.render.value
        wf_body_bottom.getObj("scwin").setReturnValue("text : " + rtn);   
    }    
}



// target1
scwin.btn_setValue1_onclick = function (e) {
    target1.setValue("()-/aA1가");
    target1.focus();
};

scwin.btn_getText1_onclick = function (e) {
    scwin.get_text(target1);
}

// target2
scwin.btn_setValue2_onclick = function (e) {
    target2.setValue("()-/aA1가");
    target2.focus();
};

scwin.btn_getText2_onclick = function (e) {
    scwin.get_text(target2);
}

// target3
scwin.btn_setValue3_onclick = function (e) {
    target3.setValue("()-/aA12가나다");
    target3.focus();
};

scwin.btn_getText3_onclick = function (e) {
    scwin.get_text(target3);
};

// target4
scwin.btn_setValue4_onclick = function (e) {
    target4.setValue(1234567890);
    target4.focus();
};

scwin.btn_getText4_onclick = function (e) {
    scwin.get_text(target4);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group style="" id="body_left" class="tc_body_left">
				<w2:wframe id="wf_body_left" src="/frame/page/body_left.xml" style=""></w2:wframe>
			</xf:group>
			<xf:group class="tc_body_right" id="body_right" style="">
				<w2:wframe id="wf_body_top" src="/frame/page/body_top.xml" style=""></w2:wframe>
				<xf:group id="grp_condition"></xf:group>
				<xf:group style="" id="grp_sample">
					<w2:textbox style="" id="" label="■ 테스트 샘플" class="tc_tbx_label_1" escape="false"></w2:textbox>
					<xf:group style="" id="grp_comp" class="tc_group_basic">
						<w2:textbox id="" label="maxByteLength=6, byteCheckIgnoreChar=()-/, 입력값=()-/aA1가, 기대값=()-/aA1가" style="height: 23px;"></w2:textbox>
						<xf:input id="target1" style="width: 200px;height: 30px;" maxByteLength="6" byteCheckIgnoreChar="()-/">
						</xf:input>
						<w2:button style="" id="btn_setValue1" label="setValue" ev:onclick="scwin.btn_setValue1_onclick"
							class="tc_btn_basic">
						</w2:button>
						<w2:button style="" id="btn_getText1" label="text 확인" class="tc_btn_basic"
							ev:onclick="scwin.btn_getText1_onclick">
						</w2:button>
						<w2:textbox id="" label="maxlength=4, maxByteLength=6, byteCheckIgnoreChar=()-/, 입력값=()-/aA1가, 기대값=()-/" style="height: 23px;"></w2:textbox>
						<xf:input id="target2" style="width: 200px;height: 30px;" maxByteLength="6" byteCheckIgnoreChar="()-/" maxlength="4">
						</xf:input>
						<w2:button ev:onclick="scwin.btn_setValue2_onclick" style="" id="btn_setValue2" label="setValue"
							class="tc_btn_basic">
						</w2:button>
						<w2:button ev:onclick="scwin.btn_getText2_onclick" style="" id="btn_getText2" label="text 확인"
							class="tc_btn_basic">
						</w2:button>
						<w2:textbox id="" label="maxByteLength=8, byteCheckIgnoreChar=가나다, 입력값=()-/aA12가나다, 기대값=()-/aA12가나다" style="height: 23px;"></w2:textbox>
						<xf:input id="target3" style="width: 200px;height: 30px;" byteCheckIgnoreChar="가나다" maxByteLength="8">
						</xf:input>
						<w2:button style="" id="btn_setValue3" label="setValue" class="tc_btn_basic"
							ev:onclick="scwin.btn_setValue3_onclick">
						</w2:button>
						<w2:button style="" id="btn_getText3" label="text 확인" class="tc_btn_basic"
							ev:onclick="scwin.btn_getText3_onclick">
						</w2:button>
						<w2:textbox id="" label="allowChar=0-9, maxByteLength=8, byteCheckIgnoreChar=01, 입력값=1234567890, 기대값=1234567890" style="height: 23px;"></w2:textbox>
						<xf:input id="target4" style="width: 200px;height: 30px;" maxByteLength="8" allowChar="0-9" byteCheckIgnoreChar="01">
						</xf:input>
						<w2:button style="" id="btn_setValue4" label="setValue" class="tc_btn_basic"
							ev:onclick="scwin.btn_setValue4_onclick">
						</w2:button>
						<w2:button style="" id="btn_getText4" label="text 확인" class="tc_btn_basic"
							ev:onclick="scwin.btn_getText4_onclick">
						</w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="" id="grp_etc"></xf:group>
				</xf:group>
				<w2:wframe id="wf_body_bottom" src="/frame/page/body_bottom.xml" style=""></w2:wframe>
			</xf:group>
		</xf:group>
	</body>
</html>