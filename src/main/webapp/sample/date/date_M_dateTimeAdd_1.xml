		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; dateTimeAdd]&lt;br/&gt;날짜 및 시간에 지정된 수만큼 더합니다. type 에 따라 증가 대상이 달라집니다.&quot;,
    &quot;validation&quot; : [
        &quot;date(필수) 파라미터로 기준 날짜와 시간을 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;offset(필수) 파라미터로 더할 숫자를 설정할 수 있어야 합니다.&quot;,
        &quot;type(필수) 파라미터로 증가 대상을 설정할 수 있어야 합니다.&quot;,
        &quot;type 을 'day' 로 설정 시 yyyyMMdd 형식의 날짜에 일수를 더하여 반환해야 합니다.&quot;,
        &quot;type 을 'month' 로 설정 시 yyyyMM 형식의 날짜에 개월 수를 더하여 반환해야 합니다.&quot;,
        &quot;type 을 'hour' 로 설정 시 yyyyMMddHH 형식의 날짜에 시간을 더하여 반환해야 합니다.&quot;,
        &quot;type 을 'minute' 로 설정 시 yyyyMMddHHmm 형식의 날짜에 분을 더하여 반환해야 합니다.&quot;,
        &quot;offset 에 음수를 설정하면 과거 날짜/시간을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_dateTimeAdd_onclick = function () {
    let date = par_date.getValue();
    let offset = Number(par_offset.getValue());
    let type = par_type.getValue();

    let ret = WebSquare.date.dateTimeAdd(date, offset, type);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;dateTimeAdd('&quot; + date + &quot;', &quot; + offset + &quot;, '&quot; + type + &quot;') : &quot; + ret);
}</script>
	</head>
