		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; getDay]&lt;br/&gt;yyyyMMdd 형식의 날짜를 입력받아서 해당 요일의 이름을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;dateFormat(필수) 파라미터로 yyyyMMdd 형식의 날짜 문자열을 설정할 수 있어야 합니다.&quot;,
        &quot;다국어 설정에 따른 요일 이름을 반환해야 합니다.&quot;,
        &quot;유효하지 않은 날짜이면 undefined 를 반환해야 합니다.&quot;,
        &quot;연도가 1900 년 미만이면 오류로 alert 이 표시되어야 합니다.&quot;,
        // &quot;다국어 메시지가 없는 경우 영문 요일명을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getDay_onclick = function () {
    let dateFormat = par_dateFormat.getValue();
    let ret = WebSquare.date.getDay(dateFormat);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getDay('&quot; + dateFormat + &quot;') : &quot; + ret);
}</script>
