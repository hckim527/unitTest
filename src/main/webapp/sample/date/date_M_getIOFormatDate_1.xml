		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; getIOFormatDate]&lt;br/&gt;날짜 문자열을 지정된 포맷에 맞게 변환하여 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;value(필수) 파라미터로 변환할 날짜 값을 yyyyMMddHHmmss 형식 중 해당 부분의 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;ioFormat(필수) 파라미터로 날짜 값에 적용할 출력 포맷을 설정할 수 있어야 합니다.&quot;,
        &quot;ioFormat 파라미터로 지정한 포맷으로 변환된 날짜 문자열을 반환해야 합니다.&quot;,
        &quot;value 와 ioFormat 의 길이가 다르면 value 를 그대로 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_getIOFormatDate_onclick = function () {
    let value = par_value.getValue();
    let ioFormat = par_ioFormat.getValue();
    let ret = WebSquare.date.getIOFormatDate(value, ioFormat);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getIOFormatDate('&quot; + value + &quot;', '&quot; + ioFormat + &quot;') : &quot; + ret);
}



scwin.par_value_onchange = function () {
    let idx = par_value.getSelectedIndex();
    par_ioFormat.setSelectedIndex(idx);
};</script>
	</head>
