		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; dateDiff]&lt;br/&gt;두 날짜 사이의 차이를 계산하여 반환합니다. (endDate - startDate)&quot;,
    &quot;validation&quot; : [
        &quot;startDate(필수) 파라미터로 시작 날짜를 yyyyMMdd 형식의 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;endDate(필수) 파라미터로 끝 날짜를 yyyyMMdd 형식의 문자열로 설정할 수 있어야 합니다.&quot;,
        &quot;options.returnType(선택) 을 'day' 로 설정 시 두 날짜 사이의 일수 차이를 반환해야 합니다.&quot;,
        &quot;options.returnType(선택) 을 'month' 로 설정 시 두 날짜 사이의 개월 수 차이를 반환해야 합니다.&quot;,
        &quot;options(선택) 파라미터 생략 시 기본값 returnType='day' 로 동작하여 일수 차이를 반환해야 합니다.&quot;,
        &quot;endDate 가 startDate 보다 이후이면 양수, 이전이면 음수를 반환해야 합니다.&quot;,
        &quot;구분자가 포함된 경우 숫자만 추출되어야 합니다.&quot;,
        &quot;연도 범위가 minYear ~ maxYear 를 벗어나면 NaN 을 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_dateDiff_onclick = function () {
    let startDate = par_startDate.getValue();
    let endDate = par_endDate.getValue();
    let returnType = par_returnType.getValue();

    let ret;
    if (returnType === 'omit') {
        ret = WebSquare.date.dateDiff(startDate, endDate);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;dateDiff('&quot; + startDate + &quot;', '&quot; + endDate + &quot;') : &quot; + ret);
    } else {
        ret = WebSquare.date.dateDiff(startDate, endDate, {&quot;returnType&quot;: returnType});
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;dateDiff('&quot; + startDate + &quot;', '&quot; + endDate + &quot;', {returnType: '&quot; + returnType + &quot;'}) : &quot; + ret);
    }
}</script>
