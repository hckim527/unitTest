		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; toSolar]&lt;br/&gt;yyyyMMdd 형식의 음력 날짜를 입력으로 받아 해당하는 양력 날짜의 문자열을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;lunar(필수) 파라미터로 yyyyMMdd 형식의 음력 날짜를 설정할 수 있어야 합니다.&quot;,
        &quot;yyyyMMdd 형식의 양력 날짜를 문자열로 반환해야 합니다.&quot;,
        &quot;lunar 파라미터값이 문자열이 아니면 undefined 를 반환해야 합니다.&quot;,
        &quot;지원 범위는 음력 1000 년 01 월 01 일(10000101) ~ 2050 년 11 월 18 일(20501118) 입니다.&quot;,
        &quot;변환 범위를 벗어나거나 잘못된 형식의 값을 입력하면 오류 로그가 출력되고 undefined 를 반환해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_toSolar_onclick = function () {
    let lunar = par_lunar.getValue();
    let ret = WebSquare.date.toSolar(lunar);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;toSolar('&quot; + lunar + &quot;') : &quot; + ret);
}</script>
