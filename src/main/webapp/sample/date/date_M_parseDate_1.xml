		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[date &gt; M &gt; parseDate]&lt;br/&gt;날짜 형식의 문자열을 지정된 포맷에 따라 파싱하여 JavaScript Date 객체로 변환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;str(필수) 파라미터로 파싱할 날짜 문자열을 설정할 수 있어야 합니다.&quot;,
        &quot;문자열에서 비숫자 문자는 자동으로 제거됩니다.&quot;,
        &quot;format(선택) 파라미터로 날짜 형식 포맷을 설정할 수 있어야 합니다.&quot;,
        &quot;지원하는 포맷 문자: y(년), M(월), d(일), H(시), m(분), s(초)&quot;,
        &quot;날짜 포맷에 따라 파싱된 JavaScript Date 객체를 반환해야 합니다.&quot;,
        &quot;입력 문자열의 길이와 포맷의 길이가 일치하지 않으면 null 을 반환해야 합니다.&quot;,
        &quot;format 생략 시 기본값 'yyyyMMdd' 로 동작해야 합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



scwin.btn_parseDate_onclick = function () {
    let str = par_str.getValue();
    let format = par_format.getValue();

    let ret;
    if (format === 'omit') {
        ret = WebSquare.date.parseDate(str);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;parseDate('&quot; + str + &quot;') : &quot; + ret);
    } else {
        ret = WebSquare.date.parseDate(str, format);
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;parseDate('&quot; + str + &quot;', '&quot; + format + &quot;') : &quot; + ret);
    }
}</script>
	</head>
