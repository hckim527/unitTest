scwin.tData = {
    &quot;description&quot; : &quot;[linkedDataList &gt; M &gt; setOption]&lt;br/&gt;속성명을 사용하여 LinkedDataList 모듈의 특정 속성의 값을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;attr(필수) 파라미터로 값을 설정하려는 속성의 이름을 문자열로 설정합니다.&quot;,
        &quot;대소문자를 구별하여 정확한 속성명을 설정해야 합니다.&quot;,
        &quot;value(필수) 파라미터로 속성에 설정하려는 값을 문자열로 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
	// 기존 target 있으면 삭제
    if (typeof gdl_org !== 'undefined') {
        $p.data.remove(&quot;gdl_org&quot;);
    }

    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }   

    if (typeof gridView2 !== 'undefined') {
        gridView2.remove();
    }     
    
    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
	// target 생성
    $c.gcm.createOrginalDataList();
    $c.gcm.createBasicLinkedDataList();

    // gridView 생성
    $c.gcm.createOriginalGridView();
    $c.gcm.createLinkedGridView();
}   



scwin.par_attr_onchange = function (info) {
	par_value.setValue(par_attr.getValue());
};



scwin.btn_getOption_onclick = function (e) {
    let attr = par_attr.getText();
    let rtn = target1.getOption(attr);
    
	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getOption: &quot; + rtn);
};



scwin.btn_setOption_onclick = function (e) {
	let attr = par_attr.getText();
    let value = par_value.getText();

    target1.setOption(attr, value);    
    
    scwin.btn_getOption_onclick();
};</script>
