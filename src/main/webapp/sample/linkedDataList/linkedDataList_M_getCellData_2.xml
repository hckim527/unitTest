		<script lazy="false" type="text/javascript">let isFilter = false;
let isSort = false;



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[linkedDataList &gt; M &gt; getCellData]&lt;br/&gt;Row 인덱스와 Column 정보를 사용하여 특정 Cell 의 값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;columnInfo(필수) 파라미터로 조회하려는 Cell 의 Column ID 값을 설정합니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
	// 기존 target 있으면 삭제
    if (typeof gdl_org !== 'undefined') {
        $p.data.remove(&quot;gdl_org&quot;);
    }

    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }   

    if (typeof gridView2 !== 'undefined') {
        gridView2.remove();
    }      
    
    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
	// target 생성
    $c.gcm.createOrginalDataList();
    $c.gcm.createBasicLinkedDataList();

    // gridView 생성
    $c.gcm.createOriginalGridView();
    $c.gcm.createLinkedGridView();

    isFilter = false;
    isSort = false;
}   



scwin.btn_setColumnFilter_onclick = function (e) {
    if (isFilter) {
        target1.clearFilter();  
        isFilter = false;  
    }
    else {
        target1.setColumnFilter({type:&quot;row&quot;, colIndex:&quot;value&quot;, key:&quot;AA11&quot;, condition:&quot;and&quot;});
        target1.setColumnFilter({type:&quot;row&quot;, colIndex:&quot;value&quot;, key:&quot;AA21&quot;, condition:&quot;or&quot;});
        isFilter = true;
    }	

    scwin.btn_getCellData_onclick();
};



scwin.btn_sort_onclick = function (e) {
    if (isSort) {    
        target1.clearSort();
        isSort = false;
    }
    else {
        target1.sort(&quot;label&quot;, 1);
        isSort = true;
    }

    scwin.btn_getCellData_onclick();
};



scwin.btn_getCellData_onclick = function (e) {
    let rtn = '';
    let rowIndex = par_rowIndex.getText();
    let colID = par_columnInfo.getText();

    rtn = target1.getCellData(Number(rowIndex), colID);
   
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getCellData : &quot; + rtn);    
};</script>
