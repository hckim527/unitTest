		<script lazy="false" type="text/javascript">let isFilter = false;
let isSort = false;



// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[linkedDataList &gt; M &gt; getOriginalCellData]&lt;br/&gt;Row 인덱스와 Column 정보를 사용하여 특정 Cell 의 원본(Origin)값을 반환합니다.&quot;,
    &quot;validation&quot; : [
        &quot;reform() 등의 메소드에 의해 원본(Origin)값이 최초에 로딩된 값이 아닐 수 있습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
	// 기존 target 있으면 삭제
    if (typeof gdl_org !== 'undefined') {
        $p.data.remove(&quot;gdl_org&quot;);
    }

    if (typeof target1 !== 'undefined') {
        $p.data.remove(&quot;target1&quot;);
    }

    if (typeof gridView1 !== 'undefined') {
        gridView1.remove();
    }   

    if (typeof gridView2 !== 'undefined') {
        gridView2.remove();
    }        
    
    // // 조건 설정       
    // let properties = {

    // };

    // let cList = $c.gcm.createCList(properties);

    // // 이벤트 설정
    // let eList = $c.gcm.createEList([&quot;&quot;]);       
   
	// target 생성
    $c.gcm.createOrginalDataList();
    $c.gcm.createBasicLinkedDataList();

    // gridView 생성
    $c.gcm.createOriginalGridView();
    $c.gcm.createLinkedGridView();

    isFilter = false;
    isSort = false;

    scwin.btn_setCellData_onclick();
}



scwin.btn_setCellData_onclick = function (e) {
    for (var i=0; i&lt;4; i++) {
        for (var j=1; j&lt;4; j++) {
            gdl_org.setCellData(i, j, &quot;v1_&quot;+i+&quot;_&quot;+j);
        }
    }

    gdl_org.reform();

    for (var i=0; i&lt;4; i++) {
        for (var j=1; j&lt;4; j++) {
            gdl_org.setCellData(i, j, &quot;v2_&quot;+i+&quot;_&quot;+j);
        }
    }
};



scwin.btn_getOriginalCellData_onclick = function (e) {
    let rtn = '';
    let realRowIndex = par_realRowIndex.getText();
    let colIndex = par_columnInfo.getText();

    rtn = target1.getOriginalCellData(Number(realRowIndex), Number(colIndex));
   
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getOriginalCellData : &quot; + rtn);    
};</script>
