    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    // $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    scwin.btn_sort_onclick();
    dlt_org.setRowPosition(0);
}   



scwin.btn_getAllFilteredJSON_onclick = function (e) {
    let rtn = target1.getAllFilteredJSON();
    let jsonString = JSON.stringify(rtn);

	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.json: &quot; + jsonString);
};



scwin.btn_sort_onclick = function (e) {   
    target1.sort('col1', 1);
}



scwin.btn_setColumnFilter_onclick = function (e) {   
    let colID = par_columnInfo.getText();

    target1.setColumnFilter({type:'row', colIndex:colID, key:'WebSquare', condition:'and', exactMatch:false});        

    scwin.btn_getAllFilteredJSON_onclick();     
};



scwin.btn_removeColumnFilter_onclick = function (e) {
	let colID = par_columnInfo.getText();

    target1.removeColumnFilter(colID);

    scwin.btn_getAllFilteredJSON_onclick(); 
};
</script>
