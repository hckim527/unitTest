scwin.tData = {
    &quot;description&quot; : &quot;[linkedDataList &gt; M &gt; setColumnFilter]&lt;br/&gt;LinkedDataList 모듈에 적용될 필터 조건을 추가합니다.&quot;,
    &quot;validation&quot; : [
        &quot;type 파라미터값이 'regExp' 일때  label Column 의 값이 'WebSquare' 이거나 'inswave' 인 Row 필터링&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    // $c.gcm.createCommonDatalist();
    
    // comp 초기 생성
    scwin.comp_init();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);
};



// comp 생성
scwin.comp_init = async function () {   
    dlt_org.setRowPosition(0);
} 



scwin.btn_getAllFilteredJSON_onclick = function (e) {
    let rtn = target1.getAllFilteredJSON();
    let jsonString = JSON.stringify(rtn);

	wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;result.json: &quot; + jsonString);
};



scwin.btn_setColumnFilter_onclick = function (e) {   
    if (isFilter) {
        target1.clearFilter();  
        isFilter = false;  
    }
    else {
        target1.setColumnFilter({type:&quot;regExp&quot;, colIndex:&quot;label&quot;, key:/^(WebSquare|inswave)$/gi, condition:&quot;and&quot;});      
        isFilter = true;
    }	

    scwin.btn_getAllFilteredJSON_onclick();     
};</script>
