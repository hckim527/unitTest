<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" id="dlt_bind1" repeatNode="map" useStatusValue="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[col1_1]]></col1>
                            <col2><![CDATA[col2_1]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[col1_2]]></col1>
                            <col2><![CDATA[col2_2]]></col2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
                <w2:dataList baseNode="list" id="dlt_bind2" repeatNode="map" useStatusValue="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[col1_1]]></col1>
                            <col2><![CDATA[col2_1]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[col1_2]]></col1>
                            <col2><![CDATA[col2_2]]></col2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// scwin.onpageload = function () {
//     // [target1] checkEditableInputClass=true
//     //   Cell (0, col1) → disabled / Cell (0, col2) → readOnly
//     target1.setCellDisabled(0, "col1", true);
//     target1.setCellReadOnly(0, "col2", true);

//     // [target2] checkEditableInputClass=false (기본값) — 동일 설정 비교군
//     target2.setCellDisabled(0, "col1", true);
//     target2.setCellReadOnly(0, "col2", true);
// };



scwin.btn_getCellClassName_onclick = function () {
    var targets = ["target1", "target2"];
    var cols = ["col1", "col2"];
    for (var i = 0; i < targets.length; i++) {
        var name = targets[i];
        for (var r = 0; r < 2; r++) {
            for (var c = 0; c < cols.length; c++) {
                var td = document.querySelector("[id*='" + name + "_cell_" + r + "_" + c + "']");
                var nobr = td ? td.firstElementChild : null;
                var cn = nobr ? nobr.className : "(nobr 없음)";
                scwin.setReturnValue("[" + name + "] cell(" + r + "," + cols[c] + ") nobr.className : " + cn);
            }
        }
    }
};
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding: 10px;" id="grp_root">
            <w2:textbox style="" id="" label="[FAIL] gridView checkEditableInputClass='true' 설정 시에도 readonly/disabled Cell 의 nobr 태그에서 'w2grid_input' CSS 클래스가 제거되지 않고 false 와 동일하게 유지되는 결함 재현" class="" escape="false"></w2:textbox>

            <w2:textbox style="margin-top:10px;" id="" label="[target1] checkEditableInputClass='true' / Cell(0,col1) → disabled / Cell(0,col2) → readOnly" class="" escape="false"></w2:textbox>
            <w2:gridView checkAllType="false" id="target1" style="width:300px;height:160px;" dataList="data:dlt_bind1"
                checkEditableInputClass="true" disabledBackgroundColor="#D3D3D3" readOnlyBackgroundColor="#FFF8DC">
                <w2:caption style="" id="caption1" value="checkEditableInputClass='true'"></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="row1">
                        <w2:column width="100" inputType="text" id="column1" value="name1"></w2:column>
                        <w2:column width="100" inputType="text" id="column2" value="name2"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="row2">
                        <w2:column width="100" inputType="text" id="col1"></w2:column>
                        <w2:column width="100" inputType="text" id="col2"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>

            <w2:textbox style="margin-top:10px;" id="" label="[target2] checkEditableInputClass='false' (기본값) — 동일 설정 비교군" class="" escape="false"></w2:textbox>
            <w2:gridView checkAllType="false" id="target2" style="width:300px;height:160px;" dataList="data:dlt_bind2"
                checkEditableInputClass="false" disabledBackgroundColor="#D3D3D3" readOnlyBackgroundColor="#FFF8DC">
                <w2:caption style="" id="caption2" value="checkEditableInputClass='false'"></w2:caption>
                <w2:header style="" id="header2">
                    <w2:row style="" id="row3">
                        <w2:column width="100" inputType="text" id="column5" value="name1"></w2:column>
                        <w2:column width="100" inputType="text" id="column6" value="name2"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody2">
                    <w2:row style="" id="row4">
                        <w2:column width="100" inputType="text" id="col1"></w2:column>
                        <w2:column width="100" inputType="text" id="col2"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>

            <xf:group style="margin-top:10px;" id="grp_buttons">
                <w2:button class="" ev:onclick="scwin.btn_getCellClassName_onclick" id="btn_getCellClassName" label="className 확인" style=""></w2:button>
            </xf:group>

            <xf:group class="" id="grp_bottom" style="margin-top:10px;">
                <w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
                <xf:group id="" style="display: flex;justify-content: flex-end">
                    <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
                </xf:group>
                <xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 240px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
            </xf:group>
        </xf:group>
    </body>
</html>
