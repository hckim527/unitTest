<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" id="dlt_bind" repeatNode="map" useStatusValue="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[a1]]></col1>
                            <col2><![CDATA[b1]]></col2>
                            <col3><![CDATA[c1]]></col3>
                            <col4><![CDATA[d1]]></col4>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[a2]]></col1>
                            <col2><![CDATA[b2]]></col2>
                            <col3><![CDATA[c2]]></col3>
                            <col4><![CDATA[d2]]></col4>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {

};


// [재현 버튼 1] 인덱스로 setHeaderDisabled 호출
scwin.btn_setByIndex_onclick = function () {    
    target1.setHeaderDisabled(0, true);
    scwin.setReturnValue("===== setHeaderDisabled(0, true) [인덱스] 호출 =====");    
};



// [재현 버튼 2] id 로 setHeaderDisabled 호출 (정상 비교군)
scwin.btn_setById_onclick = function () {
    var firstId = target1.getHeaderID(0);
    target1.setHeaderDisabled(firstId, true);
    scwin.setReturnValue("===== setHeaderDisabled(" + firstId + ", true) [ID] 호출 =====");
};



// Header 클릭 이벤트 핸들러 (text Header)
scwin.target1_onheaderclick = function (headerId) {
    scwin.setReturnValue("[이벤트 발생] onheaderclick : headerId = " + headerId);
};



// Header textImage 클릭 이벤트 핸들러 (textImage Header)
scwin.target1_onheadertextimageclick = function (headerId, headerValue) {
    scwin.setReturnValue("[이벤트 발생] onheadertextimageclick : headerId = " + headerId + ", value = " + headerValue);
};
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding: 10px;" id="grp_root">
            <w2:textbox style="" id="" label="[FAIL] gridView setHeaderDisabled 를 인덱스로 호출하면 id 기반 내부 disabled 상태가 설정되지 않아 Header 클릭 이벤트(onheaderclick / onheadertextimageclick) 차단이 동작하지 않는 결함 재현" class="" escape="false"></w2:textbox>

            <w2:textbox style="margin-top:10px;" id="" label="column1, column3 : inputType=textImage (아이콘 클릭 시 onheadertextimageclick) / column2, column4 : inputType=text (클릭 시 onheaderclick)" class="" escape="false"></w2:textbox>

            <w2:gridView checkAllType="false" id="target1" style="width:500px;height:160px;margin-top:8px;" dataList="data:dlt_bind"
                ev:onheaderclick="scwin.target1_onheaderclick" ev:onheadertextimageclick="scwin.target1_onheadertextimageclick">
                <w2:caption style="" id="caption1" value="setHeaderDisabled index 결함 재현"></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="row1">
                        <w2:column width="120" inputType="textImage" viewType="icon" imageSrc="/cm/images/base/ico_grid_filter.svg" id="column1" value="name1"></w2:column>
                        <w2:column width="120" inputType="text" id="column2" value="name2"></w2:column>
                        <w2:column width="120" inputType="textImage" viewType="icon" imageSrc="/cm/images/base/ico_grid_filter.svg" id="column3" value="name3"></w2:column>
                        <w2:column width="120" inputType="text" id="column4" value="name4"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="row2">
                        <w2:column width="120" inputType="text" id="col1"></w2:column>
                        <w2:column width="120" inputType="text" id="col2"></w2:column>
                        <w2:column width="120" inputType="text" id="col3"></w2:column>
                        <w2:column width="120" inputType="text" id="col4"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>

            <xf:group style="margin-top:10px;display:flex;gap:6px;" id="grp_buttons">
                <w2:button class="" ev:onclick="scwin.btn_setByIndex_onclick" id="btn_setByIndex" label="setHeaderDisabled(0, true) [인덱스]" style=""></w2:button>
                <w2:button class="" ev:onclick="scwin.btn_setById_onclick" id="btn_setById" label="setHeaderDisabled(첫 column id, true) [ID]" style=""></w2:button>
            </xf:group>

            <xf:group class="" id="grp_bottom" style="margin-top:10px;">
                <w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
                <xf:group id="" style="display: flex;justify-content: flex-end">
                    <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
                </xf:group>
                <xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 320px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
            </xf:group>
        </xf:group>
    </body>
</html>
