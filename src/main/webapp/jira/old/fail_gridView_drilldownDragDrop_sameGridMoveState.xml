<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" id="dlt_bind1" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="name" name="name" dataType="text"></w2:column>
                        <w2:column id="dept" name="dept" dataType="text"></w2:column>
                        <w2:column id="depth" name="depth" dataType="number"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row><name><![CDATA[영업본부]]></name><dept><![CDATA[Sales]]></dept><depth><![CDATA[1]]></depth></w2:row>
                        <w2:row><name><![CDATA[영업1팀]]></name><dept><![CDATA[Sales]]></dept><depth><![CDATA[2]]></depth></w2:row>
                        <w2:row><name><![CDATA[김영업]]></name><dept><![CDATA[Sales]]></dept><depth><![CDATA[3]]></depth></w2:row>
                        <w2:row><name><![CDATA[이영업]]></name><dept><![CDATA[Sales]]></dept><depth><![CDATA[3]]></depth></w2:row>
                        <w2:row><name><![CDATA[개발본부]]></name><dept><![CDATA[Dev]]></dept><depth><![CDATA[1]]></depth></w2:row>
                        <w2:row><name><![CDATA[개발1팀]]></name><dept><![CDATA[Dev]]></dept><depth><![CDATA[2]]></depth></w2:row>
                        <w2:row><name><![CDATA[박개발]]></name><dept><![CDATA[Dev]]></dept><depth><![CDATA[3]]></depth></w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};
// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue + "\n");
};

scwin.onpageload = function () {
    // DrillDown 그리드는 기본 Drag&Drop 미동작 -> setDrillDownDragDrop(true) 로 활성화
    target1.setDrillDownDragDrop(true);
    scwin.setReturnValue("[초기] getRowCount : " + target1.getRowCount());
};

// [확인 버튼] 현재 getRowCount 출력
scwin.btn_getRowCount_onclick = function () {
    scwin.setReturnValue("[확인] getRowCount : " + target1.getRowCount());
};

// 동일 그리드 이동 시나리오의 dragEndFunction : 이동(펼침상태 재구성) 반영 후 getRowCount 출력
scwin.target1_dragEndFunc = function (targetRowIndex, rowXml, info) {
    setTimeout(function () {
        scwin.setReturnValue("[드래그 이동 후] getRowCount : " + target1.getRowCount() + "  (정상=3 / 결함=2)");
    }, 150);
};
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding: 10px;" id="grp_root">
            <w2:textbox style="" id="" escape="false" class=""
                label="[FAIL] DrillDown GridView 에서 같은 그리드 내 부모 Row(개발본부)를 다른 부모 Row(영업본부) 위로 드래그해 이동하면, 이동 후 표시 상태가 깨짐 - 자식 행(김영업/이영업)이 빈 셀로 렌더되고 getRowCount() 가 실제보다 작게(2) 반환됨. 7월정기 degradation (6월정기는 정상: getRowCount=3, 표시 정상)."></w2:textbox>

            <w2:gridView id="target1" dataDragDrop="true" dataList="data:dlt_bind1" style="width:420px;height:300px;margin-top:8px;"
                dragEndFunction="scwin.target1_dragEndFunc">
                <w2:caption style="" id="caption1" value="DrillDown 동일 그리드 Drag and Drop 이동 결함 재현"></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="row1">
                        <w2:column width="200" style="" inputType="text" id="hname" value="이름(DrillDown)"></w2:column>
                        <w2:column width="*" style="" inputType="text" id="hdept" value="부서"></w2:column>
                        <w2:column width="60" style="" inputType="text" id="hdepth" value="depth"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="row2">
                        <w2:column width="200" style="" inputType="drilldown" depthColumn="depth" showDepth="1" depthStartIndex="1" id="name" dataList="name"></w2:column>
                        <w2:column width="*" style="" inputType="text" id="dept" dataList="dept"></w2:column>
                        <w2:column width="60" style="" inputType="text" id="depth" dataList="depth"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>

            <xf:group class="" id="grp_bottom" style="margin-top:10px;">
                <w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ getRowCount 확인 (드래그 이동 후 자동 출력 / 정상=3, 결함=2)" style=""></w2:textbox>
                <xf:group id="" style="display: flex;gap:6px;justify-content: flex-end">
                    <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getRowCount_onclick" id="btn_getRowCount" label="getRowCount 확인" style=""></w2:button>
                    <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
                </xf:group>
                <xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 100px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
            </xf:group>
        </xf:group>
    </body>
</html>
