<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="name" name="filename" dataType="text"></w2:column>
						<w2:column id="displaySize" name="size" dataType="text"></w2:column>
						<w2:column id="status" name="status" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

function selectCallback() {
	var fileInfos = multiupload1.getFileInfos();
	dataList1.setJSON(fileInfos);
}

scwin.multiupload1_ondone = function (data) {
	console.log(JSON.stringify(data));
	setTimeout(clearUpload, "3000");
};

function clearUpload() {
	dataList1.removeAll();
}


scwin.trigger2_onclick = function (e) {
	var focusRow = gridView1.getFocusedRowIndex();

	var rowData = dataList1.getRowJSON(focusRow);

	//console.log(rowData.name);
	multiupload1.removeFile(rowData.name);

	dataList1.removeRow(focusRow);
};

scwin.trigger3_onclick = function (e) {

	var returnArr = multiupload1.getFileNames();

	for(var i=0; i<returnArr.length; i++){
		var checkStr = returnArr[i].includes("&");
		if(checkStr){
			console.log(i);
		}
	}


	multiupload1.startUpload();
};

scwin.multiupload1_onprogress = function (info) {
	//console.log(info.fileName + "(" + info.percentData + "%)");

	var rowidx = dataList1.getMatchedIndex("name", info.fileName);

	$("td[colindex='2']:eq(" + rowidx + ") .w2grid_input").text(info.percentData + "%");
	$("td[colindex='2']:eq(" + rowidx + ") .w2grid_input").css("width", info.percentData + "%");
};

]]></script>
		<style type="text/css"><![CDATA[
    	td[colindex='2'] .w2grid_input {
				display: block;
				text-align: right;
				background-color: yellow;
				width: 0%;
			}
    	 ]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
		<xf:trigger type="button" style="position:absolute;top:97px;left:705px;width:80px;height:23px;margin-right:5px;z-index:0;"
			id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[파일추가]]></xf:label>
		</xf:trigger>
		<w2:gridView id="gridView1" style="width:639px;height:150px;" checkAllType="false" scrollByColumn="false"
			defaultCellHeight="20" scrollByColumnAdaptive="false" dataList="data:dataList1">
			<w2:caption style="" id="caption4" value="this is a grid caption."></w2:caption>
			<w2:header style="" id="header4">
				<w2:row style="" id="row7">
					<w2:column width="263" inputType="text" style="height:20px" id="column23" value="filename" displayMode="label"></w2:column>
					<w2:column width="98" inputType="text" style="height:20px" id="column22" value="size" displayMode="label"></w2:column>
					<w2:column width="191" inputType="text" style="height:20px" id="column21" value="status" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody style="" id="gBody4">
				<w2:row style="" id="row8">
					<w2:column width="263" inputType="text" style="height:20px" id="name" value="" displayMode="label"></w2:column>
					<w2:column width="98" inputType="text" style="height:20px" id="displaySize" value="" displayMode="label"></w2:column>
					<w2:column width="191" inputType="text" style="height:20px" id="status" value="" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="position:static; top:236px; left:464px; width:80px; height:23px; margin-right: 5px;"
			id="trigger2" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[행삭제]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="position:static; top:215px; left:592px; width:80px; height:23px; " id="trigger3"
			ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[업로드]]></xf:label>
		</xf:trigger>
		<w2:multiupload mode="html5_transparent" wmode="false"
			style="position:absolute;top:97px;left:705px;width:80px;height:23px;z-index:1;" id="multiupload1" uploadButton=""
			ev:onComplete="scwin.multiupload1_onComplete" selectCallback="selectCallback" ev:ondone="scwin.multiupload1_ondone"
			ev:onprogress="scwin.multiupload1_onprogress" maxsize="50000" filter="*:*.*" action="/upload2.do">
		</w2:multiupload>
	</body>
</html>
