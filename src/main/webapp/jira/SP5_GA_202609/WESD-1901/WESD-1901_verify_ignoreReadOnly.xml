<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dlt" baseNode="list" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="c1" name="c1" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row><c1><![CDATA[row0-편집]]></c1></w2:row>
                        <w2:row><c1><![CDATA[row1-RO]]></c1></w2:row>
                        <w2:row><c1><![CDATA[row2-편집]]></c1></w2:row>
                        <w2:row><c1><![CDATA[row3-RO]]></c1></w2:row>
                        <w2:row><c1><![CDATA[row4-편집]]></c1></w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <script type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    grid1.setRowReadOnly(1, true);
    grid1.setRowReadOnly(3, true);
    grid2.setRowReadOnly(1, true);
    grid2.setRowReadOnly(3, true);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <w2:textbox id="" label="grid1: ignoreReadOnlyCellArrowMove=false (기존동작 — RO row도 이동)" style="margin:8px;width:500px;"></w2:textbox>
        <w2:gridView id="grid1" dataList="data:dlt" editable="true" focusMode="cell"
            ignoreNonEditableCell="true" ignoreNonEditableCellTabEnter="true" moveKeyEditMode="false"
            ignoreReadOnlyCellArrowMove="false" style="width:320px;height:170px;margin:8px;">
            <w2:header><w2:row><w2:column id="h1" width="300" inputType="text" value="col (row1,3=RO)"></w2:column></w2:row></w2:header>
            <w2:gBody><w2:row><w2:column id="c1" width="300" dataList="c1" inputType="text"></w2:column></w2:row></w2:gBody>
        </w2:gridView>
        <w2:textbox id="" label="grid2: ignoreReadOnlyCellArrowMove=true (신규 — RO row 건너뜀)" style="margin:8px;width:500px;"></w2:textbox>
        <w2:gridView id="grid2" dataList="data:dlt" editable="true" focusMode="cell"
            ignoreNonEditableCell="true" ignoreNonEditableCellTabEnter="true" moveKeyEditMode="false"
            ignoreReadOnlyCellArrowMove="true" style="width:320px;height:170px;margin:8px;">
            <w2:header><w2:row><w2:column id="h1b" width="300" inputType="text" value="col (row1,3=RO)"></w2:column></w2:row></w2:header>
            <w2:gBody><w2:row><w2:column id="c1" width="300" dataList="c1" inputType="text"></w2:column></w2:row></w2:gBody>
        </w2:gridView>
    </body>
</html>
