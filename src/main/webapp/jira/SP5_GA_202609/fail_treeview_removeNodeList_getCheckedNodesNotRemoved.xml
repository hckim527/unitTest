<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] treeview removeNodeList(getCheckedNodes()) 미삭제" meta_author="InswaveSystems" meta_type="메인">
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_tree">
					<w2:columnInfo>
						<w2:column id="MENU_ID" name="MENU_ID" dataType="text"></w2:column>
						<w2:column id="MENU_NM" name="MENU_NM" dataType="text"></w2:column>
						<w2:column id="LEVEL_CNT" name="LEVEL_CNT" dataType="text"></w2:column>
						<w2:column id="CHK" name="CHK" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><MENU_ID><![CDATA[menu1]]></MENU_ID><MENU_NM><![CDATA[메뉴1]]></MENU_NM><LEVEL_CNT><![CDATA[1]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
						<w2:row><MENU_ID><![CDATA[menu1-1]]></MENU_ID><MENU_NM><![CDATA[메뉴1-1]]></MENU_NM><LEVEL_CNT><![CDATA[2]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
						<w2:row><MENU_ID><![CDATA[menu1-2]]></MENU_ID><MENU_NM><![CDATA[메뉴1-2]]></MENU_NM><LEVEL_CNT><![CDATA[2]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
						<w2:row><MENU_ID><![CDATA[menu2]]></MENU_ID><MENU_NM><![CDATA[메뉴2]]></MENU_NM><LEVEL_CNT><![CDATA[1]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
						<w2:row><MENU_ID><![CDATA[menu2-1]]></MENU_ID><MENU_NM><![CDATA[메뉴2-1]]></MENU_NM><LEVEL_CNT><![CDATA[2]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
						<w2:row><MENU_ID><![CDATA[menu3]]></MENU_ID><MENU_NM><![CDATA[메뉴3]]></MENU_NM><LEVEL_CNT><![CDATA[1]]></LEVEL_CNT><CHK><![CDATA[false]]></CHK></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue + "\n");
};



// 화면에 그려진 트리 노드 개수를 센다.
scwin.nodeCount = function () {
    var root = document.getElementById(target1.getID());
    return (root === null) ? 0 : root.querySelectorAll(".w2treeview_node").length;
};



// getCheckedNodes() 반환값을 그대로 removeNodeList() 에 전달한다.
scwin.btn_removeChecked_onclick = function () {
    var arr = target1.getCheckedNodes();
    scwin.setReturnValue("[getCheckedNodes] 삭제 전 노드 수 : " + scwin.nodeCount()
        + " / getCheckedNodes() 길이 : " + (arr === null || arr === undefined ? "null" : arr.length));
    target1.removeNodeList(arr);
    scwin.setReturnValue("[getCheckedNodes] 삭제 후 노드 수 : " + scwin.nodeCount());
};

// 대조군 : findNodeByValue() 로 얻은 노드를 배열로 전달한다.
scwin.btn_removeByNode_onclick = function () {
    var node = target1.findNodeByValue("menu1");
    scwin.setReturnValue("[findNodeByValue] 삭제 전 노드 수 : " + scwin.nodeCount());
    target1.removeNodeList([node]);
    scwin.setReturnValue("[findNodeByValue] 삭제 후 노드 수 : " + scwin.nodeCount());
};

// 트리를 최초 상태로 되돌린다.
scwin.btn_reset_onclick = function () {
    target1.refreshItemset();
    scwin.setReturnValue("초기화 후 노드 수 : " + scwin.nodeCount());
};
]]></script>
	</head>
	<body>
		<xf:group style="padding:10px;" id="grp_root">
			<w2:textbox style="font-size:16px;font-weight:bold;margin-bottom:16px;" id="" label="■ [FAIL] treeview removeNodeList() 에 getCheckedNodes() 반환값을 전달하면 노드가 하나도 삭제되지 않는다" escape="false"></w2:textbox>

			<w2:textbox style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;" id="" label="[전제]" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="1. treeview 를 renderType=&quot;table&quot;, showCheckbox=&quot;true&quot;, hierarchy=&quot;true&quot; 로 선언한다." escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="2. removeNodeList @param : &quot;&lt;Array:Y:-&gt; nodeArray 제거할 트리 아이템을 객체 배열로 설정합니다.&quot;" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="3. removeNodeList @spec : &quot;findNodeByIndex(), findNodeByValue(), getCheckedNodes(), getChildNodes(), getSelectedNode() 등의 메소드에서 반환되는 아이템 객체를 배열로 설정할 수 있습니다.&quot; (getCheckedNodes() 조합이 가이드에 명시되어 있다)" escape="false"></w2:textbox>

			<w2:textbox style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-top:16px;" id="" label="[확인 방법]" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="트리에서 체크박스를 2개 이상 체크한 뒤 '체크 노드 삭제' 를 클릭한다. 이어서 '초기화' 후 대조군 '노드 객체로 삭제' 를 클릭해 비교한다." escape="false"></w2:textbox>

			<w2:textbox style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-top:16px;" id="" label="[기대 / 실제]" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="· 기대 : 체크한 노드와 그 자식 노드가 제거되어 삭제 후 노드 수가 줄어든다." escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="· 실제 : getCheckedNodes() 가 체크한 개수와 동일한 길이를 반환하는데도 삭제 전/후 노드 수가 같다. 예외도 콘솔 오류도 발생하지 않아 호출한 쪽에서 실패를 알 수 없다." escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="· 대조군 : 동일한 removeNodeList() 에 findNodeByValue() 결과를 배열로 전달하면 정상적으로 삭제된다." escape="false"></w2:textbox>

			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ 대상 TreeView" escape="false"></w2:textbox>
			<xf:group id="grp_btn" style="margin-bottom:8px;">
				<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;margin-right:4px;" ev:onclick="scwin.btn_removeChecked_onclick" id="btn_removeChecked" label="체크 노드 삭제 (getCheckedNodes)"></w2:button>
				<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;margin-right:4px;" ev:onclick="scwin.btn_removeByNode_onclick" id="btn_removeByNode" label="노드 객체로 삭제 (대조군)"></w2:button>
				<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;" ev:onclick="scwin.btn_reset_onclick" id="btn_reset" label="초기화"></w2:button>
			</xf:group>
			<w2:treeview id="target1" style="position:relative;padding:5px;width:260px;height:240px;text-align:left;border:1px dotted #D3D3D3;"
				dataType="listed" renderType="table" hierarchy="true" showCheckbox="true" showTreeDepth="2" alwaysDraw="true" refreshCheckboxModel="true">
				<w2:itemset nodeset="data:dlt_tree">
					<w2:label ref="MENU_NM"></w2:label>
					<w2:value ref="MENU_ID"></w2:value>
					<w2:depth ref="LEVEL_CNT"></w2:depth>
					<w2:checkbox ref="CHK"></w2:checkbox>
				</w2:itemset>
			</w2:treeview>

			<xf:group id="grp_bottom" style="margin-top:16px;">
				<w2:textbox style="font-size:16px;font-weight:bold;margin-bottom:16px;" escape="false" id="" label="■ 리턴 값 확인"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear"></w2:button>
				</xf:group>
				<xf:textarea style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:120px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
