<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] MultiLine 그리드의 setRowClass 적용 범위가 6.0 과 다름" meta_author="InswaveSystems" meta_type="메인">
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind">
					<w2:columnInfo>
						<w2:column id="name" name="name" dataType="text"></w2:column>
						<w2:column id="age" name="age" dataType="text"></w2:column>
						<w2:column id="dept" name="dept" dataType="text"></w2:column>
						<w2:column id="memo" name="memo" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<name><![CDATA[John]]></name>
							<age><![CDATA[30]]></age>
							<dept><![CDATA[영업]]></dept>
							<memo><![CDATA[메모0]]></memo>
						</w2:row>
						<w2:row>
							<name><![CDATA[Jane]]></name>
							<age><![CDATA[28]]></age>
							<dept><![CDATA[기획]]></dept>
							<memo><![CDATA[메모1]]></memo>
						</w2:row>
						<w2:row>
							<name><![CDATA[Mike]]></name>
							<age><![CDATA[41]]></age>
							<dept><![CDATA[개발]]></dept>
							<memo><![CDATA[메모2]]></memo>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 =====
scwin.btn_clear_onclick = function (e) {
    $p.getComponentById("tbx_return").setValue("");
};

scwin.setReturnValue = function (strValue) {
    var objReturn = $p.getComponentById("tbx_return");
    objReturn.setValue(objReturn.getValue() + strValue);
    objReturn.setValue(objReturn.getValue() + "\n");
};

// ===== 결함 재현 (5.0 vs 6.0 동작 비교) =====
// Row 인덱스 1 (Jane) 에 CSS 클래스를 설정하고, 해당 Row 의 2 Line 중 몇 Line 에 반영되는지 센다
scwin.btn_setRowClass_onclick = function (e) {
    var objGrid = $p.getComponentById("target1");

    objGrid.setRowClass(1, "cRed");
    scwin.setReturnValue("=====setRowClass(1, 'cRed') 실행=====");
    scwin.setReturnValue("getRowClass(1) : " + objGrid.getRowClass(1));

    var arrTr = document.querySelectorAll("tr.cRed");
    scwin.setReturnValue("'cRed' 가 적용된 Line(tr) 수 : " + arrTr.length);

    var arrText = [];
    for (var i = 0; i < arrTr.length; i++) {
        arrText.push(arrTr[i].textContent);
    }
    scwin.setReturnValue("적용된 Line 표시값 : " + arrText.join(" | "));
};

]]></script>		
        <style type="text/css">.cRed, .cRed td, .cRed .w2grid_input { background-color:#ffe0e0 !important; color:red !important; }</style>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ [FAIL] Body 가 MultiLine 인 그리드에서 setRowClass 가 적용되는 Line 범위가 6.0 과 다르다" escape="false"></w2:textbox>

			<w2:textbox style="" id="" label="[전제] header 와 gBody 에 각각 Row 를 2 개 두어 한 레코드가 2 Line 으로 표시되는 MultiLine 그리드를 구성한다(Line1 = 이름·나이 / Line2 = 부서·memo). 데이터는 3 건이며 Row 인덱스 1 은 Jane(기획) 이다" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] (setRowClass(1) 적용) 버튼을 클릭하고, 결과창의 'cRed 가 적용된 Line(tr) 수' 와 그리드에서 배경색이 칠해진 Line 을 확인한다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[6.0 동작] 'cRed' 가 적용된 Line(tr) 수 : 2 (Jane·28 Line 과 기획·메모1 Line 모두 배경색이 칠해진다)" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[5.0 동작] 'cRed' 가 적용된 Line(tr) 수 : 1 (Jane·28 Line 에만 배경색이 칠해지고 기획·메모1 Line 은 칠해지지 않는다)" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[문제] 한 레코드를 여러 Line 으로 보여주는 화면에서 특정 레코드를 강조하면 그 레코드의 일부 Line 만 강조되고 나머지 Line 은 강조되지 않아, 사용자가 어디까지가 같은 레코드인지 구분할 수 없고 강조 표시가 잘못된 것으로 보인다. 또한 두 버전에서 강조 범위가 달라 동일 화면을 양쪽에서 운영하거나 버전을 옮길 때 화면 표시가 바뀐다" escape="false"></w2:textbox>

			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ 대상 컴포넌트 (gridView / MultiLine)" escape="false"></w2:textbox>
			<xf:group style="border: 1px solid #C4CDD5;border-radius: 8px;padding: 10px;" id="grp_target">
				<w2:gridView style="width:520px;height:280px;" id="target1" dataList="data:dlt_bind" checkAllType="false">
					<w2:caption style="" id="caption1" value="setRowClass MultiLine 테스트 그리드"></w2:caption>
					<w2:header style="" id="header1">
						<w2:row style="" id="hrow1">
							<w2:column width="160" style="" inputType="text" id="hcol_name" value="이름"></w2:column>
							<w2:column width="*" style="" inputType="text" id="hcol_age" value="나이"></w2:column>
						</w2:row>
						<w2:row style="" id="hrow2">
							<w2:column width="160" style="" inputType="text" id="hcol_dept" value="부서"></w2:column>
							<w2:column width="*" style="" inputType="text" id="hcol_memo" value="memo"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody style="" id="gBody1">
						<w2:row style="" id="brow1">
							<w2:column width="160" style="" inputType="text" id="name" dataList="name"></w2:column>
							<w2:column width="*" style="" inputType="text" id="age" dataList="age"></w2:column>
						</w2:row>
						<w2:row style="" id="brow2">
							<w2:column width="160" style="" inputType="text" id="dept" dataList="dept"></w2:column>
							<w2:column width="*" style="" inputType="text" id="memo" dataList="memo"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>

			<xf:group style="margin-top:10px;" id="grp_btn">
				<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;" ev:onclick="scwin.btn_setRowClass_onclick" id="btn_setRowClass" label="setRowClass(1) 적용"></w2:button>
			</xf:group>

			<xf:group id="grp_bottom" style="margin-top:14px;">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 160px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
