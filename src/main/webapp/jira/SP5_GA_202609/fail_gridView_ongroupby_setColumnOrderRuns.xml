					<w2:data use="true">
						<w2:row><region><![CDATA[서울]]></region><dept><![CDATA[개발]]></dept><grade><![CDATA[A]]></grade><score><![CDATA[10]]></score></w2:row>
						<w2:row><region><![CDATA[서울]]></region><dept><![CDATA[영업]]></dept><grade><![CDATA[B]]></grade><score><![CDATA[20]]></score></w2:row>
						<w2:row><region><![CDATA[부산]]></region><dept><![CDATA[기획]]></dept><grade><![CDATA[C]]></grade><score><![CDATA[30]]></score></w2:row>
