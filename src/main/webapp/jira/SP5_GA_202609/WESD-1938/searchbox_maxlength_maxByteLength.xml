<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

	scwin.onpageload = function() {

	};

	scwin.onpageunload = function() {

	};

	]]></script>
        <style type="text/css"><![CDATA[
.guide { display:block; margin:14px 10px 2px; color:#0a7; font-size:13px; }
.tcont { display:block; margin:6px 10px; }
]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">

        <!-- ① maxlength : 최대 글자수 -->
        <w2:textbox id="guideLen" class="guide" style=""
            label='① searchbox maxlength - 입력 가능한 최대 "글자수". maxlength 이상 입력 시 엔진이 자동으로 잘라냄'/>
        <w2:textbox id="lblLen" class="tcont" style="" label='maxlength="10" (최대 10글자, 초과 입력 차단)'/>
        <w2:searchbox id="searchMaxLen" maxlength="10" 
            style="height:21px;width:200px;margin:0 10px;" placeholder="최대 10글자"/>

        <!-- ② maxByteLength : 최대 Byte수 -->
        <w2:textbox id="guideByte" class="guide" style=""
            label='② searchbox maxByteLength - 입력 가능한 최대 "Byte 수". maxByteLength 이상 입력 시 엔진이 자동으로 잘라냄 (한글 등 멀티바이트 문자 기준)'/>
        <w2:textbox id="guideRepro" class="guide" style="color:#c00;border:1px solid #ddd;padding:8px;background:#fafafa;" escape="false"
            label='[재현방법]&lt;br/&gt;1. ② maxByteLength="10" searchbox 에 포커스&lt;br/&gt;2. 제한(10Byte)을 초과하도록 입력 (예: 한글 6자 이상 또는 영문 11자 이상)&lt;br/&gt;3. 입력값 우측의 reset(X) 버튼 확인 → [버그] reset(X) 버튼이 사라짐'/>
        <w2:textbox id="lblByte" class="tcont" style="" label='maxByteLength="10" (최대 10Byte, 한글 5자/영문 10자 등)'/>
        <w2:searchbox id="searchMaxByte" maxByteLength="10"
            style="height:21px;width:200px;margin:0 10px;" placeholder="최대 10Byte"/>

    </body>
</html>
