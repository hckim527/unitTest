<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" ev:onbeforecelldatachange="scwin.dataList1_onbeforecelldatachange"
            		ev:oncelldatachange="scwin.dataList1_oncelldatachange" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="MENU_ID" name="name1"></w2:column>
            			<w2:column dataType="text" id="MENU_NM" name="name2"></w2:column>
            			<w2:column dataType="text" id="LEVEL_CNT" name="name3"></w2:column>
            			<w2:column dataType="text" id="CHK" name="name4"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<MENU_ID><![CDATA[menu1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[1]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[2]]></LEVEL_CNT>
            				<CHK><![CDATA[n]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-1-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-1-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[3]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-1-2]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-1-2]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[3]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-2]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-2]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[2]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-2-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-2-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[3]]></LEVEL_CNT>
            				<CHK><![CDATA[1]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-2-1-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-2-1-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[4]]></LEVEL_CNT>
            				<CHK><![CDATA[n]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu1-2-1-2]]></MENU_ID>
            				<MENU_NM><![CDATA[menu1-2-1-2]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[4]]></LEVEL_CNT>
            				<CHK><![CDATA[1]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu2]]></MENU_ID>
            				<MENU_NM><![CDATA[menu2]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[1]]></LEVEL_CNT>
            				<CHK><![CDATA[n]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu2-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu2-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[2]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu3-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu3-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[2]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            			<w2:row>
            				<MENU_ID><![CDATA[menu4-1]]></MENU_ID>
            				<MENU_NM><![CDATA[menu4-1]]></MENU_NM>
            				<LEVEL_CNT><![CDATA[1]]></LEVEL_CNT>
            				<CHK><![CDATA[y]]></CHK>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	scwin.log("[init] renderType=virtual, hierarchy=true, 13 rows loaded.");
	scwin.log("       각 버튼 클릭 시 F12 콘솔에 'this.drawContents is not a function' 스택 출력됨");
};

scwin.log = function(msg) {
	var t = output;
	var cur = t.getValue() || "";
	var d = new Date();
	var stamp = ("0"+d.getHours()).slice(-2) + ":" + ("0"+d.getMinutes()).slice(-2) + ":" + ("0"+d.getSeconds()).slice(-2);
	t.setValue(cur + "[" + stamp + "] " + msg + "\n");
};

// ─── Case 1: 정상 시그니처 (노드 객체 배열) ───
scwin.btn_case1_onclick = function() {
	scwin.log("----- [Case1] removeNodeList([node]) : 정상 시그니처 -----");
	var node = treeview1.findNodeByValue("menu1");
	scwin.log("  arg = [findNodeByValue('menu1')] → 노드 객체 1개짜리 배열");
	try {
		treeview1.removeNodeList([node]);
		scwin.log("→ 리턴됨 (예외 캐치 못 함)");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
	scwin.log("  ※ virtual 렌더러는 this.drawContents 미정의 → for 루프 후 오류");
};

// ─── Case 2: getCheckedNodes() (DOM element 배열) ───
scwin.btn_case2_onclick = function() {
	scwin.log("----- [Case2] removeNodeList(getCheckedNodes()) -----");
	var arr = treeview1.getCheckedNodes();
	scwin.log("  arg = getCheckedNodes() → 길이 " + (arr ? arr.length : "null") + " (DOM element 배열)");
	try {
		treeview1.removeNodeList(arr);
		scwin.log("→ 리턴됨");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
	scwin.log("  ※ getCheckedNodes 는 element 리턴 → DOM만 지우고 drawContents 오류");
};

// ─── Case 3: 숫자 0 (배열 아님) ───
scwin.btn_case3_onclick = function() {
	scwin.log("----- [Case3] removeNodeList(0) : 원본 재현 -----");
	scwin.log("  arg = 0 → e.length === undefined → for 루프 스킵");
	try {
		treeview1.removeNodeList(0);
		scwin.log("→ 리턴됨");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
	scwin.log("  ※ 인자가 뭐든 마지막 drawContents 라인에서 오류");
};

// ─── Case 4: 배열 안 감싼 단일 노드 ───
scwin.btn_case4_onclick = function() {
	scwin.log("----- [Case4] removeNodeList(node) : 배열 미포장 -----");
	var node = treeview1.findNodeByValue("menu1");
	scwin.log("  arg = findNodeByValue('menu1') → 노드 객체 단일 (배열 아님)");
	try {
		treeview1.removeNodeList(node);
		scwin.log("→ 리턴됨");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
	scwin.log("  ※ 노드.length undefined → for 스킵 → drawContents 오류");
};

// ─── 대조군: removeNode(단일) 는 정상 ───
scwin.btn_ref_onclick = function() {
	scwin.log("----- [대조] removeNode(findNodeByValue('menu1')) -----");
	var node = treeview1.findNodeByValue("menu1");
	try {
		treeview1.removeNode(node);
		scwin.log("→ 정상 삭제 (removeNode 는 this.redraw(!0) 사용)");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
};

scwin.btn_reset_onclick = function() {
	scwin.log("----- [리셋] 데이터 원복 -----");
	try {
		dataList1.reset();
		treeview1.refreshItemset();
		scwin.log("→ dataList1.reset() + treeview1.refreshItemset()");
	} catch(e) {
		scwin.log("→ 예외: " + (e && e.message ? e.message : e));
	}
};

scwin.btn_clear_onclick = function() {
	output.setValue("");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group style="position:absolute;left:260px;top:5px;width:680px;">
    		<xf:trigger id="btn_case1" ev:onclick="scwin.btn_case1_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>Case1: removeNodeList([node])</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_case2" ev:onclick="scwin.btn_case2_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>Case2: removeNodeList(getCheckedNodes())</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_case3" ev:onclick="scwin.btn_case3_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>Case3: removeNodeList(0)</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_case4" ev:onclick="scwin.btn_case4_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>Case4: removeNodeList(node)</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_ref" ev:onclick="scwin.btn_ref_onclick" style="margin:0 4px 4px 0;background:#e8f5e9;">
    			<xf:label>대조: removeNode(node) 정상</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_reset" ev:onclick="scwin.btn_reset_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>리셋</xf:label>
    		</xf:trigger>
    		<xf:trigger id="btn_clear" ev:onclick="scwin.btn_clear_onclick" style="margin:0 4px 4px 0;">
    			<xf:label>로그 비우기</xf:label>
    		</xf:trigger>
    		<w2:textarea id="output" style="width:670px;height:360px;font-family:Consolas,monospace;font-size:12px;" readOnly="true"/>
    	</xf:group>
    	<w2:treeview
    						id="treeview1"
    						checkAllChildNodes="true"
    						dataType="listed"
    						lineShow=""
    						style="position:relative;padding:5px;width:200px;height:392px;text-align:left;margin-right:40px;border:1px dotted #D3D3D3;"
    						useDrag=""
    						tooltipGroupClass="false"
    						checkboxDisabledFalseValue=""
    						checkboxDisabledTrueValue=""
    						alwaysDraw="true"
    						accessibility=""
    						showTreeDepth="2"
    						showCheckbox="true"
    						renderType="virtual"
    						hierarchy="true"
    						refreshCheckboxModel="true">
    						<w2:itemset nodeset="data:dataList1">
    							<w2:label ref="MENU_NM"></w2:label>
    							<w2:value ref="MENU_ID"></w2:value>
    							<w2:depth ref="LEVEL_CNT"></w2:depth>
    							<w2:folder ref=""></w2:folder>
    							<w2:checkbox ref="CHK"></w2:checkbox>
    							<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    							<w2:image ref=""></w2:image>
    							<w2:iconImage ref=""></w2:iconImage>
    							<w2:selectedImage ref=""></w2:selectedImage>
    							<w2:expandedImage ref=""></w2:expandedImage>
    							<w2:leafImage ref=""></w2:leafImage>
    						</w2:itemset>
    					</w2:treeview>
    </body>
</html>
