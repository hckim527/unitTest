<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] Cell 단위 Drop 시 dragEndFunction 의 rowIndex 파라미터가 6.0 과 다름" meta_author="InswaveSystems" meta_type="메인">
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_cell1" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="c1" name="c1"></w2:column>
						<w2:column dataType="text" id="c2" name="c2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><c1><![CDATA[C-A-0]]></c1><c2><![CDATA[C-B-0]]></c2></w2:row>
						<w2:row><c1><![CDATA[C-A-1]]></c1><c2><![CDATA[C-B-1]]></c2></w2:row>
						<w2:row><c1><![CDATA[C-A-2]]></c1><c2><![CDATA[C-B-2]]></c2></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_cell2" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="d1" name="d1"></w2:column>
						<w2:column dataType="text" id="d2" name="d2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><d1><![CDATA[D-A-0]]></d1><d2><![CDATA[D-B-0]]></d2></w2:row>
						<w2:row><d1><![CDATA[D-A-1]]></d1><d2><![CDATA[D-B-1]]></d2></w2:row>
						<w2:row><d1><![CDATA[D-A-2]]></d1><d2><![CDATA[D-B-2]]></d2></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 =====
scwin.btn_clear_onclick = function (e) {
    $p.getComponentById("tbx_return").setValue("");
};

scwin.setReturnValue = function (strValue) {
    var objReturn = $p.getComponentById("tbx_return");
    objReturn.setValue(objReturn.getValue() + strValue);
    objReturn.setValue(objReturn.getValue() + "\n");
};

// ===== 결함 재현 (5.0 vs 6.0 동작 비교) =====

// Cell 단위로 데이터가 Drop 된 GridView(target2)에 설정한 사용자 정의 함수
scwin.cell_dragEndFunc = function (targetRowIndex, rowIndex, info) {
    scwin.setReturnValue("Cell Drop : targetRowIndex=" + targetRowIndex + " / rowIndex=" + rowIndex);
    return true;
};

]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ [FAIL] Cell 단위로 데이터를 Drop 했을때 dragEndFunction 사용자 함수의 두번째 파라미터(rowIndex) 가 6.0 과 다르다" escape="false"></w2:textbox>

			<w2:textbox style="" id="" label="[전제] dataDragDropCell=true 인 GridView 2 개를 나란히 둔다. 왼쪽 target1 은 Drag 소스, 오른쪽 target2 는 Drop 대상이며 target2 에만 dragEndFunction 사용자 함수를 설정한다. 이 함수는 첫번째 파라미터(targetRowIndex) 와 두번째 파라미터(rowIndex) 를 결과창에 한 줄로 출력하고 true 를 반환한다" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 왼쪽 target1 의 세번째 행 첫번째 Cell(C-A-2) 을 한 번 클릭해 선택한 뒤, 같은 Cell 을 마우스로 누른 채 오른쪽 target2 의 첫번째 행 첫번째 Cell(D-A-0) 위로 끌어다 놓는다. 결과창에 찍힌 rowIndex 값을 확인한다 (선택하지 않고 바로 끌면 Drag 가 시작되지 않는다)" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[6.0 동작] Cell Drop : targetRowIndex=0 / rowIndex=2 — Drag 를 시작한 Cell 의 Row 인덱스 숫자 2 가 전달된다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[5.0 동작] Cell Drop : targetRowIndex=0 / rowIndex=null — 어느 행의 Cell 을 끌어왔든 항상 null 이 전달된다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[영향] Cell 단위 Drop 을 받는 사용자 함수는 두번째 파라미터로 어느 행에서 끌어온 Cell 인지 판별해 원본 값을 지우거나 이동 이력을 남기고 반환값을 정한다. 5.0 에서는 그 값이 항상 null 이라 원본 행을 특정할 수 없어 해당 처리를 만들 수 없고, 같은 화면을 두 버전에서 운영하거나 버전을 옮기면 Cell 이동 결과가 달라진다" escape="false"></w2:textbox>

			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ Cell 단위 Drag&amp;Drop (좌 target1 : Drag 소스 / 우 target2 : Drop 대상, dragEndFunction 설정)" escape="false"></w2:textbox>
			<xf:group style="border: 1px solid #C4CDD5;border-radius: 8px;padding: 10px;display: flex;gap: 20px;align-items: flex-start;" id="grp_cell">
				<w2:gridView dataDragDropCell="true" dataList="data:dlt_cell1" id="target1" style="width:300px;height:160px;">
					<w2:caption id="caption1" style="" value="target1 (Cell Drag 소스)"></w2:caption>
					<w2:header id="header1" style="">
						<w2:row id="row1" style="">
							<w2:column id="hcol1" inputType="text" style="" value="col1" width="140"></w2:column>
							<w2:column id="hcol2" inputType="text" style="" value="col2" width="*"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1" style="">
						<w2:row id="row2" style="">
							<w2:column dataList="c1" id="c1" inputType="text" style="" width="140"></w2:column>
							<w2:column dataList="c2" id="c2" inputType="text" style="" width="*"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
				<w2:gridView dataDragDropCell="true" dataList="data:dlt_cell2" dragEndFunction="scwin.cell_dragEndFunc" id="target2" style="width:300px;height:160px;">
					<w2:caption id="caption2" style="" value="target2 (Cell Drop 대상)"></w2:caption>
					<w2:header id="header2" style="">
						<w2:row id="row3" style="">
							<w2:column id="hcol3" inputType="text" style="" value="col1" width="140"></w2:column>
							<w2:column id="hcol4" inputType="text" style="" value="col2" width="*"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody2" style="">
						<w2:row id="row4" style="">
							<w2:column dataList="d1" id="d1" inputType="text" style="" width="140"></w2:column>
							<w2:column dataList="d2" id="d2" inputType="text" style="" width="*"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>

			<xf:group id="grp_bottom" style="margin-top:14px;">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 140px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
