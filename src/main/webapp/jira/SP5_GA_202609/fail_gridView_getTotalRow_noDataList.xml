<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] DataList 미바인딩 그리드의 getTotalRow 동작이 6.0 과 다름" meta_author="InswaveSystems" meta_type="메인">
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map" />
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 =====
scwin.btn_clear_onclick = function (e) {
    $p.getComponentById("tbx_return").setValue("");
};

scwin.setReturnValue = function (strValue) {
    var objReturn = $p.getComponentById("tbx_return");
    objReturn.setValue(objReturn.getValue() + strValue);
    objReturn.setValue(objReturn.getValue() + "\n");
};

// ===== 결함 재현 (5.0 vs 6.0 동작 비교) =====
// 예외 처리 없이 호출 : 호출 전후로 줄을 남겨 호출 지점에서 중단되는지 확인
scwin.btn_getTotalRow_onclick = function (e) {
    scwin.setReturnValue("[호출 전] getTotalRow() 실행 직전");
    var rtn = $p.getComponentById("target1").getTotalRow();
    scwin.setReturnValue("[호출 후] getTotalRow() : " + rtn + " (typeof : " + (typeof rtn) + ")");
};

]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ [FAIL] DataList 가 바인딩되지 않은 그리드에서 getTotalRow() 를 호출했을 때의 동작이 6.0 과 다르다" escape="false"></w2:textbox>

			<w2:textbox style="" id="" label="[전제] dataList 속성을 설정하지 않은 그리드를 배치한다(데이터 미로드 상태)" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] (getTotalRow 호출) 버튼을 클릭하고 결과창에 '[호출 후]' 줄이 남는지 확인한다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[6.0 동작] '[호출 전]' 과 '[호출 후] getTotalRow() : undefined (typeof : undefined)' 두 줄이 모두 출력된다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[5.0 동작] '[호출 전]' 줄만 출력되고 '[호출 후]' 줄은 출력되지 않는다" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[문제] 데이터가 아직 로드되지 않은 시점에 건수를 확인하려 하면 호출 지점에서 스크립트가 끊겨 그 뒤의 처리(화면 초기화, 버튼 활성화, 안내 메시지 표시 등)가 전부 실행되지 않고 화면이 미완성 상태로 남는다. 또한 두 버전에서 결과가 달라 동일 화면을 양쪽에서 운영하거나 버전을 옮길 때 예외 처리 코드를 따로 넣어야 한다" escape="false"></w2:textbox>

			<w2:textbox style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;" id="" label="■ 대상 컴포넌트 (gridView / DataList 미바인딩)" escape="false"></w2:textbox>
			<xf:group style="border: 1px solid #C4CDD5;border-radius: 8px;padding: 10px;" id="grp_target">
				<w2:gridView style="width:400px;height:120px;" id="target1" checkAllType="false">
					<w2:caption style="" id="caption1" value="DataList 미바인딩 그리드"></w2:caption>
					<w2:header style="" id="header1">
						<w2:row style="" id="hrow1">
							<w2:column width="200" style="" inputType="text" id="hcol1" value="이름"></w2:column>
							<w2:column width="*" style="" inputType="text" id="hcol2" value="부서"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody style="" id="gBody1">
						<w2:row style="" id="brow1">
							<w2:column width="200" style="" inputType="text" id="col_name"></w2:column>
							<w2:column width="*" style="" inputType="text" id="col_dept"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>

			<xf:group style="margin-top:10px;" id="grp_btn">
				<w2:button style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;" ev:onclick="scwin.btn_getTotalRow_onclick" id="btn_getTotalRow" label="getTotalRow 호출"></w2:button>
			</xf:group>

			<xf:group id="grp_bottom" style="margin-top:14px;">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 160px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
