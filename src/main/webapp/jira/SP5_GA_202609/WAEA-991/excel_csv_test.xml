var scwin = {};

scwin.onpageload = function() {
};

scwin.btn_excelDown_onclick = function() {
    try {
        grd_test.advancedExcelDownload({
            fileName: "excel_test.xlsx",
            rowNumVisible: true
        });
    } catch(e) {
        exception.printStackTrace(e, null, this);
    }
};

scwin.btn_excelUp_onclick = function() {
    try {
        grd_test.advancedExcelUpload({
            headerExist: "1",
            append: true
        });
    } catch(e) {
        exception.printStackTrace(e, null, this);
    }
};

scwin.btn_csvDown_onclick = function() {
    try {
        grd_test.saveCSV({
            fileName: "csv_test.csv",
            headerExist: "1",
            encoding: "UTF-8"
        });
    } catch(e) {
        exception.printStackTrace(e, null, this);
    }
};

scwin.btn_csvUp_onclick = function() {
    try {
        grd_test.readCSV({
            headerExist: "1",
            encoding: "UTF-8",
            append: true
        });
    } catch(e) {
        exception.printStackTrace(e, null, this);
    }
};

scwin.btn_clear_onclick = function() {
    try {
        dlt_tbsvDrvOrd.removeAll();
        grd_test.refresh();
    } catch(e) {
        exception.printStackTrace(e, null, this);
    }
};
]]></script>
