<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView blockSelect Cell 에 setFocusedCell 호출 시 기존 선택 해제" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260930" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_data" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col2" name="col2"></w2:column>
						<w2:column dataType="text" id="col3" name="col3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[A1]]></col1>
							<col2><![CDATA[B1]]></col2>
							<col3><![CDATA[C1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[A2]]></col1>
							<col2><![CDATA[B2]]></col2>
							<col3><![CDATA[C2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[A3]]></col1>
							<col2><![CDATA[B3]]></col2>
							<col3><![CDATA[C3]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

// Cell 클릭 결과
scwin.grd_data_oncellclick = function (rowIndex, colIndex, colId) {
    scwin.setReturnValue("클릭 (" + rowIndex + ", " + colId + ") -> " + scwin.getFocusInfo());
};

// 차단 Cell 에 setFocusedCell 호출 결과
scwin.btn_setFocusedCell_onclick = function (e) {
    grd_data.setFocusedCell(0, 1);
    scwin.setReturnValue("setFocusedCell(0, 1) -> " + scwin.getFocusInfo());
};

// getAllFocusedIndex / 선택 표시 Cell
scwin.getFocusInfo = function () {
    let tds = grd_data.render.querySelectorAll("td.focusedTd[data-col_id]");
    let arr = [];
    for (let i = 0; i < tds.length; i++) {
        arr.push(tds[i].getAttribute("data-col_id") + "(" + tds[i].textContent + ")");
    }
    return "getAllFocusedIndex : " + JSON.stringify(grd_data.getAllFocusedIndex())
        + " / 선택 표시 Cell : " + (arr.length > 0 ? arr.join(" ") : "없음");
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] gridView Body Column 이 blockSelect=true 일 때, 선택된 Cell 이 있는 상태에서 차단 Cell 을 setFocusedCell 로 지정하면 클릭할 때와 달리 기존 선택이 모두 해제됨&lt;/b&gt;&lt;br/&gt;[확인 방법] A1 Cell 클릭 → B1 Cell 클릭 → setFocusedCell(0, 1) 버튼 클릭&lt;br/&gt;[기대] 클릭과 동일하게 setFocusedCell 도 무시되어 기존 선택(A1) 유지&lt;br/&gt;[실제] 클릭 시 A1 선택 유지, setFocusedCell 시 getAllFocusedIndex [] 로 선택 해제"></w2:textbox>

			<xf:group id="grp_btns" style="display:flex;gap:8px;margin-bottom:12px;">
				<w2:button ev:onclick="scwin.btn_setFocusedCell_onclick" id="btn_setFocusedCell" label="setFocusedCell(0, 1)" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<w2:gridView dataList="data:dlt_data" id="grd_data" style="width:380px;height:180px;" ev:oncellclick="scwin.grd_data_oncellclick">
				<w2:header id="header1" style="">
					<w2:row id="row1" style="">
						<w2:column id="column1" inputType="text" style="" value="col1" width="120"></w2:column>
						<w2:column id="column2" inputType="text" style="" value="col2 (blockSelect)" width="120"></w2:column>
						<w2:column id="column3" inputType="text" style="" value="col3" width="120"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1" style="">
					<w2:row id="row2" style="">
						<w2:column id="col1" inputType="text" style="" value="" width="120"></w2:column>
						<w2:column blockSelect="true" id="col2" inputType="text" style="" value="" width="120"></w2:column>
						<w2:column id="col3" inputType="text" style="" value="" width="120"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea id="tbx_return" style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:120px;"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
