<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] switch setReadOnly 자식 미전파" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260928" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    grp_normal.setReadOnly(true);
    sw_defect.setReadOnly(true);
};

scwin.btn_case_onclick = function (e) {
    var idx = sw_defect.getSelectedIndex() == 0 ? 1 : 0;
    sw_defect.setSelectedIndex(idx);
};

scwin.btn_check_onclick = function (e) {
    scwin.setReturnValue("[group] getReadOnly=" + grp_normal.getReadOnly()
        + " / input1.getReadOnly=" + ibx_normal1.getReadOnly()
        + " / input2.getReadOnly=" + ibx_normal2.getReadOnly());
    scwin.setReturnValue("[switch] getReadOnly=" + sw_defect.getReadOnly()
        + " / case1 input.getReadOnly=" + ibx_case1.getReadOnly()
        + " / case2 input.getReadOnly=" + ibx_case2.getReadOnly());
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"
				label="■ [FAIL] switch.setReadOnly(true) 가 case 안의 자식 컴포넌트에 전파되지 않음 (로드 시 group/switch 에 setReadOnly(true) 적용)&lt;br/&gt;[확인 방법] 각 input 에 입력(case 전환 후 case2 input 도 입력), 상태 확인 클릭&lt;br/&gt;[기대] group 과 동일하게 switch 의 case1/case2 input 도 입력이 차단됨&lt;br/&gt;[실제] switch 의 case1/case2 input 은 getReadOnly=false 로 입력이 가능함"></w2:textbox>

			<xf:group id="grp_btns" style="display:flex;gap:8px;margin-bottom:12px;">
				<w2:button ev:onclick="scwin.btn_check_onclick" id="btn_check" label="상태 확인" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<xf:group id="grp_compare" style="display:flex;gap:40px;align-items:flex-start;">
				<xf:group id="grp_normal_wrap" style="width:260px;">
					<w2:textbox id="lbl_normal" label="[정상] group" style="font-weight:bold;height:24px;"></w2:textbox>
					<xf:group id="grp_normal" style="border:1px solid #C4CDD5;padding:10px;width:220px;height:120px;">
						<xf:input id="ibx_normal1" style="width:180px;height:24px;display:block;margin-bottom:8px;"></xf:input>
						<xf:input id="ibx_normal2" style="width:180px;height:24px;display:block;"></xf:input>
					</xf:group>
				</xf:group>
				<xf:group id="grp_defect_wrap" style="width:260px;">
					<xf:group id="grp_defect_head" style="display:flex;align-items:center;gap:8px;height:24px;">
						<w2:textbox id="lbl_defect" label="[결함] switch" style="font-weight:bold;"></w2:textbox>
						<w2:button ev:onclick="scwin.btn_case_onclick" id="btn_case" label="case 전환" style="height:22px;"></w2:button>
					</xf:group>
					<xf:switch id="sw_defect" style="border:1px solid #C4CDD5;width:240px;height:140px;">
						<xf:case id="case1" selected="true" style="padding:10px;">
							<w2:textbox id="lbl_case1" label="case1" style="height:24px;"></w2:textbox>
							<xf:input id="ibx_case1" style="width:180px;height:24px;display:block;"></xf:input>
						</xf:case>
						<xf:case id="case2" style="padding:10px;">
							<w2:textbox id="lbl_case2" label="case2" style="height:24px;"></w2:textbox>
							<xf:input id="ibx_case2" style="width:180px;height:24px;display:block;"></xf:input>
						</xf:case>
					</xf:switch>
				</xf:group>
			</xf:group>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea id="tbx_return" style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:160px;"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
