<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView applyFormat=all date 입력값 깨짐" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260929" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_date" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="dateAll" name="dateAll"></w2:column>
						<w2:column dataType="text" id="dateDisplay" name="dateDisplay"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<dateAll><![CDATA[]]></dateAll>
							<dateDisplay><![CDATA[]]></dateDisplay>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

scwin.btn_check_onclick = function (e) {
    scwin.setReturnValue("[결함] applyFormat=all : 셀 표시값=" + grd_date.getCellDisplayData(0, "dateAll")
        + " / getCellData=" + grd_date.getCellData(0, "dateAll"));
    scwin.setReturnValue("[정상] applyFormat=display : 셀 표시값=" + grd_date.getCellDisplayData(0, "dateDisplay")
        + " / getCellData=" + grd_date.getCellData(0, "dateDisplay"));
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] gridView column 에 inputType=text + dataType=date + applyFormat=all 설정 시 키보드로 입력한 날짜가 깨진 값으로 DataList 에 저장됨 (두 Column 모두 displayFormat=yyyy-MM-dd)&lt;/b&gt;&lt;br/&gt;[확인 방법] 각 Column 셀 더블클릭 후 20250929 입력, 셀 밖 클릭, 셀 값 확인 클릭&lt;br/&gt;[기대] applyFormat=display Column 과 동일하게 셀 표시값 2025-09-29 / getCellData 20250929&lt;br/&gt;[실제] applyFormat=all Column 은 입력 중 2025--0 > 2025------ 로 깨지고 getCellData 에 2025------ 가 저장됨"></w2:textbox>

			<xf:group id="grp_btns" style="display:flex;gap:8px;margin-bottom:12px;">
				<w2:button ev:onclick="scwin.btn_check_onclick" id="btn_check" label="셀 값 확인" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<w2:gridView dataList="data:dlt_date" id="grd_date" style="width:520px;height:80px;">
				<w2:header id="header1" style="">
					<w2:row id="row1" style="">
						<w2:column id="column1" inputType="text" style="" value="[결함] applyFormat=all" width="250"></w2:column>
						<w2:column id="column2" inputType="text" style="" value="[정상] applyFormat=display" width="250"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1" style="">
					<w2:row id="row2" style="">
						<w2:column applyFormat="all" dataType="date" displayFormat="yyyy-MM-dd" id="dateAll" inputType="text" style="" value="" width="250"></w2:column>
						<w2:column applyFormat="display" dataType="date" displayFormat="yyyy-MM-dd" id="dateDisplay" inputType="text" style="" value="" width="250"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea id="tbx_return" style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:120px;"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
