<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView setColumnChooseOption Value 설정 후 선택 안내 표시값 빈 값" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260929" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_region" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="regionMethod" name="regionMethod"></w2:column>
						<w2:column dataType="text" id="regionAttr" name="regionAttr"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<regionMethod><![CDATA[S]]></regionMethod>
							<regionAttr><![CDATA[S]]></regionAttr>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    grd_region.setColumnChooseOption("regionMethod", "none", "-선택-");
};

scwin.btn_check_onclick = function (e) {
    scwin.setReturnValue("[결함] setColumnChooseOption : 셀 표시값=" + scwin.getCellText("regionMethod")
        + " / getCellData=" + grd_region.getCellData(0, "regionMethod"));
    scwin.setReturnValue("[정상] chooseOptionValue 속성 : 셀 표시값=" + scwin.getCellText("regionAttr")
        + " / getCellData=" + grd_region.getCellData(0, "regionAttr"));
};

// 화면에 표시된 셀 텍스트
scwin.getCellText = function (colId) {
    let td = grd_region.render.querySelector("td[data-col_id='" + colId + "']");
    return td ? td.textContent : "";
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] gridView select Column 에 setColumnChooseOption(Column, &quot;none&quot;, &quot;-선택-&quot;) 으로 선택 안내 아이템의 Value 를 설정한 뒤 선택 안내 아이템을 선택하면 셀 표시값이 빈 값으로 표시됨 (두 Column 모두 chooseOption=true, 아이템 서울(S) / 부산(B))&lt;/b&gt;&lt;br/&gt;[확인 방법] 각 Column 셀 더블클릭 후 목록에서 -선택- 클릭, 셀 밖 클릭, 셀 값 확인 클릭&lt;br/&gt;[기대] chooseOptionValue 속성 Column 과 동일하게 셀 표시값 -선택- / getCellData none&lt;br/&gt;[실제] setColumnChooseOption Column 은 getCellData 는 none 이지만 셀 표시값이 빈 값"></w2:textbox>

			<xf:group id="grp_btns" style="display:flex;gap:8px;margin-bottom:12px;">
				<w2:button ev:onclick="scwin.btn_check_onclick" id="btn_check" label="셀 값 확인" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<w2:gridView dataList="data:dlt_region" id="grd_region" style="width:620px;height:80px;">
				<w2:header id="header1" style="">
					<w2:row id="row1" style="">
						<w2:column id="column1" inputType="text" style="" value="[결함] setColumnChooseOption" width="300"></w2:column>
						<w2:column id="column2" inputType="text" style="" value="[정상] chooseOptionValue 속성" width="300"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1" style="">
					<w2:row id="row2" style="">
						<w2:column chooseOption="true" id="regionMethod" inputType="select" style="" value="" width="300">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[서울]]></w2:label>
									<w2:value><![CDATA[S]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[부산]]></w2:label>
									<w2:value><![CDATA[B]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:column>
						<w2:column chooseOption="true" chooseOptionValue="none" id="regionAttr" inputType="select" style="" value="" width="300">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[서울]]></w2:label>
									<w2:value><![CDATA[S]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[부산]]></w2:label>
									<w2:value><![CDATA[B]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea id="tbx_return" style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:120px;"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
