<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView advancedExcelDownload options.useEuroLocale 을 true 로 설정하면 금액 Cell 이 , 와 . 이 서로 바뀐 값이 아니라 값 자체가 손실된 채로 기록되는 결함" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260831" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="dept" name="부서" dataType="text"></w2:column>
						<w2:column id="name" name="담당자" dataType="text"></w2:column>
						<w2:column id="amount" name="매출액" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><dept><![CDATA[영업1팀]]></dept><name><![CDATA[홍길동]]></name><amount><![CDATA[1234567.89]]></amount></w2:row>
						<w2:row><dept><![CDATA[영업2팀]]></dept><name><![CDATA[김서연]]></name><amount><![CDATA[2345678.90]]></amount></w2:row>
						<w2:row><dept><![CDATA[기획팀]]></dept><name><![CDATA[이준호]]></name><amount><![CDATA[3456789.01]]></amount></w2:row>
						<w2:row><dept><![CDATA[개발팀]]></dept><name><![CDATA[박지훈]]></name><amount><![CDATA[8002.35]]></amount></w2:row>
						<w2:row><dept><![CDATA[지원팀]]></dept><name><![CDATA[최민서]]></name><amount><![CDATA[1200.51]]></amount></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// https://inswave01.atlassian.net/browse/WAEA-1207
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// useEuroLocale 미적용 (정상 비교군)
scwin.btn_euro_false_onclick = function () {
    target1.advancedExcelDownload({
        "fileName" : "euro_false",
        "extension" : "xlsx",
        "useEuroLocale" : "false"
    });

    scwin.setReturnValue("호출 : useEuroLocale=\"false\"");
};



// useEuroLocale 적용 (결함 발생)
scwin.btn_euro_true_onclick = function () {
    target1.advancedExcelDownload({
        "fileName" : "euro_true",
        "extension" : "xlsx",
        "useEuroLocale" : "true"
    });

    scwin.setReturnValue("호출 : useEuroLocale=\"true\"");
};]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.useEuroLocale 을 &quot;true&quot; 로 설정하면 금액 Cell 이 , 와 . 이 서로 바뀐 값이 아니라 값 자체가 손실된 채로 기록되는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.useEuroLocale &amp;lt;String:N:&quot;false&quot;&amp;gt; : &quot;유로 형식(,와 . 을 서로 바꿈)으로 다운로드할지 여부를 설정합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. 대상 GridView 의 매출액 Column 은 dataType=&quot;number&quot; , displayFormat=&quot;#,##0.00&quot; 이므로 화면에 , 와 . 이 모두 표시된다 (1,234,567.89 / 2,345,678.90 / 3,456,789.01 / 8,002.35 / 1,200.51)" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. Footer 의 합계 Cell 은 inputType=&quot;expression&quot; sum('amount') 이며 동일한 displayFormat 으로 7,046,238.66 이 표시된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 두 버튼을 각각 클릭해 파일을 내려받아 엑셀로 연 뒤 금액 Cell 을 비교한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] useEuroLocale=&quot;true&quot; 면 금액 Cell 이 1.234.567,89 처럼 , 와 . 이 서로 바뀐 값으로 기록된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[실제] 1.234 가 기록되어 엑셀에 1.23 으로 표시되며 값이 손실된다 (useEuroLocale=&quot;false&quot; 는 1,234,567.89 로 정상)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (advancedExcelDownload 호출 대상)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_bind" checkAllType="false" style="width:660px;height:280px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="180" style="" inputType="text" id="hcol1" value="부서"></w2:column>
						<w2:column width="180" style="" inputType="text" id="hcol2" value="담당자"></w2:column>
						<w2:column width="*" style="" inputType="text" id="hcol3" value="매출액"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="180" style="" inputType="text" id="dept" dataList="dept"></w2:column>
						<w2:column width="180" style="" inputType="text" id="name" dataList="name"></w2:column>
						<w2:column width="*" style="" inputType="text" dataType="number" displayFormat="#,##0.00" id="amount" dataList="amount"></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:footer style="" id="footer1">
					<w2:row style="" id="frow1">
						<w2:column width="180" style="" inputType="text" id="fcol1" value="합계"></w2:column>
						<w2:column width="180" style="" inputType="text" id="fcol2" value=""></w2:column>
						<w2:column width="*" style="" inputType="expression" dataType="number" displayFormat="#,##0.00" id="fcol3" expression="sum('amount')"></w2:column>
					</w2:row>
				</w2:footer>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;width:fit-content;max-width:100%;" id="grp_btn_case">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_euro_false_onclick" id="btn_euro_false" label="다운로드 (useEuroLocale=false)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;"></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_euro_true_onclick" id="btn_euro_true" label="다운로드 (useEuroLocale=true)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-top:6px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
