		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// https://inswave01.atlassian.net/browse/WAEA-1209
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
    tbx_return.setValue("");
};



// subtotalWordwrap = false / footerWordwrap = false
scwin.btn_false_onclick = function (e) {
    target1.advancedExcelDownload({
        "fileName" : "fail_false",
        "extension" : "xlsx",
        "useSubTotal" : "true",
        "subtotalWordwrap" : false,
        "footerWordwrap" : false
    });

    scwin.setReturnValue("호출 : subtotalWordwrap=false / footerWordwrap=false");
};



// subtotalWordwrap = true / footerWordwrap = true
scwin.btn_true_onclick = function (e) {
    target1.advancedExcelDownload({
        "fileName" : "fail_true",
        "extension" : "xlsx",
        "useSubTotal" : "true",
        "subtotalWordwrap" : true,
        "footerWordwrap" : true
    });

    scwin.setReturnValue("호출 : subtotalWordwrap=true / footerWordwrap=true");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.subtotalWordwrap / options.footerWordwrap 을 false 로 설정해도 SubTotal 및 Footer 행에 Excel 의 &quot;자동 줄바꿈&quot; 서식이 항상 적용되는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.subtotalWordwrap &amp;lt;Boolean:N:false&amp;gt; : &quot;GridView 의 SubTotal 영역 데이터에 Excel 의 자동 줄바꿈 서식을 적용할지 true/false 로 설정합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. API 가이드 options.footerWordwrap &amp;lt;Boolean:N:false&amp;gt; : &quot;GridView 의 Footer 영역 데이터에 Excel 의 자동 줄바꿈 서식을 적용할지 true/false 로 설정합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 대상 GridView 는 분류가 사무기기 3 Row , 전산장비 3 Row 이므로 SubTotal 이 2 행 생성되고 그 아래 Footer 가 1 행 생성된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. 비고 Column 은 Body / SubTotal / Footer 각 영역에 셀 폭보다 긴 텍스트를 두어 자동 줄바꿈 적용 여부가 눈으로 구분된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="5. 두 버튼 모두 useSubTotal 을 &quot;true&quot; 로 고정 전달하는데 이는 SubTotal 행을 다운로드 파일에 포함시키기 위한 값이며 검증 대상이 아니다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 각 버튼을 클릭하여 파일을 내려받은 뒤 엑셀에서 소계 행과 합계 행의 셀을 선택하고 [셀 서식] &amp;gt; [맞춤] 의 &quot;자동 줄바꿈&quot; 체크 상태를 확인한다 (파일을 압축 해제하여 xl/styles.xml 의 해당 셀 서식에 wrapText 가 있는지로도 확인할 수 있다)" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] subtotalWordwrap 과 footerWordwrap 을 false 로 설정하면 다운로드된 파일의 소계 행과 합계 행에 자동 줄바꿈이 적용되지 않아야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[실제] subtotalWordwrap 과 footerWordwrap 을 false 로 설정하든 true 로 설정하든 다운로드된 파일의 소계 행과 합계 행에 자동 줄바꿈이 항상 적용되고 두 파일의 내용이 완전히 동일함" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (advancedExcelDownload 호출 대상)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_bind" checkAllType="false" style="width:760px;height:360px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="110" style="" inputType="text" id="hcol1" value="자산번호"></w2:column>
						<w2:column width="100" style="" inputType="text" id="hcol2" value="분류"></w2:column>
						<w2:column width="150" style="" inputType="text" id="hcol3" value="품명"></w2:column>
						<w2:column width="70" style="" inputType="text" id="hcol4" value="수량"></w2:column>
						<w2:column width="*" style="" inputType="text" id="hcol5" value="비고"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="110" style="" inputType="text" id="assetNo" dataList="assetNo"></w2:column>
						<w2:column width="100" style="" inputType="text" id="category" dataList="category"></w2:column>
						<w2:column width="150" style="" inputType="text" id="assetName" dataList="assetName"></w2:column>
						<w2:column width="70" style="" inputType="text" dataType="number" displayFormat="#,##0" id="qty" dataList="qty"></w2:column>
						<w2:column width="*" style="" inputType="text" id="note" dataList="note"></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:footer style="" id="footer1">
					<w2:row style="" id="frow1">
						<w2:column width="110" style="" inputType="text" id="fcol1" value="합계"></w2:column>
						<w2:column width="100" style="" inputType="text" id="fcol2" value=""></w2:column>
						<w2:column width="150" style="" inputType="text" id="fcol3" value=""></w2:column>
						<w2:column width="70" style="" inputType="expression" dataType="number" displayFormat="#,##0" id="fcol4" expression="sum('qty')"></w2:column>
						<w2:column width="*" style="" inputType="text" id="fcol5" value="전체 자산 수량 합계이며 분기 마감 시점의 실사 결과와 대조하여 차이가 있으면 자산관리 담당자에게 통보합니다"></w2:column>
					</w2:row>
				</w2:footer>
				<w2:subTotal style="" id="subTotal1" targetColumnID="category">
					<w2:row style="" id="srow1">
						<w2:column width="110" style="" inputType="text" id="scol1" value="소계"></w2:column>
						<w2:column width="100" style="" inputType="text" id="scol2" value=""></w2:column>
						<w2:column width="150" style="" inputType="text" id="scol3" value=""></w2:column>
						<w2:column width="70" style="" inputType="expression" dataType="number" displayFormat="#,##0" id="scol4" expression="sum('qty')"></w2:column>
						<w2:column width="*" style="" inputType="text" id="scol5" value="분류별 보유 수량 소계이며 대여 중인 자산과 폐기 예정 자산을 모두 포함한 수량입니다"></w2:column>
					</w2:row>
				</w2:subTotal>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;width:fit-content;max-width:100%;" id="grp_btn_case">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_false_onclick" id="btn_false" label="다운로드 (subtotalWordwrap=false / footerWordwrap=false)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;"></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_true_onclick" id="btn_true" label="다운로드 (subtotalWordwrap=true / footerWordwrap=true)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-top:6px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
