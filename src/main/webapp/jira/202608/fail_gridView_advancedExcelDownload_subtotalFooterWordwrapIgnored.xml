	<head meta_screenName="[FAIL] gridView advancedExcelDownload options.subtotalWordwrap / options.footerWordwrap 을 false 로 설정해도 SubTotal 및 Footer 행에 Excel 의 자동 줄바꿈 서식이 항상 적용되는 결함" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260901" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="assetNo" name="자산번호" dataType="text"></w2:column>
						<w2:column id="category" name="분류" dataType="text"></w2:column>
						<w2:column id="assetName" name="품명" dataType="text"></w2:column>
						<w2:column id="qty" name="수량" dataType="number"></w2:column>
						<w2:column id="note" name="비고" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><assetNo><![CDATA[AST-1001]]></assetNo><category><![CDATA[사무기기]]></category><assetName><![CDATA[레이저 복합기]]></assetName><qty><![CDATA[3]]></qty><note><![CDATA[3층 문서실 배치 장비로 토너 잔량 확인 후 분기별 정기 점검을 진행합니다]]></note></w2:row>
						<w2:row><assetNo><![CDATA[AST-1002]]></assetNo><category><![CDATA[사무기기]]></category><assetName><![CDATA[대형 문서 세단기]]></assetName><qty><![CDATA[2]]></qty><note><![CDATA[보안 문서 폐기 전용이며 사용 후 잔여물 수거함을 반드시 비워 주십시오]]></note></w2:row>
						<w2:row><assetNo><![CDATA[AST-1003]]></assetNo><category><![CDATA[사무기기]]></category><assetName><![CDATA[무선 프레젠터]]></assetName><qty><![CDATA[6]]></qty><note><![CDATA[회의실 공용 비품]]></note></w2:row>
						<w2:row><assetNo><![CDATA[AST-2001]]></assetNo><category><![CDATA[전산장비]]></category><assetName><![CDATA[노트북 거치대]]></assetName><qty><![CDATA[12]]></qty><note><![CDATA[신규 입사자 지급분 포함 수량이며 반납 시 파손 여부를 자산관리 담당자가 확인합니다]]></note></w2:row>
						<w2:row><assetNo><![CDATA[AST-2002]]></assetNo><category><![CDATA[전산장비]]></category><assetName><![CDATA[27인치 모니터]]></assetName><qty><![CDATA[8]]></qty><note><![CDATA[듀얼 구성 요청 부서 우선 배정]]></note></w2:row>
						<w2:row><assetNo><![CDATA[AST-2003]]></assetNo><category><![CDATA[전산장비]]></category><assetName><![CDATA[외장 백업 스토리지]]></assetName><qty><![CDATA[4]]></qty><note><![CDATA[반출 시 정보보호팀 사전 승인이 필요하고 암호화 설정 상태를 함께 기록해야 합니다]]></note></w2:row>
