    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
	
	gridView1.setHeaderSortImage("column11", 1);
	dataList1.sort('col1', 0);
		
};

scwin.trigger1_onclick = function(e) {
    var options = {
        fileName : "saveCSV.csv",
        type : "1", 
        delim : "\u200B", //\uFEFF, \u200B
        removeQuotation : "0" 
    };
	
    gridView1.saveCSV(options);
};

scwin.trigger2_onclick = function(e) {
    
    var options = {};
    options.type = '1';
    options.fileName = '테스트엑셀.xlsx';
    options.useStyle = true;
    options.useClass = true;

    gridView1.advancedExcelDownload(options);
};


scwin.trigger3_onclick = function (e) {
var options = {
    status:"C",
    delim: "?",
    header: "1",
    append: "0",
    trim: "0",
    status: "R",
}; 

        gridView2.readCSV(options);
};
]]></script>
