<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView inputType checkcombobox Column 에 여러 값이 저장되어 있으면 화면에 아무것도 표시되지 않는 결함" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260828" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_grid" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="name" name="Name" dataType="text"></w2:column>
						<w2:column id="skill" name="Skill" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<name><![CDATA[Row 0 (2 개 값)]]></name>
							<skill><![CDATA[S1,S2]]></skill>
						</w2:row>
						<w2:row>
							<name><![CDATA[Row 1 (1 개 값)]]></name>
							<skill><![CDATA[S2]]></skill>
						</w2:row>
						<w2:row>
							<name><![CDATA[Row 2 (2 개 값)]]></name>
							<skill><![CDATA[S1,S3]]></skill>
						</w2:row>
						<w2:row>
							<name><![CDATA[Row 3 (1 개 값)]]></name>
							<skill><![CDATA[S3]]></skill>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// 저장값과 화면 표시값을 행별로 비교하여 출력
scwin.btn_check_onclick = function () {
    for (var i = 0; i < 4; i++) {
        var strSaved = target1.getCellData(i, 1);
        var objCell = document.querySelector("td[id*='target1_cell_" + i + "_1']");
        var strShown = (objCell === null) ? "(셀 없음)" : objCell.textContent.trim();

        scwin.setReturnValue("Row" + i + "  저장값 : " + strSaved + "  ,  화면 표시값 : " + (strShown === "" ? "(표시 없음)" : strShown));
    }
    scwin.setReturnValue("");
};

]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView — inputType=&quot;checkcombobox&quot; Column 에 여러 값이 저장되어 있으면 화면에 아무것도 표시되지 않는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. 대상 GridView 의 Skill Column 은 inputType=&quot;checkcombobox&quot; 이며 여러 항목을 동시에 선택할 수 있는 Column 이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. Skill Column 의 선택 항목은 Value S1 / S2 / S3 에 Label 개발 / 디자인 / 기획 이 각각 대응한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 바인딩된 데이터는 Row0 &quot;S1,S2&quot; (2 개) , Row1 &quot;S2&quot; (1 개) , Row2 &quot;S1,S3&quot; (2 개) , Row3 &quot;S3&quot; (1 개) 로 여러 값과 단일 값이 섞여 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. 여러 값은 콤마(,) 로 구분하여 저장한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 화면의 Skill 열을 보고 , 아래 버튼을 클릭하여 출력되는 행별 저장값과 화면 표시값을 비교" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] 저장된 값에 대응하는 Label 이 화면에 표시되어야 하며 , 여러 값이 저장된 행도 해당 Label 들이 표시되어야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[실제] 단일 값이 저장된 행은 Label 이 표시되지만 , 여러 값이 저장된 행은 화면에 아무것도 표시되지 않음" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Skill = inputType &quot;checkcombobox&quot;)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_grid" checkAllType="false" style="width:480px;height:230px;">
				<w2:header style="" id="header_d">
					<w2:row style="" id="hrow_d">
						<w2:column width="200" inputType="text" id="hcol_d1" value="Name"></w2:column>
						<w2:column width="*" inputType="text" id="hcol_d2" value="Skill"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_d">
					<w2:row style="" id="brow_d">
						<w2:column width="200" inputType="text" dataType="text" id="name" dataList="name" value=""></w2:column>
						<w2:column width="*" inputType="checkcombobox" id="skill" dataList="skill">
							<w2:choices>
								<w2:item><w2:label>개발</w2:label><w2:value>S1</w2:value></w2:item>
								<w2:item><w2:label>디자인</w2:label><w2:value>S2</w2:value></w2:item>
								<w2:item><w2:label>기획</w2:label><w2:value>S3</w2:value></w2:item>
							</w2:choices>
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;position:relative;z-index:6100;width:fit-content;max-width:100%;background:#ffffff;" id="grp_btn_run">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_check_onclick" id="btn_check" label="행별 저장값 / 화면 표시값 확인" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-bottom:4px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="position:relative;z-index:5000;background:#ffffff;">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 180px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
