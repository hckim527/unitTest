<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="col1" name="name1" dataType="text"></w2:column>
        				<w2:column id="col2" name="name2" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [
        {col1:"test1_1",col2:"test1_2"},
        {col1:"test2_1",col2:"test2_2               "},
    ];
    // dataList1.setJSON(jsonData);
};

scwin.trigger3_onclick = function(e) {
    gridView1.saveCSV({fileName:"download_trim.csv",trim:"1"})
};

scwin.trigger3_1_onclick = function(e) {
    var options = {
                fileName:"saveCSV.csv",
                delim:";",
                header: "1",
                hidden: "0",
                checkButton: "1",
                removeQuotation: "1",
                type:"0", 
                saveList:["col1","col2"]
    };

    gridView1.saveCSV(options)
};

scwin.trigger4_onclick = function(e) {
    gridView1.saveCSV({fileName:"download_notrim.csv"})
};

scwin.trigger5_onclick = function(e) {
    gridView1.saveCSV({fileName:"download_notrim.csv",trim:"0"})
};

scwin.trigger6_onclick = function(e) {
    gridView1.readCSV({});
};

scwin.trigger7_onclick = function(e) {
    gridView1.readCSV({trim:"1"});
};
scwin.trigger69_onclick = function(e) {
    gridView1.readCSV({wframe : true});
};
scwin.trigger70_onclick = function(e) {
    gridView1.readCSV({trim:"1",wframe : true});
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:trigger type="button" id="trigger3" style="position:relative;width:96px;height:23px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[saveCSV trim]]></xf:label>
    	</xf:trigger>
        <xf:trigger type="button" id="trigger3_1" style="position:relative;width:96px;height:23px;" ev:onclick="scwin.trigger3_1_onclick">
            <xf:label><![CDATA[saveCSV trim options]]></xf:label>
        </xf:trigger>        
    	<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position:relative;width:124px;height:23px;" type="button">
    		<xf:label><![CDATA[saveCSV no trim]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger5_onclick" id="trigger5" style="position:relative;width:124px;height:23px;" type="button">
    		<xf:label><![CDATA[saveCSV no trim]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger6_onclick" id="trigger6" style="position:relative;width:124px;height:23px;" type="button">
    		<xf:label><![CDATA[readCSV]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger7_onclick" id="trigger7" style="position:relative;width:124px;height:23px;" type="button">
    		<xf:label><![CDATA[readCSV trim]]></xf:label>
    	</xf:trigger>
        <xf:trigger ev:onclick="scwin.trigger69_onclick" id="trigger69" style="position:relative;width:250px;height:23px;" type="button">
            <xf:label><![CDATA[readCSV wframe]]></xf:label>
        </xf:trigger>
        <xf:trigger ev:onclick="scwin.trigger70_onclick" id="trigger70" style="position:relative;width:250px;height:23px;" type="button">
            <xf:label><![CDATA[readCSV trim wframe]]></xf:label>
        </xf:trigger>
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="position: relative;width: 500px;height: 150px;"
    		dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column4" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>

    </body>
</html>
