	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.useHeaderDataFormat 을 &quot;true&quot; 로 설정하면 Header Column 뿐 아니라 Body Column 의 표시 형식까지 바뀌고, dataType=&quot;bigDecimal&quot; 인 Header Cell 의 텍스트가 사라지는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.useHeaderDataFormat &amp;lt;String:N:&quot;false&quot;&amp;gt; : &quot;Header Column 의 dataType 속성값에 맞게 Excel 의 표시 형식을 적용할지 여부를 설정합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. 대상 GridView 의 Body Column dataType 은 순서대로 text / text / number(displayFormat=&quot;#,##0&quot;) / bigDecimal / text 이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 대상 GridView 의 Header Column dataType 은 순서대로 text / text / number / bigDecimal / text 이며 Header 는 1줄이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. &quot;다운로드 (useHeaderDataFormat=true)&quot; 버튼은 useHeaderDataFormat 만 전달하고 useDataFormat 은 전달하지 않는다. &quot;다운로드 (useDataFormat=true)&quot; 버튼은 useDataFormat 만 전달한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 버튼 3개를 각각 클릭해 파일을 내려받은 뒤, Excel 에서 Header 행과 Body 행의 Cell 을 선택해 [셀 서식] 의 표시 형식(일반 / 텍스트 / 숫자)과 Header 행의 텍스트를 확인한다. 파일을 압축 해제해 xl/styles.xml 의 표시 형식으로도 확인할 수 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] useHeaderDataFormat=&quot;true&quot; 는 Header Column 의 표시 형식만 바꾸고 Body Column 의 표시 형식은 옵션 전체 생략 시와 동일해야 하며, Header Cell 의 텍스트는 그대로 유지되어야 한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[실제] (가) useDataFormat 을 전달하지 않았는데도 Body Column 의 표시 형식이 useDataFormat=&quot;true&quot; 로 받은 파일과 동일하게 바뀐다 (text Column 이 일반에서 텍스트로 바뀜) (나) dataType=&quot;bigDecimal&quot; 인 Header Cell 의 텍스트(&quot;재고금액&quot;)가 사라져 빈 Cell 이 된다 (dataType=&quot;number&quot; 인 &quot;재고수량&quot; Header 는 유지)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (advancedExcelDownload 호출 대상)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_bind" checkAllType="false" style="width:760px;height:220px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="140" style="" inputType="text" dataType="text" id="hcol1" value="자재 구분"></w2:column>
						<w2:column width="180" style="" inputType="text" dataType="text" id="hcol2" value="품목명"></w2:column>
						<w2:column width="140" style="" inputType="text" dataType="number" id="hcol3" value="재고수량"></w2:column>
						<w2:column width="160" style="" inputType="text" dataType="bigDecimal" id="hcol4" value="재고금액"></w2:column>
						<w2:column width="*" style="" inputType="text" dataType="text" id="hcol5" value="담당코드"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="140" style="" inputType="text" dataType="text" id="matGroup" dataList="matGroup"></w2:column>
						<w2:column width="180" style="" inputType="text" dataType="text" id="matName" dataList="matName"></w2:column>
						<w2:column width="140" style="" inputType="text" dataType="number" displayFormat="#,##0" id="stockQty" dataList="stockQty"></w2:column>
						<w2:column width="160" style="" inputType="text" dataType="bigDecimal" id="stockAmt" dataList="stockAmt"></w2:column>
						<w2:column width="*" style="" inputType="text" dataType="text" id="mgrCode" dataList="mgrCode"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;width:fit-content;max-width:100%;" id="grp_btn_case">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_base_onclick" id="btn_base" label="다운로드 (전체 생략)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;"></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_header_onclick" id="btn_header" label="다운로드 (useHeaderDataFormat=true)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-top:6px;"></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_body_onclick" id="btn_body" label="다운로드 (useDataFormat=true)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-top:6px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
