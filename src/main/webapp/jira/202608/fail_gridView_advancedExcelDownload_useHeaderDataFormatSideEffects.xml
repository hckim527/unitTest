		<script lazy="false" type="text/javascript"><![CDATA[// https://inswave01.atlassian.net/browse/WAEA-1211
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
};



// 기준선 : 표시 형식 옵션 전체 생략
scwin.btn_base_onclick = function () {
    target1.advancedExcelDownload({
        "fileName" : "base",
        "extension" : "xlsx"
    });

    scwin.setReturnValue("호출 : 전체 생략");
};



// 결함 : useHeaderDataFormat 만 전달
scwin.btn_header_onclick = function () {
    target1.advancedExcelDownload({
        "fileName" : "fail_header",
        "extension" : "xlsx",
        "useHeaderDataFormat" : "true"
    });

    scwin.setReturnValue("호출 : useHeaderDataFormat=true");
};



// 대조군 : useDataFormat 만 전달
scwin.btn_body_onclick = function () {
    target1.advancedExcelDownload({
        "fileName" : "ref_body",
        "extension" : "xlsx",
        "useDataFormat" : "true"
    });

    scwin.setReturnValue("호출 : useDataFormat=true");
};]]></script>
