						<w2:row><matGroup><![CDATA[부자재]]></matGroup><matName><![CDATA[방청유]]></matName><stockQty><![CDATA[340]]></stockQty><stockAmt><![CDATA[2760000]]></stockAmt><mgrCode><![CDATA[A02]]></mgrCode></w2:row>
						<w2:row><matGroup><![CDATA[반제품]]></matGroup><matName><![CDATA[코일 슬리팅재]]></matName><stockQty><![CDATA[87]]></stockQty><stockAmt><![CDATA[15320000]]></stockAmt><mgrCode><![CDATA[B01]]></mgrCode></w2:row>
						<w2:row><matGroup><![CDATA[완제품]]></matGroup><matName><![CDATA[프레스 브라켓]]></matName><stockQty><![CDATA[2604]]></stockQty><stockAmt><![CDATA[91870000]]></stockAmt><mgrCode><![CDATA[B02]]></mgrCode></w2:row>
