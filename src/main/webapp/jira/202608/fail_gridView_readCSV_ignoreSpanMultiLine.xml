<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView readCSV ignoreSpan multiLine" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260821" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="col1" dataType="text"></w2:column>
						<w2:column id="col2" name="col2" dataType="text"></w2:column>
						<w2:column id="col3" name="col3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[x1]]></col1>
							<col2><![CDATA[x2]]></col2>
							<col3><![CDATA[x3]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[y1]]></col1>
							<col2><![CDATA[y2]]></col2>
							<col3><![CDATA[y3]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
    // 사전 조건은 dataList 정적 데이터로 세팅됨 (추가 처리 없음)
};



// (1) 현재 데이터를 CSV 로 저장 — 구분자만 readCSV 기본값에 맞추고 그 외는 기본값
scwin.btn_save_onclick = function () {
    grd_multi.saveCSV({ delim : "," });
};

// (2) 방금 저장한 CSV 를 옵션 없이(전 옵션 기본값) 다시 업로드
scwin.btn_read_onclick = function () {
    grd_multi.readCSV({});
};



// (3) 실제 반영된 dataList 값을 Row 별로 출력
scwin.btn_getResult_onclick = function () {
    var arrData = dlt_bind.getAllJSON();

    scwin.setReturnValue("Row " + arrData.length);
    for (var i = 0; i < arrData.length; i++) {
        scwin.setReturnValue("[" + i + "] " + arrData[i].col1 + " | " + arrData[i].col2 + " | " + arrData[i].col3);
    }
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView readCSV() — Body 가 MultiLine 인 GridView 에서 saveCSV() 로 저장한 CSV 를 옵션 기본값으로 다시 읽으면 원본이 복원되지 않는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. GridView 는 col1 / col2 / col3 세 개의 Column 을 가지며 col3 만 colSpan=&quot;2&quot; 로 병합되어 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. Body 가 2줄(1줄 col1 · col2 / 2줄 col3)인 MultiLine 구성이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 초기 데이터는 x1 / x2 / x3 와 y1 / y2 / y3 두 Row 다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. ① 버튼은 저장 시 delim:&quot;,&quot; 만 지정한다 — saveCSV 기본 구분자는 &quot;;&quot;, readCSV 기본 구분자는 &quot;,&quot; 로 달라 구분자 불일치가 결과에 섞이는 것을 막기 위함이며, 그 외 옵션은 저장 · 읽기 모두 기본값이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="5. 함께 첨부한 fail_gridView_readCSV_ignoreSpanMultiLine.csv 는 ① 버튼 산출물과 바이트 동일하다 — 저장 단계를 건너뛰고 바로 재현하려면 이 파일을 올리면 된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. ① CSV 저장 버튼 클릭 → 파일이 저장된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. ② 기본값 업로드 버튼 클릭 → 팝업창에서 방금 저장한 파일 선택 → File Upload" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. ③ 결과 확인 버튼 클릭" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] 같은 화면에서 방금 저장한 파일을 그대로 되읽는 것이므로 저장 전과 같은 Row 2 (x1 | x2 | x3 / y1 | y2 | y3) 로 복원되어야 한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[실제] Row 4 로 분해되고 col3 가 모두 빈 값이 된다 — x1 | x2 | 빈 값 / x3 | x3 | 빈 값 / y1 | y2 | 빈 값 / y3 | y3 | 빈 값" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Body 2줄 MultiLine)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="grd_multi" dataList="data:dlt_bind" checkAllType="false" style="width:300px;height:320px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="140" inputType="text" id="hcol1" value="name1"></w2:column>
						<w2:column width="140" inputType="text" id="hcol2" value="name2"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="140" inputType="text" dataType="text" id="col1" dataList="col1"></w2:column>
						<w2:column width="140" inputType="text" dataType="text" id="col2" dataList="col2"></w2:column>
					</w2:row>
					<w2:row style="" id="brow2">
						<w2:column width="280" colSpan="2" inputType="text" dataType="text" id="col3" dataList="col3"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="margin-top:8px;margin-bottom:14px;" id="grp_btn">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_save_onclick" id="btn_save" label="① CSV 저장" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_read_onclick" id="btn_read" label="② 기본값 업로드" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_getResult_onclick" id="btn_getResult" label="③ 결과 확인" style=""></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 140px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
