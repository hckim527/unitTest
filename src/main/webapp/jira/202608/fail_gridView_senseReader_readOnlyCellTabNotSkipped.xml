<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView senseReader readonly Cell Tab 건너뛰기" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260810" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_a" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col2" name="col2"></w2:column>
						<w2:column dataType="text" id="col3" name="col3"></w2:column>
						<w2:column dataType="text" id="col4" name="col4"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[A1]]></col1><col2><![CDATA[B1]]></col2><col3><![CDATA[C1]]></col3><col4><![CDATA[D1]]></col4></w2:row>
						<w2:row><col1><![CDATA[A2]]></col1><col2><![CDATA[B2]]></col2><col3><![CDATA[C2]]></col3><col4><![CDATA[D2]]></col4></w2:row>
						<w2:row><col1><![CDATA[A3]]></col1><col2><![CDATA[B3]]></col2><col3><![CDATA[C3]]></col3><col4><![CDATA[D3]]></col4></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_b" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col2" name="col2"></w2:column>
						<w2:column dataType="text" id="col3" name="col3"></w2:column>
						<w2:column dataType="text" id="col4" name="col4"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[A1]]></col1><col2><![CDATA[B1]]></col2><col3><![CDATA[C1]]></col3><col4><![CDATA[D1]]></col4></w2:row>
						<w2:row><col1><![CDATA[A2]]></col1><col2><![CDATA[B2]]></col2><col3><![CDATA[C2]]></col3><col4><![CDATA[D2]]></col4></w2:row>
						<w2:row><col1><![CDATA[A3]]></col1><col2><![CDATA[B3]]></col2><col3><![CDATA[C3]]></col3><col4><![CDATA[D3]]></col4></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// [FAIL] gridView senseReader="true" 인 경우
//        readonly 상태의 Body Cell(col2) 은 Tab 키 포커스 이동 시 건너뛰어야 하는데 건너뛰지 않는다.
//        또한 senseReader="true" 의 포커스 이동 동작이 ignoreNonEditableCell 속성값에 따라 서로 달라진다.
//        A(ignoreNonEditableCell 미설정) : col2(readonly) 로 포커스가 이동함
//        B(ignoreNonEditableCell="true") : col2(readonly) 를 건너뜀
//        두 GridView 는 ignoreNonEditableCell 외의 모든 설정과 데이터가 동일하다.

scwin.onpageload = function () {
    // 두 GridView 모두 첫번째 편집 가능 Cell(col1, colIndex 0) 에 포커스 위치를 맞춘다.
    grid_a.setFocusedCell(0, 0, false);
    grid_b.setFocusedCell(0, 0, false);
};



// 화면 Header 에 표시되는 Column 명
scwin.COL_NAME = ["col1(편집가능)", "col2(readOnly)", "col3(disabled)", "col4(편집가능)"];

// 이동 결과를 화면 표시 Column 명으로 "이전 → 이동" 한 줄 출력
// 최초 포커스 지정(이전 Cell 없음) 은 출력하지 않는다.
scwin.printMove = function (gridName, columnIndex, oldColumnIndex) {
    if (oldColumnIndex === null || oldColumnIndex === undefined) {
        return;
    }
    scwin.setReturnValue("[" + gridName + "] " + scwin.COL_NAME[oldColumnIndex] + " → " + scwin.COL_NAME[columnIndex]);
};

// A GridView : senseReader="true" (ignoreNonEditableCell 미설정)
scwin.grid_a_oncellindexchange = function (rowIndex, columnIndex, oldRow, oldColumnIndex) {
    scwin.printMove("A", columnIndex, oldColumnIndex);
};

// B GridView : senseReader="true" + ignoreNonEditableCell="true"
scwin.grid_b_oncellindexchange = function (rowIndex, columnIndex, oldRow, oldColumnIndex) {
    scwin.printMove("B", columnIndex, oldColumnIndex);
};



// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[.tc_fail_grid_wrap { display:flex; flex-direction:column; gap:6px; }]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px; display:flex; flex-direction:column; gap:12px;">
			<w2:textbox class="tc_tbx_label_1" escape="false" id="lbl_title" style=""
				label="■ [FAIL] gridView senseReader=&quot;true&quot; 인 경우 readonly 상태의 Body Cell 은 키보드(Tab) 포커스 이동 시 건너뛰어야 하며 이 동작은 ignoreNonEditableCell 속성값과 무관해야 하는데, ignoreNonEditableCell 을 설정하지 않으면(A) readonly Cell 로 포커스가 이동하여 ignoreNonEditableCell=&quot;true&quot; 인 B 와 결과가 달라짐."></w2:textbox>
			<w2:textbox class="" escape="false" id="lbl_guide" style=""
				label="[확인 방법] 각 GridView 의 col1(편집가능) Cell 을 클릭한 뒤 Tab 키를 반복 입력하면 이동 결과가 결과창에 출력됨&lt;br/&gt;[기대] A / B 동일하게 col1(편집가능) → col4(편집가능)&lt;br/&gt;[실제] A 는 col1(편집가능) → col2(readOnly) → col4(편집가능) / B 는 col1(편집가능) → col4(편집가능)"></w2:textbox>

			<xf:group id="grp_grids" style="display:flex; gap:32px; align-items:flex-start;">
				<xf:group id="grp_a" class="tc_fail_grid_wrap">
					<w2:textbox class="" id="" label="[A] senseReader=true (ignoreNonEditableCell 미설정)" style="font-weight:bold;"></w2:textbox>
					<w2:gridView id="grid_a" senseReader="true" focusMode="cell" checkAllType="false" dataList="data:dlt_a"
						readOnlyBackgroundColor="#D3D3D3" disabledBackgroundColor="#FFF9C4"
						style="width:540px;height:150px;" ev:oncellindexchange="scwin.grid_a_oncellindexchange">
						<w2:header id="hdr_a">
							<w2:row id="hrow_a">
								<w2:column width="130" inputType="text" id="ha1" value="col1(편집가능)"></w2:column>
								<w2:column width="130" inputType="text" id="ha2" value="col2(readOnly)"></w2:column>
								<w2:column width="130" inputType="text" id="ha3" value="col3(disabled)"></w2:column>
								<w2:column width="130" inputType="text" id="ha4" value="col4(편집가능)"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="body_a">
							<w2:row id="brow_a">
								<w2:column width="130" inputType="text" dataType="text" id="col1" dataList="col1"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col2" dataList="col2" readOnly="true"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col3" dataList="col3" disabled="true"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col4" dataList="col4"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>

				<xf:group id="grp_b" class="tc_fail_grid_wrap">
					<w2:textbox class="" id="" label="[B] senseReader=true + ignoreNonEditableCell=true" style="font-weight:bold;"></w2:textbox>
					<w2:gridView id="grid_b" senseReader="true" ignoreNonEditableCell="true" focusMode="cell" checkAllType="false" dataList="data:dlt_b"
						readOnlyBackgroundColor="#D3D3D3" disabledBackgroundColor="#FFF9C4"
						style="width:540px;height:150px;" ev:oncellindexchange="scwin.grid_b_oncellindexchange">
						<w2:header id="hdr_b">
							<w2:row id="hrow_b">
								<w2:column width="130" inputType="text" id="hb1" value="col1(편집가능)"></w2:column>
								<w2:column width="130" inputType="text" id="hb2" value="col2(readOnly)"></w2:column>
								<w2:column width="130" inputType="text" id="hb3" value="col3(disabled)"></w2:column>
								<w2:column width="130" inputType="text" id="hb4" value="col4(편집가능)"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="body_b">
							<w2:row id="brow_b">
								<w2:column width="130" inputType="text" dataType="text" id="col1" dataList="col1"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col2" dataList="col2" readOnly="true"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col3" dataList="col3" disabled="true"></w2:column>
								<w2:column width="130" inputType="text" dataType="text" id="col4" dataList="col4"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>

			<!-- ===== 리턴 값 확인 (body_bottom.xml inline) ===== -->
			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 200px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
