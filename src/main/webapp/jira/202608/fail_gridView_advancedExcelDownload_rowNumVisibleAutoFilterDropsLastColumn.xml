		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// 옵션만 달리하여 advancedExcelDownload 실행
//  · 호출 시 전달한 객체에 엔진이 내부 값을 덧붙이므로 출력 문자열은 호출 전에 만들어 둔다.
scwin.runCase = function (objOptions) {
    var arrKey = [];
    for (var strKey in objOptions) {
        if (strKey === "fileName") continue;
        arrKey.push(strKey + " \"" + objOptions[strKey] + "\"");
    }

    if (arrKey.length === 0) arrKey.push("(미설정)");

    var strOptions = arrKey.join(" , ");
    var strFileName = objOptions.fileName;

    target1.advancedExcelDownload(objOptions);

    scwin.setReturnValue("전달한 옵션 : " + strOptions);
    scwin.setReturnValue("파일명 : " + strFileName);
    scwin.setReturnValue("");
};



// rowNumVisible "true" , headerAutoFilter "true"
scwin.btn_both_onclick = function () {
    scwin.runCase({ "fileName" : "dl_rowNumVisible_headerAutoFilter.xlsx", "rowNumVisible" : "true", "headerAutoFilter" : "true" });
};

]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.rowNumVisible 과 options.headerAutoFilter 를 함께 설정하면 다운로드 파일의 마지막 컬럼이 필터 범위에서 빠지는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.rowNumVisible &amp;lt;String:N:false&amp;gt; : &quot;행 번호 표시 컬럼의 유무&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. API 가이드 options.headerAutoFilter &amp;lt;String:N:false&amp;gt; : &quot;헤더에 필터를 적용할지 여부&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 대상 GridView 는 Column 0 ~ Column 4 의 5 개 컬럼이고 각 셀 값은 c{컬럼번호}_{행번호} 형식이므로 다운로드 파일만 보고도 컬럼 위치를 식별할 수 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. 두 옵션 외의 다운로드 옵션은 fileName 만 설정하고 나머지는 기본값 상태이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="5. 대상 GridView 의 rowNumVisible 속성은 미설정 상태이며, 이 속성을 &quot;true&quot; 로 두어도 다운로드 파일에는 행 번호 컬럼이 출력되지 않으므로 재현 조건과 무관하다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 아래 버튼을 클릭하여 다운로드된 파일을 엑셀로 열고, 마지막 컬럼(Column 4) 헤더에 필터 버튼이 표시되는지 확인" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] rowNumVisible 로 행 번호 컬럼이 추가되더라도 필터는 마지막 컬럼(Column 4)까지 적용되어 Column 0 ~ Column 4 의 5 개 컬럼 모두에 필터 버튼이 표시되어야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[실제] 두 옵션을 함께 &quot;true&quot; 로 설정하면 셀 데이터는 행 번호 컬럼 + Column 0 ~ Column 4 로 모두 출력되지만 필터는 앞의 5 개 컬럼(행 번호 ~ Column 3)에만 적용되어 마지막 컬럼(Column 4)이 필터 범위에서 빠짐" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (advancedExcelDownload 호출 대상)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_down" checkAllType="false" style="width:600px;height:150px;">
				<w2:header style="" id="header_d">
					<w2:row style="" id="hrow_d">
						<w2:column width="110" inputType="text" id="hcol_d0" value="Column 0"></w2:column>
						<w2:column width="110" inputType="text" id="hcol_d1" value="Column 1"></w2:column>
						<w2:column width="110" inputType="text" id="hcol_d2" value="Column 2"></w2:column>
						<w2:column width="110" inputType="text" id="hcol_d3" value="Column 3"></w2:column>
						<w2:column width="110" inputType="text" id="hcol_d4" value="Column 4"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_d">
					<w2:row style="" id="brow_d">
