	<head meta_screenName="[FAIL] gridView adaptive 적응형 웹(crosstab) 적용 시 Header 와 달리 Footer 만 GridView 에 지정한 세로 크기를 벗어나는 결함" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260828" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_grid" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="Column 1" dataType="text"></w2:column>
						<w2:column id="col2" name="Column 2" dataType="text"></w2:column>
						<w2:column id="col3" name="Column 3" dataType="text"></w2:column>
						<w2:column id="col4" name="Column 4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[c1_0]]></col1>
							<col2><![CDATA[c2_0]]></col2>
							<col3><![CDATA[c3_0]]></col3>
							<col4><![CDATA[c4_0]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c1_1]]></col1>
							<col2><![CDATA[c2_1]]></col2>
							<col3><![CDATA[c3_1]]></col3>
							<col4><![CDATA[c4_1]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c1_2]]></col1>
							<col2><![CDATA[c2_2]]></col2>
