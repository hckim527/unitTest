		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// Header / Footer 의 내용 높이가 GridView 세로 크기를 벗어나는지 확인
//  · 내용 높이(scrollHeight) 가 표시 높이(clientHeight) 보다 크면 그 차이만큼 벗어난 것이다.
scwin.btn_sizeCheck_onclick = function () {
    var objGrid = target1.render;
    var objHeader = objGrid.querySelector("table[id$='_body_table']");
    var objFooter = objGrid.querySelector("table[id$='_foot_table']");

    var bApplied = objGrid.className.split(/\s+/).indexOf("w2grid_adaptive_crosstab") > -1;

    scwin.setReturnValue("적응형 웹 적용 : " + bApplied + " (브라우저 너비 " + window.innerWidth + "px)");
    scwin.setReturnValue("GridView 세로 크기 : " + objGrid.clientHeight + "px");
    scwin.setReturnValue("Header 내용 높이 : " + objHeader.scrollHeight + "px , 벗어난 크기 : " + (objHeader.scrollHeight - objHeader.clientHeight) + "px");
    scwin.setReturnValue("Footer 내용 높이 : " + objFooter.scrollHeight + "px , 벗어난 크기 : " + (objFooter.scrollHeight - objFooter.clientHeight) + "px");
    scwin.setReturnValue("");
};

]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView adaptive — 적응형 웹(crosstab) 적용 시 Header 와 달리 Footer 만 GridView 에 지정한 세로 크기를 벗어나는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 adaptive &amp;lt;String:N&amp;gt; : &quot;웹브라우저의 너비가 변경될 때 GridView 컴포넌트에 적응형 웹(Adaptive Web) 방식으로 적용될 레이아웃을 설정합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. API 가이드 adaptiveThreshold &amp;lt;Number&amp;gt; : 적응형 웹 레이아웃이 적용될 기준 너비이며 , adaptive=&quot;crosstab&quot; / groupbyZone=false 이고 웹브라우저 너비가 이 값 이하일 때 적용된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 대상 GridView 는 Header 1 행 / Body 1 행 / Footer 1 행 의 4 개 컬럼 구조이며 , style 로 세로 크기를 150px 로 지정했다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. adaptiveThreshold 를 2000 으로 두어 일반적인 브라우저 너비에서 적응형 웹이 적용된 상태로 표시된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 아래 버튼을 클릭하여 Header 와 Footer 의 내용 높이가 GridView 세로 크기(150px) 를 벗어나는지 비교" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] 적응형 웹이 적용되어도 Header 와 마찬가지로 Footer 도 GridView 에 지정한 세로 크기를 벗어나지 않아야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[실제] Header 는 세로 크기 안에 맞춰지지만 Footer 만 내용 높이가 커져 GridView 세로 크기를 벗어나며 , 화면에서도 Footer 행이 잘려 보이지 않음" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (adaptive=&quot;crosstab&quot; , adaptiveThreshold=&quot;2000&quot; , groupbyZone=&quot;false&quot;)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_grid" checkAllType="false" adaptive="crosstab" adaptiveThreshold="2000" groupbyZone="false" style="width:700px;height:150px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="160" inputType="text" id="hcol1" value="name1"></w2:column>
						<w2:column width="160" inputType="text" id="hcol2" value="name2"></w2:column>
						<w2:column width="160" inputType="text" id="hcol3" value="name3"></w2:column>
						<w2:column width="160" inputType="text" id="hcol4" value="name4"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="160" inputType="text" dataType="text" id="col1" dataList="col1" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="col2" dataList="col2" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="col3" dataList="col3" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="col4" dataList="col4" value=""></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:footer style="" id="footer1">
					<w2:row style="" id="frow1">
						<w2:column width="160" inputType="text" id="ft1" value="합계"></w2:column>
						<w2:column width="160" inputType="text" id="ft2" value="footer2"></w2:column>
						<w2:column width="160" inputType="text" id="ft3" value="footer3"></w2:column>
						<w2:column width="160" inputType="text" id="ft4" value="footer4"></w2:column>
					</w2:row>
				</w2:footer>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;position:relative;z-index:6100;width:fit-content;max-width:100%;background:#ffffff;" id="grp_btn_run">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_sizeCheck_onclick" id="btn_sizeCheck" label="Header / Footer 세로 크기 확인" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-bottom:4px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="position:relative;z-index:5000;background:#ffffff;">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 200px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
