<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView saveCSV columnOrder partial progress stuck" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260821" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_c" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="c0" name="c0" dataType="text"></w2:column>
						<w2:column id="c1" name="c1" dataType="text"></w2:column>
						<w2:column id="c2" name="c2" dataType="text"></w2:column>
						<w2:column id="c3" name="c3" dataType="text"></w2:column>
						<w2:column id="c4" name="c4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><c0><![CDATA[c0_1]]></c0><c1><![CDATA[c1_1]]></c1><c2><![CDATA[c2_1]]></c2><c3><![CDATA[c3_1]]></c3><c4><![CDATA[c4_1]]></c4></w2:row>
						<w2:row><c0><![CDATA[c0_2]]></c0><c1><![CDATA[c1_2]]></c1><c2><![CDATA[c2_2]]></c2><c3><![CDATA[c3_2]]></c3><c4><![CDATA[c4_2]]></c4></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.saveC = function (strOrder, strFileName) {
    var options = { fileName : strFileName, delim : ",", columnMove : "true", columnOrder : strOrder };
    grd_col.saveCSV(options);
    scwin.setReturnValue("실행 : columnOrder='" + strOrder + "' → 다운로드 파일 " + strFileName);
};

// ① 전체 Column 인덱스를 모두 나열
scwin.btn_order_all_onclick = function () {
    scwin.saveC("0,3,2,1,4", "saveCSV_order_all.csv");
};

// ② 일부 Column 인덱스만 나열 (가이드 예시 형식)
scwin.btn_order_partial_onclick = function () {
    scwin.saveC("0,3,2,1", "saveCSV_order_partial.csv");
};]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView saveCSV() — options.columnOrder 에 일부 Column 인덱스만 설정하면 Progress 가 계속 표시되는 현상" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.columnOrder : &quot;다운로드할 Column 의 순서를 콤마(,)로 구분하여 설정합니다. Column 의 인덱스로 순서를 설정합니다. (ex&gt; &quot;0,3,2,1&quot;) columnMove 파라미터가 &quot;true&quot; 일때만 적용되고 columnOrder 파라미터 순서에 맞게 데이터를 생성하여 다운로드합니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. Column 5개(c0 ~ c4) 그리드이며 각 셀 값이 c{Column인덱스}_{행번호} 형식이라 값만 보고 원래 Column 인덱스를 알 수 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 두 버튼 모두 columnMove 를 &quot;true&quot; 로 함께 설정하며, 숨김 Column 은 두지 않는다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="① 버튼을 클릭하여 다운로드되는 것을 확인한 뒤 , ② 버튼을 클릭하여 Progress 가 사라지는지 확인" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] ② 도 ① 과 마찬가지로 CSV 파일이 다운로드되고 Progress 가 닫혀야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-bottom:8px;" id="" label="[실제] ② 는 다운로드가 발생하지 않고 Progress 가 계속 표시된 상태로 남는다 (콘솔 오류 없음)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Column 5개 c0 ~ c4 / 숨김 Column 없음)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="grd_col" dataList="data:dlt_c" checkAllType="false" columnMove="true" style="width:820px;height:120px;">
				<w2:header style="" id="header_c">
					<w2:row style="" id="hrow_c">
						<w2:column width="160" inputType="text" id="h0" value="c0 (index 0)"></w2:column>
						<w2:column width="160" inputType="text" id="h1" value="c1 (index 1)"></w2:column>
						<w2:column width="160" inputType="text" id="h2" value="c2 (index 2)"></w2:column>
						<w2:column width="160" inputType="text" id="h3" value="c3 (index 3)"></w2:column>
						<w2:column width="*" inputType="text" id="h4" value="c4 (index 4)"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_c">
					<w2:row style="" id="brow_c">
						<w2:column width="160" inputType="text" dataType="text" id="c0" dataList="c0" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c1" dataList="c1" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c2" dataList="c2" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c3" dataList="c3" value=""></w2:column>
						<w2:column width="*" inputType="text" dataType="text" id="c4" dataList="c4" value=""></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="margin-top:8px;margin-bottom:14px;" id="grp_btn_c">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_order_all_onclick" id="btn_order_all" label="① columnOrder='0,3,2,1,4' (전체 나열) 다운로드" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_order_partial_onclick" id="btn_order_partial" label="② columnOrder='0,3,2,1' (일부 나열) 다운로드" style=""></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
