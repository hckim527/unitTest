<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView saveCSV saveList ignores removeColumns" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260821" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_c" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="c0" name="c0" dataType="text"></w2:column>
						<w2:column id="c1" name="c1" dataType="text"></w2:column>
						<w2:column id="c2" name="c2" dataType="text"></w2:column>
						<w2:column id="c3" name="c3" dataType="text"></w2:column>
						<w2:column id="c4" name="c4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><c0><![CDATA[c0_1]]></c0><c1><![CDATA[c1_1]]></c1><c2><![CDATA[c2_1]]></c2><c3><![CDATA[c3_1]]></c3><c4><![CDATA[c4_1]]></c4></w2:row>
						<w2:row><c0><![CDATA[c0_2]]></c0><c1><![CDATA[c1_2]]></c1><c2><![CDATA[c2_2]]></c2><c3><![CDATA[c3_2]]></c3><c4><![CDATA[c4_2]]></c4></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
    // 인덱스 1 (c1) 을 숨김 Column 으로 만든다
    grd_col.setColumnVisible(1, false);
};


// saveList 와 removeColumns 를 함께 전달하여 CSV 다운로드
scwin.saveA = function (objOptions, strFileName) {
    objOptions.fileName = strFileName;
    objOptions.delim = ",";
    grd_col.saveCSV(objOptions);
    scwin.setReturnValue("실행 : " + JSON.stringify(objOptions) + " → 다운로드 파일 " + strFileName);
};

// ① saveList 만 설정
scwin.btn_saveList_only_onclick = function () {
    scwin.saveA({ saveList : ["c2", "c0"] }, "saveCSV_saveList.csv");
};

// ② saveList + removeColumns
scwin.btn_saveList_remove_onclick = function () {
    scwin.saveA({ saveList : ["c2", "c0"], removeColumns : "1,3" }, "saveCSV_saveList_remove.csv");
};

// ③ saveList + removeColumns + hidden
scwin.btn_saveList_remove_hidden_onclick = function () {
    scwin.saveA({ saveList : ["c2", "c0"], removeColumns : "0,2", hidden : "1" }, "saveCSV_saveList_remove_hidden.csv");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView saveCSV() — options.saveList 설정 시 options.removeColumns 가 무시되지 않는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.saveList : &quot;파라미터에 설정된 Column 의 데이터만 다운로드되며 removeColumns, hidden 파라미터값이 무시됩니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. Column 5개(c0 ~ c4) 그리드이며 각 셀 값이 c{Column인덱스}_{행번호} 형식이라 값만 보고 원래 Column 인덱스를 알 수 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 인덱스 1 인 c1 은 숨김 Column 이다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="4. 다운로드 파일은 구분자를 쉼표로 지정하여 확인하기 쉽게 하였다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="① ~ ③ 버튼을 차례로 클릭하여 CSV 3개를 다운로드한 뒤 각 파일에 포함된 Column 을 확인 (파일명이 버튼별로 다름)" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] saveList 가 removeColumns 를 무시하므로 ① ② ③ 세 파일 모두 c0 , c2 두 Column 이 인덱스 순서로 다운로드되어야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-bottom:8px;" id="" label="[실제] ① 만 c0 , c2 이고 ② 는 c0 하나만 , ③ 은 c2 하나만 다운로드되어 removeColumns 가 그대로 적용됨 (hidden 은 가이드대로 무시됨)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Column 5개 c0 ~ c4 / 인덱스 1 인 c1 은 숨김)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="grd_col" dataList="data:dlt_c" checkAllType="false" columnMove="true" style="width:820px;height:120px;">
				<w2:header style="" id="header_c">
					<w2:row style="" id="hrow_c">
						<w2:column width="160" inputType="text" id="h0" value="c0 (index 0)"></w2:column>
						<w2:column width="160" inputType="text" id="h1" value="c1 (index 1 / hidden)"></w2:column>
						<w2:column width="160" inputType="text" id="h2" value="c2 (index 2)"></w2:column>
						<w2:column width="160" inputType="text" id="h3" value="c3 (index 3)"></w2:column>
						<w2:column width="*" inputType="text" id="h4" value="c4 (index 4)"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_c">
					<w2:row style="" id="brow_c">
						<w2:column width="160" inputType="text" dataType="text" id="c0" dataList="c0" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c1" dataList="c1" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c2" dataList="c2" value=""></w2:column>
						<w2:column width="160" inputType="text" dataType="text" id="c3" dataList="c3" value=""></w2:column>
						<w2:column width="*" inputType="text" dataType="text" id="c4" dataList="c4" value=""></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="margin-top:8px;margin-bottom:14px;" id="grp_btn_c">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_saveList_only_onclick" id="btn_saveList_only" label="① saveList 만 다운로드" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_saveList_remove_onclick" id="btn_saveList_remove" label="② saveList + removeColumns='1,3' 다운로드" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_saveList_remove_hidden_onclick" id="btn_saveList_remove_hidden" label="③ saveList + removeColumns='0,2' + hidden='1' 다운로드" style=""></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
