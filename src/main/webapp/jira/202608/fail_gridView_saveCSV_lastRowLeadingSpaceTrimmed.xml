<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView saveCSV last row leading space trimmed" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260824" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_sp" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="no" name="no" dataType="text"></w2:column>
						<w2:column id="name" name="name" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><no><![CDATA[1]]></no><name><![CDATA[  aaa  ]]></name></w2:row>
						<w2:row><no><![CDATA[2]]></no><name><![CDATA[  bbb  ]]></name></w2:row>
						<w2:row><no><![CDATA[3]]></no><name><![CDATA[  ccc  ]]></name></w2:row>
						<w2:row><no><![CDATA[4]]></no><name><![CDATA[  ddd  ]]></name></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};

scwin.onpageload = function () {
    // 모든 Row 의 name 값은 앞 2칸 + 뒤 2칸 공백이 동일하게 들어 있다
    var arrData = dlt_sp.getAllJSON();
    for (var i = 0; i < arrData.length; i++) {
        scwin.setReturnValue("dataList row " + i + " name = [" + arrData[i].name + "]");
    }
};

// saveCSV 다운로드 (trim 미지정 = 기본값 "0")
scwin.btn_save_onclick = function () {
    grd_sp.saveCSV({ fileName : "saveCSV_trim.csv", delim : "," });
    scwin.setReturnValue("실행 : saveCSV({ fileName : \"saveCSV_trim.csv\", delim : \",\" })");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView saveCSV() — trim 기본값(&quot;0&quot;) 인데도 다운로드된 CSV 의 마지막 Row 만 좌측 공백이 제거되는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.trim : &quot;• &quot;0&quot; : 좌우 공백을 제거하지 않습니다.&quot; (기본값 &quot;0&quot;)" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. 모든 Row 의 name 값에 앞 2칸 + 뒤 2칸 공백이 동일하게 들어 있다 (&quot;  aaa  &quot; , &quot;  bbb  &quot; , &quot;  ccc  &quot; , &quot;  ddd  &quot;)" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 다운로드 옵션은 fileName , delim 만 지정하고 trim 은 지정하지 않아 기본값 &quot;0&quot; 으로 동작한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="&quot;saveCSV 다운로드&quot; 버튼을 클릭해 CSV 를 받은 뒤 , 메모장 등 텍스트 편집기로 열어 각 Row 의 name 값 앞뒤 공백을 확인한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] 4개 Row 모두 name 값이 앞 2칸 + 뒤 2칸 공백을 그대로 유지한 상태로 저장된다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-bottom:8px;" id="" label="[실제] 마지막 Row 만 앞 공백 2칸이 제거된 상태로 저장된다 (뒤 공백은 유지 , 1 ~ 3 Row 는 정상)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Column 2개 no , name / 모든 Row 의 name 값은 앞 2칸 + 뒤 2칸 공백 포함)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="grd_sp" dataList="data:dlt_sp" checkAllType="false" style="width:520px;height:140px;">
				<w2:header style="" id="header_sp">
					<w2:row style="" id="hrow_sp">
						<w2:column width="80" inputType="text" id="h_no" value="no"></w2:column>
						<w2:column width="*" inputType="text" id="h_name" value="name (spaces)"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_sp">
					<w2:row style="" id="brow_sp">
						<w2:column width="80" inputType="text" dataType="text" id="no" dataList="no" value=""></w2:column>
						<w2:column width="*" inputType="text" dataType="text" id="name" dataList="name" value=""></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="margin-top:8px;margin-bottom:14px;" id="grp_btn_sp">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_save_onclick" id="btn_save" label="saveCSV 다운로드" style=""></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
