	<head meta_screenName="[FAIL] gridView advancedExcelDownload options.headerColor 를 생략하면 가이드에 규정된 기본값 #33CCCC 가 적용되지 않고 다른 색이 적용되는 결함" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260901" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_bind" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="deptName" name="부서명" dataType="text"></w2:column>
						<w2:column id="empName" name="사원명" dataType="text"></w2:column>
						<w2:column id="workDays" name="근무일수" dataType="number"></w2:column>
						<w2:column id="payAmt" name="급여액" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><deptName><![CDATA[영업기획팀]]></deptName><empName><![CDATA[김민서]]></empName><workDays><![CDATA[21]]></workDays><payAmt><![CDATA[4250000]]></payAmt></w2:row>
						<w2:row><deptName><![CDATA[영업기획팀]]></deptName><empName><![CDATA[박준형]]></empName><workDays><![CDATA[20]]></workDays><payAmt><![CDATA[3980000]]></payAmt></w2:row>
						<w2:row><deptName><![CDATA[상품개발팀]]></deptName><empName><![CDATA[이서연]]></empName><workDays><![CDATA[22]]></workDays><payAmt><![CDATA[4610000]]></payAmt></w2:row>
						<w2:row><deptName><![CDATA[상품개발팀]]></deptName><empName><![CDATA[정하윤]]></empName><workDays><![CDATA[19]]></workDays><payAmt><![CDATA[3720000]]></payAmt></w2:row>
