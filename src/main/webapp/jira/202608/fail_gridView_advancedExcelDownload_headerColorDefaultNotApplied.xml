		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// https://inswave01.atlassian.net/browse/WAEA-1213
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
    tbx_return.setValue("");
};



// headerColor 미전달 (생략)
scwin.btn_default_onclick = function (e) {
    target1.advancedExcelDownload({
        "fileName" : "fail_default",
        "extension" : "xlsx"
    });

    scwin.setReturnValue("호출 : headerColor 생략");
};



// headerColor = 가이드 기본값 #33CCCC 명시
scwin.btn_explicit_onclick = function (e) {
    target1.advancedExcelDownload({
        "fileName" : "ref_explicit",
        "extension" : "xlsx",
        "headerColor" : "#33CCCC"
    });

    scwin.setReturnValue("호출 : headerColor=#33CCCC");
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.headerColor 를 생략하면 가이드에 규정된 기본값 #33CCCC 가 적용되지 않고 다른 색이 적용되는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.headerColor &amp;lt;String:N:&quot;#33CCCC&quot;&amp;gt; : &quot;Excel 파일의 Header 데이터 영역 배경색을 설정합니다.&quot; 이므로 값을 생략하면 기본값 #33CCCC (청록) 이 적용되어야 한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. 첫 번째 버튼은 headerColor 를 전달하지 않고 두 번째 버튼은 가이드가 규정한 기본값 #33CCCC 를 그대로 명시하여 전달하므로 두 파일의 Header 배경색은 같아야 한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. 같은 계열 옵션인 options.bodyColor &amp;lt;String:N:&quot;#FFFFFF&quot;&amp;gt; 는 값을 생략하면 기본값 #FFFFFF (흰색) 가 정상 적용되어 두 파일의 Body 배경색이 같다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법] 두 버튼을 각각 클릭하여 파일 2 개를 내려받은 뒤 엑셀에서 Header 행 셀의 배경색을 비교한다 (파일을 압축 해제하여 xl/styles.xml 의 Header 셀 배경색으로도 확인할 수 있다)" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] headerColor 를 생략하면 가이드에 규정된 기본값 #33CCCC (청록) 가 적용되어 headerColor=&quot;#33CCCC&quot; 를 명시한 두 번째 버튼의 결과 파일과 Header 배경색이 같아야 함" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;margin-bottom:8px;" id="" label="[실제] headerColor 를 생략하면 기본값 #33CCCC (청록) 가 아니라 회색 (#C0C0C0) 이 적용되어 headerColor=&quot;#33CCCC&quot; 를 명시한 파일과 Header 배경색이 서로 다름 (같은 계열의 bodyColor 는 생략 시 기본값 #FFFFFF 가 정상 적용되어 Body 배경색은 두 파일이 같음)" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (advancedExcelDownload 호출 대상)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="target1" dataList="data:dlt_bind" checkAllType="false" style="width:640px;height:220px;">
				<w2:header style="" id="header1">
					<w2:row style="" id="hrow1">
						<w2:column width="140" style="" inputType="text" id="hcol1" value="부서명"></w2:column>
						<w2:column width="120" style="" inputType="text" id="hcol2" value="사원명"></w2:column>
						<w2:column width="120" style="" inputType="text" id="hcol3" value="근무일수"></w2:column>
						<w2:column width="*" style="" inputType="text" id="hcol4" value="급여액"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody1">
					<w2:row style="" id="brow1">
						<w2:column width="140" style="" inputType="text" id="deptName" dataList="deptName"></w2:column>
						<w2:column width="120" style="" inputType="text" id="empName" dataList="empName"></w2:column>
						<w2:column width="120" style="text-align:right;" inputType="text" dataType="number" displayFormat="#,##0" id="workDays" dataList="workDays"></w2:column>
						<w2:column width="*" style="text-align:right;" inputType="text" dataType="number" displayFormat="#,##0" id="payAmt" dataList="payAmt"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group style="margin-top:8px;margin-bottom:14px;width:fit-content;max-width:100%;" id="grp_btn_case">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_default_onclick" id="btn_default" label="다운로드 (headerColor 생략)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;"></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_explicit_onclick" id="btn_explicit" label="다운로드 (headerColor=&quot;#33CCCC&quot; 명시)" style="display:table;width:auto;min-width:0;max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;padding-left:12px;padding-right:12px;margin-top:6px;"></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 120px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
