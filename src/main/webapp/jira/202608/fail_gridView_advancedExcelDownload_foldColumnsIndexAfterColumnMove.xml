		<script lazy="false" type="text/javascript"><![CDATA[// https://inswave01.atlassian.net/browse/WAEA-1210
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



scwin.onpageload = function () {
};

// ① 순서 유지 + foldColumns="2"
scwin.btn_keep_onclick = function () {
    grd_item.advancedExcelDownload({
        fileName : "ok_keep",
        extension : "xlsx",
        foldColumns : "2"
    });
    scwin.setReturnValue("호출 : foldColumns=2");
};

// ② 순서 변경 + foldColumns="2"
scwin.btn_moved_onclick = function () {
    grd_item.advancedExcelDownload({
        fileName : "fail_moved",
        extension : "xlsx",
        foldColumns : "2",
        columnMove : "true",
        columnOrder : "2,1,0,3,4"
    });
    scwin.setReturnValue("호출 : foldColumns=2 / columnMove=true / columnOrder=2,1,0,3,4");
};]]></script>
