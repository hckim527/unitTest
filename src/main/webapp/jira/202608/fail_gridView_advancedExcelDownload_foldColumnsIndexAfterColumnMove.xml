	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView advancedExcelDownload() — options.foldColumns 의 인덱스가 Column 정의 인덱스가 아닌 이동 후 위치로 해석되어 다른 Column 이 숨겨지는 결함" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="[전제]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="1. API 가이드 options.foldColumns : &quot;Column 의 위치가 변경되어도 Column 의 인덱스는 변경되지 않습니다.&quot;" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="2. Column 정의 인덱스는 0 구분 / 1 품목설명 / 2 보관위치 / 3 비고 / 4 수량 이며 , 각 셀 값이 &quot;(인덱스n Column명) ...&quot; 형식이라 값만 보고 어느 Column 인지 알 수 있다" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="3. ② 버튼은 columnOrder=&quot;2,1,0,3,4&quot; 로 Column 순서를 바꿔서 내려받는다 (보관위치 / 품목설명 / 구분 / 비고 / 수량 순)" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[확인 방법]" class="" escape="false"></w2:textbox>
			<w2:textbox style="" id="" label="① , ② 버튼으로 각각 파일을 내려받아 Excel 에서 [열 숨기기 취소] 로 숨겨진 열을 표시한 뒤 , 그 열의 값이 어느 Column 인지 &quot;(인덱스n Column명)&quot; 표기로 확인한다 (숨김 상태 그대로는 어느 열이 숨겨졌는지 판별하기 어렵다)" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-top:6px;" id="" label="[기대] foldColumns=&quot;2&quot; 는 Column 순서를 바꿔도 정의 인덱스 2 인 보관위치 Column 이 숨겨져야 한다" class="" escape="false"></w2:textbox>
			<w2:textbox style="margin-bottom:8px;" id="" label="[실제] ① 순서 유지는 보관위치(정의 인덱스 2)가 숨겨져 정상이지만 , ② 순서 변경은 세 번째 위치의 구분(정의 인덱스 0) Column 이 대신 숨겨진다" class="" escape="false"></w2:textbox>

			<w2:textbox style="margin-top:10px;" id="" label="■ 대상 GridView (Column 정의 인덱스 0 구분 / 1 품목설명 / 2 보관위치 / 3 비고 / 4 수량)" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:gridView id="grd_item" dataList="data:dlt_item" checkAllType="false" columnMove="true" style="width:960px;height:160px;">
				<w2:header style="" id="header_item">
					<w2:row style="" id="hrow_item">
						<w2:column width="170" inputType="text" id="h_gubun" value="구분 (인덱스0)"></w2:column>
						<w2:column width="230" inputType="text" id="h_itemDesc" value="품목설명 (인덱스1)"></w2:column>
						<w2:column width="200" inputType="text" id="h_location" value="보관위치 (인덱스2)"></w2:column>
						<w2:column width="180" inputType="text" id="h_remark" value="비고 (인덱스3)"></w2:column>
						<w2:column width="*" inputType="text" id="h_qty" value="수량 (인덱스4)"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody style="" id="gBody_item">
					<w2:row style="" id="brow_item">
						<w2:column width="170" inputType="text" dataType="text" id="gubun" dataList="gubun" value=""></w2:column>
						<w2:column width="230" inputType="text" dataType="text" id="itemDesc" dataList="itemDesc" value=""></w2:column>
						<w2:column width="200" inputType="text" dataType="text" id="location" dataList="location" value=""></w2:column>
						<w2:column width="180" inputType="text" dataType="text" id="remark" dataList="remark" value=""></w2:column>
						<w2:column width="*" inputType="text" dataType="text" id="qty" dataList="qty" value=""></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="margin-top:8px;margin-bottom:14px;" id="grp_btn_item">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_keep_onclick" id="btn_keep" label="① 다운로드 (순서 유지 / foldColumns=2)" style=""></w2:button>
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_moved_onclick" id="btn_moved" label="② 다운로드 (순서 변경 / foldColumns=2)" style=""></w2:button>
			</xf:group>

			<xf:group class="" id="grp_bottom" style="">
