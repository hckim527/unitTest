									inputType="checkcombobox" separator="," style="text-align:left;" value="" width="310">
									<w2:choices>
										<w2:item>
											<w2:label><![CDATA[서울]]></w2:label>
											<w2:value><![CDATA[SEL]]></w2:value>
										</w2:item>
										<w2:item>
											<w2:label><![CDATA[부산]]></w2:label>
											<w2:value><![CDATA[BSN]]></w2:value>
										</w2:item>
										<w2:item>
											<w2:label><![CDATA[대구]]></w2:label>
											<w2:value><![CDATA[DGU]]></w2:value>
										</w2:item>
										<w2:item>
											<w2:label><![CDATA[인천]]></w2:label>
											<w2:value><![CDATA[ICN]]></w2:value>
										</w2:item>
									</w2:choices>
								</w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>

