		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

// 한번 열었던 필터 창 값 입력란 아이템 리스트의 항목 텍스트 (필터 창을 닫아도 항목 DOM 은 유지됨)
scwin.getFilterItemText = function (grid) {
    let tds = document.querySelectorAll("td[id^='" + grid.id + "_item_'][id*='_itemTable_']");
    let arr = [];
    tds.forEach(function (td) {
        if (/_itemTable_\d+$/.test(td.id)) {
            arr.push("'" + td.textContent + "'");
        }
    });
    return arr.length ? arr.join(" / ") : "열린 필터 항목 리스트 없음";
};

// 필터 항목 확인
scwin.btn_checkFilterList_onclick = function (e) {
    scwin.setReturnValue("[A] 필터 항목 : " + scwin.getFilterItemText(grd_A));
    scwin.setReturnValue("[B] 필터 항목 : " + scwin.getFilterItemText(grd_B));
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
