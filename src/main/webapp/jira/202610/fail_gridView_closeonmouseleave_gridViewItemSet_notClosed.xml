		<script lazy="false" type="text/javascript"><![CDATA[
// 감시 대상 (A : GridViewItemSet / B : Item)
scwin.watchList = [
    { "name" : "A", "grid" : "grd_A", "opened" : false, "outReported" : false },
    { "name" : "B", "grid" : "grd_B", "opened" : false, "outReported" : false }
];
scwin.mouseX = -1;
scwin.mouseY = -1;

scwin.onpageload = function () {
    document.addEventListener("mousemove", function (e) {
        scwin.mouseX = e.clientX;
        scwin.mouseY = e.clientY;
    }, true);
    setInterval(scwin.watchItemList, 100);
};

// 좌표가 요소 영역 안인지 여부
scwin.isInside = function (el) {
    if (!el) {
        return false;
    }
    let r = el.getBoundingClientRect();
    return scwin.mouseX >= r.left && scwin.mouseX <= r.right && scwin.mouseY >= r.top && scwin.mouseY <= r.bottom;
};

// 표시 중인 아이템 리스트창
scwin.getOpenedList = function (gridId) {
    // gridId : 렌더링된 GridView id (grid.id)
    let arr = document.querySelectorAll("[id^='G_" + gridId + "___selectbox_region_'][id$='temTable']");
    for (let i = 0; i < arr.length; i++) {
        let rect = arr[i].getBoundingClientRect();
        let style = window.getComputedStyle(arr[i]);
        if (rect.height > 0 && style.display !== "none" && style.visibility !== "hidden") {
            return arr[i];
        }
    }
    return null;
};

// 리스트창 표시 / 닫힘 / 영역 이탈 출력
scwin.watchItemList = function () {
    for (let i = 0; i < scwin.watchList.length; i++) {
        let w = scwin.watchList[i];
        let grid = $p.getComponentById(w.grid);
        if (!grid) {
            continue;
        }
        let gridEl = grid.render;
        let listEl = scwin.getOpenedList(grid.id);
        let opened = (listEl !== null);
        let inGrid = scwin.isInside(gridEl);

        if (opened !== w.opened) {
            w.opened = opened;
            w.outReported = false;
            scwin.setReturnValue("[" + w.name + "] 리스트창 " + (opened ? "표시" : "닫힘 (마우스 : GridView " + (inGrid ? "안" : "밖") + ")"));
        } else if (opened && !w.outReported && !inGrid && !scwin.isInside(listEl)) {
            w.outReported = true;
            scwin.setReturnValue("[" + w.name + "] 마우스 GridView·리스트창 밖 -> 리스트창 표시 유지");
        }
    }
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
