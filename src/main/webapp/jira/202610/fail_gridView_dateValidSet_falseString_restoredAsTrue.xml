		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // 편집 입력창에서 Enter 입력 시 결과 기록 (capture 단계)
    grd_A.render.addEventListener("keydown", function (e) { scwin.enterCapture(e, grd_A, dlt_A, "A"); }, true);
    grd_B.render.addEventListener("keydown", function (e) { scwin.enterCapture(e, grd_B, dlt_B, "B"); }, true);
    grd_C.render.addEventListener("keydown", function (e) { scwin.enterCapture(e, grd_C, dlt_C, "C"); }, true);
};

// Enter 입력값 -> 300ms 후 입력창 값 / DataList 값 / 표시값 출력
scwin.enterCapture = function (e, grd, dlt, name) {
    if (e.keyCode !== 13 || !e.target || e.target.tagName !== "INPUT") {
        return;
    }
    let inputEl = e.target;
    let typedValue = inputEl.value;
    let rowIndex = grd.getFocusedRowIndex();
    setTimeout(function () {
        scwin.setReturnValue("[" + name + "] Row " + rowIndex + " 입력 " + typedValue + " Enter -> 입력창 " + inputEl.value
            + " / DataList " + dlt.getCellData(rowIndex, "cal") + " / 표시값 " + grd.getCellDisplayData(rowIndex, "cal"));
    }, 300);
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
