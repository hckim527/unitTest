							<w2:choices>
								<w2:item><w2:label><![CDATA[서울]]></w2:label><w2:value><![CDATA[1]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[부산]]></w2:label><w2:value><![CDATA[2]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[대구]]></w2:label><w2:value><![CDATA[3]]></w2:value></w2:item>
							</w2:choices>
						</w2:column>
						<w2:column editModeEvent="onsecondclick" id="ccbSecond" inputType="checkcombobox" style="" value="" width="236">
							<w2:choices>
								<w2:item><w2:label><![CDATA[서울]]></w2:label><w2:value><![CDATA[1]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[부산]]></w2:label><w2:value><![CDATA[2]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[대구]]></w2:label><w2:value><![CDATA[3]]></w2:value></w2:item>
							</w2:choices>
						</w2:column>
						<w2:column editModeEvent="onsecondclick" id="acSecond" inputType="autoComplete" style="" value="" width="236">
							<w2:choices>
								<w2:item><w2:label><![CDATA[서울]]></w2:label><w2:value><![CDATA[1]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[부산]]></w2:label><w2:value><![CDATA[2]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[대구]]></w2:label><w2:value><![CDATA[3]]></w2:value></w2:item>
							</w2:choices>
						</w2:column>
						<w2:column editModeEvent="ondblclick" id="selDbl" inputType="select" style="" value="" width="236">
							<w2:choices>
								<w2:item><w2:label><![CDATA[서울]]></w2:label><w2:value><![CDATA[1]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[부산]]></w2:label><w2:value><![CDATA[2]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[대구]]></w2:label><w2:value><![CDATA[3]]></w2:value></w2:item>
