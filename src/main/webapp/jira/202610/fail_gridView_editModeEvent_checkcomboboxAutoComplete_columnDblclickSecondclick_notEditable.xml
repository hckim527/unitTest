					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1" style="">
					<w2:row id="row2" style="">
						<w2:column id="name" inputType="text" readOnly="true" style="" value="" width="50"></w2:column>
						<w2:column editModeEvent="ondblclick" id="ccbDbl" inputType="checkcombobox" style="" value="" width="236">
							<w2:choices>
								<w2:item><w2:label><![CDATA[서울]]></w2:label><w2:value><![CDATA[1]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[부산]]></w2:label><w2:value><![CDATA[2]]></w2:value></w2:item>
								<w2:item><w2:label><![CDATA[대구]]></w2:label><w2:value><![CDATA[3]]></w2:value></w2:item>
							</w2:choices>
						</w2:column>
