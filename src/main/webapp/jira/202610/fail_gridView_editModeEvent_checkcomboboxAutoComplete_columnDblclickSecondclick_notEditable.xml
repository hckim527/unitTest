		<script lazy="false" type="text/javascript"><![CDATA[
// Column 별 editModeEvent (결과 출력용)
scwin.colEvent = {
    "ccbDbl" : "ondblclick",
    "acDbl" : "ondblclick",
    "ccbSecond" : "onsecondclick",
    "acSecond" : "onsecondclick",
    "selDbl" : "ondblclick"
};
scwin.lastClick = { "key" : "", "time" : 0 };
scwin.editCell = "";

scwin.onpageload = function () {
};

// 조작 후 편집 모드 여부 출력
scwin.report = function (action, rowIndex, colId) {
    setTimeout(function () {
        let edited = grd_1.isEditing() && scwin.editCell === rowIndex + ":" + colId;
        scwin.setReturnValue(action + " : " + colId + " (row " + rowIndex + ") -> 편집 모드 " + (edited ? "진입" : "미진입"));
    }, 300);
};

// onsecondclick Column : 같은 셀을 시간을 두고 다시 클릭한 경우만 출력
scwin.grd_1_oncellclick = function (rowIndex, columnIndex, columnId) {
    let key = rowIndex + ":" + columnId;
    let now = new Date().getTime();
    let isSecond = (scwin.lastClick.key === key) && (now - scwin.lastClick.time > 500);
    let isDblPart = (scwin.lastClick.key === key) && (now - scwin.lastClick.time <= 500);
    scwin.lastClick = { "key" : key, "time" : now };
    if (scwin.colEvent[columnId] !== "onsecondclick" || isDblPart) {
        return;
    }
    scwin.report(isSecond ? "두 번째 클릭" : "첫 클릭", rowIndex, columnId);
};

// ondblclick Column : 더블클릭 결과 출력
scwin.grd_1_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    if (scwin.colEvent[columnId] !== "ondblclick") {
        return;
    }
    scwin.report("더블클릭", rowIndex, columnId);
};

scwin.grd_1_onbeforeedit = function (rowIndex, colIndex, value) {
    scwin.editCell = rowIndex + ":" + grd_1.getColumnID(colIndex);
};

scwin.grd_1_oneditend = function (rowIndex, colIndex, value) {
    scwin.editCell = "";
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] gridView editModeEvent=&quot;onclick&quot; 일 때 Body Column 이 inputType=&quot;checkcombobox&quot;/&quot;autoComplete&quot; 이고 Column editModeEvent=&quot;ondblclick&quot;/&quot;onsecondclick&quot; 이면 더블클릭·두 번째 클릭으로 편집 모드가 되지 않음&lt;/b&gt;&lt;br/&gt;[확인 방법] ondblclick Column 셀은 더블클릭, onsecondclick Column 셀은 클릭 후 1초 정도 뒤 같은 셀을 다시 클릭 (select Column 은 대조군)&lt;br/&gt;[기대] Column editModeEvent 대로 편집 모드 진입 (checkcombobox 는 아이템 리스트창, autoComplete 는 입력창 표시)&lt;br/&gt;[실제] checkcombobox·autoComplete Column 은 더블클릭·두 번째 클릭·클릭 1회 모두 편집 모드 미진입 / select Column(대조군) 은 더블클릭으로 정상 진입"></w2:textbox>

			<w2:textbox escape="false" id="" label="gridView editModeEvent=&quot;onclick&quot; / viewType 미설정" style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-bottom:8px;"></w2:textbox>
