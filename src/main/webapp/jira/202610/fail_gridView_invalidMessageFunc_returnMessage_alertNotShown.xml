		<script lazy="false" type="text/javascript"><![CDATA[
scwin.alertCount = 0;
scwin.callCount = 0;
scwin.checkTimer = null;

scwin.onpageload = function () {
    // alert 표시 여부를 결과창에 기록 (원래 alert 도 그대로 표시)
    scwin.orgAlert = window.alert;
    window.alert = function (msg) {
        scwin.alertCount++;
        scwin.setReturnValue("alert 표시 : " + msg);
        return scwin.orgAlert.apply(window, arguments);
    };
};

// A : 메시지 문자열을 반환하는 invalidMessageFunc
scwin.grd_A_cal_invalidMessageFunc = function () {
    let message = "유효하지 않은 날짜입니다.";
    scwin.callCount++;
    scwin.setReturnValue("[A] invalidMessageFunc 호출 " + scwin.callCount + " : 반환값 \"" + message + "\"");

    // 호출 직후 발생한 alert 건수 1줄 출력
    let before = scwin.alertCount;
    if (scwin.checkTimer) {
        clearTimeout(scwin.checkTimer);
    }
    scwin.checkTimer = setTimeout(function () {
        scwin.checkTimer = null;
        scwin.setReturnValue("[A] alert 표시 건수 : " + (scwin.alertCount - before));
    }, 500);
    return message;
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
    scwin.callCount = 0;
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
