			<w2:button ev:onclick="scwin.btn_b_onclick" id="btn_b" label="B advancedExcelDownload" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;margin-bottom:16px;"></w2:button>

