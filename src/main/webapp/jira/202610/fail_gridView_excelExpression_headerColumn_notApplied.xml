						<w2:column id="b_hGoal1" inputType="text" value="100" width="100"></w2:column>
						<w2:column id="b_hGoal2" inputType="text" value="120" width="100"></w2:column>
						<w2:column id="b_hGoal3" inputType="text" value="150" width="100"></w2:column>
						<w2:column id="b_hGoalSum" inputType="text" value="370" width="120"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gb_b" style="">
					<w2:row id="br_b" style="">
