						<w2:column id="total" inputType="text" width="120"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<w2:button ev:onclick="scwin.btn_a_onclick" id="btn_a" label="A advancedExcelDownload" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;margin-bottom:16px;"></w2:button>

			<w2:textbox id="" label="B : Body total Column excelExpression=SUM(B3:D3) (대조)" style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-bottom:8px;"></w2:textbox>
