		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
    let arr = [
        { "item" : "노트북", "col1" : "12", "col2" : "15", "col3" : "18", "total" : "45" }
    ];
    dlt_a.setJSON(arr);
    dlt_b.setJSON(arr);
};

// advancedExcelDownload 실행 + 서버로 전송된 합계 Column 의 excelExpression 출력
scwin.download = function (grd, name, sColId) {
    let sBody = "";
    let fnSubmit = HTMLFormElement.prototype.submit;
    HTMLFormElement.prototype.submit = function () {
        let objInput = this.querySelector("input[name=xmlValue]");
        if (sBody === "" && objInput) {
            sBody = objInput.value;
        }
        return fnSubmit.apply(this, arguments);
    };
    try {
        grd.advancedExcelDownload({ "fileName" : "grid_" + name, "extension" : "xlsx" });
    } finally {
        HTMLFormElement.prototype.submit = fnSubmit;
    }
    scwin.setReturnValue("[" + name + "] 전송 " + sColId + " Column excelExpression : " + scwin.getSentExpression(sBody, sColId));
};

// 전송 XML 에서 id 로 Column 여는 태그를 찾아 excelExpression 속성값을 읽는다
scwin.getSentExpression = function (sBody, sColId) {
    let nId = sBody.indexOf(' id="' + sColId + '"');
    if (nId < 0) {
        return "(미전달)";
    }
    let nStart = sBody.lastIndexOf("<w2:column", nId);
    let sTag = sBody.substring(nStart, sBody.indexOf(">", nId));
    let objExp = sTag.match(/ excelExpression="([^"]*)"/);
    return objExp ? objExp[1] : "(없음)";
};

scwin.btn_a_onclick = function () { scwin.download(grd_a, "A", "hGoalSum"); };
scwin.btn_b_onclick = function () { scwin.download(grd_b, "B", "total"); };

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] Header Column 에 설정한 excelExpression 이 advancedExcelDownload 로 받은 Excel 파일에 적용되지 않음&lt;/b&gt;&lt;br/&gt;[확인 방법] 각 그리드의 advancedExcelDownload 버튼을 눌러 받은 xlsx 를 Excel 로 열어 A 는 E2 셀(Header 2번째 Row hGoalSum), B 는 E3 셀(Body total)의 수식 입력줄 확인&lt;br/&gt;[기대] A 의 E2 셀에도 B 의 E3 셀처럼 설정한 Excel 수식이 적용됨&lt;br/&gt;[실제] B 의 E3 셀은 수식 SUM(B3:D3) 이 적용되나, A 의 E2 셀은 수식 없이 Header 값 370 만 저장됨"></w2:textbox>

			<w2:textbox id="" label="A : Header 2번째 Row hGoalSum Column excelExpression=SUM(B2:D2)" style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-bottom:8px;"></w2:textbox>
