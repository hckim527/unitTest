						<w2:column id="hMonth1" inputType="text" value="1월" width="100"></w2:column>
						<w2:column id="hMonth2" inputType="text" value="2월" width="100"></w2:column>
						<w2:column id="hMonth3" inputType="text" value="3월" width="100"></w2:column>
						<w2:column id="hTotal" inputType="text" value="합계" width="120"></w2:column>
					</w2:row>
					<w2:row id="hr_a2" style="">
