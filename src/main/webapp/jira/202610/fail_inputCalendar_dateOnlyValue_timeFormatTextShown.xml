<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] inputCalendar calendarValueType=yearMonthDateTime, ioFormat=yyyyMMdd 이면 마스크 문자 HH:mm 가 그대로 표시됨" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20261016" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_data" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="date" id="calA1" name="calA1"></w2:column>
						<w2:column dataType="date" id="calA2" name="calA2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<calA1><![CDATA[20261001]]></calA1>
							<calA2><![CDATA[20261001]]></calA2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    let calList = [ica_A1, ica_A2, ica_B1];
    for (let i = 0; i < calList.length; i++) {
        calList[i].setValue("20261001");
        scwin.setReturnValue("[" + calList[i].id.replace(/^.*ica_/, "ica_") + "] 표시값 : " + calList[i].render.querySelector("input").value + " / getValue : " + calList[i].getValue());
    }
    let colIds = ["calA1", "calA2"];
    for (let j = 0; j < colIds.length; j++) {
        scwin.setReturnValue("[참고 gridView " + colIds[j] + "] 셀 표시값 : " + scwin.getCellText(0, colIds[j]) + " / DataList : " + dlt_data.getCellData(0, colIds[j]));
    }
};

// 화면에 표시된 셀 텍스트
scwin.getCellText = function (rowIndex, colId) {
    let td = grd_data.render.querySelectorAll("td[data-col_id='" + colId + "']")[rowIndex];
    return td ? td.textContent : "";
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] inputCalendar : calendarValueType=yearMonthDateTime(Sec) + ioFormat=yyyyMMdd 에 8자리 값이면 HH:mm 문자가 표시됨&lt;/b&gt;&lt;br/&gt;[확인 방법] 페이지 로드 후 ica_A1 / ica_A2 표시값 확인 (모두 setValue(&quot;20261001&quot;))&lt;br/&gt;[기대] 마스크 문자(HH, mm, SS)가 표시되지 않음 (ica_B1 처럼 원값 또는 2026-10-01 00:00)&lt;br/&gt;[실제] ica_A1 : 2026-10-01 HH:mm / ica_A2 : 2026-10-01 HH:mm:SS"></w2:textbox>

			<xf:group id="" style="display:flex;align-items:center;margin-bottom:8px;">
				<w2:textbox id="" label="ica_A1 (yearMonthDateTime, io=yyyyMMdd)" style="width:320px;"></w2:textbox>
				<w2:inputCalendar calendarValueType="yearMonthDateTime" id="ica_A1" ioFormat="yyyyMMdd" style="width:220px;height:30px;"></w2:inputCalendar>
			</xf:group>
			<xf:group id="" style="display:flex;align-items:center;margin-bottom:8px;">
				<w2:textbox id="" label="ica_A2 (yearMonthDateTimeSec, io=yyyyMMdd)" style="width:320px;"></w2:textbox>
				<w2:inputCalendar calendarValueType="yearMonthDateTimeSec" id="ica_A2" ioFormat="yyyyMMdd" style="width:220px;height:30px;"></w2:inputCalendar>
			</xf:group>
			<xf:group id="" style="display:flex;align-items:center;margin-bottom:8px;">
				<w2:textbox id="" label="ica_B1 (대조) (yearMonthDateTime, io 미설정)" style="width:320px;"></w2:textbox>
				<w2:inputCalendar calendarValueType="yearMonthDateTime" id="ica_B1" style="width:220px;height:30px;"></w2:inputCalendar>
			</xf:group>

			<w2:textbox escape="false" id="" label="[참고] gridView calendar Column 도 동일 (DataList 값 20261001)" style="font-size:13px;margin-top:24px;margin-bottom:8px;"></w2:textbox>
			<w2:gridView dataList="data:dlt_data" id="grd_data" style="width:500px;height:80px;">
				<w2:header id="header1" style="">
					<w2:row id="row1" style="">
						<w2:column id="column1" inputType="text" style="" value="calA1 (yearMonthDateTime, io=yyyyMMdd)" width="250"></w2:column>
						<w2:column id="column2" inputType="text" style="" value="calA2 (yearMonthDateTimeSec, io=yyyyMMdd)" width="250"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1" style="">
					<w2:row id="row2" style="">
						<w2:column calendarValueType="yearMonthDateTime" dataType="date" id="calA1" inputType="calendar" ioFormat="yyyyMMdd" style=""
							viewType="icon" width="250"></w2:column>
						<w2:column calendarValueType="yearMonthDateTimeSec" dataType="date" id="calA2" inputType="calendar" ioFormat="yyyyMMdd" style=""
							viewType="icon" width="250"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="grp_bottom" style="margin-top:40px;">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display:flex;justify-content:flex-end;">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea id="tbx_return" style="border:1px solid #C4CDD5;border-radius:8px;width:100%;height:120px;"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
