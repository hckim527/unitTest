<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView select Column embeddedInput=true + directOpen=true 일 때 Enter 아래 이동 막힘" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20261016" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_a">
					<w2:columnInfo>
						<w2:column id="txt" name="txt" dataType="text"></w2:column>
						<w2:column id="sel" name="sel" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_b">
					<w2:columnInfo>
						<w2:column id="txt" name="txt" dataType="text"></w2:column>
						<w2:column id="sel" name="sel" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
    let arr = [
        { "txt" : "서울", "sel" : "1" },
        { "txt" : "부산", "sel" : "2" },
        { "txt" : "대구", "sel" : "3" }
    ];
    dlt_a.setJSON(arr);
    dlt_b.setJSON(arr);

    // Enter 키 입력 직전 포커스 셀 기록 (capture 단계)
    grd_a.render.addEventListener("keydown", function (e) { scwin.enterCapture(e, grd_a, "A"); }, true);
    grd_b.render.addEventListener("keydown", function (e) { scwin.enterCapture(e, grd_b, "B"); }, true);
};

// Enter 입력 셀 -> 300ms 후 포커스 셀 출력
scwin.enterCapture = function (e, grd, name) {
    if (e.keyCode !== 13) {
        return;
    }
    let beforeRow = grd.getFocusedRowIndex();
    let beforeCol = grd.getFocusedColumnID();
    setTimeout(function () {
        scwin.setReturnValue("[" + name + "] " + beforeCol + " (Row " + beforeRow + ") Enter -> " + grd.getFocusedColumnID() + " (Row " + grd.getFocusedRowIndex() + ")");
    }, 300);
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] select Column 이 embeddedInput=true 일 때 directOpen=true 를 설정하면 Enter 키의 기본 아래 이동이 막힘 (가이드 : embeddedInput=true 인 경우 directOpen 속성은 false 로 동작)&lt;/b&gt;&lt;br/&gt;[전제] A / B 두 그리드 모두 sel Column : inputType=select, embeddedInput=true / A : directOpen=true, B : directOpen=false / enterKeyMove 미설정(기본 아래 이동)&lt;br/&gt;[확인 방법] 각 그리드의 txt Column 첫 번째 행(서울) 셀 클릭 → →(오른쪽 방향키)로 sel 셀로 이동 → Enter 키 → 리턴 값 확인 (sel 셀을 마우스로 클릭하면 브라우저 기본 목록이 열려 Enter 가 그리드로 전달되지 않으므로 반드시 방향키로 이동)&lt;br/&gt;[기대] A 도 directOpen=false 로 동작하여 B 와 같이 Row 0 → Row 1 로 이동&lt;br/&gt;[실제] A 는 리스트창도 열리지 않고 Row 0 에 머무름 (B 는 Row 1 로 이동)"></w2:textbox>

			<w2:textbox id="" label="A : sel Column embeddedInput=true, directOpen=true" style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-bottom:8px;"></w2:textbox>
			<w2:gridView id="grd_a" dataList="data:dlt_a" style="width:400px;height:120px;margin-bottom:16px;">
				<w2:header id="hd_a" style="">
					<w2:row id="hr_a" style="">
						<w2:column id="h_a_txt" inputType="text" value="txt (text)" width="180"></w2:column>
						<w2:column id="h_a_sel" inputType="text" value="sel (select)" width="180"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gb_a" style="">
					<w2:row id="br_a" style="">
						<w2:column id="txt" inputType="text" width="180"></w2:column>
						<w2:column id="sel" inputType="select" width="180" embeddedInput="true" directOpen="true">
							<w2:choices>
								<w2:item><w2:label>1월</w2:label><w2:value>1</w2:value></w2:item>
								<w2:item><w2:label>2월</w2:label><w2:value>2</w2:value></w2:item>
								<w2:item><w2:label>3월</w2:label><w2:value>3</w2:value></w2:item>
							</w2:choices>
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<w2:textbox id="" label="B : sel Column embeddedInput=true, directOpen=false (대조)" style="background-color:#EAEEF1;font-size:16px;font-weight:bold;padding-left:5px;margin-bottom:8px;"></w2:textbox>
			<w2:gridView id="grd_b" dataList="data:dlt_b" style="width:400px;height:120px;margin-bottom:16px;">
				<w2:header id="hd_b" style="">
					<w2:row id="hr_b" style="">
						<w2:column id="h_b_txt" inputType="text" value="txt (text)" width="180"></w2:column>
						<w2:column id="h_b_sel" inputType="text" value="sel (select)" width="180"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gb_b" style="">
					<w2:row id="br_b" style="">
						<w2:column id="txt" inputType="text" width="180"></w2:column>
						<w2:column id="sel" inputType="select" width="180" embeddedInput="true" directOpen="false">
							<w2:choices>
								<w2:item><w2:label>1월</w2:label><w2:value>1</w2:value></w2:item>
								<w2:item><w2:label>2월</w2:label><w2:value>2</w2:value></w2:item>
								<w2:item><w2:label>3월</w2:label><w2:value>3</w2:value></w2:item>
							</w2:choices>
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 120px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
