<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView getColumnUseEditFormat" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성" meta_date="20260723" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_grid" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="dCalTrue" name="달력_true" dataType="text"></w2:column>
						<w2:column id="dCalFalse" name="달력_false" dataType="text"></w2:column>
						<w2:column id="dText" name="텍스트" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<dCalTrue><![CDATA[20260101]]></dCalTrue>
							<dCalFalse><![CDATA[20260202]]></dCalFalse>
							<dText><![CDATA[일반텍스트]]></dText>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};

scwin.onpageload = function () {
};

// 재현: 4개 컬럼/파라미터에 대해 getColumnUseEditFormat 호출 후 반환값+타입 출력
scwin.btn_reproduce_onclick = function () {
    var g = grd_target;

    var r1 = g.getColumnUseEditFormat("dCalTrue");   // calendar, useEditFormat=true
    var r2 = g.getColumnUseEditFormat("dCalFalse");  // calendar, useEditFormat=false
    var r3 = g.getColumnUseEditFormat("dText");      // text (비-calendar)
    var r4 = g.getColumnUseEditFormat("NOT_EXIST");  // 잘못된 columnInfo (없는 ID)
    var r5 = g.getColumnUseEditFormat(99);           // 잘못된 columnInfo (범위 밖 인덱스)

    scwin.setReturnValue("[getColumnUseEditFormat 반환값]");
    scwin.setReturnValue("① calendar, useEditFormat=true  → " + r1);
    scwin.setReturnValue("② calendar, useEditFormat=false → " + r2);
    scwin.setReturnValue("③ text(비-calendar 컬럼)         → " + r3);
    scwin.setReturnValue("④ 잘못된 columnInfo(없는 ID)     → " + r4);
    scwin.setReturnValue("⑤ 잘못된 columnInfo(범위밖 99)   → " + r5);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 10px;" id="grp_root">
			<w2:textbox style="" id="" label="■ [FAIL] gridView.getColumnUseEditFormat — calendar 아닌 컬럼 / 잘못된 columnInfo 도 false 반환하여 정상 false 와 구분 불가" class="tc_tbx_label_1" escape="false"></w2:textbox>
			<w2:textbox style="margin-bottom:8px;" id="" label="[기대] calendar 컬럼은 useEditFormat(true/false) 반환, inputType 이 calendar 아님/잘못된 columnInfo 는 구분 가능한 값(undefined 등) 반환" class="" escape="false"></w2:textbox>
			<xf:group style="margin-bottom:12px;" id="grp_grid">
				<w2:gridView id="grd_target" dataList="data:dlt_grid" style="height:130px;width:560px;" autoFit="allColumn">
					<w2:header id="header1">
						<w2:row id="hrow1">
							<w2:column width="190" inputType="text" id="hCalTrue" value="calendar useEditFormat=true"></w2:column>
							<w2:column width="190" inputType="text" id="hCalFalse" value="calendar useEditFormat=false"></w2:column>
							<w2:column width="180" inputType="text" id="hText" value="text(비-calendar)"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="brow1">
							<w2:column width="190" inputType="calendar" id="dCalTrue" calendarValueType="yearMonthDate" displayFormat="yyyy/MM/dd" useEditFormat="true"></w2:column>
							<w2:column width="190" inputType="calendar" id="dCalFalse" calendarValueType="yearMonthDate" displayFormat="yyyy/MM/dd" useEditFormat="false"></w2:column>
							<w2:column width="180" inputType="text" id="dText"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
			<xf:group style="margin-bottom:12px;" id="grp_btn">
				<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_reproduce_onclick" id="btn_reproduce" label="결함 재현 (getColumnUseEditFormat 호출)" style=""></w2:button>
			</xf:group>
			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 160px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
