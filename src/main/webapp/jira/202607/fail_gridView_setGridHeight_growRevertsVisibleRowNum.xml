<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" id="dlt_bind" repeatNode="map" useStatusValue="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true"></w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};



// 사전 조건 : 두 그리드에 동일 데이터(10행 : visibleRowNum(6)보다 많아 세로 스크롤 발생) 세팅
scwin.onpageload = function () {
    var rows = [];
    for (var i = 1; i <= 10; i++) {
        rows.push({ col1: "A" + i, col2: "B" + i, col3: "C" + i, col4: "D" + i });
    }
    dlt_bind.setJSON(rows, false);
};



// 현재 그리드의 실제 offsetHeight 반환
scwin.getHeight = function () {
    return Math.round(target1.render.offsetHeight);
};



// [재현 버튼] setGridHeight(100) : 현재(초기 약 280px)보다 작으므로 축소 경로 -> 정상
scwin.btn_shrink_onclick = function () {
    target1.setGridHeight(100);
    setTimeout(function () {
        scwin.setReturnValue("① setGridHeight(100) [축소] -> offsetHeight=" + scwin.getHeight() + "px");
    }, 350);
};



// [재현 버튼] setGridHeight(150) : 직전 100px 보다 크므로 확대 경로 -> visibleRowNum 기준 높이로 복귀(결함)
scwin.btn_grow_onclick = function () {
    target1.setGridHeight(150);
    setTimeout(function () {
        var h = scwin.getHeight();
        scwin.setReturnValue("② setGridHeight(150) [확대] -> offsetHeight=" + h + "px");
        scwin.setReturnValue("   [기대] 150px   [실제] " + h + "px" + (h !== 150 ? "  => 결함 : visibleRowNum(6) 기준 높이로 복귀" : ""));
    }, 350);
};
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding: 10px;" id="grp_root">
            <w2:textbox style="" id="" label="[FAIL] gridView.setGridHeight() 로 현재보다 큰 높이를 설정하면(확대), 요청 높이가 아닌 visibleRowNum 기준 높이로 복귀하는 결함 재현 (축소는 정상 / @spec 'setGridHeight 실행 시 visibleRowNum 무시'와 불일치)" class="" escape="false"></w2:textbox>

            <w2:textbox style="margin-top:8px;" id="" label="그리드 : visibleRowNum=6 (결함 조건) / 데이터 10행 / 높이 280px" class="" escape="false"></w2:textbox>

            <xf:group style="margin-top:8px;height:300px;" id="grp_grids">
                <xf:group id="grp_gridA" style="">
                    <w2:gridView checkAllType="false" id="target1" style="width:460px;height:280px;margin-top:4px;" dataList="data:dlt_bind" visibleRowNum="6">
                        <w2:caption style="" id="captionA" value="visibleRowNum=6"></w2:caption>
                        <w2:header style="" id="headerA">
                            <w2:row style="" id="rowA1">
                                <w2:column width="110" inputType="text" id="colA1" value="col1"></w2:column>
                                <w2:column width="110" inputType="text" id="colA2" value="col2"></w2:column>
                                <w2:column width="110" inputType="text" id="colA3" value="col3"></w2:column>
                                <w2:column width="110" inputType="text" id="colA4" value="col4"></w2:column>
                            </w2:row>
                        </w2:header>
                        <w2:gBody style="" id="gBodyA">
                            <w2:row style="" id="rowA2">
                                <w2:column width="110" inputType="text" id="col1" dataList="col1"></w2:column>
                                <w2:column width="110" inputType="text" id="col2" dataList="col2"></w2:column>
                                <w2:column width="110" inputType="text" id="col3" dataList="col3"></w2:column>
                                <w2:column width="110" inputType="text" id="col4" dataList="col4"></w2:column>
                            </w2:row>
                        </w2:gBody>
                    </w2:gridView>
                </xf:group>
            </xf:group>

            <xf:group style="margin-top:10px;display:flex;gap:6px;" id="grp_buttons">
                <w2:button class="" ev:onclick="scwin.btn_shrink_onclick" id="btn_shrink" label="① setGridHeight(100) [축소]" style=""></w2:button>
                <w2:button class="" ev:onclick="scwin.btn_grow_onclick" id="btn_grow" label="② setGridHeight(150) [확대]" style=""></w2:button>
            </xf:group>

            <xf:group class="" id="grp_bottom" style="margin-top:10px;">
                <w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
                <xf:group id="" style="display: flex;justify-content: flex-end">
                    <w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
                </xf:group>
                <xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 220px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
            </xf:group>
        </xf:group>
    </body>
</html>
