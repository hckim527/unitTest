<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView accessibility=true inputType=radio Tab 포커스" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260730" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_bug" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col2" name="col2"></w2:column>
						<w2:column dataType="text" id="col3" name="col3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[1행]]></col1><col2><![CDATA[N]]></col2><col3><![CDATA[A]]></col3></w2:row>
						<w2:row><col1><![CDATA[2행]]></col1><col2><![CDATA[N]]></col2><col3><![CDATA[B]]></col3></w2:row>
						<w2:row><col1><![CDATA[3행]]></col1><col2><![CDATA[Y]]></col2><col3><![CDATA[C]]></col3></w2:row>
						<w2:row><col1><![CDATA[4행]]></col1><col2><![CDATA[N]]></col2><col3><![CDATA[D]]></col3></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// [FAIL] gridView accessibility="true" 이고 Body Column inputType="radio" 인 경우
//        선택된 Radio 의 행만 Tab 키로 포커스 이동이 가능해야 하는데,
//        선택되지 않은 행의 Radio 로도 Tab 포커스가 이동한다.
//        (선택된 Radio 는 3행 col2)

scwin.onpageload = function () {
    // Radio 로 포커스가 진입할 때마다 어느 행인지 결과창에 출력 → Tab 에 의한 포커스 이동을 관측
    document.addEventListener('focusin', scwin.onRadioFocusIn, true);
};



// col2(radio) 셀로 포커스가 들어오면 행 번호와 선택 여부를 출력
scwin.onRadioFocusIn = function (e) {
    let el = e.target;
    if (!el || el.tagName !== 'INPUT' || el.type !== 'radio') {
        return;
    }
    let grid = document.getElementById('mf_grid_bug');
    if (!grid || !grid.contains(el)) {
        return;
    }
    let td = el.parentNode;
    while (td && td.tagName !== 'TD') {
        td = td.parentNode;
    }
    let m = (td && td.id ? td.id : '').match(/_cell_(\d+)_(\d+)/);
    let rowNo = m ? (Number(m[1]) + 1) : '?';
    scwin.setReturnValue("[Tab 포커스] " + rowNo + "행 Radio (선택됨=" + el.checked + ")"
        + (el.checked ? "" : "  <-- 선택되지 않은 행인데 Tab 포커스가 진입함"));
};

// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[/* 현재 테마에서 Cell 내부 Radio 의 테두리가 보이지 않아 표시를 보정한다(결함과 무관). */
.w2grid_embedded_radio { border-width: 1px !important; }]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px; display:flex; flex-direction:column; gap:12px;">
			<w2:textbox class="tc_tbx_label_1" escape="false" id="lbl_title" style=""
				label="■ [FAIL] gridView accessibility=&quot;true&quot; 이고 Body Column inputType=&quot;radio&quot; 인 경우, 선택된 Radio 의 행만 Tab 키로 포커스 이동이 가능해야 하는데 선택되지 않은 행의 Radio 로도 Tab 포커스가 이동함."></w2:textbox>

			<xf:group id="grp_grids" style="display:flex; gap:32px; align-items:flex-start;">
				<xf:group id="grp_bug" style="display:flex; flex-direction:column; gap:6px;">
					<w2:textbox class="" id="" label="[결함] accessibility=true / inputType=radio" style="font-weight:bold;"></w2:textbox>
					<w2:gridView id="grid_bug" accessibility="true" checkAllType="false" dataList="data:dlt_bug"
						style="width:420px;height:160px;">
						<w2:header id="hdr_bug">
							<w2:row id="hrow_bug">
								<w2:column width="120" inputType="text" id="hbug1" value="col1 (text)"></w2:column>
								<w2:column width="120" inputType="text" id="hbug2" value="col2 (radio)"></w2:column>
								<w2:column width="*" inputType="text" id="hbug3" value="col3 (text)"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="body_bug">
							<w2:row id="brow_bug">
								<w2:column width="120" inputType="text" dataType="text" id="col1" dataList="col1"></w2:column>
								<w2:column width="120" inputType="radio" dataType="text" valueType="other" trueValue="Y" falseValue="N"
									id="col2" dataList="col2"></w2:column>
								<w2:column width="*" inputType="text" dataType="text" id="col3" dataList="col3"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>

			<xf:group id="grp_btn" style="display:flex; gap:8px;">
			</xf:group>

			<!-- ===== 리턴 값 확인 (body_bottom.xml inline) ===== -->
			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 180px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
