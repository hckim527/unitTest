<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] gridView focusFlow=linear 시 focusMove=false Tab 이동" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20260715" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_bug" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col2" name="col2"></w2:column>
						<w2:column dataType="text" id="col3" name="col3"></w2:column>
						<w2:column dataType="text" id="col4" name="col4"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[A1]]></col1><col2><![CDATA[B1]]></col2><col3><![CDATA[C1]]></col3><col4><![CDATA[D1]]></col4></w2:row>
						<w2:row><col1><![CDATA[A2]]></col1><col2><![CDATA[B2]]></col2><col3><![CDATA[C2]]></col3><col4><![CDATA[D2]]></col4></w2:row>
						<w2:row><col1><![CDATA[A3]]></col1><col2><![CDATA[B3]]></col2><col3><![CDATA[C3]]></col3><col4><![CDATA[D3]]></col4></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// [FAIL] gridView 에서 focusMove="false" 이면 Tab 키로 셀 포커스가 이동하면 안 된다(@description).
//        그러나 focusFlow="linear" 이면 focusMove="false" 여도 Tab 키로 다음 셀로 포커스가 이동한다.

scwin.onpageload = function () {
    // 각 그리드 셀에 포커스가 들어올 때(focusin) 어느 셀인지 결과창에 출력 → Tab 에 의한 셀 포커스 이동을 관측
    document.addEventListener('focusin', scwin.onCellFocusIn);

    scwin.setReturnValue("[안내] 그리드의 임의의 셀을 클릭(포커스)한 뒤 Tab 키를 누르세요. (focusMove=false 이므로 Tab 으로 셀 포커스가 이동하면 안 됩니다.)");
    scwin.setReturnValue("[기대] Tab 시 다음 셀 포커스 로그가 찍히지 않고 포커스가 그리드 밖으로 나가야 함.");
    scwin.setReturnValue("[실제/결함] focusFlow=linear 이므로 Tab 시 '다음 셀' 포커스 로그가 연속으로 찍힘(= focusMove=false 무시하고 셀 이동).");
    scwin.setReturnValue("");
};



// 셀 포커스 진입 로그 (id 패턴 ..._cell_{row}_{col} 에서 어느 그리드/셀인지 판별)
scwin.onCellFocusIn = function (e) {
    let tid = (e.target && e.target.id) || '';
    let m = tid.match(/grid_bug_cell_(\d+)_(\d+)/);
    if (!m) return;
    scwin.setReturnValue("[결함(focusFlow=linear)] 셀 포커스 → row " + m[1] + ", col " + m[2]);
};



// ===== 리턴 값 출력 영역 (body_bottom.xml inline 복사) =====
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
		<style type="text/css"><![CDATA[]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_root" style="padding:16px; display:flex; flex-direction:column; gap:12px;">
			<w2:textbox class="tc_tbx_label_1" escape="false" id="lbl_title" style=""
				label="■ [FAIL] gridView focusMove=false 인데 focusFlow=linear 이면 Tab 키로 셀 포커스가 다음 셀로 이동함 (focusMove=false 는 Tab 이동을 막아야 함)."></w2:textbox>

			<xf:group id="grp_grids" style="display:flex; gap:32px; align-items:flex-start;">
				<xf:group id="grp_bug" style="display:flex; flex-direction:column; gap:6px;">
					<w2:textbox class="" id="" label="[결함] focusMove=false / focusFlow=linear" style="font-weight:bold;"></w2:textbox>
					<w2:gridView id="grid_bug" focusMode="cell" focusMove="false" focusFlow="linear" checkAllType="false"
						dataList="data:dlt_bug" style="width:420px;height:130px;">
						<w2:header id="hdr_bug">
							<w2:row id="hrow_bug">
								<w2:column width="100" inputType="text" id="hbug1" value="col1"></w2:column>
								<w2:column width="100" inputType="text" id="hbug2" value="col2"></w2:column>
								<w2:column width="100" inputType="text" id="hbug3" value="col3"></w2:column>
								<w2:column width="100" inputType="text" id="hbug4" value="col4"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="body_bug">
							<w2:row id="brow_bug">
								<w2:column width="100" inputType="text" id="col1" dataList="col1"></w2:column>
								<w2:column width="100" inputType="text" id="col2" dataList="col2"></w2:column>
								<w2:column width="100" inputType="text" id="col3" dataList="col3"></w2:column>
								<w2:column width="100" inputType="text" id="col4" dataList="col4"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>

			<!-- ===== 리턴 값 확인 (body_bottom.xml inline) ===== -->
			<xf:group class="" id="grp_bottom" style="">
				<w2:textbox class="tc_tbx_label_1" escape="false" id="" label="■ 리턴 값 확인" style=""></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style=""></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 180px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
