<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dlt_bind" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[A1]]></col1>
            				<col2><![CDATA[B1]]></col2>
            				<col3><![CDATA[C1]]></col3>
            				<col4><![CDATA[D1]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[A2]]></col1>
            				<col2><![CDATA[B2]]></col2>
            				<col3><![CDATA[C2]]></col3>
            				<col4><![CDATA[D2]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[A3]]></col1>
            				<col2><![CDATA[B3]]></col2>
            				<col3><![CDATA[C3]]></col3>
            				<col4><![CDATA[D3]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[A4]]></col1>
            				<col2><![CDATA[B4]]></col2>
            				<col3><![CDATA[C4]]></col3>
            				<col4><![CDATA[D4]]></col4>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding: 10px;" id="grp_root">
            <w2:textbox style="" id="" label="[FAIL] gridView 병합(colSpan) 그룹 헤더 '그룹A' 의 가운데(하위 col1/col2 경계)에 마우스 오버 시 col-resize 커서로 바뀌고 드래그하면 하위 Column 폭이 변경됨 (7월정기 degradation, 6월정기는 병합 헤더 내부에서 리사이즈 불가)" class="" escape="false"></w2:textbox>

            <w2:gridView checkAllType="false" id="target1" style="width:720px;height:220px;margin-top:8px;" dataList="data:dlt_bind">
                <w2:caption style="" id="caption1" value="병합(colSpan) 그룹 헤더 columnResize 결함 재현"></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="hrow1">
                        <w2:column colSpan="2" width="240" inputType="text" id="hcol_group" value="그룹A"></w2:column>
                        <w2:column rowSpan="2" width="120" inputType="text" id="hcol3" value="col3"></w2:column>
                        <w2:column rowSpan="2" width="*" inputType="text" id="hcol4" value="col4"></w2:column>
                    </w2:row>
                    <w2:row style="" id="hrow2">
                        <w2:column width="120" inputType="text" id="hcol1" value="col1"></w2:column>
                        <w2:column width="120" inputType="text" id="hcol2" value="col2"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="brow1">
                        <w2:column width="120" inputType="text" id="col1" dataList="col1"></w2:column>
                        <w2:column width="120" inputType="text" id="col2" dataList="col2"></w2:column>
                        <w2:column width="120" inputType="text" id="col3" dataList="col3"></w2:column>
                        <w2:column width="*" inputType="text" id="col4" dataList="col4"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
