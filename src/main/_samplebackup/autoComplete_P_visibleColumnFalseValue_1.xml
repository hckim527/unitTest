		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[autoComplete > P > visibleColumnFalseValue]<br/>아이템의 표시 여부에 대한 기준값들을 집합으로 설정합니다.",
    "validation" : [                
        "renderType=component 이고, visibleColumn 속성이 설정되었을때 아이템이 BindItemSet 으로 정의된 경우에 동작합니다.",
        "표시 여부 기준값들을 ',' 로 구분하여 문자열로 설정합니다.",
        "visibleColumn 속성이 설정되고, DataCollection 바인딩으로 아이템이 정의된 경우에 동작합니다.",
        "값을 설정하지 않으면 '0,false,FALSE,F' 값이 적용됩니다.",
        "visibleColumn 속성에 설정된 컬럼의 값이 visibleColumnFalseValue 속성의 기준값에 있는 경우 해당 아이템은 표시되지 않습니다."
    ]
}




scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getVisible_onclick = function (e) {
    let comp = '';

    if (par_comp.getText() == "target1")
        comp = "target1_itemTable_main";
    else
        comp = "target2_itemTable_main";
        
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj("scwin").setReturnValue("SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음");

    let trs = targetElements[0].querySelectorAll('tr.w2table_sb_row');
    
    // 각 td 요소의 visible 확인
    trs.forEach((tr, index) => {   
        if (tr.hasAttribute('data-wqhidden')) {            
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 미표시");	
        } else {
            wf_body_bottom.getObj("scwin").setReturnValue(comp + " 의 index=" + index + " 은 표시");	
        }
    });	
};
]]></script>
