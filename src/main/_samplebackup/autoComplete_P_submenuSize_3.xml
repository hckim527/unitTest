		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[autoComplete &gt; P &gt; submenuSize]&lt;br/&gt;아이템 리스트창의 너비(Width)를 결정하는 기준을 설정합니다.&quot;,
    &quot;validation&quot; : [            
        &quot;아이템이 GridViewItemSet 으로 정의된 경우 아이템 리스트창의 너비는 설정 팝업창의 'Ref Property' 탭에 설정한 'Width' 값이 우선 적용됩니다.&quot;,
        &quot;아이템이 GridViewItemSet 으로 정의된 경우 설정 팝업창의 'Ref Property' 탭에 'Width' 값을 설정하지 않으면 SelectBox 컴포넌트의 너비가 적용됩니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}



scwin.btn_getItemListSize_onclick = function (target) {
    let rtn = '';    
    let comp = target+&quot;_gridViewItemTable&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
            wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    rtn = targetElements[0].style.width
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;Itemlist width : &quot; + rtn);
};



scwin.target1_onclick = function (e) {
    scwin.btn_getItemListSize_onclick(&quot;target1&quot;);
}



scwin.target2_onclick = function (e) {
    scwin.btn_getItemListSize_onclick(&quot;target2&quot;);	
};
</script>
