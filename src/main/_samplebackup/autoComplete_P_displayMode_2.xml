		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[autoComplete &gt; P &gt; displayMode]&lt;br/&gt;컴포넌트의 아이템 리스트와 라벨 표시 영역에 아이템의 라벨값이 표시되는 포맷을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;customFormatter 또는 customLablFormatter 설정 시 해당 영역에 displayMode 속성이 적용되지 않습니다.&quot;,
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {        
        displayMode : con_displayMode.getText(),
        customFormatter : con_customFormatter.getText(),
        customLabelFormatter : con_customLabelFormatter.getText(),
    }
   
    let cList = $c.gcm.createCList(properties)
   
    // comp 생성 함수 호출
    $c.gcm.createBasicAutoComplete(cList);
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.render.textContent;
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;text : &quot; + rtn);    
};



scwin.fn_customformatter = function(items) {
    for (var i = 0; i &lt; items.length; i++) {
        items[i].label = items[i].orgLabel + &quot; Custom&quot;;
    }
    return items;
}



scwin.fn_customlabelformatter = function(label, idx) {
    return idx + &quot;, &quot; + label;
}</script>
	</head>
