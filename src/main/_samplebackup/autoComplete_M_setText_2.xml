		<script lazy="false" type="text/javascript"><![CDATA[// 테스트 설명, 유효성 값 설정
scwin.tData = {
    "description" : "[autoComplete > M > setText]<br/>컴포넌트에서 선택하려는 아이템의 라벨값을 설정합니다.",
    "validation" : [                
        "동일한 라벨값을 가진 아이템이 있는 경우 마지막 아이템이 선택됩니다.",        
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj("scwin").createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}


scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    rtn = target1.getText();
    
    wf_body_bottom.getObj("scwin").setReturnValue("getText : " + rtn);    
};



scwin.btn_setText_onclick = function (e) {
    let label = par_label.getText();
    let format = par_format.getText();

    if (format == "false" || format == "")
        format = false;
    else
        format = true;
    
	target1.setText(label, format);

    scwin.btn_getText_onclick();
};]]></script>
