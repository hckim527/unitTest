		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[autoComplete &gt; M &gt; setRef]&lt;br/&gt;컴포넌트의 ref 속성을 설정합니다.&quot;,
    &quot;validation&quot; : [
        &quot;ref(필수) 파라미터로 접근 가능한 DataCollection 의 컬럼을 'data:[DataCollection ID].[Key 또는 Column ID]' 형식으로 설정합니다.&quot;,
        &quot;메소드가 실행되어 ref 속성이 설정되면 DataCollection 에 선택된 데이터에 해당하는 아이템이 선택됩니다.&quot;,
        &quot;DataList 를 바인딩 했을때 선택한 데이터가 없거나 아이템의 Value 값과 일치하는 않으면 아이템 선택이 해제됩니다.&quot;,
        &quot;컴포넌트에서 선택한 아이템의 Value 값이 바인딩 된 DataCollection 에 반영됩니다.&quot;,    
    ]
}



scwin.onpageload = function () {
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);    

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {

}

scwin.target1_onchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onchange=====&quot;);
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;info.newValue : &quot; + info.newValue);
};



scwin.btn_getDataList_onclick = function (e) {
	let rsData  = dlt_ref.getAllJSON();

    for(var i = 0; i &lt; rsData.length; i++) {        
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;value 값 : &quot; + rsData[i].value);
    }
};



scwin.btn_setRef_onclick = function (e) {
	target1.setRef(&quot;data:dlt_ref.value&quot;);
};
</script>
	</head>
	<body ev:onpageload="scwin.onpageload">
