		<script lazy="false" type="text/javascript">// 테스트 설명, 유효성 값 설정
scwin.tData = {
    &quot;description&quot; : &quot;[autoComplete &gt; M &gt; changeChooseOption]&lt;br/&gt;chooseOption 속성으로 추가된 '선택 안내' 아이템의 Value, Label 값을 변경합니다.&quot;,
    &quot;validation&quot; : [
        &quot;newValue(필수) 파라미터로 '선택 안내' 아이템의 Value 값을 설정합니다.&quot;,        
        &quot;newLabel '선택 안내' 아이템의 Label 값을 설정합니다.&quot;,
        &quot;chooseOption=false 인 경우 새로운 '선택 안내' 아이템이 기존 아이템 위에 추가되며 나머지 아이템의 인덱스가 1 씩 증가합니다.&quot;,        
    ]
}



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();
    
    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);

    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }

    let properties = {
        chooseOption : con_chooseOption.getText(),        
    }
   
    let cList = $c.gcm.createCList(properties);
    let eList = $c.gcm.createEList([&quot;onviewchange&quot;]);
   
    // comp 생성 함수 호출
    $c.gcm.createBasicAutoComplete(cList, eList);
}



scwin.btn_getText_onclick = function (e) {
    let rtn = '';
    
    rtn = target1.getText();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getText : &quot; + rtn); 

    rtn = target1.getValue();    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;getValue : &quot; + rtn); 
};



scwin.btn_changeChooseOption_onclick = function (e) {
    let newValue = par_newValue.getValue();
    let newLabel = par_newLabel.getValue();

	target1.changeChooseOption(newValue, newLabel);
};



scwin.target1_onviewchange = function (info) {
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;=====target1_onviewchange=====&quot;); 
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item index : &quot; + info.newSelectedIndex); 
};
</script>
	</head>
