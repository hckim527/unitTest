		<script lazy="false" type="text/javascript">// 샘플에 직접 유효성 설정
scwin.tData = {
    &quot;description&quot; : &quot;[autoComplete &gt; M &gt; setNodeSet]&lt;br/&gt;아이템이 BindItemSet 또는 ItemSet 으로 정의되었을때 아이템과 DataCollection 을 새롭게 바인딩합니다.&quot;,
    &quot;validation&quot; : [        
        &quot;아이템이 GridViewItemSet 으로 정의된 경우는 지원하지 않습니다.&quot;,
        &quot;nodeset(필수) 파라미터로 아이템이 정의된 DataCollection 을 'data:[DataCollection ID]' 형식의 문자열로 설정합니다.&quot;,
        &quot;nodeset(필수) 파라미터로 유효하지 않은 값 설정 시 기존 아이템이 모두 제거됩니다.&quot;,
        &quot;label(선택) 파라미터로 아이템의 Label 값으로 설정할 컬럼의 ID 를 문자열로 설정합니다.&quot;,
        &quot;label(선택) 파라미터로 유효하지 않은 값으로 설정 시 아이템이 표시되지 않거나 'undefined' 가 표시됩니다.&quot;,
        &quot;label(선택) 파라미터로 값을 설정하지 않으면 기존값이 유지됩니다.&quot;,
        &quot;value(선택) 파라미터로 아이템의 Value 값으로 설정할 컬럼의 ID 를 문자열로 설정합니다.&quot;,
        &quot;value(선택) 파라미터로 유효하지 않은 값으로 설정 시 아이템이 표시되지 않습니다.&quot;,
        &quot;value(선택) 파라미터로 값을 설정하지 않으면 기존값이 유지됩니다.&quot;,
        &quot;setNodeSet() 메소드가 정상적으로 실행되면 기존의 아이템 선택 상태가 유지됩니다.&quot;,
        &quot;label, value 파라미터는 모두 생략되거나 모두 설정되어야 합니다.&quot;,
        &quot;label, value 파라미터를 생략 시 nodeset 파라미터의 DataCollection 컬럼 정보와 기존 컬럼 정보가 일치하여야 정상동작합니다.&quot;,
    ]
} 



scwin.onpageload = function () {
    // Global DataList 생성 호출
    $c.gcm.createCommonDatalist();

    // 테스트 설명, 유효성 생성
    wf_body_left.getObj(&quot;scwin&quot;).createValidation(scwin.tData);	
    
    // comp 초기 생성
    scwin.comp_init();
};



// comp 생성
scwin.comp_init = async function () {
    // 기존 target 있으면 삭제
    if (typeof target1 !== 'undefined') {
        target1.remove();
    }
    
    // target 생성    
    $c.gcm.createBasicAutoComplete();
}



scwin.btn_setNodeSet_onclick = function (e) {
    let nodeset = par_nodeset.getText();
    let label = par_label.getText();
    let value = par_value.getText();

    if (label == '' &amp;&amp; value == '')
        target1.setNodeSet(nodeset);
    else
        target1.setNodeSet(nodeset, label, value);
};



scwin.btn_getItem_onclick = function (e) {
    let rtn = '';
    rtn = target1.getText();
    
    wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;selectbox 의 label : &quot; + rtn); 

    let comp = &quot;target1_itemTable_main&quot;;
    let targetElements = document.querySelectorAll('[id*='+comp+']');

    if (targetElements.length == 0)
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;SelectBox 의 아이템 리스트를 한번 오픈해야 아이템 리스트 정보를 가져올 수 있음&quot;);

    let tds = targetElements[0].querySelectorAll('td.w2table_sb_col');
    
    // 각 td 요소의 visible 확인
    tds.forEach((td, index) =&gt; {   
        let itemLabel = td.textContent;
        wf_body_bottom.getObj(&quot;scwin&quot;).setReturnValue(&quot;item index=&quot; + index + &quot; 의 label : &quot; + itemLabel);	
    });	 
};</script>
